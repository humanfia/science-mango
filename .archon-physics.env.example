# Local-only provider configuration. Copy to .archon-physics.env and fill the
# values on the machine that runs the campaign. Never commit real credentials.
ANTHROPIC_AUTH_TOKEN=<local-secret>
ARCHON_MLLM_BASE_URL=<provider-origin>
ARCHON_MLLM_MODEL=<model-name>
LEANEXPLORE_API_KEY=<local-secret-if-required>
