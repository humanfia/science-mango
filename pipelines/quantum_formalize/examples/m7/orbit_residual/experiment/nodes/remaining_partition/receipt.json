          "declaration": "theorem M7.OrbitResidual.remaining_partition : ∀ (N : ℕ) [NeZero N], ∀ C0 C1 bases : Finset (M7.Action.Recipe N), M7.OrbitResidual.remaining (C0 ∪ C1) bases = M7.OrbitResidual.remaining C0 bases ∪ M7.OrbitResidual.remaining C1 bases := by\n  classical\n  intro N inst C0 C1 bases\n  unfold M7.OrbitResidual.remaining\n  apply Finset.ext\n  intro x\n  simp only [Finset.mem_sdiff, Finset.mem_union]\n  constructor\n  · rintro ⟨h0 | h1, h⟩\n    · exact Or.inl ⟨h0, h⟩\n    · exact Or.inr ⟨h1, h⟩\n  · rintro (⟨h0, h⟩ | ⟨h1, h⟩)\n    · exact ⟨Or.inl h0, h⟩\n    · exact ⟨Or.inr h1, h⟩",
