          "declaration": "theorem M7.OrbitFibers.orbit_partition : ∀ (G : Type) [Group G] [Fintype G] (X : Type) [MulAction G X] (c : X), ∀ (P : X → Prop) (test : X → Bool), M7.OrbitFibers.orbitCount G c P = M7.OrbitFibers.orbitCount G c (fun y => P y ∧ test y = false) + M7.OrbitFibers.orbitCount G c (fun y => P y ∧ test y = true) := by\n  classical\n  intro G _ _ X _ c P test\n  unfold M7.OrbitFibers.orbitCount\n  simp only [Finset.card_eq_sum_ones, Finset.sum_filter]\n  rw [← Finset.sum_add_distrib]\n  apply Finset.sum_congr rfl\n  intro y hy\n  have hb : ∀ b : Bool, b ≠ false → b = true := by decide\n  by_cases hp : P y\n  · by_cases ht : test y = false\n    · simp [hp, ht]\n    · have ht' : test y = true := hb (test y) ht\n      simp [hp, ht']\n  · simp [hp]",
          "imports": [
            "M7OrbitFibers"
