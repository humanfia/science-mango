        "payload": {
          "declaration": "theorem M7.GlobalQuery.winning_classes : ∀ (H N : ℕ) [NeZero N] (q : M7.DefaultQuery.Query) (bases : M7.GlobalQuery.Family H N) (i : Fin H), i ∈ M7.GlobalQuery.winningClasses q bases ↔ ∃ g : M7.Action.Record N, (i,g) ∈ M7.GlobalQuery.winners q bases := by\n  let QuantumHarnessFrozenTarget : Prop := (\n    ∀ (H N : ℕ) [NeZero N] (q : M7.DefaultQuery.Query) (bases : M7.GlobalQuery.Family H N) (i : Fin H), i ∈ M7.GlobalQuery.winningClasses q bases ↔ ∃ g : M7.Action.Record N, (i,g) ∈ M7.GlobalQuery.winners q bases\n  )\n  change QuantumHarnessFrozenTarget\n  unfold QuantumHarnessFrozenTarget\n  intro H N inst q bases i\n  classical\n  unfold M7.GlobalQuery.winningClasses\n  rw [Finset.mem_image]\n  constructor\n  · rintro ⟨⟨j, g⟩, h, hj⟩\n    change j = i at hj\n    subst j\n    exact ⟨g, h⟩\n  · rintro ⟨g, hg⟩\n    exact ⟨(i, g), hg, rfl⟩",
