          "declaration": "theorem M7.ResiduePrefix.polynomial_bridge : ∀ (N : ℕ) [NeZero N], ∀ A : Finset (ZMod N), M5.SupportPolynomial.ofSupport (M7.ResiduePrefix.encode A) = M7.Supports.polynomial A := by\n  classical\n  intro N inst A\n  unfold M7.ResiduePrefix.encode M7.Supports.natSupport M5.SupportPolynomial.ofSupport M7.Supports.polynomial\n  rw [Finset.sum_image]\n  intro a ha b hb hab\n  have h := congrArg (fun k : ℕ => (k : ZMod N)) hab\n  simpa only [ZMod.natCast_zmod_val] using h",
