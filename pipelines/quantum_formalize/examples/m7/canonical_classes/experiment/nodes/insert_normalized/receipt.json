          "declaration": "theorem M7.CanonicalClasses.idempotent : ∀ (N : ℕ) [NeZero N], ∀ c : M7.Action.Recipe N, M7.CanonicalOuter.canonical (M7.CanonicalOuter.canonical c) = M7.CanonicalOuter.canonical c := by\n  intro N inst c\n  simpa only [M7.CanonicalOuter.realizer_correct N c] using\n    M7.CanonicalOuter.canonical_invariant N (M7.CanonicalOuter.realizer c) c",
