        "payload": {
          "declaration": "theorem M7.AffinePolynomial.rho_mul_val : ∀ (N : ℕ) [NeZero N], ∀ (u : (ZMod N)ˣ) (x : ZMod N), M7.CyclicSubstitution.rho N ^ ((u : ZMod N)*x).val = M7.CyclicSubstitution.point u ^ x.val := by\n  intro N inst u x\n  change M7.CyclicSubstitution.rho N ^ ((u : ZMod N) * x).val =\n    (M7.CyclicSubstitution.rho N ^ (u : ZMod N).val) ^ x.val\n  rw [← pow_mul, ZMod.val_mul]\n  exact (M7.CyclicSubstitution.power_mod N ((u : ZMod N).val * x.val)).symm",
          "imports": [
            "M7AffinePolynomial"
          ],
