          "declaration": "theorem M7.AffinePolynomial.support_sum : ∀ (N : ℕ) [NeZero N], ∀ A : M7.Supports.Support N, M7.AffinePolynomial.image A = ∑ i ∈ A, M7.CyclicSubstitution.rho N ^ i.val := by\n  intro N inst A\n  classical\n  simp [M7.AffinePolynomial.image, M7.Supports.polynomial,\n    M6.Cyclic.image, M7.CyclicSubstitution.rho, map_sum,\n    map_pow, AdjoinRoot.mk_X]",
