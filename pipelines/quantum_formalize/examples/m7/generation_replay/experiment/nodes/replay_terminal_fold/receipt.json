        "payload": {
          "declaration": "theorem M7.GenerationReplay.replay_terminal_fold : ∀ (N : ℕ) [NeZero N] (w : ℕ) (E : Finset M5.BinaryPolynomial), ∀ (bases final : Finset (M7.Action.Recipe N)) (es : List (M7.CompactGeneration.Emission N)), M7.GenerationReplay.replay w E bases es = some final → M7.CompactGeneration.residual w E final [] = 0 ∧ final = es.foldl (fun acc e => insert e.representative acc) bases := by\n  classical\n  intro N inst w E bases final es\n  induction es generalizing bases final with\n  | nil =>\n      intro h\n      unfold M7.GenerationReplay.replay at h\n      split at h\n      · rename_i hz\n        have heq : bases = final := Option.some.inj h\n        subst final\n        exact ⟨hz, rfl⟩\n      · simp at h\n  | cons e es ih =>\n      intro h\n      unfold M7.GenerationReplay.replay at h\n      split at h\n      · exact ih (insert e.representative bases) final h\n      · simp at h",
          "imports": [
            "M7GenerationReplay"
          ],
