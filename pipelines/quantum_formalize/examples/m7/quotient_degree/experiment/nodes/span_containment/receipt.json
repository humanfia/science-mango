          "declaration": "theorem M7.QuotientDegree.span_containment : ∀ (N : ℕ) [NeZero N], ∀ F : M6.Cyclic.BinaryPolynomial, F ∣ M6.Cyclic.modulus N → Ideal.span ({M6.Cyclic.modulus N} : Set M6.Cyclic.BinaryPolynomial) ≤ Ideal.span ({F} : Set M6.Cyclic.BinaryPolynomial) := by\n  intro N _ F hF\n  apply Ideal.span_le.mpr\n  intro p hp\n  rcases Set.mem_singleton_iff.mp hp with rfl\n  exact Ideal.mem_span_singleton.mpr hF",
