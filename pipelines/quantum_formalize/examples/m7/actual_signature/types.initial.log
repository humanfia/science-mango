∀ (N : ℕ) [NeZero N] (c : M7.Action.Recipe N),
  Polynomial.Monic (M7.RecipeSignature.signature c) ∧ M7.RecipeSignature.signature c ∣ M6.Cyclic.modulus N : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (g : M7.Action.Record N),
  M7.SignatureIdeal.pairIdeal N (M7.Supports.polynomial (M7.Action.act g c).1)
      (M7.Supports.polynomial (M7.Action.act g c).2) =
    Ideal.map (M7.QuotientAuto.substitution g.unit)
      (M7.SignatureIdeal.pairIdeal N (M7.Supports.polynomial c.1) (M7.Supports.polynomial c.2)) : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (g : M7.Action.Record N),
  M7.RecipeSignature.signature (M7.Action.act g c) =
    M7.SignatureTau.sourceTau g.unit (M7.RecipeSignature.signature c) : Prop
∀ (N : ℕ) [inst : NeZero N] (u : (ZMod N)ˣ) (F : M6.Cyclic.BinaryPolynomial),
  Polynomial.Monic F →
    F ∣ M6.Cyclic.modulus N → Polynomial.natDegree (M7.SignatureTau.tau u F) = Polynomial.natDegree F : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (g : M7.Action.Record N),
  Polynomial.natDegree (M7.RecipeSignature.signature (M7.Action.act g c)) =
    Polynomial.natDegree (M7.RecipeSignature.signature c) : Prop
∀ (N : ℕ) [inst : NeZero N] (E : M6.Cyclic.BinaryPolynomial → Prop),
  M7.ActualFactorized.TranslationInvariant (M7.RecipeSignature.region E) : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (u : M7.ActualFactorized.Outer N),
  M7.RecipeSignature.signature (M7.ActualFactorized.outerImage c u) =
    M7.SignatureTau.sourceTau u.1 (M7.RecipeSignature.signature c) : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (E : M6.Cyclic.BinaryPolynomial → Prop),
  (∃ g, E (M7.RecipeSignature.signature (M7.Action.act g c))) ↔
    ∃ u, E (M7.SignatureTau.sourceTau u (M7.RecipeSignature.signature c)) : Prop
∀ (N : ℕ) [inst : NeZero N] (c : M7.Action.Recipe N) (E : M6.Cyclic.BinaryPolynomial → Prop)
  (L R : Finset (ZMod N) → Prop),
  (M7.RecipeSignature.sourceCount c E L R =
      M7.ActualOrbit.distinctCount c fun y => E (M7.RecipeSignature.signature y) ∧ L y.1 ∧ R y.2) ∧
    M7.ActualFactorized.stabilizerNumerator c ∣ M7.RecipeSignature.sourceNumerator c E L R : Prop
