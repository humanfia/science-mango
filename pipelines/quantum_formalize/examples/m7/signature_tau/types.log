  M7.SignatureTau.sourceTau u F = M7.SignatureTau.tau u F : Prop
∀ (N : ℕ) [inst : NeZero N] (F : M6.Cyclic.BinaryPolynomial),
  Polynomial.Monic F → F ∣ M6.Cyclic.modulus N → M7.SignatureTau.tau 1 F = F : Prop
∀ (N : ℕ) [inst : NeZero N] (u v : (ZMod N)ˣ) (F : M6.Cyclic.BinaryPolynomial),
  Polynomial.Monic F →
    F ∣ M6.Cyclic.modulus N → M7.SignatureTau.tau v (M7.SignatureTau.tau u F) = M7.SignatureTau.tau (v * u) F : Prop
