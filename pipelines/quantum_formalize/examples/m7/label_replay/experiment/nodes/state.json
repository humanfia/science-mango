            "payload": {
              "declaration": "theorem M7.LabelReplay.trace_recover : ∀ (N : ℕ) [NeZero N] (c : M7.Action.Recipe N) (d : ℕ) (P : M6.Pinned.Pins (2*N)) (xs : List (Fin (2*N))), (M7.LabelReplay.endpoint P (M7.LabelReplay.trace c d P xs), M7.LabelReplay.queryCount (M7.LabelReplay.trace c d P xs)) = M6.Pinned.recover (fun P => (M7.LabelReplay.Q c P).coeff d) P xs := by\n  intro N inst c d P xs\n  induction xs generalizing P with\n  | nil =>\n      rfl\n  | cons x xs ih =>\n      simp only [M7.LabelReplay.trace, M6.Pinned.recover]\n      rw [← ih]\n      simp [M7.LabelReplay.endpoint, M7.LabelReplay.queryCount, Nat.add_comm]",
