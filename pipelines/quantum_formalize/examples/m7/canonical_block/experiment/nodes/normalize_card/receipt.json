      "normalize_card": {
        "payload": {
          "declaration": "theorem M7.CanonicalBlock.normalize_card : ∀ (N : ℕ) [NeZero N], ∀ A : M7.CanonicalBlock.Support N, (M7.CanonicalBlock.normalize A).card = A.card := by\n  intro N inst A\n  change (M7.CanonicalBlock.shift (-M7.CanonicalBlock.bestAnchor A) A).card = A.card\n  exact M7.CanonicalBlock.shift_card N (-M7.CanonicalBlock.bestAnchor A) A",
