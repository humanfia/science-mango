        "payload": {
          "declaration": "theorem M7.CanonicalBlock.shift_card : ∀ (N : ℕ) [NeZero N], ∀ (s : ZMod N) (A : M7.CanonicalBlock.Support N), (M7.CanonicalBlock.shift s A).card = A.card := by\n  intro N inst s A\n  classical\n  change (A.image (fun i => i + s)).card = A.card\n  apply Finset.card_image_of_injective\n  intro a b h\n  exact add_right_cancel h",
