      },
      "completion_R_count": {
        "payload": {
          "declaration": "theorem M5.TupleCompletion.completion_R_count : ∀ (P : M5.BinaryPolynomial) (hP : P.Monic) (Z : M5.BinaryPolynomial) (T d k : ℕ), M5.ArithmeticTuple.R P hP T d k (AdjoinRoot.mk P Z) = (M5.TupleCompletion.count P Z T d k : ℤ) := by\n  intro P hP Z T d k\n  classical\n  rw [M5.ArithmeticTuple.R_exact]\n  simp only [M5.TupleCompletion.count, M5.TupleCompletion.divisibility_sum]",
