      "divisibility_sum": {
        "payload": {
          "declaration": "theorem M5.TupleCompletion.divisibility_sum : ∀ (P Z : M5.BinaryPolynomial) (T d k : ℕ) (t : Fin k → Fin (T / d)), (P ∣ Z + M5.ArithmeticTuple.tuplePolynomial T d k t ↔ AdjoinRoot.mk P (M5.ArithmeticTuple.tuplePolynomial T d k t) = AdjoinRoot.mk P Z) := by\n  intro P Z T d k t\n  have hneg : -Z = Z := by\n    ext n\n    simp only [Polynomial.coeff_neg]\n    have h : ∀ a : ZMod 2, -a = a := by decide\n    exact h (Z.coeff n)\n  rw [AdjoinRoot.mk_eq_mk, sub_eq_add_neg, hneg, add_comm]",
          "imports": [
            "M5TupleCompletion"
          ],
          "name": "M5.TupleCompletion.divisibility_sum",
          "ancestors": [],
          "spec_sha256": "4dad265e514ec1dc92a7c95ca34e671d92c48b0f4ed20f20ab2069d38d8e7d74"
