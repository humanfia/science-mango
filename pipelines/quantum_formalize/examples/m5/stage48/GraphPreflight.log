∀ (w : ℕ) (F : M5.BinaryPolynomial),
  0 < w →
    Polynomial.Monic F →
      Polynomial.coeff F 0 = 1 →
        M5.Final.PeriodClause F ∧
          M5.Final.OrderClause w F ∧ M5.Final.LowerClause w F ∧ M5.Final.WeightOneClause F : Prop
M5.Final.NormalizationClause : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  2 ≤ w →
    Polynomial.Monic F →
      Polynomial.coeff F 0 = 1 →
        M5.Final.GlobalClause w F ∧
          M5.Final.ProgressionClause w F ∧ M5.Final.BirthClause w F ∧ M5.Final.LaterClause w F : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  0 < w → Polynomial.Monic F → Polynomial.coeff F 0 = 1 → M5.Final.OriginalM5Core w F : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  0 < w → Polynomial.Monic F → Polynomial.coeff F 0 = 1 → M5.Final.OrderRecoveryClause w F : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  0 < w → Polynomial.Monic F → Polynomial.coeff F 0 = 1 → M5.Final.ResidueRecoveryClause w F : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  0 < w → Polynomial.Monic F → Polynomial.coeff F 0 = 1 → M5.Final.OriginalM5Spec w F : Prop
