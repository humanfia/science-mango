          "filtered_powerset": {
            "payload": {
              "declaration": "theorem M5.FiniteExclusion.filtered_powerset : ∀ (S : Finset M5.BinaryPolynomial) (bad : M5.BinaryPolynomial → Bool), S.powerset.filter (fun H => ∀ p ∈ H, bad p = true) = (S.filter (fun p => bad p = true)).powerset := by\n  change ∀ (S : Finset M5.BinaryPolynomial) (bad : M5.BinaryPolynomial → Bool), S.powerset.filter (fun H => ∀ p ∈ H, bad p = true) = (S.filter (fun p => bad p = true)).powerset\n  intro S bad\n  classical\n  apply Finset.ext\n  intro H\n  simp only [Finset.mem_filter, Finset.mem_powerset]\n  constructor\n  · rintro ⟨hHS, hbad⟩\n    intro p hp\n    exact Finset.mem_filter.mpr ⟨hHS hp, hbad p hp⟩\n  · intro hH\n    constructor\n    · intro p hp\n      exact (Finset.mem_filter.mp (hH hp)).1\n    · intro p hp\n      exact (Finset.mem_filter.mp (hH hp)).2",
              "imports": [
