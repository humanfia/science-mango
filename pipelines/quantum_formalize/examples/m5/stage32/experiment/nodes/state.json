              "declaration": "theorem M5.ResidueTailBridge.anchor_zero : ∀ (T k : ℕ) (hT : 0 < T) (r : Fin k → Fin T), ∀ i : Fin (k + 1), i.val = 0 → (M5.ResidueTailBridge.anchored hT r i).val = 0 := by\n  change ∀ (T k : ℕ) (hT : 0 < T) (r : Fin k → Fin T), ∀ i : Fin (k + 1), i.val = 0 → (M5.ResidueTailBridge.anchored hT r i).val = 0\n  intro T k hT r i hi\n  have hi0 : i = 0 := Fin.ext hi\n  subst i\n  simp [M5.ResidueTailBridge.anchored, Fin.cons_zero]",
