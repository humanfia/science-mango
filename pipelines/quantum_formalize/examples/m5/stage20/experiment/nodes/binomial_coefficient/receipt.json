          "declaration": "theorem M5.ArithmeticSubset.character_sign : ∀ (P : M5.BinaryPolynomial) (hP : P.Monic) (lam : M5.Character.BinaryVector P.natDegree) (z : AdjoinRoot P), M5.QuotientCharacter.value P hP lam z = 1 ∨ M5.QuotientCharacter.value P hP lam z = -1 := by\n  intro P hP lam z\n  unfold M5.QuotientCharacter.value M5.Character.value M5.Character.bitSign\n  simp only [Finset.prod_pow_eq_pow_sum]\n  exact neg_one_pow_eq_or ℤ _",
