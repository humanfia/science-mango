              "declaration": "theorem M5.SupportPolynomial.packed_sum_image : ∀ (w T : ℕ) (r : Fin w → Fin T), Function.Injective (M5.Packing.packedValue r) → M5.SupportPolynomial.ofSupport (M5.Packing.packedSupport r) = ∑ i : Fin w, (Polynomial.X : M5.BinaryPolynomial) ^ M5.Packing.packedValue r i := by\n  change ∀ (w T : ℕ) (r : Fin w → Fin T), Function.Injective (M5.Packing.packedValue r) → M5.SupportPolynomial.ofSupport (M5.Packing.packedSupport r) = ∑ i : Fin w, (Polynomial.X : M5.BinaryPolynomial) ^ M5.Packing.packedValue r i\n  intro w T r hinj\n  classical\n  unfold M5.SupportPolynomial.ofSupport M5.Packing.packedSupport\n  apply Finset.sum_image\n  intro i hi j hj hij\n  exact hinj hij",
