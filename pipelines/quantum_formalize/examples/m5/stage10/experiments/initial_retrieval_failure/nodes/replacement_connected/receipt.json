        "payload": {
          "declaration": "theorem M5.RepairSupport.replacement_combined_gcd : ∀ (A B : Finset ℕ) (e q : ℕ), M5.RepairSupport.combinedGcd (M5.RepairSupport.repaired A e q) B = Nat.gcd q (Nat.gcd ((A.erase e).gcd id) (B.gcd id)) := by\n  intro A B e q\n  unfold M5.RepairSupport.combinedGcd M5.RepairSupport.repaired\n  rw [Finset.gcd_insert]\n  change Nat.gcd (Nat.gcd q ((A.erase e).gcd id)) (B.gcd id) = Nat.gcd q (Nat.gcd ((A.erase e).gcd id) (B.gcd id))\n  exact Nat.gcd_assoc q ((A.erase e).gcd id) (B.gcd id)",
          "imports": [
            "M5QuotientMonomialPeriod",
            "M5RepairSupport"
