        "payload": {
          "declaration": "theorem M5.RepairSupport.replacement_connected : ∀ (A B : Finset ℕ) (e q : ℕ), Nat.gcd (Nat.gcd ((A.erase e).gcd id) (B.gcd id)) q = 1 → M5.RepairSupport.combinedGcd (M5.RepairSupport.repaired A e q) B = 1 := by\n  intro A B e q h\n  rw [M5.RepairSupport.replacement_combined_gcd, Nat.gcd_comm q]\n  exact h",
