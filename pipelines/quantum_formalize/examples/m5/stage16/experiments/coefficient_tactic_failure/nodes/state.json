        "artifacts": {
          "cyclic_quotient_nonzero": {
            "payload": {
              "declaration": "theorem M5.PolynomialExclusion.cyclic_quotient_nonzero : ∀ (F : M5.BinaryPolynomial) (N : ℕ), 0 < N → F.Monic → F ∣ M5.cyclicModulus N → M5.cyclicModulus N / F ≠ 0 := by\n  change ∀ (F : M5.BinaryPolynomial) (N : ℕ), 0 < N → F.Monic → F ∣ M5.cyclicModulus N → M5.cyclicModulus N / F ≠ 0\n  intro F N hN hmonic hdvd hquot\n  have hmul := EuclideanDomain.mul_div_cancel' hmonic.ne_zero hdvd\n  have hzero : M5.cyclicModulus N = 0 := by\n    rw [hquot, mul_zero] at hmul\n    exact hmul.symm\n  have hcoeff := congrArg (fun p : M5.BinaryPolynomial => p.coeff N) hzero\n  simp [M5.cyclicModulus, Polynomial.coeff_add, Polynomial.coeff_X_pow,\n    Polynomial.coeff_one, Nat.ne_of_gt hN] at hcoeff",
              "imports": [
                "M5BinaryDivisibility",
                "M5PolynomialExclusion"
              ],
              "name": "M5.PolynomialExclusion.cyclic_quotient_nonzero",
              "ancestors": [],
              "spec_sha256": "b0532c3169a505613547a5afe9875d28b297d14bd0d58335ec2106c544c8a1e0"
            },
            "sha256": "036811517bf41eac11a8dd2b92b8d60c29660b9fa842c056582bd36cb6c6bd89"
          }
        }
