          "declaration": "theorem M5.Lift.bounded_progression : ∀ T E L : ℕ, 0 < E → T < L → ∃ j : ℕ, L ≤ T + j * E ∧ T + j * E < L + E := by\n  change ∀ T E L : ℕ, 0 < E → T < L → ∃ j : ℕ, L ≤ T + j * E ∧ T + j * E < L + E\n  intro T E L hE hTL\n  let a := L - T - 1\n  have ha : T + a + 1 = L := by\n    dsimp [a]\n    omega\n  have hdiv := Nat.mod_add_div a E\n  have hmod := Nat.mod_lt a hE\n  rw [Nat.mul_comm E (a / E)] at hdiv\n  refine ⟨a / E + 1, ?_⟩\n  rw [Nat.add_mul, Nat.one_mul]\n  constructor <;> omega",
