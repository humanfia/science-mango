          "declaration": "theorem M5.PhysicalBridge.positive_member : ∀ A : Finset ℕ, 2 ≤ A.card → 0 ∈ A → ∃ a ∈ A, 0 < a := by\n  change ∀ A : Finset ℕ, 2 ≤ A.card → 0 ∈ A → ∃ a ∈ A, 0 < a\n  intro A hcard hzero\n  by_contra h\n  have hsub : A ⊆ {0} := by\n    intro a ha\n    have haz : a = 0 := by\n      by_contra hne\n      exact h ⟨a, ha, Nat.pos_of_ne_zero hne⟩\n    simpa only [Finset.mem_singleton] using haz\n  have hle : A.card ≤ 1 := by\n    simpa using Finset.card_le_card hsub\n  omega",
