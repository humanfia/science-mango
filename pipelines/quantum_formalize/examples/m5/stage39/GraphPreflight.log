∀ (N w : ℕ) (F : M5.BinaryPolynomial) (S U : Finset ℕ),
  0 < w →
    Polynomial.Monic F →
      Polynomial.coeff F 0 = 1 → M5.PhysicalOrder.realizes N w F S U → 0 < M5.ResidueCount.A w F : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  2 ≤ w →
    Polynomial.Monic F →
      Polynomial.coeff F 0 = 1 →
        0 < M5.ResidueCount.A w F →
          ∃ S U N E,
            0 < E ∧
              N < M5.birthBound w (M5.signaturePeriod F) ∧
                ∀ (j : ℕ), M5.PhysicalOrder.realizes (N + j * E) w F S U : Prop
∀ (w : ℕ) (F : M5.BinaryPolynomial),
  2 ≤ w →
    Polynomial.Monic F →
      Polynomial.coeff F 0 = 1 →
        0 ≤ M5.ResidueCount.A w F ∧
          (0 < M5.ResidueCount.A w F ↔ ∃ N S U, M5.PhysicalOrder.realizes N w F S U) ∧
            (M5.ResidueCount.A w F = 0 ↔ ¬∃ N S U, M5.PhysicalOrder.realizes N w F S U) : Prop
