      "divide_degree": {
        "payload": {
          "declaration": "theorem M6.Normalize.divide_degree : ∀ (k : ℤ) (p : Polynomial ℤ) (n : ℕ), (∀ d, n < d → p.coeff d = 0) → ∀ d, n < d → (M6.Normalize.divide k p).coeff d = 0 := by\n  change ∀ (k : ℤ) (p : Polynomial ℤ) (n : ℕ), (∀ d, n < d → p.coeff d = 0) → ∀ d, n < d → (M6.Normalize.divide k p).coeff d = 0\n  intro k p n hp d hd\n  rw [M6.Normalize.divide_coeff, hp d hd, Int.zero_ediv]",
