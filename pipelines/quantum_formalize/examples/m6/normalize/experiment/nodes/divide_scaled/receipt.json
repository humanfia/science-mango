      "divide_coeff": {
        "payload": {
          "declaration": "theorem M6.Normalize.divide_coeff : ∀ (k : ℤ) (p : Polynomial ℤ) (d : ℕ), (M6.Normalize.divide k p).coeff d = p.coeff d / k := by\n  classical\n  change ∀ (k : ℤ) (p : Polynomial ℤ) (d : ℕ), (M6.Normalize.divide k p).coeff d = p.coeff d / k\n  intro k p d\n  by_cases hd : d ∈ p.support\n  · simp [M6.Normalize.divide, Polynomial.sum, Polynomial.coeff_sum, Polynomial.coeff_monomial, hd]\n  · have hz : p.coeff d = 0 := by simpa using hd\n    simp [M6.Normalize.divide, Polynomial.sum, Polynomial.coeff_sum, Polynomial.coeff_monomial, hd, hz]",
          "imports": [
            "M6Normalize"
          ],
          "name": "M6.Normalize.divide_coeff",
          "ancestors": [],
          "spec_sha256": "946721a0b7429363eab7134d8abf36639063f6bc4f7b8155a7c54d4762a862cc"
        },
        "sha256": "6ab8656e4ccd9151e2dc1f1bcf48a5e097ee3649e622a6eb01410e999a840e4f"
      },
      "divide_scaled": {
        "payload": {
          "declaration": "theorem M6.Normalize.divide_scaled : ∀ (k : ℤ) (p : Polynomial ℤ), k ≠ 0 → M6.Normalize.divide k (Polynomial.C k * p) = p := by\n  change ∀ (k : ℤ) (p : Polynomial ℤ), k ≠ 0 → M6.Normalize.divide k (Polynomial.C k * p) = p\n  intro k p hk\n  apply Polynomial.ext\n  intro d\n  rw [M6.Normalize.divide_coeff, Polynomial.coeff_C_mul]\n  simp [Int.mul_ediv_cancel_left, hk]",
