        "payload": {
          "declaration": "theorem M6.BoundaryFibers.annihilator_general : ∀ (F M : M6.BoundaryFibers.BP), F.Monic → F ∣ M → M ≠ 0 → Nat.card {h : AdjoinRoot M // AdjoinRoot.mk M F * h = 0} = 2^F.natDegree := by\n  intro F M hF hFM hM\n  rcases hFM with ⟨K, rfl⟩\n  have hK : K ≠ 0 := by\n    intro hK\n    apply hM\n    simp [hK]\n  simpa only [M6.KernelFibers.annihilator] using\n    (M6.KernelFibers.annihilator_card F K hF hK)",
