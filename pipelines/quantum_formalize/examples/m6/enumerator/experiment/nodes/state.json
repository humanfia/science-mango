              "declaration": "theorem M6.Pinned.enumerator_total : ∀ (m : ℕ) (L : Finset (M6.Pinned.Vector m)), Polynomial.eval 1 (M6.Pinned.enumerator L (M6.Pinned.free m)) = (L.card : ℤ) := by\n  classical\n  intro m L\n  change (Polynomial.evalRingHom (1 : ℤ)) (M6.Pinned.enumerator L (M6.Pinned.free m)) = (L.card : ℤ)\n  simp [M6.Pinned.enumerator, M6.Pinned.agrees, M6.Pinned.free]",
