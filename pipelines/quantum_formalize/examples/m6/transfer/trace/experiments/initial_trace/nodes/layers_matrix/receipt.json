        "payload": {
          "declaration": "theorem M6.Transfer.layers_matrix : ∀ (R : ℕ) (K : Type) [CommSemiring K] (W : ℕ → M6.Transfer.Memory R → M6.Transfer.Bit → K) (start finish : M6.Transfer.Memory R) (n : ℕ), M6.Transfer.layers W start n finish = M6.Transfer.matrixProduct (fun i => M6.Transfer.edgeMatrix (W i)) n start finish := by\n  classical\n  intro R K inst W start finish n\n  induction n generalizing finish with\n  | zero =>\n      simp [M6.Transfer.layers, M6.Transfer.matrixProduct, Matrix.one_apply, eq_comm]\n  | succ n ih =>\n      simp only [M6.Transfer.layers, M6.Transfer.propagate,\n        M6.Transfer.matrixProduct, Matrix.mul_apply, M6.Transfer.edgeMatrix,\n        Finset.mul_sum, mul_ite, mul_zero, ih]",
