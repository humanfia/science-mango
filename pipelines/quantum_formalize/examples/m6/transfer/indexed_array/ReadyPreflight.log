∀ (R N : ℕ) [inst : NeZero N] (W : ℕ → M6.Transfer.Memory R → M6.Transfer.Bit → Polynomial ℤ),
  R < N →
    (∀ (i : ℕ) (m : M6.Transfer.Memory R) (t : M6.Transfer.Bit), M6.Transfer.polynomialMass (W i m t) ≤ 4) →
      (∀ (i : ℕ) (m : M6.Transfer.Memory R) (t : M6.Transfer.Bit), (W i m t).natDegree ≤ 2) →
        M6.Transfer.IndexedArrayGuarantee R N W : Prop
