        "payload": {
          "declaration": "theorem M6.ActualTransfer.scalar_trace_support : ∀ (R N : ℕ) (W : ℕ → M6.Transfer.Memory R → M6.Transfer.Bit → Polynomial ℤ) (d : ℕ), 2*N < d → (M6.Transfer.scalarTracePolynomial W N).coeff d = 0 := by\n  intro R N W d hd\n  classical\n  unfold M6.Transfer.scalarTracePolynomial\n  rw [Polynomial.finset_sum_coeff]\n  apply Finset.sum_eq_zero\n  intro i hi\n  have hne : (i : ℕ) ≠ d := by\n    have hi_lt := i.isLt\n    omega\n  simp [Polynomial.coeff_monomial, hne]",
