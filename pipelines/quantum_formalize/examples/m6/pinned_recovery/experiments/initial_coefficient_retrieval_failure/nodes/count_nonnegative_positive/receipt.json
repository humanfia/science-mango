          "declaration": "theorem M6.Pinned.count_nonnegative_positive : ∀ (m : ℕ) (L : Finset (M6.Pinned.Vector m)) (P : M6.Pinned.Pins m) (d : ℕ), 0 ≤ M6.Pinned.count L P d ∧ (0 < M6.Pinned.count L P d ↔ ∃ v ∈ L, M6.Pinned.agrees P v ∧ M6.Pinned.weight v = d) := by\n  classical\n  intro m L P d\n  unfold M6.Pinned.count\n  constructor\n  · exact Int.natCast_nonneg _\n  · simp [Int.natCast_pos, Finset.card_pos, Finset.Nonempty, and_assoc]",
