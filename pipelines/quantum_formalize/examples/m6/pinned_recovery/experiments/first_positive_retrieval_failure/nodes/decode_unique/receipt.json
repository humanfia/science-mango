          "declaration": "theorem M6.Pinned.decode_unique : ∀ (m : ℕ) (P : M6.Pinned.Pins m), M6.Pinned.assigned P → ∀ v : M6.Pinned.Vector m, (M6.Pinned.agrees P v ↔ v = M6.Pinned.decode P) := by\n  intro m P hP v\n  unfold M6.Pinned.assigned at hP\n  constructor\n  · intro hv\n    unfold M6.Pinned.agrees at hv\n    funext i\n    have ha := hP i\n    have hv' := hv i\n    cases hi : P i <;> simp_all [M6.Pinned.decode]\n  · intro hv\n    subst v\n    unfold M6.Pinned.agrees\n    intro i\n    cases hi : P i <;> simp [M6.Pinned.decode, hi]",
