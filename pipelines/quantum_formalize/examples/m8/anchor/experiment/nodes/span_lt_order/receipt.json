          "declaration": "theorem M8.Anchor.span_lt_order : ∀ (N : ℕ) [NeZero N] (c : M8.Anchor.Recipe N), M8.Anchor.span c < N := by\n  change ∀ (N : ℕ) [NeZero N] (c : M8.Anchor.Recipe N), M8.Anchor.span c < N\n  intro N inst c\n  have hN : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)\n  unfold M8.Anchor.span\n  apply max_lt_iff.mpr\n  constructor\n  all_goals\n    apply (Finset.sup_lt_iff hN).mpr\n    intro a ha\n    exact ZMod.val_lt a",
