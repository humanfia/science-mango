        "payload": {
          "declaration": "theorem M8.CoverageFoundation.coset_direction : ∀ (N : ℕ) [NeZero N], ∀ (A : Finset (ZMod N)) (H : AddSubgroup (ZMod N)), M8.CoverageFoundation.InCoset A H → M8.CoverageFoundation.direction A ≤ H := by\n  intro N inst A H hA\n  rcases hA with ⟨a, ha⟩\n  change AddSubgroup.closure (M7.Connectivity.differences A) ≤ H\n  apply (AddSubgroup.closure_le H).2\n  intro z hz\n  rcases hz with ⟨x, hx, y, hy, rfl⟩\n  change x - y ∈ H\n  have he : x - y = (x - a) - (y - a) := by abel\n  rw [he]\n  exact H.sub_mem (ha x hx) (ha y hy)",
          "imports": [
            "M8CoverageFoundation"
          ],
