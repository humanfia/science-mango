        "payload": {
          "declaration": "theorem M8.Solver.discovery_span : ∀ (N : ℕ) [NeZero N] (c : M7.Action.Recipe N), ∀ w : ℕ, 0 < w → M8.PhysicalBridge.Valid w c → (M8.Discovery.discover c ≠ none ↔ M8.OrbitSpan.value c ≤ M8.Cutoff.limit N) := by\n  intro N inst c w hw hv\n  have hleft : c.1.Nonempty := Finset.card_pos.mp (by\n    rw [hv.1]\n    exact hw)\n  have hright : c.2.Nonempty := Finset.card_pos.mp (by\n    rw [hv.2.1]\n    exact hw)\n  exact (M8.Discovery.complete N c).trans\n    (M8.OrbitSpan.small_iff N c hleft hright (M8.Cutoff.limit N)).symm",
          "imports": [
            "M8Solver"
          ],
