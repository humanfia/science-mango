      "conv_delta": {
        "payload": {
          "declaration": "theorem M8.Diagonal.conv_delta : ∀ (N : ℕ) [NeZero N], ∀ (p : M6.Physical.Block N) (j i : ZMod N), M6.Physical.conv N p (M6.Physical.delta N j) i = p (i-j) := by\n  intro N inst p j i\n  classical\n  unfold M6.Physical.conv M6.Physical.delta\n  rw [Finset.sum_eq_single (i - j)]\n  · simp\n  · intro r hr hne\n    have h : i - r ≠ j := by\n      intro heq\n      apply hne\n      calc\n        r = i - (i - r) := (sub_sub_cancel i r).symm\n        _ = i - j := congrArg (fun x => i - x) heq\n    simp [h, Ne.symm h]\n  · simp",
          "imports": [
            "M8Diagonal"
          ],
          "name": "M8.Diagonal.conv_delta",
