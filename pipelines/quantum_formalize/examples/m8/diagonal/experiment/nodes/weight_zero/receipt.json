        "payload": {
          "declaration": "theorem M8.Diagonal.weight_zero : ∀ (N : ℕ) [NeZero N], ∀ a : M6.Physical.Block N, M6.Physical.weight N a = 0 ↔ a = 0 := by\n  classical\n  intro N inst a\n  change (Finset.univ.filter (fun i : ZMod N => a i ≠ 0)).card = 0 ↔ a = 0\n  constructor\n  · intro h\n    have hempty := Finset.card_eq_zero.mp h\n    funext i\n    change a i = 0\n    by_contra hi\n    have hmem : i ∈ Finset.univ.filter (fun j : ZMod N => a j ≠ 0) :=\n      Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩\n    simp [hempty] at hmem\n  · rintro rfl\n    simp",
