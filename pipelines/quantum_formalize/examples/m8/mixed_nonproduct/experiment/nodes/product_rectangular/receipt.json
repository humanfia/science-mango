        "payload": {
          "declaration": "theorem M8.MixedNonproduct.product_rectangular : ∀ (N : ℕ) [NeZero N], ∀ c : M7.Action.Recipe N, M8.MixedNonproduct.Product c ↔ ∀ z ∈ M8.MixedNonproduct.Cycles c, ∀ t ∈ M8.MixedNonproduct.Cycles c, (z.1,t.2) ∈ M8.MixedNonproduct.Cycles c := by\n  intro N inst c\n  unfold M8.MixedNonproduct.Product\n  constructor\n  · rintro ⟨U, V, h⟩ z hz t ht\n    rw [h] at hz ht ⊢\n    exact ⟨hz.1, ht.2⟩\n  · intro h\n    refine ⟨{x | ∃ y, (x, y) ∈ M8.MixedNonproduct.Cycles c},\n      {y | ∃ x, (x, y) ∈ M8.MixedNonproduct.Cycles c}, ?_⟩\n    apply Set.ext\n    intro z\n    change z ∈ M8.MixedNonproduct.Cycles c ↔\n      (∃ y, (z.1, y) ∈ M8.MixedNonproduct.Cycles c) ∧\n      (∃ x, (x, z.2) ∈ M8.MixedNonproduct.Cycles c)\n    constructor\n    · intro hz\n      exact ⟨⟨z.2, hz⟩, ⟨z.1, hz⟩⟩\n    · rintro ⟨⟨y, hy⟩, ⟨x, hx⟩⟩\n      exact h (z.1, y) hy (x, z.2) hx",
