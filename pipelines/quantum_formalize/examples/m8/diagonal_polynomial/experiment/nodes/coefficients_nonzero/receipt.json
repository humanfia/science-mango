        "payload": {
          "declaration": "theorem M8.DiagonalPolynomial.coefficients_nonzero : ∀ (N : ℕ) [NeZero N], ∀ p : M8.DiagonalPolynomial.BP, p ≠ 0 → p.degree < (N : WithBot ℕ) → M6.Coordinates.coefficients N p ≠ 0 := by\n  intro N inst p hp hdeg hzero\n  apply hp\n  have hrec := M6.Coordinates.block_reconstruct N p hdeg\n  rw [hzero] at hrec\n  simpa [M6.Coordinates.blockPolynomial] using hrec.symm",
