noncomputable section

set_option autoImplicit false
set_option warningAsError true

/-!
# The all-Frostman branch from pointwise tube packing

This file connects the geometric common-point packing input directly to the
exact `K_F(gamma / 2)` endpoint.  The pointwise cap is imposed on the actual
full tube carriers.  Integrating it inside the normalized unit ball gives

`actualFamilyVolume <= (C * volume unitBallBody) * delta^(-2)`.

The existing all-Frostman algebra then absorbs this entire finite constant at
an explicit small-delta threshold.  Neither an abstract volume bound nor a
multiplicity conclusion is stored in an auxiliary structure.
-/

/-- The finite volume constant generated by a pointwise packing constant
`C`.  Keeping the unit-ball volume visible avoids hiding a normalization
constant. -/
def allFrostmanPointwisePackingVolumeConstant (C : ENNReal) : ENNReal :=
  C * volume (unitBallBody : Set Space)

theorem allFrostmanPointwisePackingVolumeConstant_ne_top
    {C : ENNReal} (hCtop : C ≠ ⊤) :
    allFrostmanPointwisePackingVolumeConstant C ≠ ⊤ := by
  unfold allFrostmanPointwisePackingVolumeConstant
  exact ENNReal.mul_ne_top hCtop measure_closedBall_lt_top.ne

/-- Terminal scale at which the pointwise packing constant, including the
fixed unit-ball volume, is absorbed into the allowed `delta^(-epsilon)` loss.
The extra minimum makes the scale immediately suitable for the quantifiers in
`FrostmanProperty`. -/
def allFrostmanPointwisePackingThreshold
    (C : ENNReal) (epsilon gamma : Real) : NNReal :=
  min
    (allFrostmanConstantThreshold
      (allFrostmanPointwisePackingVolumeConstant C) epsilon gamma)
    (2 : NNReal)⁻¹

theorem allFrostmanPointwisePackingThreshold_pos
    (C : ENNReal) (epsilon gamma : Real) :
    0 < allFrostmanPointwisePackingThreshold C epsilon gamma := by
  rw [allFrostmanPointwisePackingThreshold, lt_min_iff]
  exact ⟨allFrostmanConstantThreshold_pos _ _ _, by positivity⟩

theorem allFrostmanPointwisePackingThreshold_le_half
    (C : ENNReal) (epsilon gamma : Real) :
    allFrostmanPointwisePackingThreshold C epsilon gamma ≤
      (2 : NNReal)⁻¹ :=
  min_le_right _ _

/-- A literal pointwise full-carrier cap, together with the Sticky
union-volume lower bound, implies the exact `K_F(gamma / 2)` estimate.

The cap constant `C` is the one in `M <= C * delta^(-2)`.  The proof itself
integrates that cap, exposes the resulting unit-ball volume factor, and
absorbs it at `allFrostmanPointwisePackingThreshold`.
-/
theorem averageMultiplicity_le_frostmanRHS_of_allFrostman_pointwisePacking
    {delta : NNReal} {iota : Type} [Fintype iota] [DecidableEq iota]
    (D : ActualTubeDatum delta iota) (hD : D.IsAdmissible)
    (M : Nat) {C : ENNReal} {epsilon gamma : Real}
    (hdeltaThreshold :
      delta ≤ allFrostmanPointwisePackingThreshold C epsilon gamma)
    (hCtop : C ≠ ⊤) (hepsilon : 0 < epsilon)
    (hgamma0 : 0 ≤ gamma) (hgamma4 : gamma ≤ 4)
    (hpoint :
      ∀ x, (actualCarrierShading D).pointMultiplicity x ≤ M)
    (hcap :
      (M : ENNReal) ≤ C * (delta : ENNReal) ^ (-2 : Real))
    (hunion :
      (delta : ENNReal) ^ (gamma / 2) ≤
        volume D.shading.shadedUnion) :
    D.shading.averageMultiplicity ≤
      frostmanMultiplicityRHS delta D.actualFamilyVolume epsilon
        (gamma / 2) := by
  have hvolume :
      D.actualFamilyVolume ≤
        allFrostmanPointwisePackingVolumeConstant C *
          (delta : ENNReal) ^ (-2 : Real) := by
    simpa only [allFrostmanPointwisePackingVolumeConstant] using
      (actualFamilyVolume_le_rpow_neg_two_of_pointCap
        D hD M hpoint hcap)
  have hconstantTop :
      allFrostmanPointwisePackingVolumeConstant C ≠ ⊤ :=
    allFrostmanPointwisePackingVolumeConstant_ne_top hCtop
  exact averageMultiplicity_le_frostmanRHS_of_allFrostman_branch
    D hD.delta_pos
      (hdeltaThreshold.trans (min_le_left _ _))
      hconstantTop hepsilon hgamma0 hgamma4 hvolume hunion

/-- Quantified `FrostmanAtParameters (gamma / 2)` wrapper.  The two theorem
arguments are precisely the geometric producers still supplied by the
branch: an actual pointwise carrier-hit packing theorem and the Sticky
union-volume lower theorem. -/
theorem frostmanAtParameters_halfExponent_of_pointwisePacking
    (C : ENNReal) {epsilon eta gamma : Real}
    (hCtop : C ≠ ⊤) (hepsilon : 0 < epsilon)
    (hgamma0 : 0 ≤ gamma) (hgamma4 : gamma ≤ 4)
    (hpacking :
      ∀ {delta : NNReal} {iota : Type}
        [Fintype iota] [DecidableEq iota]
        (D : ActualTubeDatum delta iota),
        D.IsAdmissible → FrostmanHypotheses D eta →
          ∃ M : Nat,
            (∀ x, (actualCarrierShading D).pointMultiplicity x ≤ M) ∧
            (M : ENNReal) ≤
              C * (delta : ENNReal) ^ (-2 : Real))
    (hunion :
      ∀ {delta : NNReal} {iota : Type}
        [Fintype iota] [DecidableEq iota]
        (D : ActualTubeDatum delta iota),
        D.IsAdmissible → FrostmanHypotheses D eta →
          (delta : ENNReal) ^ (gamma / 2) ≤
            volume D.shading.shadedUnion) :
    FrostmanAtParameters (gamma / 2) epsilon eta
      (allFrostmanPointwisePackingThreshold C epsilon gamma) := by
  intro delta iota _ _ D hD hdelta hF
  obtain ⟨M, hpoint, hcap⟩ := hpacking D hD hF
  exact averageMultiplicity_le_frostmanRHS_of_allFrostman_pointwisePacking
    D hD M hdelta hCtop hepsilon hgamma0 hgamma4 hpoint hcap
      (hunion D hD hF)

#print axioms allFrostmanPointwisePackingVolumeConstant_ne_top
#print axioms allFrostmanPointwisePackingThreshold_pos
#print axioms averageMultiplicity_le_frostmanRHS_of_allFrostman_pointwisePacking
#print axioms frostmanAtParameters_halfExponent_of_pointwisePacking

end

end Family8AllFrostmanBranchFromPointwisePackingV1
