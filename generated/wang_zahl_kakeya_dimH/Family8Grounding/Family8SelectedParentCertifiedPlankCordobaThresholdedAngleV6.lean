/-!
# The paper-faithful `a / b` angle cutoff

The literal V4 assignment placed every positive angle in a genuine bucket,
so its inverse-sine factor had no uniform geometric bound.  Here angles with
`sin(angle) < a / b` are assigned to the exceptional class.  On every genuine
class the dyadic upper endpoint times `a / b` is at most `2`, exactly retaining
the anisotropic cancellation in the plank overlap estimate.  The genuine
labels moreover lie in the explicit interval generated by `[1,b/a]`.

No angle lower bound, container-scale bound, or final Cordoba estimate is an
input to these constructions.
-/

universe u

variable {iota : Type u} [Fintype iota]
variable {F : ConvexFamily iota} {Y : Shading F}
variable {C a b : NNReal}

/-- Exceptional below the plank aspect ratio; literal ceil-log above it. -/
noncomputable def certifiedPlankThresholdedPairLevel
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) : Option Int :=
  if (((a / b : NNReal) : Real) ≤ certifiedPlankPairSine cert i j) then
    some (dyadicCeilBucket ((certifiedPlankPairSine cert i j)⁻¹))
  else none

/-- Actual pairs that survive the `a / b` angular cutoff. -/
noncomputable def certifiedPlankThresholdedPairs
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) :
    Finset (iota × iota) := by
  classical
  exact Finset.univ.filter fun ij ↦
    (((a / b : NNReal) : Real) ≤
      certifiedPlankPairSine cert ij.1 ij.2)

@[simp]
theorem mem_certifiedPlankThresholdedPairs
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (ij : iota × iota) :
    ij ∈ certifiedPlankThresholdedPairs cert ↔
      (((a / b : NNReal) : Real) ≤
        certifiedPlankPairSine cert ij.1 ij.2) := by
  classical
  change ij ∈ (Finset.univ.filter fun xy : iota × iota ↦
      (((a / b : NNReal) : Real) ≤
        certifiedPlankPairSine cert xy.1 xy.2)) ↔ _
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]

/-- Only labels occupied by pairs surviving the aspect-ratio cutoff. -/
noncomputable def certifiedPlankThresholdedLevels
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) : Finset Int :=
  occupiedWeightBuckets (certifiedPlankThresholdedPairs cert) fun ij ↦
    dyadicCeilBucket ((certifiedPlankPairSine cert ij.1 ij.2)⁻¹)

/-- Members of one thresholded row-angle class. -/
noncomputable def certifiedPlankThresholdedRowIndices
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i : iota) (k : Option Int) : Finset iota := by
  classical
  exact Finset.univ.filter fun j ↦
    certifiedPlankThresholdedPairLevel cert i j = k

@[simp]
theorem mem_certifiedPlankThresholdedRowIndices
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) (k : Option Int) :
    j ∈ certifiedPlankThresholdedRowIndices cert i k ↔
      certifiedPlankThresholdedPairLevel cert i j = k := by
  classical
  simp [certifiedPlankThresholdedRowIndices]

/-- Convex hull of the actual full bodies in a thresholded row class. -/
noncomputable def certifiedPlankThresholdedHullContainer
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i : iota) (k : Option Int) : ConvexBody Space :=
  hullContainer F (certifiedPlankThresholdedRowIndices cert i k)

omit [Fintype iota] in
theorem certifiedPlankAspectRatio_pos
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) (i : iota) :
    0 < (((a / b : NNReal) : Real)) := by
  have ha : 0 < a := (cert i).a_pos
  have hb : 0 < b := ha.trans_le (cert i).a_le_b
  exact_mod_cast div_pos ha hb

theorem certifiedPlankThresholdedPairLevel_mem
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) :
    certifiedPlankThresholdedPairLevel cert i j ∈
      plankAngleLevels (certifiedPlankThresholdedLevels cert) := by
  classical
  by_cases hcut : (((a / b : NNReal) : Real) ≤
      certifiedPlankPairSine cert i j)
  · have hp : (i, j) ∈ certifiedPlankThresholdedPairs cert :=
      (mem_certifiedPlankThresholdedPairs cert (i, j)).2 hcut
    have hb : dyadicCeilBucket ((certifiedPlankPairSine cert i j)⁻¹) ∈
        certifiedPlankThresholdedLevels cert := by
      exact mem_occupiedWeightBuckets_iff.mpr ⟨(i, j), hp, rfl⟩
    unfold certifiedPlankThresholdedPairLevel
    rw [if_pos hcut]
    simp [plankAngleLevels, hb]
  · unfold certifiedPlankThresholdedPairLevel
    rw [if_neg hcut]
    simp [plankAngleLevels]
omit [Fintype iota] in
theorem certifiedPlankThresholdedPairSine_pos_of_level_eq_some
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) (k : Int)
    (hlevel : certifiedPlankThresholdedPairLevel cert i j = some k) :
    0 < certifiedPlankPairSine cert i j := by
  unfold certifiedPlankThresholdedPairLevel at hlevel
  split_ifs at hlevel with hcut
  exact (certifiedPlankAspectRatio_pos cert i).trans_le hcut

omit [Fintype iota] in
theorem certifiedPlankThresholded_inverseSine_le
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) (k : Int)
    (hlevel : certifiedPlankThresholdedPairLevel cert i j = some k) :
    ENNReal.ofReal ((certifiedPlankPairSine cert i j)⁻¹) ≤
      certifiedPlankDyadicInverseSineWeight k := by
  have hsin := certifiedPlankThresholdedPairSine_pos_of_level_eq_some
    cert i j k hlevel
  have hcut : (((a / b : NNReal) : Real) ≤
      certifiedPlankPairSine cert i j) := by
    unfold certifiedPlankThresholdedPairLevel at hlevel
    split_ifs at hlevel with h
    exact h
  unfold certifiedPlankThresholdedPairLevel at hlevel
  rw [if_pos hcut] at hlevel
  injection hlevel with hk
  subst k
  unfold certifiedPlankDyadicInverseSineWeight
  exact ENNReal.ofReal_le_ofReal
    (dyadicCeilUpper_half_lt_and_le (inv_pos.mpr hsin)).2

theorem certifiedPlankThresholded_body_subset_hullContainer
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) :
    (F j : Set Space) ⊆
      (certifiedPlankThresholdedHullContainer cert i
        (certifiedPlankThresholdedPairLevel cert i j) : Set Space) := by
  classical
  have hj : j ∈ certifiedPlankThresholdedRowIndices cert i
      (certifiedPlankThresholdedPairLevel cert i j) := by simp
  exact body_subset_hullContainer F hj ⟨j, hj⟩

omit [Fintype iota] in
theorem certifiedPlankThresholdedPairLevel_self
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) (i : iota) :
    certifiedPlankThresholdedPairLevel cert i i = none := by
  have hframe : (cert i).box.frame 0 ≠ 0 := by
    intro hzero
    have hone := (cert i).box.frame.norm_eq_one 0
    rw [hzero, norm_zero] at hone
    norm_num at hone
  have hsine : certifiedPlankPairSine cert i i = 0 := by
    unfold certifiedPlankPairSine
    rw [InnerProductGeometry.angle_self hframe]
    simp
  have hratio := certifiedPlankAspectRatio_pos cert i
  have hnot : ¬ (((a / b : NNReal) : Real) ≤ 0) := not_le.mpr hratio
  unfold certifiedPlankThresholdedPairLevel
  rw [hsine, if_neg hnot]

/- Exact real cancellation behind the plank angle gain. -/
omit [Fintype iota] in
theorem dyadicCeilUpper_mul_aspectRatio_le_two
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) (k : Int)
    (hlevel : certifiedPlankThresholdedPairLevel cert i j = some k) :
    dyadicCeilUpper k * (((a / b : NNReal) : Real)) ≤ 2 := by
  let s := certifiedPlankPairSine cert i j
  let q : Real := ((a / b : NNReal) : Real)
  have hq : 0 < q := certifiedPlankAspectRatio_pos cert i
  have hcut : q ≤ s := by
    unfold certifiedPlankThresholdedPairLevel at hlevel
    split_ifs at hlevel with h
    exact h
  have hs : 0 < s := hq.trans_le hcut
  have hk : k = dyadicCeilBucket s⁻¹ := by
    unfold certifiedPlankThresholdedPairLevel at hlevel
    rw [if_pos hcut] at hlevel
    exact (Option.some.inj hlevel).symm
  subst k
  have hupper : dyadicCeilUpper (dyadicCeilBucket s⁻¹) ≤ 2 * s⁻¹ := by
    have hhalf :=
      (dyadicCeilUpper_half_lt_and_le (inv_pos.mpr hs)).1
    have hmul := (div_lt_iff₀ (by norm_num : (0 : Real) < 2)).mp hhalf
    simpa [mul_comm] using le_of_lt hmul
  have hinvRatio : s⁻¹ * q ≤ 1 := by
    rw [mul_comm]
    exact (mul_inv_le_iff₀ hs).2 (by simpa using hcut)
  calc
    dyadicCeilUpper (dyadicCeilBucket s⁻¹) * q ≤
        (2 * s⁻¹) * q := mul_le_mul_of_nonneg_right hupper hq.le
    _ = 2 * (s⁻¹ * q) := by ring
    _ ≤ 2 * 1 := mul_le_mul_of_nonneg_left hinvRatio (by norm_num)
    _ = 2 := by norm_num

/- ENNReal form used directly by `certifiedPlankAngleScale`. -/
omit [Fintype iota] in
theorem certifiedPlankDyadicWeight_mul_aspectRatio_le_two
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (i j : iota) (k : Int)
    (hlevel : certifiedPlankThresholdedPairLevel cert i j = some k) :
    certifiedPlankDyadicInverseSineWeight k *
        ((a / b : NNReal) : ENNReal) ≤ 2 := by
  have hu : 0 ≤ dyadicCeilUpper k :=
    (Real.rpow_pos_of_pos (by norm_num : (0 : Real) < 2) _).le
  have hreal := dyadicCeilUpper_mul_aspectRatio_le_two cert i j k hlevel
  unfold certifiedPlankDyadicInverseSineWeight
  rw [← ENNReal.ofReal_coe_nnreal]
  rw [← ENNReal.ofReal_mul hu]
  simpa using ENNReal.ofReal_le_ofReal hreal

/-- Uniform paper-level angle cap after the `a / b` cancellation. -/
def certifiedPlankThresholdedAngleScaleCap (C : NNReal) : ENNReal :=
  max 1 (4 * ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹))

theorem certifiedPlankThresholdedAngleScale_le_cap
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (k : Option Int)
    (hk : k ∈ plankAngleLevels (certifiedPlankThresholdedLevels cert)) :
    certifiedPlankAngleScale C a b
        certifiedPlankDyadicInverseSineWeight k ≤
      certifiedPlankThresholdedAngleScaleCap C := by
  classical
  cases k with
  | none =>
      simp [certifiedPlankAngleScale,
        certifiedPlankThresholdedAngleScaleCap]
  | some label =>
      have hlabel : label ∈ certifiedPlankThresholdedLevels cert := by
        simpa [plankAngleLevels] using hk
      rcases mem_occupiedWeightBuckets_iff.mp hlabel with ⟨ij, hij, hijLabel⟩
      have hcut : (((a / b : NNReal) : Real) ≤
          certifiedPlankPairSine cert ij.1 ij.2) := by
        exact (mem_certifiedPlankThresholdedPairs cert ij).1 hij
      have hlevel : certifiedPlankThresholdedPairLevel cert ij.1 ij.2 =
          some label := by
        simp only [certifiedPlankThresholdedPairLevel, if_pos hcut]
        exact congrArg some hijLabel
      have hweight := certifiedPlankDyadicWeight_mul_aspectRatio_le_two
        cert ij.1 ij.2 label hlevel
      have hscale :
          certifiedPlankAngleScale C a b
              certifiedPlankDyadicInverseSineWeight (some label) ≤
            4 * ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹) := by
        simp only [certifiedPlankAngleScale]
        calc
          certifiedPlankDyadicInverseSineWeight label * 2 *
                ((a / b : NNReal) : ENNReal) *
                ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹) =
              (certifiedPlankDyadicInverseSineWeight label *
                ((a / b : NNReal) : ENNReal)) * 2 *
                ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹) := by ring
          _ ≤ 2 * 2 * ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹) := by
            gcongr
          _ = 4 * ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹) := by
            norm_num
      exact hscale.trans (le_max_right 1
        (4 * ((((C⁻¹ : NNReal) : ENNReal) ^ 3)⁻¹)))

theorem certifiedPlankThresholded_inverseSine_bounds
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (ij : iota × iota) (hij : ij ∈ certifiedPlankThresholdedPairs cert) :
    1 ≤ (certifiedPlankPairSine cert ij.1 ij.2)⁻¹ ∧
      (certifiedPlankPairSine cert ij.1 ij.2)⁻¹ ≤
        (((b / a : NNReal) : Real)) := by
  have hcut : (((a / b : NNReal) : Real) ≤
      certifiedPlankPairSine cert ij.1 ij.2) := by
    exact (mem_certifiedPlankThresholdedPairs cert ij).1 hij
  have hq : 0 < (((a / b : NNReal) : Real)) :=
    certifiedPlankAspectRatio_pos cert ij.1
  have hs : 0 < certifiedPlankPairSine cert ij.1 ij.2 := hq.trans_le hcut
  have hsOne : certifiedPlankPairSine cert ij.1 ij.2 ≤ 1 := by
    exact Real.sin_le_one _
  constructor
  · exact (one_le_inv₀ hs).2 hsOne
  · have hinv := (inv_le_inv₀ hs hq).2 hcut
    have ha : (0 : Real) < (a : Real) := by exact_mod_cast (cert ij.1).a_pos
    have hb : (0 : Real) < (b : Real) := by
      exact_mod_cast (cert ij.1).a_pos.trans_le (cert ij.1).a_le_b
    have hratioInv : (((a / b : NNReal) : Real))⁻¹ =
        (((b / a : NNReal) : Real)) := by
      simp only [NNReal.coe_div]
      field_simp
    simpa [hratioInv] using hinv

/-- The number of genuine angular labels is explicitly logarithmic in `b/a`. -/
theorem card_certifiedPlankThresholdedLevels_le
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) :
    (certifiedPlankThresholdedLevels cert).card ≤
      (dyadicCeilBucket (((b / a : NNReal) : Real)) + 1 -
        dyadicCeilBucket 1).toNat := by
  apply card_occupied_dyadicCeilBuckets_le
    (certifiedPlankThresholdedPairs cert)
    (fun ij ↦ (certifiedPlankPairSine cert ij.1 ij.2)⁻¹)
    (by norm_num)
  intro ij hij
  exact certifiedPlankThresholded_inverseSine_bounds cert ij hij


/-! ## Complete common-container scale producer -/

/-- Every thresholded row hull is controlled by any actual common convex
container for the certified family, including the empty-row case. -/
theorem volume_certifiedPlankThresholdedHullContainer_le_globalContainer
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (K : ConvexBody Space)
    (hcontains : ∀ j, (F j : Set Space) ⊆ (K : Set Space))
    (i : iota) (k : Option Int) :
    volume (certifiedPlankThresholdedHullContainer cert i k : Set Space) ≤
      volume (K : Set Space) := by
  classical
  by_cases hrow : (certifiedPlankThresholdedRowIndices cert i k).Nonempty
  · exact measure_mono (hullContainer_subset F hrow (fun j _hj ↦ hcontains j))
  · have hempty : certifiedPlankThresholdedRowIndices cert i k = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp hrow
    simp [certifiedPlankThresholdedHullContainer, hempty]

/-- Literal thresholded counterpart of V4's double supremum. -/
noncomputable def canonicalCertifiedPlankThresholdedAngleContainerScaleFactor
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (Y : Shading F) : ENNReal :=
  ⨆ i : iota,
    ⨆ k : {k // k ∈ plankAngleLevels
        (certifiedPlankThresholdedLevels cert)},
      certifiedPlankAngleScale C a b
          certifiedPlankDyadicInverseSineWeight k.1 *
        volume (certifiedPlankThresholdedHullContainer cert i k.1 : Set Space) /
          volume (Y.carrier i)

/-- The complete thresholded scale is an explicit angle constant times the
actual common-container/carrier-floor volume ratio. -/
theorem canonicalCertifiedPlankThresholdedAngleContainerScaleFactor_le
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (Y : Shading F) (K : ConvexBody Space)
    (hcontains : ∀ j, (F j : Set Space) ⊆ (K : Set Space))
    (lower : ENNReal) (hlower0 : lower ≠ 0) (hlowerTop : lower ≠ ∞)
    (hfloor : ∀ i, lower ≤ volume (Y.carrier i)) :
    canonicalCertifiedPlankThresholdedAngleContainerScaleFactor cert Y ≤
      certifiedPlankThresholdedAngleScaleCap C *
        (volume (K : Set Space) / lower) := by
  unfold canonicalCertifiedPlankThresholdedAngleContainerScaleFactor
  apply iSup_le
  intro i
  apply iSup_le
  intro k
  have hcarrier0 : volume (Y.carrier i) ≠ 0 :=
    ne_of_gt (lt_of_lt_of_le (bot_lt_iff_ne_bot.mpr hlower0) (hfloor i))
  have hcarrierTop : volume (Y.carrier i) ≠ ∞ :=
    ((measure_mono (Y.carrier_subset i)).trans_lt
      (F i).isCompact.measure_lt_top).ne
  apply (ENNReal.div_le_iff hcarrier0 hcarrierTop).2
  calc
    certifiedPlankAngleScale C a b certifiedPlankDyadicInverseSineWeight k.1 *
          volume (certifiedPlankThresholdedHullContainer cert i k.1 : Set Space) ≤
        certifiedPlankThresholdedAngleScaleCap C * volume (K : Set Space) := by
      exact mul_le_mul
        (certifiedPlankThresholdedAngleScale_le_cap cert k.1 k.2)
        (volume_certifiedPlankThresholdedHullContainer_le_globalContainer
          cert K hcontains i k.1) bot_le bot_le
    _ = certifiedPlankThresholdedAngleScaleCap C *
        ((volume (K : Set Space) / lower) * lower) := by
      rw [ENNReal.div_mul_cancel hlower0 hlowerTop]
    _ ≤ certifiedPlankThresholdedAngleScaleCap C *
        ((volume (K : Set Space) / lower) * volume (Y.carrier i)) := by
      exact mul_le_mul' le_rfl (mul_le_mul' le_rfl (hfloor i))
    _ = (certifiedPlankThresholdedAngleScaleCap C *
        (volume (K : Set Space) / lower)) * volume (Y.carrier i) := by
      ring

/-- Rowwise form consumed directly by the certified Córdoba theorem. -/
theorem certifiedPlankThresholdedAngleContainer_scale_le
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (Y : Shading F) (K : ConvexBody Space)
    (hcontains : ∀ j, (F j : Set Space) ⊆ (K : Set Space))
    (lower : ENNReal) (hlower0 : lower ≠ 0) (hlowerTop : lower ≠ ∞)
    (hfloor : ∀ i, lower ≤ volume (Y.carrier i))
    (i : iota) (k : Option Int)
    (hk : k ∈ plankAngleLevels (certifiedPlankThresholdedLevels cert)) :
    certifiedPlankAngleScale C a b certifiedPlankDyadicInverseSineWeight k *
        volume (certifiedPlankThresholdedHullContainer cert i k : Set Space) ≤
      (certifiedPlankThresholdedAngleScaleCap C *
        (volume (K : Set Space) / lower)) * volume (Y.carrier i) := by
  calc
    certifiedPlankAngleScale C a b certifiedPlankDyadicInverseSineWeight k *
          volume (certifiedPlankThresholdedHullContainer cert i k : Set Space) ≤
        certifiedPlankThresholdedAngleScaleCap C * volume (K : Set Space) := by
      exact mul_le_mul
        (certifiedPlankThresholdedAngleScale_le_cap cert k hk)
        (volume_certifiedPlankThresholdedHullContainer_le_globalContainer
          cert K hcontains i k) bot_le bot_le
    _ = certifiedPlankThresholdedAngleScaleCap C *
        ((volume (K : Set Space) / lower) * lower) := by
      rw [ENNReal.div_mul_cancel hlower0 hlowerTop]
    _ ≤ certifiedPlankThresholdedAngleScaleCap C *
        ((volume (K : Set Space) / lower) * volume (Y.carrier i)) := by
      exact mul_le_mul' le_rfl (mul_le_mul' le_rfl (hfloor i))
    _ = (certifiedPlankThresholdedAngleScaleCap C *
        (volume (K : Set Space) / lower)) * volume (Y.carrier i) := by ring

/-- Callback-free Córdoba endpoint for the thresholded assignment. -/
theorem certifiedPlankThresholded_averageMultiplicity_le_globalContainer
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (Y : Shading F) (K : ConvexBody Space)
    (hcontains : ∀ j, (F j : Set Space) ⊆ (K : Set Space))
    (lower : ENNReal) (hlower0 : lower ≠ 0) (hlowerTop : lower ≠ ∞)
    (hfloor : ∀ i, lower ≤ volume (Y.carrier i))
    (D : ENNReal) (hKT : IsKatzTao D F) :
    Y.averageMultiplicity ≤
      certifiedPlankDyadicFactor (certifiedPlankThresholdedLevels cert) D
        (certifiedPlankThresholdedAngleScaleCap C *
          (volume (K : Set Space) / lower)) := by
  apply certifiedPlankDyadic_averageMultiplicity_le cert
    (certifiedPlankThresholdedLevels cert)
    (certifiedPlankThresholdedPairLevel cert)
    certifiedPlankDyadicInverseSineWeight
    (certifiedPlankThresholdedHullContainer cert) D
    (certifiedPlankThresholdedAngleScaleCap C *
      (volume (K : Set Space) / lower))
  · exact certifiedPlankThresholdedPairLevel_mem cert
  · exact certifiedPlankThresholdedPairSine_pos_of_level_eq_some cert
  · exact certifiedPlankThresholded_inverseSine_le cert
  · exact certifiedPlankThresholded_body_subset_hullContainer cert
  · exact hKT
  · exact certifiedPlankThresholdedAngleContainer_scale_le
      cert Y K hcontains lower hlower0 hlowerTop hfloor

/-- Add the exceptional class to the explicit genuine-label bound. -/
def certifiedPlankThresholdedAngleBucketLoss (a b : NNReal) : Nat :=
  (dyadicCeilBucket (((b / a : NNReal) : Real)) + 1 -
    dyadicCeilBucket 1).toNat + 1

theorem card_plankAngleLevels_certifiedPlankThresholdedLevels_le
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i)) :
    (plankAngleLevels (certifiedPlankThresholdedLevels cert)).card ≤
      certifiedPlankThresholdedAngleBucketLoss a b := by
  classical
  have hcard := card_certifiedPlankThresholdedLevels_le cert
  unfold certifiedPlankThresholdedAngleBucketLoss
  calc
    (plankAngleLevels (certifiedPlankThresholdedLevels cert)).card ≤
        ({none} : Finset (Option Int)).card +
          ((certifiedPlankThresholdedLevels cert).image some).card := by
      unfold plankAngleLevels
      exact Finset.card_union_le _ _
    _ = 1 + (certifiedPlankThresholdedLevels cert).card := by
      rw [Finset.card_image_of_injective _
        (fun _ _ h ↦ Option.some.inj h)]
      simp
    _ = (certifiedPlankThresholdedLevels cert).card + 1 := by omega
    _ ≤ (dyadicCeilBucket (((b / a : NNReal) : Real)) + 1 -
        dyadicCeilBucket 1).toNat + 1 := Nat.add_le_add_right hcard 1

theorem certifiedPlankDyadicFactor_thresholded_le_explicit
    (cert : ∀ i, PlankDimensionsCertificate C a b (F i))
    (D A : ENNReal) :
    certifiedPlankDyadicFactor (certifiedPlankThresholdedLevels cert) D A ≤
      (certifiedPlankThresholdedAngleBucketLoss a b : ENNReal) * D * A := by
  unfold certifiedPlankDyadicFactor
  have hcard :
      ((plankAngleLevels (certifiedPlankThresholdedLevels cert)).card : ENNReal) ≤
        (certifiedPlankThresholdedAngleBucketLoss a b : ENNReal) := by
    exact_mod_cast
      card_plankAngleLevels_certifiedPlankThresholdedLevels_le cert
  gcongr

