import Family8Grounding.Family8FrozenNeighborhoodAssemblyV1
import Family8Grounding.Family8CellularEqualVolumeEdgeMassV1
import Family8Grounding.Family8CellularJointFactoringFiniteCoreV1
import Mathlib.Tactic

/-!
# Child shadings generated by one parent--cell edge set

This is the measurable-space adapter between the finite cellular graph and a
fine shading.  For every child label, it keeps exactly the cells selected at
that child's parent.  Thus the child shading and the parent cell regions are
defined by one edge set.  Pairwise disjointness of the cells turns the
resulting child shading mass into the sum of the corresponding parent--cell
edge weights.

The module assumes a finite disjoint equal-volume cell family.  It does not
construct a half-open grid or assert a quantitative retained-mass bound.
-/

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false

open Set MeasureTheory
open scoped BigOperators ENNReal NNReal

namespace Family8CellularJointShadingFromEdgesV1

open LeanEval.Analysis.WangZahlKakeya
open Submission.Kakeya.ConvexGeometry
open Family8CellularEqualVolumeEdgeMassV1
open Family8CellularEqualVolumeEdgeMassV1.EqualVolumeCells
open Family8CellularJointFactoringFiniteCoreV1

noncomputable section

variable {child parent cell : Type*}
  [Fintype child] [DecidableEq child]
  [Fintype parent] [DecidableEq parent]
  [Fintype cell] [DecidableEq cell]
  {F : ConvexFamily child}

/-- Weight of one labelled parent--cell edge: all child shading mass of that
parent inside that cell. -/
def parentCellWeight (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (e : parent × cell) : ENNReal :=
  ∑ i : child, if parentOf i = e.1 then
    volume (Y.carrier i ∩ C.carrier e.2) else 0

/-- The fine shading obtained by retaining, for each child, precisely the
cell regions joined to its parent by `E`. -/
def selectedChildShading (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell)) : Shading F where
  carrier i := Y.carrier i ∩ C.parentRegion E (parentOf i)
  measurable_carrier i := Y.measurable_carrier i |>.inter
    (C.measurableSet_parentRegion E (parentOf i))
  carrier_subset i := inter_subset_left.trans (Y.carrier_subset i)

@[simp] theorem selectedChildShading_carrier
    (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell)) (i : child) :
    (selectedChildShading Y C parentOf E).carrier i =
      Y.carrier i ∩ C.parentRegion E (parentOf i) := rfl

/-- Spatial P2 is definitional: a retained child point lies in the parent
region generated by the same edge set. -/
theorem selectedChild_mem_parentRegion
    (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell))
    (i : child) (x : Space)
    (hx : x ∈ (selectedChildShading Y C parentOf E).carrier i) :
    x ∈ C.parentRegion E (parentOf i) :=
  hx.2

theorem volume_inter_parentRegion_eq_sum
    (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell)) (i : child) :
    volume (Y.carrier i ∩ C.parentRegion E (parentOf i)) =
      ∑ q ∈ incidentCells E (parentOf i),
        volume (Y.carrier i ∩ C.carrier q) := by
  let selected := incidentCells E (parentOf i)
  have hdisjoint : Pairwise (fun q q' : {q // q ∈ selected} =>
      Disjoint (Y.carrier i ∩ C.carrier q.1)
        (Y.carrier i ∩ C.carrier q'.1)) := by
    intro q q' hqq'
    exact (C.pairwise_disjoint (fun hval => hqq' (Subtype.ext hval))).mono
      inter_subset_right inter_subset_right
  have hmeas : forall q : {q // q ∈ selected},
      MeasurableSet (Y.carrier i ∩ C.carrier q.1) := fun q =>
    (Y.measurable_carrier i).inter (C.measurable_carrier q.1)
  rw [parentRegion, inter_iUnion]
  rw [measure_iUnion hdisjoint hmeas, tsum_fintype]
  exact (Finset.sum_subtype (M := ENNReal) selected
    (fun _q => Iff.rfl)
    (fun q => volume (Y.carrier i ∩ C.carrier q))).symm

/-- Pure finite reindexing: summing selected cells child-first is the same as
summing the corresponding labelled parent--cell edges first. -/
theorem sum_incidentCells_eq_sum_parentCellWeight
    (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell)) :
    (∑ i : child, ∑ q ∈ incidentCells E (parentOf i),
      volume (Y.carrier i ∩ C.carrier q)) =
      ∑ e ∈ E, parentCellWeight Y C parentOf e := by
  classical
  have hE : E = (Finset.univ : Finset (parent × cell)).filter
      (fun e => e ∈ E) := by
    ext e
    simp
  rw [hE]
  simp only [parentCellWeight, incidentCells, Finset.sum_filter]
  rw [Finset.sum_comm]
  conv_rhs =>
    rw [Fintype.sum_prod_type_right]
  apply Finset.sum_congr rfl
  intro q hq
  have hdistrib : ∀ p : parent,
      (if (p, q) ∈ E then
          ∑ i : child, if parentOf i = p then
            volume (Y.carrier i ∩ C.carrier q) else 0
        else 0) =
        ∑ i : child, if (p, q) ∈ E then
          (if parentOf i = p then
            volume (Y.carrier i ∩ C.carrier q) else 0) else 0 := by
    intro p
    by_cases hp : (p, q) ∈ E <;> simp [hp]
  simp_rw [hdistrib]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.sum_eq_single (parentOf i)]
  · simp
  · intro p hp hne
    simp [Ne.symm hne]
  · simp

/-- Exact cellular mass identity for an arbitrary selected edge set. -/
theorem selectedChildShading_shadingMass_eq_edgeWeight
    (Y : Shading F) (C : EqualVolumeCells cell)
    (parentOf : child -> parent) (E : Finset (parent × cell)) :
    (selectedChildShading Y C parentOf E).shadingMass =
      edgeWeight E (parentCellWeight Y C parentOf) := by
  unfold Shading.shadingMass edgeWeight
  simp_rw [selectedChildShading_carrier,
    volume_inter_parentRegion_eq_sum Y C parentOf E]
  exact sum_incidentCells_eq_sum_parentCellWeight Y C parentOf E

#print axioms selectedChildShading
#print axioms selectedChild_mem_parentRegion
#print axioms volume_inter_parentRegion_eq_sum
#print axioms sum_incidentCells_eq_sum_parentCellWeight
#print axioms selectedChildShading_shadingMass_eq_edgeWeight

end
end Family8CellularJointShadingFromEdgesV1
