import ChallengeDeps
import Mathlib.Tactic

/-!
# Equal-volume cellular edge mass

This file isolates the exact finite bookkeeping used by cellular joint
factoring.  A labelled parent--cell incidence contributes one copy of the
common cell volume.  Consequently, retaining a fraction of labelled parent
mass is exactly the same as retaining that fraction of the edge count.

No geometric factoring or existence statement is asserted here.  The cell
partition and the selected edge sets remain explicit data.
-/

set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false

open Set MeasureTheory
open scoped BigOperators ENNReal NNReal

namespace Family8CellularEqualVolumeEdgeMassV1

open LeanEval.Analysis.WangZahlKakeya

noncomputable section

/-- A finite measurable collection of pairwise-disjoint cells with one
strictly positive finite volume.  Coverage is deliberately left to the
later geometric adapter, since the finite edge bookkeeping only uses the
cells that meet the relevant shading. -/
structure EqualVolumeCells (cell : Type*) [Fintype cell] where
  carrier : cell -> Set Space
  measurable_carrier : forall q, MeasurableSet (carrier q)
  pairwise_disjoint : Pairwise (fun q q' => Disjoint (carrier q) (carrier q'))
  cellVolume : NNReal
  cellVolume_pos : 0 < cellVolume
  volume_carrier : forall q, volume (carrier q) = (cellVolume : ENNReal)

variable {parent cell : Type*}
  [Fintype parent] [Fintype cell]
  [DecidableEq parent] [DecidableEq cell]

namespace EqualVolumeCells

/-- The labelled mass of a finite parent--cell edge set.  Repeated spatial
cells attached to different parent labels are intentionally counted once per
label. -/
def labelledEdgeMass (C : EqualVolumeCells cell)
    (E : Finset (parent × cell)) : NNReal :=
  ∑ _e ∈ E, C.cellVolume

@[simp] theorem labelledEdgeMass_eq_card_mul
    (C : EqualVolumeCells cell) (E : Finset (parent × cell)) :
    C.labelledEdgeMass E = (E.card : NNReal) * C.cellVolume := by
  simp [labelledEdgeMass]

/-- Exact cancellation of the common positive cell volume. -/
theorem labelledEdgeMass_le_iff_card_le
    (C : EqualVolumeCells cell) (E E' : Finset (parent × cell)) :
    C.labelledEdgeMass E <= C.labelledEdgeMass E' <-> E.card <= E'.card := by
  rw [C.labelledEdgeMass_eq_card_mul, C.labelledEdgeMass_eq_card_mul]
  constructor
  · intro h
    have hcast : (E.card : NNReal) <= (E'.card : NNReal) :=
      le_of_mul_le_mul_right h C.cellVolume_pos
    exact_mod_cast hcast
  · intro h
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast h) bot_le

/-- A fractional labelled-mass lower bound becomes the identical fractional
edge-cardinality lower bound.  This is the finite content of the equal-cell
step in whole-incidence lifting. -/
theorem scaled_card_le_of_scaled_labelledEdgeMass_le
    (C : EqualVolumeCells cell) (E E' : Finset (parent × cell))
    (c : NNReal)
    (h : c * C.labelledEdgeMass E <= C.labelledEdgeMass E') :
    c * (E.card : NNReal) <= (E'.card : NNReal) := by
  rw [C.labelledEdgeMass_eq_card_mul,
    C.labelledEdgeMass_eq_card_mul] at h
  exact le_of_mul_le_mul_right (by
    simpa only [mul_assoc] using h) C.cellVolume_pos

/-- Cells incident to one labelled parent. -/
def incidentCells (E : Finset (parent × cell)) (B : parent) : Finset cell :=
  Finset.univ.filter fun q => (B, q) ∈ E

/-- The cellular parent shading generated by the selected edges. -/
def parentRegion (C : EqualVolumeCells cell)
    (E : Finset (parent × cell)) (B : parent) : Set Space :=
  ⋃ q : {q // q ∈ incidentCells E B}, C.carrier q.1

theorem measurableSet_parentRegion
    (C : EqualVolumeCells cell) (E : Finset (parent × cell)) (B : parent) :
    MeasurableSet (C.parentRegion E B) := by
  exact MeasurableSet.iUnion fun q => C.measurable_carrier q.1

theorem parentRegion_volume
    (C : EqualVolumeCells cell) (E : Finset (parent × cell)) (B : parent) :
    volume (C.parentRegion E B) =
      ((incidentCells E B).card : ENNReal) * (C.cellVolume : ENNReal) := by
  have hdisjoint : Pairwise (fun
      q q' : {q // q ∈ incidentCells E B} =>
        Disjoint (C.carrier q.1) (C.carrier q'.1)) := by
    intro q q' hqq'
    apply C.pairwise_disjoint
    intro hval
    apply hqq'
    exact Subtype.ext hval
  rw [parentRegion, measure_iUnion hdisjoint
    (fun q => C.measurable_carrier q.1), tsum_fintype]
  simp [C.volume_carrier, nsmul_eq_mul]

#print axioms EqualVolumeCells.labelledEdgeMass_le_iff_card_le
#print axioms EqualVolumeCells.scaled_card_le_of_scaled_labelledEdgeMass_le
#print axioms EqualVolumeCells.parentRegion_volume

end EqualVolumeCells
end
end Family8CellularEqualVolumeEdgeMassV1
