open Family8SelectedOccurrenceDensityFrostmanV1
open Family8SelectedOccurrenceNormalizedOuterDatumV1
open Family8SelectedParentCertifiedPlankCordobaConnectorV3
open Family8SelectedParentCertifiedPlankCordobaThresholdedAngleV6
open Family8SelectedParentJohnPlankSideWidthBridgeV7

noncomputable section

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 4000000

local instance (p : Prop) : Decidable p := Classical.propDecidable p

universe u

variable {delta : NNReal} {iota : Type u}
  [Fintype iota] [DecidableEq iota]
  {fine : UniformTubeFamily delta iota}
  {active : Finset iota}

variable
  (P : GreedyDensityPartition fine.bodyFamily
    (hullCandidates active) (hullContainer fine.bodyFamily) active)

/-- The callback-free certified-plank argument gives the literal Lemma 6.9
power bound on the normalized selected outer family.  The memberwise carrier
floor is kept explicit: total shading density alone does not imply it.

The scalar hypothesis is precisely the last estimate after the number of
thresholded angle buckets and the common-container row scale have been made
explicit. -/
theorem selectedOccurrenceNormalizedOuter_averageMultiplicity_le_lemma69Power
    (Y : Shading fine.bodyFamily)
    (hdelta : 0 < delta)
    (labelOuter : Fin 3 -> Int)
    (Rside : Finset (Fin (blocks fine.bodyFamily P).length))
    (hlabel : forall k, k ∈ Rside ->
      sideShapeLabel (winnerLongSide P hdelta k) = labelOuter)
    (K : ConvexBody Space)
    (hcontains : forall q,
      (selectedOccurrenceNormalizedOuterFamily P labelOuter Rside q :
          Set Space) ⊆ (K : Set Space))
    (carrierFloor : ENNReal)
    (hcarrierFloor0 : carrierFloor ≠ 0)
    (hcarrierFloorTop : carrierFloor ≠ ∞)
    (hcarrierFloor : forall q, carrierFloor ≤
      volume ((selectedOccurrenceNormalizedOuterShading
        P Y labelOuter Rside).carrier q))
    (KT : ENNReal)
    (hKT : IsKatzTao KT
      (selectedOccurrenceNormalizedOuterFamily P labelOuter Rside))
    (eta : Real)
    (hlemma69Scalar :
      (certifiedPlankThresholdedAngleBucketLoss
          (bucketShortA labelOuter) (bucketShortB labelOuter) : ENNReal) *
          KT *
          (certifiedPlankThresholdedAngleScaleCap 576 *
            (volume (K : Set Space) / carrierFloor)) ≤
        (bucketShortA labelOuter : ENNReal) ^ (-8 * eta)) :
    (selectedOccurrenceNormalizedOuterShading
        P Y labelOuter Rside).averageMultiplicity ≤
      (bucketShortA labelOuter : ENNReal) ^ (-8 * eta) := by
  let Youter := selectedOccurrenceNormalizedOuterShading
    P Y labelOuter Rside
  have hplank : forall q,
      IsPlank 576 (bucketShortA labelOuter) (bucketShortB labelOuter)
        (selectedOccurrenceNormalizedOuterFamily P labelOuter Rside q) :=
    selectedOccurrenceNormalizedOuterFamily_all_isPlank
      P hdelta labelOuter Rside hlabel
  let cert := chosenPlankCertificate hplank
  let rowScale : ENNReal :=
    certifiedPlankThresholdedAngleScaleCap 576 *
      (volume (K : Set Space) / carrierFloor)
  have hcordoba :
      Youter.averageMultiplicity ≤
        certifiedPlankDyadicFactor
          (certifiedPlankThresholdedLevels cert) KT rowScale := by
    exact certifiedPlankThresholded_averageMultiplicity_le_globalContainer
      cert Youter K hcontains carrierFloor hcarrierFloor0
        hcarrierFloorTop hcarrierFloor KT hKT
  have hexplicit :
      certifiedPlankDyadicFactor
          (certifiedPlankThresholdedLevels cert) KT rowScale ≤
        (certifiedPlankThresholdedAngleBucketLoss
            (bucketShortA labelOuter) (bucketShortB labelOuter) : ENNReal) *
          KT * rowScale :=
    certifiedPlankDyadicFactor_thresholded_le_explicit cert KT rowScale
  calc
    (selectedOccurrenceNormalizedOuterShading
        P Y labelOuter Rside).averageMultiplicity =
        Youter.averageMultiplicity := rfl
    _ ≤ certifiedPlankDyadicFactor
          (certifiedPlankThresholdedLevels cert) KT rowScale := hcordoba
    _ ≤ (certifiedPlankThresholdedAngleBucketLoss
            (bucketShortA labelOuter) (bucketShortB labelOuter) : ENNReal) *
          KT * rowScale := hexplicit
    _ ≤ (bucketShortA labelOuter : ENNReal) ^ (-8 * eta) := by
      simpa only [rowScale] using hlemma69Scalar

/-- Source-shaped large-`b` completion of Equation (32).  Equation (44) is
the exact-assembly product on one surviving source fibre.  Lemma 6.9 bounds
the induced outer object after its exact selected-occurrence reindexing and
common affine normalization.  Equation (46) is requested only in the form
used by that product.

`hlargeBOuterPayment` is the sole comparison between the `a^(-8 eta)` slab
bound and the paper's outer Proposition 6.6(A) factor. -/
theorem exactAssembly_refinement_eq32_of_selectedOccurrence_largeBLemma69
    (Y : Shading fine.bodyFamily)
    (Rside : Finset (Fin (blocks fine.bodyFamily P).length))
    {assemblyLoss : Nat}
    (A : FactoringMultiplicityAssembly.ExactAssembly
      (selectedOccurrenceFactorization P Rside) Y assemblyLoss)
    (hsource :
      (IndexedShadingRefinement.restrictTo Y
        (selectedOccurrenceFactorization P Rside).index.fine).shading.shadingMass
          ≠ 0)
    (hdelta : 0 < delta)
    (labelOuter : Fin 3 -> Int)
    (hlabel : forall k, k ∈ Rside ->
      sideShapeLabel (winnerLongSide P hdelta k) = labelOuter)
    (K : ConvexBody Space)
    (hcontains : forall q,
      (selectedOccurrenceNormalizedOuterFamily P labelOuter Rside q :
          Set Space) ⊆ (K : Set Space))
    (carrierFloor : ENNReal)
    (hcarrierFloor0 : carrierFloor ≠ 0)
    (hcarrierFloorTop : carrierFloor ≠ ∞)
    (hcarrierFloor : forall q, carrierFloor ≤
      volume ((selectedOccurrenceNormalizedOuterShading
        P A.refinement.shading labelOuter Rside).carrier q))
    (KT : ENNReal)
    (hKT : IsKatzTao KT
      (selectedOccurrenceNormalizedOuterFamily P labelOuter Rside))
    (eta : Real)
    (hlemma69Scalar :
      (certifiedPlankThresholdedAngleBucketLoss
          (bucketShortA labelOuter) (bucketShortB labelOuter) : ENNReal) *
          KT *
          (certifiedPlankThresholdedAngleScaleCap 576 *
            (volume (K : Set Space) / carrierFloor)) ≤
        (bucketShortA labelOuter : ENNReal) ^ (-8 * eta))
    {tubesPerPlank totalCount : Nat}
    {CF outerLoss : ENNReal} {epsilon beta : Real}
    (hbeta : 0 ≤ beta) (hbetaOne : beta ≤ 1)
    (hcount : totalCount =
      Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside} *
        tubesPerPlank)
    (hinner : forall k,
      k ∈ (selectedOccurrenceFactorization P Rside).index.coarse ->
        (sourceFineLevelShading A k).averageMultiplicity ≤
          proposition66AInnerFactor delta
            (bucketShortA labelOuter) (bucketShortB labelOuter)
            tubesPerPlank epsilon beta)
    (hlargeBOuterPayment :
      (bucketShortA labelOuter : ENNReal) ^ (-8 * eta) ≤
        outerLoss * proposition66AOuterFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          (Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside})
          CF epsilon beta) :
    A.refinement.shading.averageMultiplicity ≤
      outerLoss * proposition66AFrostmanFactor delta
        (bucketShortA labelOuter) (bucketShortB labelOuter)
        totalCount CF epsilon beta := by
  let Q := selectedOccurrenceFactorization P Rside
  let Youter := selectedOccurrenceNormalizedOuterShading
    P A.refinement.shading labelOuter Rside
  have houterLemma69 :
      Youter.averageMultiplicity ≤
        (bucketShortA labelOuter : ENNReal) ^ (-8 * eta) := by
    simpa only [Youter] using
      selectedOccurrenceNormalizedOuter_averageMultiplicity_le_lemma69Power
        P A.refinement.shading hdelta labelOuter Rside hlabel K hcontains
          carrierFloor hcarrierFloor0 hcarrierFloorTop hcarrierFloor
          KT hKT eta hlemma69Scalar
  have houterTransport :
      (Q.inducedShading A.refinement.shading).averageMultiplicity =
        Youter.averageMultiplicity := by
    calc
      (Q.inducedShading A.refinement.shading).averageMultiplicity =
          (selectedOccurrenceOuterShading
            P A.refinement.shading Rside).averageMultiplicity := by
        simpa only [Q] using
          selectedOccurrenceFactorization_inducedShading_averageMultiplicity_eq_outer
            P A.refinement.shading Rside
      _ = Youter.averageMultiplicity := by
        simpa only [Youter] using
          (selectedOccurrenceNormalizedOuterShading_averageMultiplicity
            P A.refinement.shading labelOuter Rside).symm
  have houter :
      (Q.inducedShading A.refinement.shading).averageMultiplicity ≤
        outerLoss * proposition66AOuterFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          (Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside})
          CF epsilon beta := by
    rw [houterTransport]
    exact houterLemma69.trans hlargeBOuterPayment
  obtain ⟨k, hk, _hvolume, hproduct⟩ :=
    refinement_averageMultiplicity_le_product_actualAverages A hsource
  have hfactor :
      proposition66AOuterFactor delta
            (bucketShortA labelOuter) (bucketShortB labelOuter)
            (Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside})
            CF epsilon beta *
          proposition66AInnerFactor delta
            (bucketShortA labelOuter) (bucketShortB labelOuter)
            tubesPerPlank epsilon beta =
        proposition66AFrostmanFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          totalCount CF epsilon beta := by
    exact proposition66AOuterFactor_mul_innerFactor_eq_frostmanFactor
      hdelta (bucketShortA_pos labelOuter)
        (lt_of_lt_of_le (bucketShortA_pos labelOuter)
          (bucketShortA_le_bucketShortB labelOuter))
        hbeta hbetaOne hcount
  calc
    A.refinement.shading.averageMultiplicity ≤
        (Q.inducedShading A.refinement.shading).averageMultiplicity *
          (sourceFineLevelShading A k).averageMultiplicity := by
      simpa only [Q] using hproduct
    _ ≤ (outerLoss * proposition66AOuterFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          (Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside})
          CF epsilon beta) *
        proposition66AInnerFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          tubesPerPlank epsilon beta := by
      exact mul_le_mul' houter (hinner k hk)
    _ = outerLoss *
        (proposition66AOuterFactor delta
            (bucketShortA labelOuter) (bucketShortB labelOuter)
            (Fintype.card {q // q ∈ selectedOccurrenceIndices P Rside})
            CF epsilon beta *
          proposition66AInnerFactor delta
            (bucketShortA labelOuter) (bucketShortB labelOuter)
            tubesPerPlank epsilon beta) := by
      ac_rfl
    _ = outerLoss * proposition66AFrostmanFactor delta
          (bucketShortA labelOuter) (bucketShortB labelOuter)
          totalCount CF epsilon beta := by rw [hfactor]

#print axioms
  selectedOccurrenceNormalizedOuter_averageMultiplicity_le_lemma69Power
#print axioms
  exactAssembly_refinement_eq32_of_selectedOccurrence_largeBLemma69

end
end Family8SelectedOccurrenceLargeBLemma69Eq32ComposerV1
