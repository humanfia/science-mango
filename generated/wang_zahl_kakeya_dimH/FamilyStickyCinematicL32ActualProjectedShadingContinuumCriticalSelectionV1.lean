noncomputable section

/-!
# Actual continuum critical selection from a projected shading

This is the callback-free analytic splice.  The source set and active family
are definitionally generated by the projected shading, their measurability is
automatic, and the selected Tube family is nonempty by the actual
multiplicity/cap argument.  The output retains the sharp product count of the
two dyadic label ranges and the literal half-open scale bins.
-/

/-- The exact certificate returned by continuum double-dyadic selection. -/
def HasContinuumCriticalDoubleDyadicSelection
    {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (E : Set X)
    (normScale tangencyScale : X → Real)
    (delta normCeiling tangencyCeiling : Real) : Prop :=
  ∃ normLabel ∈ Finset.Icc (dyadicCeilBucket delta)
      (dyadicCeilBucket normCeiling),
    ∃ tangencyLabel ∈ Finset.Icc (dyadicCeilBucket delta)
        (dyadicCeilBucket tangencyCeiling),
      μ E / (continuumCriticalDoubleDyadicBinFactor delta normCeiling
          tangencyCeiling : ENNReal) ≤
        μ (continuumCriticalDoubleDyadicCell E normScale tangencyScale
          normLabel tangencyLabel) ∧
      0 < dyadicCeilUpper normLabel ∧
      0 < dyadicCeilUpper tangencyLabel ∧
      ∀ x ∈ continuumCriticalDoubleDyadicCell E normScale tangencyScale
          normLabel tangencyLabel,
        dyadicCeilUpper normLabel / 2 < normScale x ∧
        normScale x ≤ dyadicCeilUpper normLabel ∧
        dyadicCeilUpper tangencyLabel / 2 < tangencyScale x ∧
        tangencyScale x ≤ dyadicCeilUpper tangencyLabel

/-- The actual canonical critical scale on one projected multiplicity band. -/
noncomputable def actualProjectedCriticalScaleOnBand
    {delta : NNReal} {iota : Type*} [DecidableEq iota]
    (fine : UniformTubeFamily delta iota)
    (Z : FiniteProjectedShading (Real × Real) iota)
    (lower upper : Nat)
    (distanceOfActive :
      Finset iota → Tube delta → Tube delta → Real)
    (ceiling exponent : Real)
    (hfamily : ∀ x ∈ Z.multiplicityBand lower upper,
      (actualProjectedCriticalFamily fine (Z.activeAtPoint x)).Nonempty) :
    Real × Real → Real :=
  finiteIncidenceActualCriticalScaleOnSlice
    Z.base Z.ambient (fun i x => x ∈ Z.carrier i)
    (multiplicityBandAccept lower upper)
    (actualProjectedCriticalFamily fine) distanceOfActive
    (delta : Real) ceiling exponent hfamily

/-- Actual projected-shading continuum selection.  In particular, no
`MeasurableSet E`, measurable scale, `hEeq`, `hactiveEq`, or pointwise family
nonempty premise appears in this signature. -/
theorem has_actualProjectedShading_continuumCriticalDoubleDyadicSelection
    {delta : NNReal} {iota : Type*} [DecidableEq iota]
    (μ : Measure (Real × Real))
    (fine : UniformTubeFamily delta iota)
    (Z : FiniteProjectedShading (Real × Real) iota)
    {lower upper multiplicity : Nat}
    (f f1 f2 : Real → Real) (A B : Real) (hAB : A ≤ B)
    (hfDeriv : ∀ z, z ∈ Icc A B → HasDerivAt f (f1 z) z)
    (hf1Deriv : ∀ z, z ∈ Icc A B → HasDerivAt f1 (f2 z) z)
    (normCeiling tangencyCeiling normExponent tangencyExponent : Real)
    (hdelta : 0 < delta)
    (hnormCeiling : (delta : Real) ≤ normCeiling)
    (htangencyCeiling : (delta : Real) ≤ tangencyCeiling)
    (hmultiplicity : 0 < multiplicity)
    (hlower : 3 * multiplicity ≤ lower)
    (hpair : ∀ x, x ∈ Z.multiplicityBand lower upper →
      Set.Pairwise (Z.activeAtPoint x : Set iota) fun i j =>
        EssentiallyDistinct (fine.tubes i) (fine.tubes j))
    (hactiveCap : ∀ x, x ∈ Z.multiplicityBand lower upper →
      ∀ center,
        center ∈ actualProjectedCriticalFamily fine (Z.activeAtPoint x) →
        (activeNearCoefficientIndices fine (Z.activeAtPoint x) center
          (delta : Real)).card ≤ multiplicity) :
    let hfamily :=
      actualProjectedCriticalFamily_nonempty_on_multiplicityBand
        fine Z hdelta hmultiplicity hlower hpair hactiveCap
    HasContinuumCriticalDoubleDyadicSelection μ
      (Z.multiplicityBand lower upper)
      (actualProjectedCriticalScaleOnBand fine Z lower upper
        actualProjectedNormDistance normCeiling normExponent hfamily)
      (actualProjectedCriticalScaleOnBand fine Z lower upper
        (actualProjectedTangencyDistance f f1 f2 A B hAB
          hfDeriv hf1Deriv)
        tangencyCeiling tangencyExponent hfamily)
      (delta : Real) normCeiling tangencyCeiling := by
  dsimp only
  let hfamily :=
    actualProjectedCriticalFamily_nonempty_on_multiplicityBand
      fine Z hdelta hmultiplicity hlower hpair hactiveCap
  have hsource :=
    exists_finiteIncidence_actualCritical_doubleDyadicSelection
      μ Z.base Z.ambient (fun i x => x ∈ Z.carrier i)
      (multiplicityBandAccept lower upper)
      (actualProjectedCriticalFamily fine)
      actualProjectedNormDistance
      (actualProjectedTangencyDistance f f1 f2 A B hAB
        hfDeriv hf1Deriv)
      (delta : Real) normCeiling tangencyCeiling normExponent
      tangencyExponent Z.measurable_base
      (fun i hi => Z.measurable_carrier i hi)
      (by exact_mod_cast hdelta) hnormCeiling htangencyCeiling hfamily
  simpa only [HasContinuumCriticalDoubleDyadicSelection,
    FiniteProjectedShading.multiplicityBand,
    actualProjectedCriticalScaleOnBand] using hsource

#print axioms HasContinuumCriticalDoubleDyadicSelection
#print axioms actualProjectedCriticalScaleOnBand
#print axioms has_actualProjectedShading_continuumCriticalDoubleDyadicSelection

end


end FamilyStickyCinematicL32ActualProjectedShadingContinuumCriticalSelectionV1
