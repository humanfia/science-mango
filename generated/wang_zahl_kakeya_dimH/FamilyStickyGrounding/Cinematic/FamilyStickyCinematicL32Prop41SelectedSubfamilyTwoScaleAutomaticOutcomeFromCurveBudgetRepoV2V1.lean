noncomputable section

universe u

local instance tubeDecidableEq {radius : NNReal} :
    DecidableEq (Tube radius) := Classical.decEq _

/-!
# Package-free fixed-common-C counting from a finite curve budget

This is the carrier-generic core needed by a C-grid fibre.  The carrier may
be any finite type and the endpoint maps may be arbitrary fixed transforms.
The theorem does not mention an Exact-C, G-prime, sampling, or grid package.

The genuinely geometric inputs that remain visible are:

* the literal common-C fact on the deduplicated endpoint family;
* one coefficient ball around `globalCenter`;
* perturbation-ready rectangle data for each selected item; and
* the AtScales source Pairwise fact (normally supplied by two-stage
  clustering).

Owner-cluster/shading caps belong to the outer all-fibre mass aggregation
and are intentionally absent here.
-/

/-- Ambient logarithmic depth generated by a deterministic natural curve
budget. -/
def selectedSubfamilyAutomaticDepthFromCurveBudget
    (curveBudget : Nat) : Real :=
  (Nat.log 2 curveBudget + 1 : Nat)

theorem selectedSubfamilyAutomaticDepthFromCurveBudget_nonneg
    (curveBudget : Nat) :
    0 <= selectedSubfamilyAutomaticDepthFromCurveBudget curveBudget := by
  unfold selectedSubfamilyAutomaticDepthFromCurveBudget
  positivity

theorem selectedSubfamily_depth_le_automaticDepthFromCurveBudget
    {alpha : Type u} [DecidableEq alpha] {radius : NNReal}
    (fiber : Finset alpha) (T U : alpha -> Tube radius)
    (curveBudget : Nat)
    (hcurveBudget : (retainedPairTubeFamily fiber T U).card <= curveBudget) :
    (canonicalDepth (FirstGenerationCurve
      (retainedPairTubeFamily fiber T U)) : Real) <=
        selectedSubfamilyAutomaticDepthFromCurveBudget curveBudget := by
  unfold selectedSubfamilyAutomaticDepthFromCurveBudget canonicalDepth
  norm_cast
  simpa only [FirstGenerationCurve, Fintype.card_coe] using
    Nat.add_le_add_right (Nat.log_mono_right (b := 2) hcurveBudget) 1

/-- Grid-generic per-fibre RepoV2 endpoint.  A literal curve budget supplies
the depth automatically; the conclusion keeps the exact deduplicated curve
count so different common-C fibres can later be aggregated losslessly. -/
theorem selectedSubfamily_card_le_sampledLensBoundAtScales_automatic_of_curveBudget
    {alpha : Type u} [DecidableEq alpha] {radius : NNReal}
    (fiber : Finset alpha) (hfiber : fiber.Nonempty)
    (T U : alpha -> Tube radius)
    (source : alpha -> C2GraphRectangle)
    (globalCenter : Tube radius) (commonC rho : Real)
    (curveBudget : Nat)
    (f f1 f2 : Real -> Real)
    (outerA outerB globalDelta tGlobal pairScale referenceScale : Real)
    (hOuter : outerA <= outerB)
    (hfDeriv : forall z, HasDerivAt f (f1 z) z)
    (hf1Deriv : forall z, HasDerivAt f1 (f2 z) z)
    (sharp : ActualY1SharpFineScaleNumerics
      (radius : Real) globalDelta tGlobal (outerB - outerA))
    (hthree : ActualY1PaperFineThreeShiftPairScaleSmallness
      (radius : Real) globalDelta tGlobal pairScale)
    (hcount : ActualY1PaperFineSelectedCountingSmallness
      (radius : Real) globalDelta tGlobal pairScale)
    (hparameter : forall z, z ∈ Icc outerA outerB -> |z| <= 1)
    (hfunction : forall z, z ∈ Icc outerA outerB -> |f z| <= 2)
    (hfirstLower : forall z, z ∈ Icc outerA outerB -> 1 <= |f1 z|)
    (hfirstUpper : forall z, z ∈ Icc outerA outerB -> |f1 z| <= 2)
    (hsecond : forall z, z ∈ Icc outerA outerB -> |f2 z| <= 1 / 100)
    (hsecondContinuous : ContinuousOn f2 (Icc outerA outerB))
    (hcommon : forall V, V ∈ retainedPairTubeFamily fiber T U ->
      tubeGraphC V = commonC)
    (hball : forall V, V ∈ retainedPairTubeFamily fiber T U ->
      tubePairCoefficientDistance V globalCenter <= rho)
    (hcurveBudget : (retainedPairTubeFamily fiber T U).card <= curveBudget)
    (hreferenceMargin :
      max ((401 / 100 : Real) * rho) (2 * rho + 0) <
        3 * referenceScale)
    (hdata : forall a, a ∈ fiber ->
      PerturbationReadyPairLocalActualLensRectangleData
        (T a) (U a) f (source a) outerA outerB
          (actualY1PaperFineChoiceLocalDelta
            (radius : Real) globalDelta tGlobal pairScale)
          pairScale
          (actualY1PaperFineChoiceLambda
            (radius : Real) globalDelta tGlobal pairScale)
          (2 * actualY1PaperFineChoiceLambda
            (radius : Real) globalDelta tGlobal pairScale))
    (hsource : Set.Pairwise (fiber : Set alpha)
      (fun a b => Not (compactC2SymmetricGraphLambdaComparableOnAtScales
        (Icc outerA outerB)
        (globalCenterFixedCommonCReference globalCenter commonC f f1 f2
          hfDeriv hf1Deriv outerA outerB hOuter)
        (source a) (source b)
        (actualY1PaperFineChoiceLocalDelta
          (radius : Real) globalDelta tGlobal pairScale)
        pairScale referenceScale
        (actualY1PaperFineSelectedAutomaticComparisonLambda
          (radius := radius) globalDelta tGlobal pairScale)))) :
    (fiber.card : Real) <=
      sampledLensBound
        (selectedSubfamilyAutomaticDepthFromCurveBudget curveBudget)
        ((retainedPairTubeFamily fiber T U).card : Real) := by
  let depth := selectedSubfamilyAutomaticDepthFromCurveBudget curveBudget
  have hdepth :
      (canonicalDepth (FirstGenerationCurve
        (retainedPairTubeFamily fiber T U)) : Real) <= depth := by
    simpa only [depth] using
      selectedSubfamily_depth_le_automaticDepthFromCurveBudget
        fiber T U curveBudget hcurveBudget
  obtain ⟨G⟩ :=
    exists_selectedSubfamilyFiniteGeneralPositionTwoScaleCountingNoSourcePairwisePackage_automatic
      fiber T U source globalCenter commonC rho f f1 f2 outerA outerB
        globalDelta tGlobal pairScale referenceScale depth hOuter hfDeriv
        hf1Deriv sharp hthree hcount hparameter hfunction hfirstLower
        hfirstUpper hsecond hsecondContinuous hcommon hball hdepth
        hreferenceMargin
  simpa only [depth] using
    selectedSubfamily_card_le_sampledLensBoundAtScales_of_perturbationReady
      fiber hfiber T U source f f1 f2
      (globalCenterFixedCommonCReference globalCenter commonC f f1 f2
        hfDeriv hf1Deriv outerA outerB hOuter)
      (Icc outerA outerB)
      (actualY1PaperFineSelectedAutomaticComparisonLambda
        (radius := radius) globalDelta tGlobal pairScale)
      hfDeriv hf1Deriv hdata G hsource

#print axioms selectedSubfamilyAutomaticDepthFromCurveBudget
#print axioms selectedSubfamilyAutomaticDepthFromCurveBudget_nonneg
#print axioms selectedSubfamily_depth_le_automaticDepthFromCurveBudget
#print axioms selectedSubfamily_card_le_sampledLensBoundAtScales_automatic_of_curveBudget

end

