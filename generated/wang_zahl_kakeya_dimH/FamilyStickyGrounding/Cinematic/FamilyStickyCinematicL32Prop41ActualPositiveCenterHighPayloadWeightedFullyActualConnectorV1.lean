/-- The localized norm family needed by the point-source producer is
nonempty at every E2 point, directly from the payload's active-Y1 field. -/
theorem positiveCenterPayload_E2_localizedFamily_nonempty
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    {base : Set (Real × Real)} {hbase : MeasurableSet base}
    {fine : UniformTubeFamily radius iota}
    {physical : FiniteProjectedShading (Real × Real) iota}
    {f f1 f2 : Real -> Real} {outerA outerB : Real}
    {hOuter : outerA <= outerB}
    {hf : forall z, HasDerivAt f (f1 z) z}
    {hf1 : forall z, HasDerivAt f1 (f2 z) z}
    {tGlobal : Real} {globalCenter : Tube radius}
    {tangencyExponent : Real}
    (payload : ActualPositiveCenterCanonicalPayload volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent)
    (q : Real × Real)
    (hq : q ∈ positiveCenterE2 base hbase fine physical f f1 f2 outerA
      outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
        payload.tangencyLabel payload.finalLabel) :
    (finiteIncidenceNormLocalizedFamilyValue
      (actualProjectedAmbientCriticalFamily fine physical.ambient)
      projectedTubePairCoefficientDistance tGlobal globalCenter
      (physical.activeAtPoint q)).Nonempty := by
  let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
    outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
      payload.tangencyLabel
  let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent payload.tangencyLabel
  obtain ⟨_hlabel, _hq0, _hmass, _hEtPos, _hEtSubset, _hbin, _hE2Pos,
      _hE2Measurable, _hE2Subset, hactive⟩ := payload.certificate
  obtain ⟨i, hi⟩ := hactive q hq
  have hi' : i ∈ (actualProjectedCenteredHalfTangencyY1 E_t hEt fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        (36 * tGlobal) tangencyExponent
          (dyadicCeilUpper payload.tangencyLabel)).activeAtPoint q := by
    simpa only [positiveCenterY1, positiveCenterTangencyCell, E_t, hEt] using hi
  refine ⟨fine.tubes i, ?_⟩
  have hiData := mem_actualProjectedCenteredHalfTangencyY1_data E_t hEt fine
    physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
      (36 * tGlobal) tangencyExponent
        (dyadicCeilUpper payload.tangencyLabel) q i hi'
  exact hiData.2.1



/-- The positive-centre payload itself already contains a nonempty localized
norm family at its selected E2 point.  Forgetting the global-ball filter
therefore supplies the local critical-family nonemptiness needed by the
retained high record; no extra norm-family callback is required. -/
noncomputable def actualHighPayloadWithNormNonconcentration_of_payload
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    {base : Set (Real × Real)} {hbase : MeasurableSet base}
    {fine : UniformTubeFamily radius iota}
    {physical : FiniteProjectedShading (Real × Real) iota}
    {f f1 f2 : Real -> Real} {outerA outerB : Real}
    {hOuter : outerA <= outerB}
    {hf : forall z, HasDerivAt f (f1 z) z}
    {hf1 : forall z, HasDerivAt f1 (f2 z) z}
    {tGlobal : Real} {globalCenter : Tube radius}
    {tangencyExponent normExponent : Real} {logCount : Nat}
    (payload : ActualPositiveCenterCanonicalPayload volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent)
    (high : 24 * logCount <= pyzE2DegreeLower payload.finalLabel)
    (hradius : 0 < radius) (hradiusSixteen : (radius : Real) <= 16)
    (hnormExponent : 0 <= normExponent) :
    ActualHighPayloadWithNormNonconcentration volume base hbase fine physical
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount := by
  obtain ⟨_hlabel, hq, _hmass, _hEtPos, _hEtSubset, _hbin, _hE2Pos,
      _hE2Measurable, _hE2Subset, _hactive⟩ := payload.certificate
  have hlocalized :=
    positiveCenterPayload_E2_localizedFamily_nonempty payload payload.q hq
  have hcriticalNonempty :
      (actualProjectedAmbientCriticalFamily fine physical.ambient
        (physical.activeAtPoint payload.q)).Nonempty := by
    obtain ⟨T, hT⟩ := hlocalized
    exact ⟨T, (Finset.mem_filter.mp hT).1⟩
  exact
    { payload := payload
      high := high
      normFamily_nonempty := hcriticalNonempty
      radius_pos := hradius
      radius_le_sixteen := hradiusSixteen
      normExponent_nonneg := hnormExponent }

/-- Exact output proposition of the fully-actual weighted Family 7 endpoint,
specialized to the E2 cell retained by one positive-centre high payload. -/
def PositiveCenterHighPayloadWeightedGlobalSampledLensConclusion
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (mesh ballRadius : Real) : Prop :=
  let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
    outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
      H.payload.tangencyLabel
  let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent H.payload.tangencyLabel
  let globalDelta := dyadicCeilUpper H.payload.tangencyLabel
  let N := positiveCenterHighPayloadGlobalNormData H
  let D := actualCenteredHalfPaperFineE2SpatialIncidenceData E_t hEt fine
    physical H.payload.finalLabel mesh f f1 f2 outerA outerB hOuter hf hf1
      tGlobal globalDelta globalCenter (36 * tGlobal) tangencyExponent
  let source := actualCenteredHalfPaperFineE2 E_t hEt fine physical
    H.payload.finalLabel f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter (36 * tGlobal) tangencyExponent globalDelta
  exists Q : ActualGPrimeE2FirstHitWeightedSampledOutcome
      N D H.payload.finalLabel ballRadius,
    exists P :
      ActualGPrimeLabelFirstThreeShiftCGridPaperFineWeightedUniformPackageV2
        fine N D (fun _ _ => True) Q.sampled.pair.left Q.sampled.pair.right
          ballRadius Q.sampled.omega
            (actualGPrimeE2FirstHitLabelWeight D H.payload.finalLabel)
              f outerA outerB globalDelta tGlobal,
      let referenceScale :=
        actualGPrimeThreeShiftCGridWeightedAutomaticReferenceScale P
      let comparisonLambda :=
        actualY1PaperFineCNormalizedAutomaticComparisonLambda
          (radius := radius) globalDelta tGlobal (4 * ballRadius)
      let centerGap := (401 / 100 : Real) * (ballRadius + 6 * tGlobal)
      let curvatureRatio := twoCenterAutomaticCurvatureRatio
        (4 * ballRadius) centerGap referenceScale
      let codeBound : ENNReal := projectedCoefficientPackingCap ballRadius
        (2 * (ballRadius + 6 * tGlobal))
      let localPacking := finiteOccupiedCodeLocalPacking
        comparisonLambda curvatureRatio
      let thirdPacking := finiteOccupiedCodeThirdPacking codeBound
        comparisonLambda curvatureRatio curvatureRatio
      let cap := actualGPrimeThreeShiftCGridWeightedE2WideCap
        (radius : Real) ballRadius globalDelta tGlobal
      volume source *
          ((pyzE2DegreeLower H.payload.finalLabel *
            (pyzE2DegreeLower H.payload.finalLabel -
              automaticCanonicalNearCap N ballRadius) : Nat) : ENNReal) <=
        72 *
          ((richSeparatedCenterPairs N.family
            (canonicalTenRadiusSeparated N ballRadius)
            (fun _ _ => True)).card : ENNReal) *
          (localPacking * thirdPacking *
            ENNReal.ofReal
              (sampledLensBound
                (selectedSubfamilyAutomaticDepthFromCurveBudget
                  (actualThreeShiftCGridRestrictedGlobalTubeFamily
                    P.gridSelection P.selected
                      (actualGPrimeLabelFirstThreeShiftCGridFinalTraceShift
                        (P := P))).card)
                (twoSidedZeroColorLoad 1 1 Q.sampled.omega)) * cap)


/-- A retained actual high payload feeds the complete weighted Family 7
sampled-lens endpoint.  Only the scalar and curve hypotheses of that endpoint
remain explicit; the point source, active geometry, norm family, and distance
identification are all produced here. -/
theorem positiveCenterHighPayload_weightedGlobalSampledLens
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota) (ambient : Finset iota)
    (physicalBase : Set (Real × Real))
    (hphysicalBase : MeasurableSet physicalBase)
    (f : Real -> Real) (hfContinuous : Continuous f)
    (f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (htGlobal : 0 < tGlobal)
    (globalCenter : Tube radius)
    (hglobalCenter : globalCenter ∈ finiteMetricCoverCenters
      (activeTubeImage fine ambient) projectedTubePairCoefficientDistance
      tGlobal (fun T U => projectedTubePairCoefficientDistance_comm T U))
    (bucket : Int)
    (hbucket : forall i, i ∈ ambient ->
      actualProjectedTubeCBucket ((radius : Real) / 2) (fine.tubes i) =
        bucket)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      (actualProjectedNormFirstSixteenthPhysicalShading fine ambient
        physicalBase hphysicalBase f hfContinuous outerA outerB)
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (mesh : Real) (hmesh : 0 < mesh)
    (hparameter : forall z, z ∈ Icc outerA outerB -> |z| <= 1)
    (sharp : ActualY1SharpFineScaleNumerics
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (outerB - outerA))
    (hft : forall z, z ∈ Icc outerA outerB -> |f z| <= 2)
    (hf1Lower : forall z, z ∈ Icc outerA outerB -> 1 <= |f1 z|)
    (hf1Upper : forall z, z ∈ Icc outerA outerB -> |f1 z| <= 2)
    (hf2 : forall z, z ∈ Icc outerA outerB -> |f2 z| <= 1 / 100)
    (hf2Continuous : ContinuousOn f2 (Icc outerA outerB))
    (hmeshBase : mesh <= Real.sqrt ((radius : Real) /
      prop41Y1PaperFineT (radius : Real)
        (dyadicCeilUpper H.payload.tangencyLabel) tGlobal) / 2)
    (ballRadius : Real)
    (hroom : automaticCanonicalNearCap
      (positiveCenterHighPayloadGlobalNormData H) ballRadius <
        pyzE2DegreeLower H.payload.finalLabel)
    (hnearRadiusLower :
      (positiveCenterHighPayloadGlobalNormData H).delta <= 10 * ballRadius)
    (hnearRadiusUpper :
      10 * ballRadius <=
        (positiveCenterHighPayloadGlobalNormData H).ceiling)
    (hballRadiusLower :
      (positiveCenterHighPayloadGlobalNormData H).delta <= ballRadius)
    (hballRadiusUpper :
      ballRadius <= (positiveCenterHighPayloadGlobalNormData H).ceiling)
    (hsmall : ActualY1PaperFineCNormalizedThreeShiftPairScaleSmallness
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (4 * ballRadius))
    (hcount : ActualY1PaperFineCNormalizedSelectedCountingSmallness
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (4 * ballRadius)) :
    PositiveCenterHighPayloadWeightedGlobalSampledLensConclusion base hbase
      fine
      (actualProjectedNormFirstSixteenthPhysicalShading fine ambient
        physicalBase hphysicalBase f hfContinuous outerA outerB)
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount H mesh ballRadius := by
  let physical := actualProjectedNormFirstSixteenthPhysicalShading fine
    ambient physicalBase hphysicalBase f hfContinuous outerA outerB
  let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
    outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
      H.payload.tangencyLabel
  let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent H.payload.tangencyLabel
  let globalDelta := dyadicCeilUpper H.payload.tangencyLabel
  let source := actualCenteredHalfPaperFineE2 E_t hEt fine physical
    H.payload.finalLabel f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter (36 * tGlobal) tangencyExponent globalDelta
  let N := positiveCenterHighPayloadGlobalNormData H
  obtain ⟨_hlabel, hq, _hmass, _hEtPos, _hEtSubset, _hbin, _hE2Pos,
      _hE2Measurable, _hE2Subset, hactivePayload⟩ := H.payload.certificate
  have hsource : source.Nonempty := by
    refine ⟨H.payload.q, ?_⟩
    simpa only [source, actualCenteredHalfPaperFineE2,
      actualCenteredHalfPaperFineY1, positiveCenterE2, positiveCenterY1,
      positiveCenterTangencyCell, E_t, hEt, globalDelta] using hq
  have hactive : forall q, q ∈ source ->
      ((actualCenteredHalfPaperFineY1 E_t hEt fine physical f f1 f2 outerA
        outerB hOuter hf hf1 tGlobal globalCenter (36 * tGlobal)
          tangencyExponent globalDelta).activeAtPoint q).Nonempty := by
    intro q hqSource
    have hqPositive : q ∈ positiveCenterE2 base hbase fine physical f f1 f2
        outerA outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
          H.payload.tangencyLabel H.payload.finalLabel := by
      simpa only [source, actualCenteredHalfPaperFineE2,
        actualCenteredHalfPaperFineY1, positiveCenterE2, positiveCenterY1,
        positiveCenterTangencyCell, E_t, hEt, globalDelta] using hqSource
    obtain ⟨i, hi⟩ := hactivePayload q hqPositive
    refine ⟨i, ?_⟩
    simpa only [actualCenteredHalfPaperFineY1, positiveCenterY1,
      positiveCenterTangencyCell, E_t, hEt, globalDelta] using hi
  have hambientCBucket : forall i, i ∈ ambient -> forall j, j ∈ ambient ->
      |tubeGraphC (fine.tubes i) - tubeGraphC (fine.tubes j)| <=
        (radius : Real) / 2 := by
    intro i hi j hj
    exact abs_projectedTubeGraphC_sub_le_of_bucket_eq
      (div_pos (by exact_mod_cast H.radius_pos) (by norm_num))
      ((hbucket i hi).trans (hbucket j hj).symm)
  have hlocalized : forall q, q ∈ source ->
      (finiteIncidenceNormLocalizedFamilyValue
        (actualProjectedAmbientCriticalFamily fine physical.ambient)
        projectedTubePairCoefficientDistance tGlobal globalCenter
        (physical.activeAtPoint q)).Nonempty := by
    intro q hqSource
    apply positiveCenterPayload_E2_localizedFamily_nonempty H.payload q
    simpa only [source, actualCenteredHalfPaperFineE2,
      actualCenteredHalfPaperFineY1, positiveCenterE2, positiveCenterY1,
      positiveCenterTangencyCell, E_t, hEt, globalDelta] using hqSource
  have pointSourceRaw :=
    actualCenteredHalfPointRectangleSource_of_outerSixteenthPhysical fine
      ambient physicalBase hphysicalBase f hfContinuous outerA outerB f1 f2
      hOuter hf hf1 tGlobal htGlobal globalCenter hglobalCenter
        (36 * tGlobal) tangencyExponent source hlocalized hambientCBucket
  have pointSource : ActualCenteredHalfPointRectangleSource source globalCenter
      (actualCenteredHalfPaperFineTubeAt fine physical f f1 f2 outerA outerB
        hOuter hf hf1 tGlobal globalCenter (36 * tGlobal)
          tangencyExponent)
      f outerA outerB tGlobal := by
    simpa only [physical, actualProjectedNormFirstSixteenthPhysicalShading,
      actualProjectedNormFirstOuterSixteenthPhysicalShading,
      actualCenteredHalfPaperFineTubeAt] using pointSourceRaw
  have hdeltaThreshold : (radius : Real) <= globalDelta := by
    simpa only [globalDelta] using
      positiveCenterHighPayload_radius_le_tangencyUpper H
  have factsRaw := actualCenteredHalfY1ActiveGeometryFacts E_t hEt fine
    ambient physicalBase hphysicalBase f f1 f2 hfContinuous outerA outerB
      hOuter hf hf1 tGlobal globalCenter (36 * tGlobal) tangencyExponent
        globalDelta source hambientCBucket hdeltaThreshold
  have facts : ActualCenteredHalfY1ActiveGeometryFacts fine physical source
      (actualCenteredHalfPaperFineY1 E_t hEt fine physical f f1 f2 outerA
        outerB hOuter hf hf1 tGlobal globalCenter (36 * tGlobal)
          tangencyExponent globalDelta).activeAtPoint
      (actualCenteredHalfPaperFineTubeAt fine physical f f1 f2 outerA outerB
        hOuter hf hf1 tGlobal globalCenter (36 * tGlobal)
          tangencyExponent)
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalDelta := by
    simpa only [physical, actualProjectedNormFirstSixteenthPhysicalShading,
      actualProjectedNormFirstOuterSixteenthPhysicalShading,
      actualCenteredHalfPaperFineY1,
      actualCenteredHalfPaperFineTubeAt] using factsRaw
  have hNfamily : N.family =
      actualGlobalNormIndexFamily fine physical tGlobal globalCenter := by
    rfl
  have hdistance : forall i j, N.distance i j =
      projectedTubePairCoefficientDistance
        ((actualCenteredHalfPaperFineE2SpatialIncidenceData E_t hEt fine
          physical H.payload.finalLabel mesh f f1 f2 outerA outerB hOuter hf
            hf1 tGlobal globalDelta globalCenter (36 * tGlobal)
              tangencyExponent).fine.tubes i)
        ((actualCenteredHalfPaperFineE2SpatialIncidenceData E_t hEt fine
          physical H.payload.finalLabel mesh f f1 f2 outerA outerB hOuter hf
            hf1 tGlobal globalDelta globalCenter (36 * tGlobal)
              tangencyExponent).fine.tubes j) := by
    intro i j
    rfl
  unfold PositiveCenterHighPayloadWeightedGlobalSampledLensConclusion
  dsimp only
  exact actualCenteredHalfPaperFineE2_labelFirstThreeShiftCGridWeighted_globalSampledLens
    E_t hEt fine physical H.payload.finalLabel hmesh f f1 f2 outerA outerB
      hOuter hf hf1 tGlobal globalDelta globalCenter (36 * tGlobal)
        tangencyExponent pointSource facts hparameter sharp hft hf1Lower
          hf1Upper hf2 hf2Continuous hmeshBase hsource hactive N hNfamily
            hdistance ballRadius hroom hnearRadiusLower hnearRadiusUpper
              hballRadiusLower hballRadiusUpper hsmall hcount

/-! ## Base-cell mass transport into the same weighted E2 endpoint -/

/-- The E2 source used by the fully-actual weighted theorem is definitionally
the positive-center E2 cell stored in the high payload.  Hence the payload
certificate transports the literal base-cell measure to that exact source;
there is no relabelled set or cardinal surrogate. -/
theorem positiveCenterHighPayload_base_measure_le_binLoss_mul_paperFineE2
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount) :
    let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
      outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
        H.payload.tangencyLabel
    let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
      base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
        globalCenter tangencyExponent H.payload.tangencyLabel
    let globalDelta := dyadicCeilUpper H.payload.tangencyLabel
    volume base <=
      actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
        volume (actualCenteredHalfPaperFineE2 E_t hEt fine physical
          H.payload.finalLabel f f1 f2 outerA outerB hOuter hf hf1 tGlobal
            globalCenter (36 * tGlobal) tangencyExponent globalDelta) := by
  dsimp only
  obtain ⟨_hlabel, _hq, hmass, _hEtPos, _hEtSubset, _hbin, _hE2Pos,
      _hE2Measurable, _hE2Subset, _hactive⟩ := H.payload.certificate
  simpa only [actualCenteredHalfPaperFineE2, actualCenteredHalfPaperFineY1,
    positiveCenterE2, positiveCenterY1, positiveCenterTangencyCell,
    positiveCenterTangencyScale] using hmass

/-- Multiplying the preceding literal source transport by an arbitrary
nonnegative degree factor preserves the same right-hand side produced by the
weighted sampled-lens theorem.  This works in ENNReal even when the supplied
right-hand side is infinite and performs no cancellation or toReal step. -/
theorem positiveCenterHighPayload_base_mul_degree_le_binLoss_mul_of_E2_mul_le
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (degree rhs : ENNReal)
    (hsource :
      let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
        outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
          H.payload.tangencyLabel
      let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
        base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
          globalCenter tangencyExponent H.payload.tangencyLabel
      let globalDelta := dyadicCeilUpper H.payload.tangencyLabel
      volume (actualCenteredHalfPaperFineE2 E_t hEt fine physical
          H.payload.finalLabel f f1 f2 outerA outerB hOuter hf hf1 tGlobal
            globalCenter (36 * tGlobal) tangencyExponent globalDelta) *
        degree <= rhs) :
    volume base * degree <=
      actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
        rhs := by
  have hbaseMeasure :=
    positiveCenterHighPayload_base_measure_le_binLoss_mul_paperFineE2
      base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
        globalCenter tangencyExponent normExponent logCount H
  dsimp only at hbaseMeasure hsource
  calc
    volume base * degree <=
        (actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
          volume (actualCenteredHalfPaperFineE2
            (positiveCenterTangencyCell base fine physical f f1 f2 outerA
              outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
                H.payload.tangencyLabel)
            (measurableSet_positiveCenterTangencyCell base hbase fine physical
              f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
                tangencyExponent H.payload.tangencyLabel)
            fine physical H.payload.finalLabel f f1 f2 outerA outerB hOuter hf
              hf1 tGlobal globalCenter (36 * tGlobal) tangencyExponent
                (dyadicCeilUpper H.payload.tangencyLabel))) * degree :=
      by simpa [mul_comm] using mul_le_mul_right hbaseMeasure degree
    _ = actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
        (volume (actualCenteredHalfPaperFineE2
          (positiveCenterTangencyCell base fine physical f f1 f2 outerA
            outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
              H.payload.tangencyLabel)
          (measurableSet_positiveCenterTangencyCell base hbase fine physical
            f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
              tangencyExponent H.payload.tangencyLabel)
          fine physical H.payload.finalLabel f f1 f2 outerA outerB hOuter hf
            hf1 tGlobal globalCenter (36 * tGlobal) tangencyExponent
              (dyadicCeilUpper H.payload.tangencyLabel)) * degree) := by
      ac_rfl
    _ <= actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
        rhs := by
      simpa [mul_comm] using
        (mul_le_mul_left hsource
          (actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card))


/-- The exact same `Q` and `P` supplied by the weighted fully-actual endpoint,
now with the positive-center base mass on the left.  The only new loss is the
literal all-center bin loss already present in the payload certificate. -/
def PositiveCenterHighPayloadBaseWeightedGlobalSampledLensConclusion
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (mesh ballRadius : Real) : Prop :=
  let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
    outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
      H.payload.tangencyLabel
  let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent H.payload.tangencyLabel
  let globalDelta := dyadicCeilUpper H.payload.tangencyLabel
  let N := positiveCenterHighPayloadGlobalNormData H
  let D := actualCenteredHalfPaperFineE2SpatialIncidenceData E_t hEt fine
    physical H.payload.finalLabel mesh f f1 f2 outerA outerB hOuter hf hf1
      tGlobal globalDelta globalCenter (36 * tGlobal) tangencyExponent
  exists Q : ActualGPrimeE2FirstHitWeightedSampledOutcome
      N D H.payload.finalLabel ballRadius,
    exists P :
      ActualGPrimeLabelFirstThreeShiftCGridPaperFineWeightedUniformPackageV2
        fine N D (fun _ _ => True) Q.sampled.pair.left Q.sampled.pair.right
          ballRadius Q.sampled.omega
            (actualGPrimeE2FirstHitLabelWeight D H.payload.finalLabel)
              f outerA outerB globalDelta tGlobal,
      let referenceScale :=
        actualGPrimeThreeShiftCGridWeightedAutomaticReferenceScale P
      let comparisonLambda :=
        actualY1PaperFineCNormalizedAutomaticComparisonLambda
          (radius := radius) globalDelta tGlobal (4 * ballRadius)
      let centerGap := (401 / 100 : Real) * (ballRadius + 6 * tGlobal)
      let curvatureRatio := twoCenterAutomaticCurvatureRatio
        (4 * ballRadius) centerGap referenceScale
      let codeBound : ENNReal := projectedCoefficientPackingCap ballRadius
        (2 * (ballRadius + 6 * tGlobal))
      let localPacking := finiteOccupiedCodeLocalPacking
        comparisonLambda curvatureRatio
      let thirdPacking := finiteOccupiedCodeThirdPacking codeBound
        comparisonLambda curvatureRatio curvatureRatio
      let cap := actualGPrimeThreeShiftCGridWeightedE2WideCap
        (radius : Real) ballRadius globalDelta tGlobal
      volume base *
          ((pyzE2DegreeLower H.payload.finalLabel *
            (pyzE2DegreeLower H.payload.finalLabel -
              automaticCanonicalNearCap N ballRadius) : Nat) : ENNReal) <=
        actualAllCenterPostNormBinLoss radius tGlobal physical.ambient.card *
          (72 *
            ((richSeparatedCenterPairs N.family
              (canonicalTenRadiusSeparated N ballRadius)
              (fun _ _ => True)).card : ENNReal) *
            (localPacking * thirdPacking *
              ENNReal.ofReal
                (sampledLensBound
                  (selectedSubfamilyAutomaticDepthFromCurveBudget
                    (actualThreeShiftCGridRestrictedGlobalTubeFamily
                      P.gridSelection P.selected
                        (actualGPrimeLabelFirstThreeShiftCGridFinalTraceShift
                          (P := P))).card)
                  (twoSidedZeroColorLoad 1 1 Q.sampled.omega)) * cap))

/-- Pure same-witness transport from the literal E2 endpoint to the
positive-center base endpoint.  In particular, no fresh `Q`, `P`, or
sampled-lens witness is chosen. -/
theorem positiveCenterHighPayload_baseWeightedGlobalSampledLens_of_source
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (mesh ballRadius : Real)
    (hsource : PositiveCenterHighPayloadWeightedGlobalSampledLensConclusion
      base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
        globalCenter tangencyExponent normExponent logCount H mesh
          ballRadius) :
    PositiveCenterHighPayloadBaseWeightedGlobalSampledLensConclusion base
      hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
        globalCenter tangencyExponent normExponent logCount H mesh
          ballRadius := by
  unfold PositiveCenterHighPayloadWeightedGlobalSampledLensConclusion at hsource
  unfold PositiveCenterHighPayloadBaseWeightedGlobalSampledLensConclusion
  dsimp only at hsource ⊢
  obtain ⟨Q, P, hQP⟩ := hsource
  refine ⟨Q, P, ?_⟩
  exact positiveCenterHighPayload_base_mul_degree_le_binLoss_mul_of_E2_mul_le
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent normExponent logCount H
      ((pyzE2DegreeLower H.payload.finalLabel *
        (pyzE2DegreeLower H.payload.finalLabel -
          automaticCanonicalNearCap
            (positiveCenterHighPayloadGlobalNormData H) ballRadius) : Nat) :
        ENNReal)
      (72 *
        ((richSeparatedCenterPairs
          (positiveCenterHighPayloadGlobalNormData H).family
          (canonicalTenRadiusSeparated
            (positiveCenterHighPayloadGlobalNormData H) ballRadius)
          (fun _ _ => True)).card : ENNReal) *
        (finiteOccupiedCodeLocalPacking
            (actualY1PaperFineCNormalizedAutomaticComparisonLambda
              (radius := radius) (dyadicCeilUpper H.payload.tangencyLabel)
                tGlobal (4 * ballRadius))
            (twoCenterAutomaticCurvatureRatio (4 * ballRadius)
              ((401 / 100 : Real) * (ballRadius + 6 * tGlobal))
              (actualGPrimeThreeShiftCGridWeightedAutomaticReferenceScale P)) *
          finiteOccupiedCodeThirdPacking
            (projectedCoefficientPackingCap ballRadius
              (2 * (ballRadius + 6 * tGlobal)))
            (actualY1PaperFineCNormalizedAutomaticComparisonLambda
              (radius := radius) (dyadicCeilUpper H.payload.tangencyLabel)
                tGlobal (4 * ballRadius))
            (twoCenterAutomaticCurvatureRatio (4 * ballRadius)
              ((401 / 100 : Real) * (ballRadius + 6 * tGlobal))
              (actualGPrimeThreeShiftCGridWeightedAutomaticReferenceScale P))
            (twoCenterAutomaticCurvatureRatio (4 * ballRadius)
              ((401 / 100 : Real) * (ballRadius + 6 * tGlobal))
              (actualGPrimeThreeShiftCGridWeightedAutomaticReferenceScale P)) *
          ENNReal.ofReal
            (sampledLensBound
              (selectedSubfamilyAutomaticDepthFromCurveBudget
                (actualThreeShiftCGridRestrictedGlobalTubeFamily
                  P.gridSelection P.selected
                    (actualGPrimeLabelFirstThreeShiftCGridFinalTraceShift
                      (P := P))).card)
              (twoSidedZeroColorLoad 1 1 Q.sampled.omega)) *
          actualGPrimeThreeShiftCGridWeightedE2WideCap (radius : Real)
            ballRadius (dyadicCeilUpper H.payload.tangencyLabel) tGlobal))
      hQP


/-- Fully concrete positive-center high-payload endpoint with the base-cell
mass on the left.  The existential `Q` and `P` are exactly those produced by
`positiveCenterHighPayload_weightedGlobalSampledLens`; the proof only applies
the literal payload mass transport to their sampled-lens inequality. -/
theorem positiveCenterHighPayload_baseWeightedGlobalSampledLens
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota) (ambient : Finset iota)
    (physicalBase : Set (Real × Real))
    (hphysicalBase : MeasurableSet physicalBase)
    (f : Real -> Real) (hfContinuous : Continuous f)
    (f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (htGlobal : 0 < tGlobal)
    (globalCenter : Tube radius)
    (hglobalCenter : globalCenter ∈ finiteMetricCoverCenters
      (activeTubeImage fine ambient) projectedTubePairCoefficientDistance
      tGlobal (fun T U => projectedTubePairCoefficientDistance_comm T U))
    (bucket : Int)
    (hbucket : forall i, i ∈ ambient ->
      actualProjectedTubeCBucket ((radius : Real) / 2) (fine.tubes i) =
        bucket)
    (tangencyExponent normExponent : Real) (logCount : Nat)
    (H : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      (actualProjectedNormFirstSixteenthPhysicalShading fine ambient
        physicalBase hphysicalBase f hfContinuous outerA outerB)
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount)
    (mesh : Real) (hmesh : 0 < mesh)
    (hparameter : forall z, z ∈ Icc outerA outerB -> |z| <= 1)
    (sharp : ActualY1SharpFineScaleNumerics
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (outerB - outerA))
    (hft : forall z, z ∈ Icc outerA outerB -> |f z| <= 2)
    (hf1Lower : forall z, z ∈ Icc outerA outerB -> 1 <= |f1 z|)
    (hf1Upper : forall z, z ∈ Icc outerA outerB -> |f1 z| <= 2)
    (hf2 : forall z, z ∈ Icc outerA outerB -> |f2 z| <= 1 / 100)
    (hf2Continuous : ContinuousOn f2 (Icc outerA outerB))
    (hmeshBase : mesh <= Real.sqrt ((radius : Real) /
      prop41Y1PaperFineT (radius : Real)
        (dyadicCeilUpper H.payload.tangencyLabel) tGlobal) / 2)
    (ballRadius : Real)
    (hroom : automaticCanonicalNearCap
      (positiveCenterHighPayloadGlobalNormData H) ballRadius <
        pyzE2DegreeLower H.payload.finalLabel)
    (hnearRadiusLower :
      (positiveCenterHighPayloadGlobalNormData H).delta <= 10 * ballRadius)
    (hnearRadiusUpper :
      10 * ballRadius <=
        (positiveCenterHighPayloadGlobalNormData H).ceiling)
    (hballRadiusLower :
      (positiveCenterHighPayloadGlobalNormData H).delta <= ballRadius)
    (hballRadiusUpper :
      ballRadius <= (positiveCenterHighPayloadGlobalNormData H).ceiling)
    (hsmall : ActualY1PaperFineCNormalizedThreeShiftPairScaleSmallness
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (4 * ballRadius))
    (hcount : ActualY1PaperFineCNormalizedSelectedCountingSmallness
      (radius : Real) (dyadicCeilUpper H.payload.tangencyLabel) tGlobal
        (4 * ballRadius)) :
    PositiveCenterHighPayloadBaseWeightedGlobalSampledLensConclusion base
      hbase fine
      (actualProjectedNormFirstSixteenthPhysicalShading fine ambient
        physicalBase hphysicalBase f hfContinuous outerA outerB)
      f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount H mesh ballRadius := by
  apply positiveCenterHighPayload_baseWeightedGlobalSampledLens_of_source
  exact positiveCenterHighPayload_weightedGlobalSampledLens
    base hbase fine ambient physicalBase hphysicalBase f hfContinuous f1 f2
      outerA outerB hOuter hf hf1 tGlobal htGlobal globalCenter hglobalCenter
        bucket hbucket tangencyExponent normExponent logCount H mesh hmesh
          hparameter sharp hft hf1Lower hf1Upper hf2 hf2Continuous hmeshBase
            ballRadius hroom hnearRadiusLower hnearRadiusUpper hballRadiusLower
              hballRadiusUpper hsmall hcount

