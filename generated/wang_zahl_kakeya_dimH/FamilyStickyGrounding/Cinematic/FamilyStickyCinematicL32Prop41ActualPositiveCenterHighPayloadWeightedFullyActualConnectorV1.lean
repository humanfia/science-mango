/-!
# High positive-centre payload to the weighted fully-actual Family 7 endpoint

The all-centre norm-first branch already chooses a literal cover centre and
an actual positive-centre payload.  The payload's E2 certificate supplies a
nonempty centred-half active fibre at every retained point.  Consequently the
common global norm family, the point-rectangle source, and all active Y1
geometry are produced here; they are not accepted as callbacks.

The remaining hypotheses are the honest scalar/curve assumptions of the
fully-actual sampled-lens theorem.  In particular the near-cap room and the
two explicit smallness conditions are not inferred from the bare high-degree
inequality.
-/

/-- The tangency cell stored implicitly in a positive-centre payload is
measurable by construction. -/
theorem measurableSet_positiveCenterTangencyCell
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    (base : Set (Real × Real)) (hbase : MeasurableSet base)
    (fine : UniformTubeFamily radius iota)
    (physical : FiniteProjectedShading (Real × Real) iota)
    (f f1 f2 : Real -> Real) (outerA outerB : Real)
    (hOuter : outerA <= outerB)
    (hf : forall z, HasDerivAt f (f1 z) z)
    (hf1 : forall z, HasDerivAt f1 (f2 z) z)
    (tGlobal : Real) (globalCenter : Tube radius)
    (tangencyExponent : Real) (tangencyLabel : Int) :
    MeasurableSet (positiveCenterTangencyCell base fine physical f f1 f2
      outerA outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
        tangencyLabel) := by
  exact measurableSet_continuumCriticalSingleDyadicCell hbase
    (measurable_actualProjectedCenteredHalfLocalizedTangencyScale fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        (36 * tGlobal) tangencyExponent) tangencyLabel

/-- Active E2 fibres in the payload produce a literal index in the common
global norm family. -/
theorem positiveCenterPayload_globalNormIndexFamily_nonempty
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    {base : Set (Real × Real)} {hbase : MeasurableSet base}
    {fine : UniformTubeFamily radius iota}
    {physical : FiniteProjectedShading (Real × Real) iota}
    {f f1 f2 : Real -> Real} {outerA outerB : Real}
    {hOuter : outerA <= outerB}
    {hf : forall z, HasDerivAt f (f1 z) z}
    {hf1 : forall z, HasDerivAt f1 (f2 z) z}
    {tGlobal : Real} {globalCenter : Tube radius}
    {tangencyExponent : Real}
    (payload : ActualPositiveCenterCanonicalPayload volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent) :
    (actualGlobalNormIndexFamily fine physical tGlobal globalCenter).Nonempty := by
  let E_t := positiveCenterTangencyCell base fine physical f f1 f2 outerA
    outerB hOuter hf hf1 tGlobal globalCenter tangencyExponent
      payload.tangencyLabel
  let hEt : MeasurableSet E_t := measurableSet_positiveCenterTangencyCell
    base hbase fine physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal
      globalCenter tangencyExponent payload.tangencyLabel
  obtain ⟨_hlabel, hq, _hmass, _hEtPos, _hEtSubset, _hbin, _hE2Pos,
      _hE2Measurable, _hE2Subset, hactive⟩ := payload.certificate
  obtain ⟨i, hi⟩ := hactive payload.q hq
  have hi' : i ∈ (actualProjectedCenteredHalfTangencyY1 E_t hEt fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        (36 * tGlobal) tangencyExponent
          (dyadicCeilUpper payload.tangencyLabel)).activeAtPoint payload.q := by
    simpa only [positiveCenterY1, positiveCenterTangencyCell, E_t, hEt] using hi
  refine ⟨i, ?_⟩
  exact (actualCenteredHalfY1_active_mem_globalNormFamilies E_t hEt fine
    physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
      (36 * tGlobal) tangencyExponent
        (dyadicCeilUpper payload.tangencyLabel) payload.q i hi').1


/-- The lower endpoint of the payload tangency bucket places the physical
radius below its attained dyadic upper scale. -/
theorem positiveCenterHighPayload_radius_le_tangencyUpper
    {radius : NNReal} {iota : Type u} [DecidableEq iota]
    {base : Set (Real × Real)} {hbase : MeasurableSet base}
    {fine : UniformTubeFamily radius iota}
    {physical : FiniteProjectedShading (Real × Real) iota}
    {f f1 f2 : Real -> Real} {outerA outerB : Real}
    {hOuter : outerA <= outerB}
    {hf : forall z, HasDerivAt f (f1 z) z}
    {hf1 : forall z, HasDerivAt f1 (f2 z) z}
    {tGlobal : Real} {globalCenter : Tube radius}
    {tangencyExponent normExponent : Real} {logCount : Nat}
    (P : ActualHighPayloadWithNormNonconcentration volume base hbase fine
      physical f f1 f2 outerA outerB hOuter hf hf1 tGlobal globalCenter
        tangencyExponent normExponent logCount) :
    (radius : Real) <= dyadicCeilUpper P.payload.tangencyLabel := by
  have hradius : 0 < (radius : Real) := by exact_mod_cast P.radius_pos
  have hphysicalToBucket :=
    (dyadicCeilUpper_half_lt_and_le hradius).2
  have hlabelLower := (Finset.mem_Icc.mp P.payload.tangencyLabel_mem).1
  have hbucketMono :
      dyadicCeilUpper (dyadicCeilBucket (radius : Real)) <=
        dyadicCeilUpper P.payload.tangencyLabel := by
    unfold dyadicCeilUpper
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num)
      (by exact_mod_cast hlabelLower)
  exact hphysicalToBucket.trans hbucketMono

