import FamilyStickyGrounding.Cinematic.FamilyStickyCinematicL32Prop41ActualY1PaperFineThreeShiftScaleProducerV1
import Mathlib.Tactic

set_option autoImplicit false
set_option warningAsError true

namespace FamilyStickyCinematicL32Prop41ActualY1SamplingPaperFineSelectedBasicNumericsV1

open Set
open FamilyStickyCinematicL32Prop41TangencyProductToScaleV1
open FamilyStickyCinematicL32Prop41ActualY1SharpFineScaleTangencyV1
open FamilyStickyCinematicL32Prop41ActualY1PaperFineThreeShiftScaleProducerV1

noncomputable section

/-!
# Automatic scalar data for selected paper-fine counting

The paper-fine three-shift hypothesis already forces all elementary scalar
fields used by the selected counting theorem.  The only genuinely stronger
input is the final counting small-scale inequality; it is named separately
so it cannot be confused with the weaker three-shift condition.
-/

/-- The residual small-scale inequality at the enlarged selected-counting
parameter.  This is intentionally a separate hypothesis: the three-shift
radius condition alone does not imply it. -/
def ActualY1PaperFineSelectedCountingSmallness
    (fineDelta globalDelta tGlobal pairScale : Real) : Prop :=
  prop41TangencyScaleFactor
      (4 * (2 * actualY1PaperFineChoiceLambda
        fineDelta globalDelta tGlobal pairScale)) *
      actualY1PaperFineChoiceLocalDelta
        fineDelta globalDelta tGlobal pairScale <
    pairScale / 1200

/-- The five elementary scalar fields of the literal selected counting
package, all generated by the existing sharp-scale and three-shift data. -/
structure ActualY1PaperFineSelectedBasicNumerics
    (fineDelta globalDelta tGlobal A B pairScale : Real) : Prop where
  interval_strict : A < B
  delta_pos : 0 < actualY1PaperFineChoiceLocalDelta
    fineDelta globalDelta tGlobal pairScale
  t_pos : 0 < pairScale
  lambda1_ge_one : 1 <=
    2 * actualY1PaperFineChoiceLambda
      fineDelta globalDelta tGlobal pairScale
  interval_width : (1 / 2 : Real) <= B - A

/-- Add exactly the residual selected-counting smallness inequality. -/
structure ActualY1PaperFineSelectedCountingNumerics
    (fineDelta globalDelta tGlobal A B pairScale : Real) : Prop
    extends ActualY1PaperFineSelectedBasicNumerics
      fineDelta globalDelta tGlobal A B pairScale where
  small_scale : prop41TangencyScaleFactor
      (4 * (2 * actualY1PaperFineChoiceLambda
        fineDelta globalDelta tGlobal pairScale)) *
      actualY1PaperFineChoiceLocalDelta
        fineDelta globalDelta tGlobal pairScale <
    pairScale / 1200

/-- The sharp paper scale plus the three-shift smallness condition generate
all elementary selected-counting scalar fields. -/
theorem actualY1PaperFineSelectedBasicNumerics_of_pairScaleSmall
    {fineDelta globalDelta tGlobal A B pairScale : Real}
    (N : ActualY1SharpFineScaleNumerics
      fineDelta globalDelta tGlobal (B - A))
    (hsmall : ActualY1PaperFineThreeShiftPairScaleSmallness
      fineDelta globalDelta tGlobal pairScale) :
    ActualY1PaperFineSelectedBasicNumerics
      fineDelta globalDelta tGlobal A B pairScale := by
  have scales :=
    actualY1PaperFineAutomaticThreeShiftNumerics_of_pairScaleSmall N hsmall
  have hfactor := q_le_prop41TangencyScaleFactor_of_one_le scales.traceQ_one
  refine {
    interval_strict := by linarith [N.outerWidth_lower]
    delta_pos := scales.choice_scale.localDelta_pos
    t_pos := scales.choice_scale.pairScale_pos
    lambda1_ge_one := ?_
    interval_width := N.outerWidth_lower }
  unfold actualY1PaperFineChoiceLambda
  nlinarith [scales.traceQ_one, hfactor]

/-- Full selected-counting scalar data from the automatic elementary fields
and the one explicitly named residual inequality. -/
theorem actualY1PaperFineSelectedCountingNumerics_of_pairScaleSmall
    {fineDelta globalDelta tGlobal A B pairScale : Real}
    (N : ActualY1SharpFineScaleNumerics
      fineDelta globalDelta tGlobal (B - A))
    (hthree : ActualY1PaperFineThreeShiftPairScaleSmallness
      fineDelta globalDelta tGlobal pairScale)
    (hcount : ActualY1PaperFineSelectedCountingSmallness
      fineDelta globalDelta tGlobal pairScale) :
    ActualY1PaperFineSelectedCountingNumerics
      fineDelta globalDelta tGlobal A B pairScale where
  toActualY1PaperFineSelectedBasicNumerics :=
    actualY1PaperFineSelectedBasicNumerics_of_pairScaleSmall N hthree
  small_scale := by
    simpa only [ActualY1PaperFineSelectedCountingSmallness] using hcount

#print axioms ActualY1PaperFineSelectedCountingSmallness
#print axioms ActualY1PaperFineSelectedBasicNumerics
#print axioms ActualY1PaperFineSelectedCountingNumerics
#print axioms actualY1PaperFineSelectedBasicNumerics_of_pairScaleSmall
#print axioms actualY1PaperFineSelectedCountingNumerics_of_pairScaleSmall

end

end FamilyStickyCinematicL32Prop41ActualY1SamplingPaperFineSelectedBasicNumericsV1
