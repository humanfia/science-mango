/-!
# Canonical counted stopping driver

The generic counted driver quantifies its analytic successor over every
abstract `HierarchyStoppingState`.  Canonical insertion transport is stronger
but intentionally applies only when the hierarchy is the depth-one coherent
hierarchy generated by the current finite scale sequence.

This module closes that mismatch.  Its state space contains only canonical
realizations carrying the factor-count invariant, and its successor is
queried only on those canonical invariant-bearing states.  The same
separated-factor argument proves last-stage termination.  Thus no
arbitrary-state successor and no `NoBadAtStageBound` premise occur here.
-/

universe u

variable {delta : NNReal} {gapEpsilon : Real}
  {N : Nat} {eta : Nat -> Real}
  {iota : Type u} [Fintype iota] [DecidableEq iota]
  {fine : UniformTubeFamily delta iota}

/-! ## A canonical inserted successor -/

/-- The genuinely new data after one canonical bad-scale insertion.  The
depth, scale sequence, stage, coherent hierarchy, and untouched bodies are
fixed by construction; only a positive body family, its terminal
normalization, and its canonical envelope estimates remain to be supplied.

The insertion-transport module constructs the intended body family from two
child bodies.  Keeping the present interface at the whole-family level makes
the driver independent of the eventual analytic choice of those bodies. -/
structure CanonicalInsertedSuccessorData
    (C : CoherentStickyMultiscaleCover fine)
    (gap_nonneg : 0 <= gapEpsilon)
    (delta_pos : 0 < delta)
    (Q : CanonicalOneStepStoppingData C N gapEpsilon eta)
    (bad : SelectedActualBadSplit C (Q.toState C delta_pos))
    (stage_lt : Q.stage < N) where
  initialBody : Fin (Q.depth + 1) -> ConvexBody Space
  initialVolume_pos : forall m,
    0 < volume (initialBody m : Set Space)
  terminal_top_le_one : forall m,
    let S' := bad.refinedScales C (Q.toState C delta_pos)
      gap_nonneg
      delta_pos
    let F := CoherentExactHierarchyFamily.ofFiniteScaleSequence C S'
      Q.fine_refined_nonempty
    concentration (effectiveActiveFamily (F.hierarchy m) 1)
        (canonicalTestBody (F.hierarchy m) (initialBody m) 1) <= 1
  canonicalEnvelope_upper : forall m,
    let S' := bad.refinedScales C (Q.toState C delta_pos)
      gap_nonneg
      delta_pos
    canonicalHierarchyEnvelopeAt
        (CoherentExactHierarchyFamily.ofFiniteScaleSequence C S'
          Q.fine_refined_nonempty)
        (by omega) initialBody m <=
      requiredGlobalPowerAt S' eta (Q.stage + 1) m

namespace CanonicalInsertedSuccessorData

variable (C : CoherentStickyMultiscaleCover fine)
  (gap_nonneg : 0 <= gapEpsilon) (delta_pos : 0 < delta)
  (Q : CanonicalOneStepStoppingData C N gapEpsilon eta)
  (bad : SelectedActualBadSplit C (Q.toState C delta_pos))
  (stage_lt : Q.stage < N)
  (R : CanonicalInsertedSuccessorData C gap_nonneg delta_pos Q bad stage_lt)

def toCanonical : CanonicalOneStepStoppingData C N gapEpsilon eta where
  depth := Q.depth + 1
  depth_pos := Nat.succ_pos Q.depth
  fine_refined_nonempty := Q.fine_refined_nonempty
  scales := bad.refinedScales C (Q.toState C delta_pos)
    gap_nonneg delta_pos
  stage := Q.stage + 1
  stage_pos := by omega
  stage_le := by omega
  initialBody := R.initialBody
  initialVolume_pos := R.initialVolume_pos
  terminal_top_le_one := R.terminal_top_le_one
  canonicalEnvelope_upper := R.canonicalEnvelope_upper

@[simp] theorem toCanonical_depth :
    (R.toCanonical C gap_nonneg delta_pos Q bad stage_lt).depth =
      Q.depth + 1 := rfl

@[simp] theorem toCanonical_scales :
    (R.toCanonical C gap_nonneg delta_pos Q bad stage_lt).scales =
      bad.refinedScales C (Q.toState C delta_pos)
        gap_nonneg delta_pos := rfl

@[simp] theorem toCanonical_stage :
    (R.toCanonical C gap_nonneg delta_pos Q bad stage_lt).stage =
      Q.stage + 1 := rfl

@[simp] theorem toCanonical_initialBody :
    (R.toCanonical C gap_nonneg delta_pos Q bad stage_lt).initialBody =
      R.initialBody := rfl

theorem factorCountInvariant_toCanonical
    (gap_pos : 0 < gapEpsilon)
    (hQ : FactorCountInvariant (Q.toState C delta_pos)) :
    FactorCountInvariant
      ((R.toCanonical C gap_nonneg delta_pos Q bad stage_lt).toState
        C delta_pos) := by
  have growth := badSplit_separatedFactorCount_succ_le
    C (Q.toState C delta_pos) bad gap_nonneg delta_pos gap_pos
  unfold FactorCountInvariant at hQ ⊢
  change Q.stage - 1 <=
      separatedFactorCount (lastStageRatioFloor delta gapEpsilon) Q.scales at hQ
  change Q.stage + 1 - 1 <=
    separatedFactorCount (lastStageRatioFloor delta gapEpsilon)
      (bad.refinedScales C (Q.toState C delta_pos)
        gap_nonneg delta_pos)
  change separatedFactorCount
      (lastStageRatioFloor delta gapEpsilon) Q.scales + 1 <=
    separatedFactorCount (lastStageRatioFloor delta gapEpsilon)
      (bad.refinedScales C (Q.toState C delta_pos)
        gap_nonneg delta_pos) at growth
  calc
    Q.stage + 1 - 1 = Q.stage := by omega
    _ = Q.stage - 1 + 1 := (Nat.sub_add_cancel Q.stage_pos).symm
    _ <= separatedFactorCount
        (lastStageRatioFloor delta gapEpsilon) Q.scales + 1 :=
      Nat.add_le_add_right hQ 1
    _ <= separatedFactorCount (lastStageRatioFloor delta gapEpsilon)
        (bad.refinedScales C (Q.toState C delta_pos)
          gap_nonneg delta_pos) := growth

end CanonicalInsertedSuccessorData

structure CanonicalCountedState
    (C : CoherentStickyMultiscaleCover fine) (delta_pos : 0 < delta)
    (N : Nat) (gapEpsilon : Real) (eta : Nat -> Real) where
  data : CanonicalOneStepStoppingData C N gapEpsilon eta
  factorCount : FactorCountInvariant (data.toState C delta_pos)

namespace CanonicalCountedState

variable (C : CoherentStickyMultiscaleCover fine) (delta_pos : 0 < delta)
  (X : CanonicalCountedState C delta_pos N gapEpsilon eta)

def toState : HierarchyStoppingState delta N gapEpsilon eta :=
  X.data.toState C delta_pos

@[simp] theorem toState_stage :
    (X.toState C delta_pos).stage = X.data.stage := rfl

@[simp] theorem toState_scales :
    (X.toState C delta_pos).scales = X.data.scales := rfl

end CanonicalCountedState

def canonicalCountedInitialState
    (C : CoherentStickyMultiscaleCover fine) (delta_pos : 0 < delta)
    (Q : CanonicalOneStepStoppingData C N gapEpsilon eta)
    (stage_eq : Q.stage = 1) :
    CanonicalCountedState C delta_pos N gapEpsilon eta where
  data := Q
  factorCount := factorCountInvariant_of_stage_eq_one
    (Q.toState C delta_pos) (by simpa using stage_eq)

def CanonicalCountedAnalyticSuccessor
    (C : CoherentStickyMultiscaleCover fine)
    (gap_nonneg : 0 <= gapEpsilon) (delta_pos : 0 < delta) : Type _ :=
  forall (X : CanonicalCountedState C delta_pos N gapEpsilon eta),
    forall stage_lt : X.data.stage < N,
    forall bad : SelectedActualBadSplit C (X.toState C delta_pos),
      CanonicalInsertedSuccessorData C gap_nonneg delta_pos X.data bad
        stage_lt

def canonicalCountingNext
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (X : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    Option (CanonicalCountedState C delta_pos N gapEpsilon eta) := by
  classical
  by_cases hbad : Nonempty
      (SelectedActualBadSplit C (X.toState C delta_pos))
  · have stage_lt : X.data.stage < N := by
      by_contra not_lt
      have stage_eq : X.data.stage = N := by
        have := X.data.stage_le
        omega
      exact (no_bad_of_factorCountInvariant_at_bound
        C (X.toState C delta_pos) X.factorCount
        (by simpa using stage_eq) delta_pos delta_lt_one gap_pos
        exponent_budget) hbad
    let bad : SelectedActualBadSplit C (X.toState C delta_pos) :=
      Classical.choice hbad
    let R := successor X stage_lt bad
    exact some
      { data := R.toCanonical C gap_pos.le delta_pos X.data bad stage_lt
        factorCount := R.factorCountInvariant_toCanonical
          C gap_pos.le delta_pos X.data bad stage_lt gap_pos X.factorCount }
  · exact none

theorem canonicalCountingNext_eq_none_iff_no_bad
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (X : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    canonicalCountingNext C delta_pos delta_lt_one gap_pos exponent_budget
        successor X = none <->
      Not (Nonempty (SelectedActualBadSplit C (X.toState C delta_pos))) := by
  classical
  simp [canonicalCountingNext]

theorem canonicalCountingNext_stage
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    {X Y : CanonicalCountedState C delta_pos N gapEpsilon eta}
    (hnext : canonicalCountingNext C delta_pos delta_lt_one gap_pos
      exponent_budget successor X = some Y) :
    Y.data.stage = X.data.stage + 1 := by
  classical
  unfold canonicalCountingNext at hnext
  split at hnext
  next hbad =>
    have state_eq := Option.some.inj hnext
    rw [← state_eq]
    rfl
  next hbad =>
    simp at hnext

def canonicalCountingBoundedSystem
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos) :
    BoundedSuccessorSystem
      (CanonicalCountedState C delta_pos N gapEpsilon eta) N where
  stage := fun X => X.data.stage
  stage_le := fun X => X.data.stage_le
  next := canonicalCountingNext C delta_pos delta_lt_one gap_pos
    exponent_budget successor
  stage_next := canonicalCountingNext_stage C delta_pos delta_lt_one gap_pos
    exponent_budget successor

def canonicalCountingTerminalState
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (initial : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    CanonicalCountedState C delta_pos N gapEpsilon eta :=
  (canonicalCountingBoundedSystem C delta_pos delta_lt_one gap_pos
    exponent_budget successor).terminalState initial

theorem canonicalCountingNext_terminalState_eq_none
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (initial : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    canonicalCountingNext C delta_pos delta_lt_one gap_pos exponent_budget
      successor
      (canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
        exponent_budget successor initial) = none := by
  exact (canonicalCountingBoundedSystem C delta_pos delta_lt_one gap_pos
    exponent_budget successor).next_terminalState_eq_none initial

theorem canonicalCountingTerminalState_reachesIn
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (initial : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    exists steps, steps <= N - initial.data.stage /\
      (canonicalCountingBoundedSystem C delta_pos delta_lt_one gap_pos
        exponent_budget successor).ReachesIn steps initial
          (canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
            exponent_budget successor initial) := by
  exact (canonicalCountingBoundedSystem C delta_pos delta_lt_one gap_pos
    exponent_budget successor).terminalState_reachesIn initial

theorem canonicalCountingTerminalState_no_bad
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (initial : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    Not (Nonempty (SelectedActualBadSplit C
      ((canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
        exponent_budget successor initial).toState C delta_pos))) := by
  exact (canonicalCountingNext_eq_none_iff_no_bad C delta_pos delta_lt_one
    gap_pos exponent_budget successor _).1
      (canonicalCountingNext_terminalState_eq_none C delta_pos delta_lt_one
        gap_pos exponent_budget successor initial)

theorem canonicalCountingTerminalState_terminalNoSplit
    (C : CoherentStickyMultiscaleCover fine)
    (delta_pos : 0 < delta) (delta_lt_one : delta < 1)
    (gap_pos : 0 < gapEpsilon)
    (exponent_budget : 1 <
      (gapEpsilon * gapEpsilon) * (N : Real))
    (successor : CanonicalCountedAnalyticSuccessor (N := N) (eta := eta)
      C gap_pos.le delta_pos)
    (initial : CanonicalCountedState C delta_pos N gapEpsilon eta) :
    forall not_all_large : Not
        ((canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
          exponent_budget successor initial).data.scales.AllStepsLarge
            gapEpsilon),
      SelectedActualTerminalNoSplit
        (C.toActualIntervalCovers
          (canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
            exponent_budget successor initial).data.scales)
        gapEpsilon eta
        (canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
          exponent_budget successor initial).data.stage
        (firstNonLargeStep
          (canonicalCountingTerminalState C delta_pos delta_lt_one gap_pos
            exponent_budget successor initial).data.scales
          gapEpsilon not_all_large) := by
  exact (no_bad_iff_terminalNoSplit C _).1
    (canonicalCountingTerminalState_no_bad C delta_pos delta_lt_one gap_pos
      exponent_budget successor initial)

