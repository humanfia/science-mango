import ArchonPhysics.FourWaveCollisionAlgebra

/-!
# Consumer: effective four-wave FPUT collision algebra

This is the kinetic-side target for the effective quartic interaction
generated by eliminating the empty nonzero three-wave shell.
-/

namespace ArchonPhysicsConsumers.Thermalization

open ArchonPhysics.FourWaveCollisionAlgebra

theorem problem_four_wave_action_conservation
    (rate n₁ n₂ n₃ n₄ : Real) :
    fourWaveLinearObservableSlope 1 1 1 1 rate n₁ n₂ n₃ n₄ = 0 :=
  fourWaveActionSlope_eq_zero rate n₁ n₂ n₃ n₄

theorem problem_four_wave_energy_conservation
    (ω₁ ω₂ ω₃ ω₄ rate n₁ n₂ n₃ n₄ : Real)
    (hω : ω₁ + ω₂ = ω₃ + ω₄) :
    fourWaveLinearObservableSlope
      ω₁ ω₂ ω₃ ω₄ rate n₁ n₂ n₃ n₄ = 0 :=
  fourWaveEnergySlope_eq_zero_of_resonance
    ω₁ ω₂ ω₃ ω₄ rate n₁ n₂ n₃ n₄ hω

theorem problem_four_wave_rayleigh_jeans_stationary
    (chemical inverseTemperature : Real) (ω₁ ω₂ ω₃ ω₄ : Real)
    (hω : ω₁ + ω₂ = ω₃ + ω₄) :
    fourWaveCollisionFlux
      (fourWaveRayleighJeansAction chemical inverseTemperature ω₁)
      (fourWaveRayleighJeansAction chemical inverseTemperature ω₂)
      (fourWaveRayleighJeansAction chemical inverseTemperature ω₃)
      (fourWaveRayleighJeansAction chemical inverseTemperature ω₄) = 0 :=
  fourWaveCollisionFlux_rayleighJeans_eq_zero
    chemical inverseTemperature ω₁ ω₂ ω₃ ω₄ hω

#print axioms problem_four_wave_action_conservation
#print axioms problem_four_wave_energy_conservation
#print axioms problem_four_wave_rayleigh_jeans_stationary

end ArchonPhysicsConsumers.Thermalization
