import ArchonPhysics.EqualMassPeriodicFPUTFourWaveHaarPhaseCouples

/-!
# Consumer: actual effective four-wave Haar phase couples

This consumer exposes the exact phase-selection contracts for the active
equal-mass alpha-FPUT effective diagrams.  Different external signatures are
annihilated; equal signatures retain the complete ordered cross term; and the
full second moment is an equal-signature couple sum rather than a diagonal
sum.
-/

namespace ArchonPhysicsConsumers.Thermalization.EqualMassPeriodicFPUTFourWaveHaarPhaseCouples

open MeasureTheory
open UnitAddTorus
open ArchonPhysics
open ArchonPhysics.EqualMassPeriodicFPUTEffectiveFourWaveVertex
open ArchonPhysics.EqualMassPeriodicFPUTFourWaveHaarPhaseCouples
open ArchonPhysics.PhyslibFPUTBinaryInteractionTreeCouples
open ArchonPhysics.RandomPhaseMoments

noncomputable section

/-- The external signature is the signed occurrence count read directly from
the four microscopic external-leg arrays. -/
theorem actualExternalSignature_contract
    {N : Nat} [NeZero N]
    (diagram : ActiveEffectiveFourWaveDiagram N)
    (mode : Lattice.Site N) :
    externalFourWavePhaseSignature diagram.1 mode =
      ∑ slot : Fin 4,
        if mode = totalFourWaveModes diagram.1 slot then
          (interactionSignToPhaseSign
            (totalFourWaveSign diagram.1 slot)).exponent
        else 0 := by
  exact externalFourWavePhaseSignature_apply diagram.1 mode

/-- An unmatched pair of actual active diagrams has zero Haar cross
expectation. -/
theorem actualUnmatchedDiagramCross_eq_zero_contract
    (N : Nat) [NeZero N] (alpha time : Real)
    (left right : ActiveEffectiveFourWaveDiagram N)
    (hunmatched : ¬ leafPhaseBalanced
      (externalFourWaveDiagramCouple left.1 right.1)) :
    (∫ phase : UnitAddTorus (Lattice.Site N),
      effectiveFourWavePhaseCross N alpha time left.1 right.1 phase
      ∂finitePhaseHaarLaw (Lattice.Site N)) = 0 := by
  exact integral_effectiveFourWavePhaseCross_eq_zero_of_unmatchedCouple
    N alpha time left.1 right.1 hunmatched

/-- Equal external signatures, including collisions generated by different
leg orderings, retain the full coefficient cross product. -/
theorem actualMatchedDiagramCross_contract
    (N : Nat) [NeZero N] (alpha time : Real)
    (left right : ActiveEffectiveFourWaveDiagram N)
    (hmatched : externalFourWavePhaseSignature left.1 =
      externalFourWavePhaseSignature right.1) :
    (∫ phase : UnitAddTorus (Lattice.Site N),
      effectiveFourWavePhaseCross N alpha time left.1 right.1 phase
      ∂finitePhaseHaarLaw (Lattice.Site N)) =
      effectiveFourWavePhaseCoefficient N alpha time left.1 *
        starRingEnd Complex
          (effectiveFourWavePhaseCoefficient N alpha time right.1) := by
  exact
    integral_effectiveFourWavePhaseCross_eq_coefficientCross_of_signature_eq
      N alpha time left.1 right.1 hmatched

/-- The exact active-diagram second moment keeps all and only matched ordered
binary-tree couples.  No injectivity or diagonal-only hypothesis appears. -/
theorem actualActiveDiagramSecondMoment_coupleSum_contract
    (N : Nat) [NeZero N] (alpha time : Real) :
    (∫ phase : UnitAddTorus (Lattice.Site N),
      (Complex.normSq
        (activeEffectiveFourWaveHaarAmplitude N alpha time phase) : Complex)
      ∂finitePhaseHaarLaw (Lattice.Site N)) =
      ∑ left : ActiveEffectiveFourWaveDiagram N,
        ∑ right : ActiveEffectiveFourWaveDiagram N,
          if leafPhaseBalanced
              (externalFourWaveDiagramCouple left.1 right.1) then
            effectiveFourWavePhaseCoefficient N alpha time left.1 *
              starRingEnd Complex
                (effectiveFourWavePhaseCoefficient N alpha time right.1)
          else 0 := by
  exact integral_normSq_activeEffectiveFourWaveHaarAmplitude_eq_coupleSum
    N alpha time

#print axioms actualExternalSignature_contract
#print axioms actualUnmatchedDiagramCross_eq_zero_contract
#print axioms actualMatchedDiagramCross_contract
#print axioms actualActiveDiagramSecondMoment_coupleSum_contract
#print axioms integral_normSq_activeEffectiveFourWaveHaarAmplitude_eq_coupleSum

end

end ArchonPhysicsConsumers.Thermalization.EqualMassPeriodicFPUTFourWaveHaarPhaseCouples
