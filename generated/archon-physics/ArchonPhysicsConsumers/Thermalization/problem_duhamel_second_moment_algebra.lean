import ArchonPhysics.DuhamelSecondMomentAlgebra

/-!
Independent consumer for the exact finite Duhamel second-moment algebra.

The five-mode statement below treats both amplitudes as arbitrary supplied
complex data.  It makes no claim that the correction is generated by a
microscopic dynamics or converges to a kinetic collision term.
-/

namespace ArchonPhysicsConsumers.Thermalization.DuhamelSecondMomentAlgebra

open ArchonPhysics.DuhamelSecondMomentAlgebra

noncomputable section

/-- The exact pointwise and normalized-average quadratic identities on five
arbitrary complex modes. -/
theorem fiveMode_secondMoment_contract
    (z w : Fin 5 → Complex) (epsilon : Real) :
    (∀ k, Complex.normSq (perturbedAmplitude epsilon (z k) (w k)) =
      secondMomentZeroth (z k) +
        epsilon * secondMomentFirst (z k) (w k) +
        epsilon ^ 2 * secondMomentSecond (w k)) ∧
      finiteAverage (fun k =>
          Complex.normSq (perturbedAmplitude epsilon (z k) (w k))) =
        finiteAverage (fun k => secondMomentZeroth (z k)) +
          epsilon * finiteAverage (fun k => secondMomentFirst (z k) (w k)) +
          epsilon ^ 2 * finiteAverage (fun k => secondMomentSecond (w k)) := by
  exact ⟨fun k => normSq_perturbedAmplitude (z k) (w k) epsilon,
    finiteAverage_normSq_perturbedAmplitude z w epsilon⟩

end

end ArchonPhysicsConsumers.Thermalization.DuhamelSecondMomentAlgebra
