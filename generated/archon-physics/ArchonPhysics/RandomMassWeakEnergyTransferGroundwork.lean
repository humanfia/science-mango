import ArchonPhysics.FrozenUniformMassMoments
import ArchonPhysics.RandomMassAndersonTransferBridge

/-!
# Centered weak-energy transfer-matrix groundwork

For the frozen iid mass law `Uniform[4/5, 6/5]`, write `m = 1 + ξ`.
This module records the exact affine decomposition of the one-site transfer
matrix around the mean mass, an explicit positive invariant quadratic form
for the mean transfer in the elliptic range `0 < λ < 4`, and the first two
moments of the scalar random transfer coefficient.

These are local algebraic and probabilistic identities only. No Lyapunov
exponent, localization, eigenfunction-correlator, or asymptotic theorem is
asserted.
-/

open scoped Matrix

namespace ArchonPhysics.RandomMassWeakEnergyTransferGroundwork

open ArchonPhysics
open ArchonPhysics.FrozenUniformMassMoments
open ArchonPhysics.RandomMassAndersonTransferBridge
open MeasureTheory ProbabilityTheory

noncomputable section

/-- The centered mass coordinate `ξ = m - 1`. -/
def centeredMass (mass : Real) : Real :=
  mass - 1

/-- The deterministic transfer matrix at the mean mass `m = 1`. -/
def meanTransferMatrix (lambda : Real) : Matrix (Fin 2) (Fin 2) Real :=
  andersonTransferMatrix lambda 1

/-- Direction of the affine random perturbation of the transfer matrix. -/
def centeredTransferDirection (lambda : Real) : Matrix (Fin 2) (Fin 2) Real :=
  !![-lambda, 0;
      0,       0]

/-- Transfer perturbation generated by one centered mass coordinate. -/
def centeredTransferPerturbation (lambda xi : Real) :
    Matrix (Fin 2) (Fin 2) Real :=
  xi • centeredTransferDirection lambda

/-- Exact centered decomposition `T(1 + ξ, λ) = T(1, λ) + ξ B(λ)`. -/
theorem andersonTransferMatrix_one_add_centered_decomposition
    (lambda xi : Real) :
    andersonTransferMatrix lambda (1 + xi) =
      meanTransferMatrix lambda + centeredTransferPerturbation lambda xi := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [andersonTransferMatrix, andersonDiagonalPotential,
      meanTransferMatrix, centeredTransferPerturbation,
      centeredTransferDirection];
    ring

/-- Exact decomposition written directly in terms of the mass `m`. -/
theorem andersonTransferMatrix_centered_decomposition
    (lambda mass : Real) :
    andersonTransferMatrix lambda mass =
      meanTransferMatrix lambda +
        centeredTransferPerturbation lambda (centeredMass mass) := by
  have h := andersonTransferMatrix_one_add_centered_decomposition
    lambda (centeredMass mass)
  simpa [centeredMass] using h

/-- Symmetric matrix of the invariant quadratic form for the mean transfer. -/
def meanInvariantFormMatrix (lambda : Real) : Matrix (Fin 2) (Fin 2) Real :=
  !![1,                -(2 - lambda) / 2;
     -(2 - lambda) / 2,                 1]

/-- The mean transfer exactly preserves the displayed symmetric form. -/
theorem meanTransferMatrix_preserves_invariantForm (lambda : Real) :
    Matrix.transpose (meanTransferMatrix lambda) *
        meanInvariantFormMatrix lambda * meanTransferMatrix lambda =
      meanInvariantFormMatrix lambda := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [meanTransferMatrix, meanInvariantFormMatrix,
      andersonTransferMatrix, andersonDiagonalPotential,
      Matrix.mul_apply, Fin.sum_univ_two] <;>
    ring

/-- Scalar presentation of the invariant quadratic form. -/
def meanInvariantQuadratic (lambda : Real) (state : Fin 2 → Real) : Real :=
  state 0 ^ 2 - (2 - lambda) * state 0 * state 1 + state 1 ^ 2

/-- Exact invariance of the quadratic form under one mean transfer step. -/
theorem meanInvariantQuadratic_meanTransferMatrix_mulVec
    (lambda : Real) (state : Fin 2 → Real) :
    meanInvariantQuadratic lambda
        (Matrix.mulVec (meanTransferMatrix lambda) state) =
      meanInvariantQuadratic lambda state := by
  simp [meanInvariantQuadratic, meanTransferMatrix,
    andersonTransferMatrix, andersonDiagonalPotential,
    Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  ring

/-- Completed-square identity exposing ellipticity for `0 < λ < 4`. -/
theorem meanInvariantQuadratic_eq_completedSquare
    (lambda : Real) (state : Fin 2 → Real) :
    meanInvariantQuadratic lambda state =
      (state 0 - (2 - lambda) / 2 * state 1) ^ 2 +
        (lambda * (4 - lambda) / 4) * state 1 ^ 2 := by
  simp only [meanInvariantQuadratic]
  ring

/-- In the elliptic range, the invariant quadratic form is positive definite. -/
theorem meanInvariantQuadratic_pos
    {lambda : Real} (hlambda_pos : 0 < lambda) (hlambda_four : lambda < 4)
    {state : Fin 2 → Real} (hstate : state ≠ 0) :
    0 < meanInvariantQuadratic lambda state := by
  rw [meanInvariantQuadratic_eq_completedSquare]
  have hcoefficient : 0 < lambda * (4 - lambda) / 4 := by
    positivity
  by_cases hsecond : state 1 = 0
  · have hfirst : state 0 ≠ 0 := by
      intro hzero
      apply hstate
      funext i
      fin_cases i
      · exact hzero
      · exact hsecond
    simpa [hsecond] using sq_pos_of_ne_zero hfirst
  · have hsecond_sq : 0 < state 1 ^ 2 := sq_pos_of_ne_zero hsecond
    nlinarith [sq_nonneg (state 0 - (2 - lambda) / 2 * state 1)]

/-- The centered scalar multiplying the sole random matrix entry. -/
def centeredTransferCoefficient (lambda mass : Real) : Real :=
  -lambda * centeredMass mass

theorem measurable_centeredTransferCoefficient (lambda : Real) :
    Measurable (centeredTransferCoefficient lambda) := by
  unfold centeredTransferCoefficient centeredMass
  fun_prop

/-- The perturbation has the centered coefficient in entry `(0,0)`. -/
theorem centeredTransferPerturbation_apply_zero_zero
    (lambda mass : Real) :
    centeredTransferPerturbation lambda (centeredMass mass) 0 0 =
      centeredTransferCoefficient lambda mass := by
  simp [centeredTransferPerturbation, centeredTransferDirection,
    centeredTransferCoefficient]
  ring

/-- The canonical uniform mass coordinate is exactly centered at one. -/
theorem integral_centeredMass_massCoordinateLaw :
    (∫ mass, centeredMass mass ∂(RandomEnsemble.massCoordinateLaw)) = 0 := by
  rw [integral_massCoordinateLaw_eq_normalized_setIntegral,
    integral_massSupport_eq_intervalIntegral]
  simp only [centeredMass]
  rw [intervalIntegral.integral_sub intervalIntegral.intervalIntegrable_id
    intervalIntegrable_const, integral_id]
  simp [RandomEnsemble.massLower, RandomEnsemble.massUpper]
  norm_num

/-- The first-order random transfer coefficient has mean zero. -/
theorem integral_centeredTransferCoefficient_massCoordinateLaw
    (lambda : Real) :
    (∫ mass, centeredTransferCoefficient lambda mass
        ∂(RandomEnsemble.massCoordinateLaw)) = 0 := by
  simp only [centeredTransferCoefficient]
  rw [integral_const_mul, integral_centeredMass_massCoordinateLaw, mul_zero]

/-- Its exact second moment is `λ² Var(m) = λ² / 75`. -/
theorem integral_centeredTransferCoefficient_sq_massCoordinateLaw
    (lambda : Real) :
    (∫ mass, centeredTransferCoefficient lambda mass ^ 2
        ∂(RandomEnsemble.massCoordinateLaw)) = lambda ^ 2 / 75 := by
  have hintegrand :
      (fun mass : Real ↦ centeredTransferCoefficient lambda mass ^ 2) =
        fun mass : Real ↦ lambda ^ 2 * (mass - 1) ^ 2 := by
    funext mass
    simp only [centeredTransferCoefficient, centeredMass]
    ring
  rw [hintegrand, integral_const_mul, massCoordinateLaw_centeredSecondMoment]
  ring

/-- The second coefficient is precisely controlled by the mass variance. -/
theorem integral_centeredTransferCoefficient_sq_eq_variance
    (lambda : Real) :
    (∫ mass, centeredTransferCoefficient lambda mass ^ 2
        ∂(RandomEnsemble.massCoordinateLaw)) =
      lambda ^ 2 * Var[id; RandomEnsemble.massCoordinateLaw] := by
  rw [integral_centeredTransferCoefficient_sq_massCoordinateLaw,
    massCoordinateLaw_variance]
  ring

/-- Nondegenerate masses give a strictly positive second coefficient at
every nonzero spectral parameter. -/
theorem integral_centeredTransferCoefficient_sq_pos
    {lambda : Real} (hlambda : lambda ≠ 0) :
    0 < ∫ mass, centeredTransferCoefficient lambda mass ^ 2
      ∂(RandomEnsemble.massCoordinateLaw) := by
  rw [integral_centeredTransferCoefficient_sq_massCoordinateLaw]
  positivity

variable {Omega : Type*} [MeasurableSpace Omega]

/-- Centered transfer coefficient at one coordinate of an iid ensemble. -/
def iidCenteredTransferCoefficient
    (ensemble : IIDMassPhaseEnsemble Omega) (lambda : Real)
    (i : Nat) (omega : Omega) : Real :=
  centeredTransferCoefficient lambda (ensemble.mass i omega)

theorem measurable_iidCenteredTransferCoefficient
    (ensemble : IIDMassPhaseEnsemble Omega) (lambda : Real) (i : Nat) :
    Measurable (iidCenteredTransferCoefficient ensemble lambda i) := by
  exact (measurable_centeredTransferCoefficient lambda).comp
    (ensemble.mass_measurable i)

/-- The centered transfer coefficients retain coordinate independence. -/
theorem iidCenteredTransferCoefficient_iIndep
    (ensemble : IIDMassPhaseEnsemble Omega) (lambda : Real) :
    iIndepFun (iidCenteredTransferCoefficient ensemble lambda)
      ensemble.probability := by
  exact ensemble.mass_iIndep.comp
    (fun _i : Nat => centeredTransferCoefficient lambda)
    (fun _i : Nat => measurable_centeredTransferCoefficient lambda)

/-- Every iid centered transfer coefficient has mean zero. -/
theorem ensemble_centeredTransferCoefficient_mean
    (ensemble : IIDMassPhaseEnsemble Omega) (lambda : Real) (i : Nat) :
    (∫ omega, iidCenteredTransferCoefficient ensemble lambda i omega
        ∂(ensemble.probability)) = 0 := by
  have htransport := (ensemble.mass_hasLaw i).integral_comp
    (f := centeredTransferCoefficient lambda)
    (measurable_centeredTransferCoefficient lambda).aestronglyMeasurable
  simpa [iidCenteredTransferCoefficient, Function.comp_def] using
    htransport.trans
      (integral_centeredTransferCoefficient_massCoordinateLaw lambda)

/-- Every iid centered coefficient has exact second moment `λ²/75`. -/
theorem ensemble_centeredTransferCoefficient_secondMoment
    (ensemble : IIDMassPhaseEnsemble Omega) (lambda : Real) (i : Nat) :
    (∫ omega, iidCenteredTransferCoefficient ensemble lambda i omega ^ 2
        ∂(ensemble.probability)) = lambda ^ 2 / 75 := by
  have hmeas : AEStronglyMeasurable
      (fun mass : Real ↦ centeredTransferCoefficient lambda mass ^ 2)
      RandomEnsemble.massCoordinateLaw :=
    Measurable.aestronglyMeasurable
      ((measurable_centeredTransferCoefficient lambda).pow_const 2)
  have htransport := (ensemble.mass_hasLaw i).integral_comp
    (f := fun mass : Real ↦ centeredTransferCoefficient lambda mass ^ 2)
    hmeas
  simpa [iidCenteredTransferCoefficient, Function.comp_def] using
    htransport.trans
      (integral_centeredTransferCoefficient_sq_massCoordinateLaw lambda)

/-- Bundled local weak-energy input: exact centering, elliptic invariance, and
strictly positive variance coefficient. -/
theorem frozenUniform_weakEnergyTransfer_local_groundwork
    (lambda : Real) (hlambda_pos : 0 < lambda) (hlambda_four : lambda < 4) :
    (∀ mass, andersonTransferMatrix lambda mass =
      meanTransferMatrix lambda +
        centeredTransferPerturbation lambda (centeredMass mass)) ∧
    (∀ state, meanInvariantQuadratic lambda
      (Matrix.mulVec (meanTransferMatrix lambda) state) =
        meanInvariantQuadratic lambda state) ∧
    (∀ state, state ≠ 0 → 0 < meanInvariantQuadratic lambda state) ∧
    (∫ mass, centeredTransferCoefficient lambda mass
      ∂(RandomEnsemble.massCoordinateLaw)) = 0 ∧
    (∫ mass, centeredTransferCoefficient lambda mass ^ 2
      ∂(RandomEnsemble.massCoordinateLaw)) =
        lambda ^ 2 * Var[id; RandomEnsemble.massCoordinateLaw] ∧
    0 < ∫ mass, centeredTransferCoefficient lambda mass ^ 2
      ∂(RandomEnsemble.massCoordinateLaw) := by
  refine ⟨andersonTransferMatrix_centered_decomposition lambda,
    meanInvariantQuadratic_meanTransferMatrix_mulVec lambda, ?_,
    integral_centeredTransferCoefficient_massCoordinateLaw lambda,
    integral_centeredTransferCoefficient_sq_eq_variance lambda, ?_⟩
  · intro state hstate
    exact meanInvariantQuadratic_pos hlambda_pos hlambda_four hstate
  · exact integral_centeredTransferCoefficient_sq_pos
      (ne_of_gt hlambda_pos)

end

end ArchonPhysics.RandomMassWeakEnergyTransferGroundwork
