def ratMod103 (q : Rat) : ZMod 103 :=
  (q.num : ZMod 103) * (q.den : ZMod 103) ^ 101

/-- The common multiplication denominator reduces to the certified scalar. -/
theorem multiplicationDenominator_mod_103 :
