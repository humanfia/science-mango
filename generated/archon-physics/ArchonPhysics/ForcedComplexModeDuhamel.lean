import ArchonPhysics.ComplexModeAmplitude
import ArchonPhysics.InteractionPictureDuhamel

/-!
# Duhamel formula for one forced positive-frequency mode

This module composes the existing real-to-complex mode transform with the
existing interaction-picture fundamental-theorem-of-calculus adapter.  For

`Q' = P`, `P' = -omega^2 Q + R`,

the convention

`a = (omega Q + i P) / sqrt (2 omega)`

gives the exact source `i R / sqrt (2 omega)` after removal of the free
rotation.

The forcing `R` and all interval-integrability assumptions remain explicit.
No claim is made that `R` has been derived from the target lattice
Hamiltonian, its mode-coupling tensor, or a perturbative expansion.
-/

namespace ArchonPhysics.ForcedComplexModeDuhamel

open Set
open ArchonPhysics.ComplexModeAmplitude
open ArchonPhysics.PhaseRenormalization
open ArchonPhysics.InteractionPictureDuhamel

noncomputable section

/-- Complex source generated by a real force in the current positive-frequency
amplitude convention. -/
def forcedModeSource (omega force : Real) : Complex :=
  Complex.I * (force : Complex) / Real.sqrt (2 * omega)

/-- The forced real oscillator equation becomes free complex rotation plus
the displayed complex source. -/
theorem hasDerivAt_complexModeAmplitude_forced
    {omega : Real} (homega : 0 < omega)
    {Q P R : Real → Real} {t : Real}
    (hQ : HasDerivAt Q (P t) t)
    (hP : HasDerivAt P (-(omega ^ 2) * Q t + R t) t) :
    HasDerivAt (fun s ↦ complexModeAmplitude omega (Q s) (P s))
      (forcedModeSource omega (R t) -
        (Complex.I * (omega : Complex)) *
          complexModeAmplitude omega (Q t) (P t)) t := by
  have hsqrt : Real.sqrt (2 * omega) ≠ 0 :=
    Real.sqrt_ne_zero'.mpr (mul_pos zero_lt_two homega)
  convert hasDerivAt_complexModeAmplitude (omega := omega) hQ hP using 1
  unfold forcedModeSource complexModeAmplitude
  push_cast
  field_simp [hsqrt]
  ring_nf
  simp

/-- Exact interaction-picture Duhamel formula for one forced oscillator on
the oriented interval from `0` to `t`. -/
theorem interactionPicture_forcedMode_eq_initial_add_integral
    {omega t : Real} (homega : 0 < omega)
    {Q P R : Real → Real}
    (hQ : ∀ s ∈ uIcc 0 t, HasDerivAt Q (P s) s)
    (hP : ∀ s ∈ uIcc 0 t,
      HasDerivAt P (-(omega ^ 2) * Q s + R s) s)
    (hIntegrable : IntervalIntegrable
      (fun s ↦ phaseFactor (omega * s) * forcedModeSource omega (R s))
      MeasureTheory.volume 0 t) :
    phaseRenormalize (omega * t)
        (complexModeAmplitude omega (Q t) (P t)) =
      complexModeAmplitude omega (Q 0) (P 0) +
        ∫ s in 0..t,
          phaseFactor (omega * s) * forcedModeSource omega (R s) := by
  exact interactionPicture_eq_initial_add_integral
    (fun s hs ↦ hasDerivAt_complexModeAmplitude_forced homega
      (hQ s hs) (hP s hs))
    hIntegrable

end

end ArchonPhysics.ForcedComplexModeDuhamel
