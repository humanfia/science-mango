import ArchonPhysics.DuhamelSecondMomentAlgebra

/-!
# Exact moment algebra for two Duhamel corrections

For a truncation `z + epsilon * w + epsilon^2 * u`, the squared amplitude is
an exact degree-four polynomial.  In particular, the genuine second-order
coefficient contains both `|w|^2` and the interference of the initial term
with the second Duhamel correction `u`.

This prevents the common mistake of identifying `|w|^2` alone with the full
second-order collision term.  The module is pure complex algebra and makes no
claim that `w` or `u` has been derived from a microscopic lattice equation.
-/

namespace ArchonPhysics.DuhamelTwoStepMomentAlgebra

open ArchonPhysics.DuhamelSecondMomentAlgebra
open scoped ComplexConjugate

noncomputable section

/-- Amplitude truncated after the second perturbative correction. -/
def twoStepPerturbedAmplitude
    (epsilon : Real) (z w u : Complex) : Complex :=
  z + (epsilon : Complex) * w + ((epsilon ^ 2 : Real) : Complex) * u

/-- Full coefficient at order two: gain `|w|^2` plus the initial/second-step
interference term. -/
def twoStepSecondCoefficient (z w u : Complex) : Real :=
  secondMomentSecond w + secondMomentFirst z u

/-- Cubic coefficient generated by interference of the two supplied
corrections. -/
def twoStepThirdCoefficient (w u : Complex) : Real :=
  secondMomentFirst w u

/-- Quartic coefficient generated by the squared second correction. -/
def twoStepFourthCoefficient (u : Complex) : Real :=
  secondMomentSecond u

/-- Exact degree-four squared-amplitude identity, with no remainder. -/
theorem normSq_twoStepPerturbedAmplitude
    (z w u : Complex) (epsilon : Real) :
    Complex.normSq (twoStepPerturbedAmplitude epsilon z w u) =
      secondMomentZeroth z +
        epsilon * secondMomentFirst z w +
        epsilon ^ 2 * twoStepSecondCoefficient z w u +
        epsilon ^ 3 * twoStepThirdCoefficient w u +
        epsilon ^ 4 * twoStepFourthCoefficient u := by
  unfold twoStepPerturbedAmplitude twoStepSecondCoefficient
    twoStepThirdCoefficient twoStepFourthCoefficient
  unfold secondMomentZeroth secondMomentFirst secondMomentSecond
  simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    Complex.conj_re, Complex.conj_im, zero_mul, sub_zero, add_zero]
  ring

/-- The coefficient of `epsilon^2` explicitly contains both second-order
mechanisms. -/
theorem twoStepSecondCoefficient_eq
    (z w u : Complex) :
    twoStepSecondCoefficient z w u =
      Complex.normSq w + 2 * (z * conj u).re := by
  rfl

end

end ArchonPhysics.DuhamelTwoStepMomentAlgebra
