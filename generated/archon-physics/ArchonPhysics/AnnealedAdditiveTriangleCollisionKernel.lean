import ArchonPhysics.AdditiveTriangleMeasureSupport
import ArchonPhysics.BoundedMeasurableAEFrequencyBalanceRigidity
import ArchonPhysics.MeasurableThreeWaveBalanceRigidity

/-!
# A nondegenerate annealed additive-triangle collision kernel

This file constructs a genuine continuum resonant three-wave measure by
transporting planar Lebesgue measure on the additive frequency triangle along
`(y, z) ↦ (y + z, y, z)`.  Unlike a fixed finite-volume exact collision graph,
this kernel is nonzero for every positive frequency ceiling.

Its child-frequency trace is *equal* to Lebesgue measure restricted to the
triangle.  Consequently the measurable Cauchy theorem gives the exact
bounded-measurable frequency-balance rigidity required by the continuum
H-theorem.  An actual random-lattice annealed limit can use this kernel once
model-specific coarea estimates identify an everywhere-positive density with
respect to this reference trace; no realization-wise statement is made here.
-/

namespace ArchonPhysics.AnnealedAdditiveTriangleCollisionKernel

open Set MeasureTheory
open ArchonPhysics
open ArchonPhysics.AdditiveTriangleMeasureSupport
open ArchonPhysics.BoundedMeasurableAEFrequencyBalanceRigidity
open ArchonPhysics.ContinuousThreeWaveBalanceRigidity
open ArchonPhysics.MeasurableThreeWaveBalanceRigidity
open ArchonPhysics.ResonantThreeWaveKineticRadonNikodym
open scoped ENNReal

noncomputable section

/-- The additive frequency triangle is contained in its coordinate square. -/
theorem additiveFrequencyTriangle_subset_square (W : Real) :
    additiveFrequencyTriangle W ⊆ Icc (0 : Real) W ×ˢ Icc (0 : Real) W := by
  intro pair hpair
  exact
    ⟨⟨hpair.1, (le_add_of_nonneg_right hpair.2.1).trans hpair.2.2⟩,
      ⟨hpair.2.1, (le_add_of_nonneg_left hpair.1).trans hpair.2.2⟩⟩

/-- Planar Lebesgue measure restricted to the additive triangle, packaged as
a finite measure.  Finiteness follows from containment in a compact square. -/
def additiveTriangleFiniteMeasure (W : Real) : FiniteMeasure (Real × Real) :=
  ⟨volume.restrict (additiveFrequencyTriangle W),
    ⟨by
      rw [Measure.restrict_apply_univ]
      exact measure_lt_top_of_subset (additiveFrequencyTriangle_subset_square W)
        ((isCompact_Icc.prod isCompact_Icc).measure_ne_top)⟩⟩

@[simp] theorem additiveTriangleFiniteMeasure_toMeasure (W : Real) :
    (additiveTriangleFiniteMeasure W : Measure (Real × Real)) =
      volume.restrict (additiveFrequencyTriangle W) := by
  rfl

/-- The resonant parent/child triple generated by a pair of child
frequencies. -/
def additiveResonantTriad (pair : Real × Real) : Fin 3 → Real :=
  fun leg => Fin.cases (pair.1 + pair.2)
    (fun child => Fin.cases pair.1 (fun _ => pair.2) child) leg

@[simp] theorem additiveResonantTriad_zero (pair : Real × Real) :
    additiveResonantTriad pair 0 = pair.1 + pair.2 := by
  rfl

@[simp] theorem additiveResonantTriad_one (pair : Real × Real) :
    additiveResonantTriad pair 1 = pair.1 := by
  rfl

@[simp] theorem additiveResonantTriad_two (pair : Real × Real) :
    additiveResonantTriad pair 2 = pair.2 := by
  rfl

theorem measurable_additiveResonantTriad : Measurable additiveResonantTriad := by
  apply measurable_pi_lambda
  intro leg
  fin_cases leg
  · exact measurable_fst.add measurable_snd
  · exact measurable_fst
  · exact measurable_snd

/-- The annealed continuum collision kernel induced by uniform child-pair
Lebesgue measure on the complete additive triangle. -/
def annealedAdditiveTriangleCollision (W : Real) :
    ResonantThreeWaveMeasure Real where
  frequency := id
  measurable_frequency := measurable_id
  collisionMeasure := (additiveTriangleFiniteMeasure W).map additiveResonantTriad
  resonance_ae := by
    rw [FiniteMeasure.toMeasure_map]
    refine (ae_map_iff measurable_additiveResonantTriad.aemeasurable ?_).2 ?_
    · measurability
    · exact Filter.Eventually.of_forall fun pair => by
        simp only [id_eq, additiveResonantTriad_zero,
          additiveResonantTriad_one, additiveResonantTriad_two]

/-- Every collision frequency lies in the physical compact interval. -/
theorem frequency_mem_Icc_ae (W : Real) :
    ∀ᵐ triad ∂((annealedAdditiveTriangleCollision W).collisionMeasure :
        Measure (Fin 3 → Real)),
      ∀ leg : Fin 3,
        (annealedAdditiveTriangleCollision W).frequency (triad leg) ∈
          Icc (0 : Real) W := by
  rw [show ((annealedAdditiveTriangleCollision W).collisionMeasure :
      Measure (Fin 3 → Real)) =
        Measure.map additiveResonantTriad
          (volume.restrict (additiveFrequencyTriangle W)) by rfl]
  refine (ae_map_iff measurable_additiveResonantTriad.aemeasurable ?_).2 ?_
  · measurability
  · filter_upwards [ae_restrict_mem
        (isClosed_additiveFrequencyTriangle W).measurableSet] with pair hpair
    intro leg
    fin_cases leg
    · exact ⟨add_nonneg hpair.1 hpair.2.1, hpair.2.2⟩
    · exact
        ⟨hpair.1, (le_add_of_nonneg_right hpair.2.1).trans hpair.2.2⟩
    · exact
        ⟨hpair.2.1, (le_add_of_nonneg_left hpair.1).trans hpair.2.2⟩

/-- Projecting the generated triad back to its two child frequencies is the
identity on the source plane. -/
theorem childFrequencyPair_comp_additiveResonantTriad (W : Real) :
    childFrequencyPair (annealedAdditiveTriangleCollision W) ∘
        additiveResonantTriad = id := by
  funext pair
  simp [childFrequencyPair, annealedAdditiveTriangleCollision]

/-- The child-frequency trace of the annealed kernel is exactly planar
Lebesgue measure on the full additive triangle. -/
theorem childFrequencyPairMeasure_eq (W : Real) :
    childFrequencyPairMeasure (annealedAdditiveTriangleCollision W) =
      volume.restrict (additiveFrequencyTriangle W) := by
  unfold childFrequencyPairMeasure
  rw [show (((annealedAdditiveTriangleCollision W).collisionMeasure :
      FiniteMeasure (Fin 3 → Real)) : Measure (Fin 3 → Real)) =
        Measure.map additiveResonantTriad
          (volume.restrict (additiveFrequencyTriangle W)) by rfl]
  rw [Measure.map_map
    (measurable_childFrequencyPair (annealedAdditiveTriangleCollision W))
    measurable_additiveResonantTriad]
  rw [childFrequencyPair_comp_additiveResonantTriad, Measure.map_id]

/-- Restricting the child trace to the physical triangle changes nothing. -/
theorem childFrequencyPairMeasure_restrict_eq (W : Real) :
    (childFrequencyPairMeasure (annealedAdditiveTriangleCollision W)).restrict
        (additiveFrequencyTriangle W) =
      volume.restrict (additiveFrequencyTriangle W) := by
  rw [childFrequencyPairMeasure_eq]
  exact Measure.restrict_restrict_of_subset Subset.rfl

/-- Positive width makes the reference triangle measure nonzero. -/
theorem additiveTriangleMeasure_ne_zero {W : Real} (hW : 0 < W) :
    volume.restrict (additiveFrequencyTriangle W) ≠ 0 := by
  intro hzero
  obtain ⟨pair, hpairInterior⟩ :=
    interior_additiveFrequencyTriangle_nonempty hW
  have hpairTriangle : pair ∈ additiveFrequencyTriangle W :=
    interior_subset hpairInterior
  have hpairSupport :=
    additiveFrequencyTriangle_subset_volume_restrict_support hW hpairTriangle
  rw [hzero, Measure.support_zero] at hpairSupport
  exact hpairSupport

/-- The continuum collision measure itself is nonzero, not merely its
reference child trace. -/
theorem collisionMeasure_ne_zero {W : Real} (hW : 0 < W) :
    (annealedAdditiveTriangleCollision W).collisionMeasure ≠ 0 := by
  intro hzero
  have hzeroMeasure :
      (((annealedAdditiveTriangleCollision W).collisionMeasure :
          FiniteMeasure (Fin 3 → Real)) : Measure (Fin 3 → Real)) = 0 :=
    congrArg FiniteMeasure.toMeasure hzero
  rw [show (((annealedAdditiveTriangleCollision W).collisionMeasure :
      FiniteMeasure (Fin 3 → Real)) : Measure (Fin 3 → Real)) =
        Measure.map additiveResonantTriad
          (volume.restrict (additiveFrequencyTriangle W)) by rfl,
      Measure.map_eq_zero_iff measurable_additiveResonantTriad.aemeasurable]
    at hzeroMeasure
  exact additiveTriangleMeasure_ne_zero hW hzeroMeasure

/-- The nonzero annealed additive-triangle kernel has the exact
bounded-measurable balance rigidity used by entropy-production arguments. -/
theorem boundedMeasurableAEFrequencyBalanceRigid {W : Real} (hW : 0 < W) :
    BoundedMeasurableAEFrequencyBalanceRigid
      (annealedAdditiveTriangleCollision W) := by
  intro weight hweight hbalance
  obtain ⟨bound, hbound⟩ := hweight.exists_norm_bound
  have hmemLp :
      MemLp weight ∞ (volume.restrict (Icc (0 : Real) W)) :=
    memLp_top_of_bound hweight.measurable.aestronglyMeasurable bound
      (Filter.Eventually.of_forall hbound)
  apply measurableFrequencyProfile_ae_proportional_of_memLp_top_equivalentTrace
    (annealedAdditiveTriangleCollision W) hW (frequency_mem_Icc_ae W)
    hweight.measurable hmemLp hbalance
  · rw [childFrequencyPairMeasure_restrict_eq]
  · rw [childFrequencyPairMeasure_restrict_eq]

end

end ArchonPhysics.AnnealedAdditiveTriangleCollisionKernel
