import ArchonPhysics.ActualTwoMassChildRepeatedAnnealedReconstruction
import ArchonPhysics.FiniteProductBoundedDifferences

/-!
# Bounded-difference audit for child-repeated weak tests

Clipping any finite-volume child test to a fixed range gives a completely
rigorous bounded-difference estimate, but only with one full range-width per
mass coordinate.  Its variance proxy grows linearly with volume.  Thus this
automatic estimate cannot yield self-averaging or a Borel--Cantelli argument.
The final theorem states the genuinely missing sharper input: order `1/N`
coordinate sensitivity.
-/

open scoped ENNReal NNReal BoundedContinuousFunction

namespace ArchonPhysics.ChildRepeatedBoundedDifferenceAudit

open ArchonPhysics
open ArchonPhysics.ActualTwoMassChildRepeatedAnnealedReconstruction
open ArchonPhysics.ActualTwoMassChildRepeatedDeterministicBridge
open ArchonPhysics.FiniteProductBoundedDifferences
open ArchonPhysics.RandomEnsemble
open Filter MeasureTheory ProbabilityTheory Set

noncomputable section

/-- A positive finite-volume mass configuration generated by a raw
`Fin (n+2)` mass vector. -/
def finChildRepeatedPositiveMassConfig
    (n : Nat) (x : Fin (n + 2) → Real) :
    Lattice.PositiveMassConfig (n + 2) where
  mass site := clippedMass (x ⟨site.val, site.val_lt⟩)
  mass_pos site := clippedMass_pos _

theorem measurable_finChildRepeatedPositiveMassConfig_mass
    (n : Nat) (site : Lattice.Site (n + 2)) :
    Measurable fun x : Fin (n + 2) → Real ↦
      (finChildRepeatedPositiveMassConfig n x).mass site := by
  exact measurable_clippedMass.comp
    (measurable_pi_apply (⟨site.val, site.val_lt⟩ : Fin (n + 2)))

/-- The untruncated real-valued bounded-continuous test integral of the exact
finite child-repeated reduced measure. -/
def finChildRepeatedReducedRawTest
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (x : Fin (n + 2) → Real) : Real :=
  (∫⁻ frequency, (test frequency : ENNReal)
    ∂childRepeatedReducedPerSitePairMeasure
      (finChildRepeatedPositiveMassConfig n x)).toReal

theorem measurable_finChildRepeatedReducedRawTest
    (n : Nat) (test : (Real × Real) →ᵇ NNReal) :
    Measurable (finChildRepeatedReducedRawTest n test) := by
  have hmeasure : Measurable fun x : Fin (n + 2) → Real ↦
      childRepeatedReducedPerSitePairMeasure
        (finChildRepeatedPositiveMassConfig n x) := by
    refine Measure.measurable_of_measurable_coe _ fun A hA ↦ ?_
    exact measurable_childRepeatedReducedPerSitePairMeasure_apply
      (finChildRepeatedPositiveMassConfig n)
      (measurable_finChildRepeatedPositiveMassConfig_mass n) hA
  unfold finChildRepeatedReducedRawTest
  exact ((Measure.measurable_lintegral
    test.measurable_coe_ennreal_comp).comp hmeasure).ennreal_toReal

/-- Clip a child weak test to a prescribed finite real interval. -/
def finChildRepeatedReducedClippedTest
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (bound : NNReal) (x : Fin (n + 2) → Real) : Real :=
  max 0 (min (bound : Real)
    (finChildRepeatedReducedRawTest n test x))

theorem measurable_finChildRepeatedReducedClippedTest
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (bound : NNReal) :
    Measurable (finChildRepeatedReducedClippedTest n test bound) := by
  unfold finChildRepeatedReducedClippedTest
  exact measurable_const.max
    (measurable_const.min (measurable_finChildRepeatedReducedRawTest n test))

theorem finChildRepeatedReducedClippedTest_mem_Icc
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (bound : NNReal) (x : Fin (n + 2) → Real) :
    finChildRepeatedReducedClippedTest n test bound x ∈
      Set.Icc 0 (bound : Real) := by
  unfold finChildRepeatedReducedClippedTest
  constructor
  · exact le_max_left _ _
  · exact max_le (NNReal.coe_nonneg bound) (min_le_left _ _)

/-- Any function with range in `[0,B]` has the crude bounded-difference
constant `B` in every coordinate. -/
theorem hasFinBoundedDifferences_of_mem_Icc
    {alpha : Type*} {N : Nat} (observable : (Fin N → alpha) → Real)
    (bound : NNReal)
    (hrange : ∀ x, observable x ∈ Set.Icc 0 (bound : Real)) :
    HasFinBoundedDifferences observable (fun _ : Fin N ↦ bound) := by
  intro x y _i _hoff
  rw [abs_le]
  constructor
  · linarith [(hrange x).1, (hrange y).2]
  · linarith [(hrange x).2, (hrange y).1]

/-- The actual clipped child test therefore has one full range-width of
sensitivity per mass coordinate. -/
theorem finChildRepeatedReducedClippedTest_hasBoundedDifferences
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (bound : NNReal) :
    HasFinBoundedDifferences
      (finChildRepeatedReducedClippedTest n test bound)
      (fun _ : Fin (n + 2) ↦ bound) :=
  hasFinBoundedDifferences_of_mem_Icc _ bound
    (finChildRepeatedReducedClippedTest_mem_Icc n test bound)

/-- Exact proxy of the crude constant-coordinate estimate. -/
theorem varianceProxy_const
    (N : Nat) (bound : NNReal) :
    varianceProxy (fun _ : Fin N ↦ bound) =
      (N : NNReal) * (bound / 2) ^ 2 := by
  simp [varianceProxy, Finset.sum_const, nsmul_eq_mul]

/-- For unit clipping, the actual proxy is `(n+2)/4`; it grows rather than
vanishes. -/
theorem varianceProxy_childRepeated_unit
    (n : Nat) :
    varianceProxy (fun _ : Fin (n + 2) ↦ (1 : NNReal)) =
      ((n + 2 : Nat) : NNReal) / 4 := by
  rw [varianceProxy_const]
  apply NNReal.eq
  simp
  ring

/-- The strongest unconditional McDiarmid certificate supplied merely by
clipping the actual child test to `[0,1]`.  Its parameter is `(n+2)/4`, so it
does not imply concentration as volume grows. -/
theorem finChildRepeatedReducedUnitClippedTest_hasSubgaussianMGF
    (n : Nat) (test : (Real × Real) →ᵇ NNReal) :
    HasSubgaussianMGF
      (fun x ↦ finChildRepeatedReducedClippedTest n test 1 x -
        ∫ y, finChildRepeatedReducedClippedTest n test 1 y
          ∂(Measure.pi fun _ : Fin (n + 2) ↦ massCoordinateLaw))
      (((n + 2 : Nat) : NNReal) / 4)
      (Measure.pi fun _ : Fin (n + 2) ↦ massCoordinateLaw) := by
  have h := hasSubgaussianMGF_finitePi_of_boundedDifferences
    massCoordinateLaw (n + 2)
    (finChildRepeatedReducedClippedTest n test 1)
    (fun _ : Fin (n + 2) ↦ (1 : NNReal))
    (measurable_finChildRepeatedReducedClippedTest n test 1)
    (finChildRepeatedReducedClippedTest_mem_Icc n test 1)
    (finChildRepeatedReducedClippedTest_hasBoundedDifferences n test 1)
  rw [varianceProxy_childRepeated_unit] at h
  exact h

/-- The missing model theorem is a sharper replacement of the crude bound:
changing one of `N` masses must alter the normalized weak test by at most
`K/N`.  Once supplied, the generic McDiarmid engine applies with that
coordinate scale. -/
theorem finChildRepeatedReducedClippedTest_hasSubgaussianMGF_of_inverseVolumeSensitivity
    (n : Nat) (test : (Real × Real) →ᵇ NNReal)
    (K : NNReal)
    (hsensitivity : HasFinBoundedDifferences
      (finChildRepeatedReducedClippedTest n test 1)
      (fun _ : Fin (n + 2) ↦ K / ((n + 2 : Nat) : NNReal))) :
    HasSubgaussianMGF
      (fun x ↦ finChildRepeatedReducedClippedTest n test 1 x -
        ∫ y, finChildRepeatedReducedClippedTest n test 1 y
          ∂(Measure.pi fun _ : Fin (n + 2) ↦ massCoordinateLaw))
      (varianceProxy
        (fun _ : Fin (n + 2) ↦ K / ((n + 2 : Nat) : NNReal)))
      (Measure.pi fun _ : Fin (n + 2) ↦ massCoordinateLaw) :=
  hasSubgaussianMGF_finitePi_of_boundedDifferences
    massCoordinateLaw (n + 2)
    (finChildRepeatedReducedClippedTest n test 1)
    (fun _ : Fin (n + 2) ↦ K / ((n + 2 : Nat) : NNReal))
    (measurable_finChildRepeatedReducedClippedTest n test 1)
    (finChildRepeatedReducedClippedTest_mem_Icc n test 1)
    hsensitivity

end

end ArchonPhysics.ChildRepeatedBoundedDifferenceAudit
