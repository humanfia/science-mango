import ArchonPhysics.ModeCoupling
import ArchonPhysics.NonresonantOscillatoryGain

/-!
# Phase mismatch for finite random-mass normal modes

Homogeneous wave-kinetic derivations label interactions by Fourier momentum.
A random mass profile destroys that translation-invariant label, but the
interaction-picture phase is still the signed sum of the participating normal
mode frequencies.  This module defines that model-faithful replacement for
interactions of arbitrary finite order.

Combining the exact interaction tensor from `ModeCoupling` with the generic
oscillatory integral estimate gives a deterministic inverse-phase-gap bound
for every fixed positive mass realization.  No probabilistic lower bound on
the phase gap, resonance counting theorem, or diagram summability is asserted.
-/

namespace ArchonPhysics.ModalPhaseMismatch

open ArchonPhysics
open HarmonicModes
open ModeCoupling
open NonresonantOscillatoryGain

noncomputable section

/-- Sign of one frequency in an interaction-picture phase. -/
inductive InteractionSign where
  | plus
  | minus
  deriving DecidableEq

/-- Real coefficient represented by an interaction sign. -/
def InteractionSign.coefficient : InteractionSign → Real
  | .plus => 1
  | .minus => -1

@[simp] theorem InteractionSign.coefficient_plus :
    InteractionSign.plus.coefficient = 1 := rfl

@[simp] theorem InteractionSign.coefficient_minus :
    InteractionSign.minus.coefficient = -1 := rfl

/-- Nonnegative frequency selected from the squared harmonic eigenvalue. -/
def modeFrequency {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (k : Lattice.Site N) : Real :=
  Real.sqrt (modeFrequencySq m k)

theorem modeFrequency_nonneg {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (k : Lattice.Site N) :
    0 ≤ modeFrequency m k :=
  Real.sqrt_nonneg _

theorem modeFrequency_sq {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (k : Lattice.Site N) :
    (modeFrequency m k) ^ 2 = modeFrequencySq m k := by
  exact Real.sq_sqrt (modeFrequencySq_nonneg m k)

/-- Signed frequency mismatch of an arbitrary finite modal interaction. -/
def phaseMismatch {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N) : Real :=
  ∑ r, (sign r).coefficient * modeFrequency m (modes r)

/-- Exact resonance is vanishing signed frequency mismatch. -/
def IsResonant {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N) : Prop :=
  phaseMismatch m sign modes = 0

/-- A nonresonant interaction has a nonzero signed frequency mismatch. -/
def IsNonresonant {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N) : Prop :=
  phaseMismatch m sign modes ≠ 0

/-- Time oscillation generated by a fixed modal phase mismatch. -/
def modalOscillatoryFactor {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N)
    (t : Real) : Complex :=
  oscillatoryIntegral (phaseMismatch m sign modes) t

/-- Every nonresonant modal interaction receives the model-independent gap gain. -/
theorem norm_modalOscillatoryFactor_le_min {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N)
    (t : Real) (h : IsNonresonant m sign modes) :
    ‖modalOscillatoryFactor m sign modes t‖ ≤
      min |t| (2 / |phaseMismatch m sign modes|) := by
  exact norm_oscillatoryIntegral_le_min h

/-- Interaction tensor multiplied by its time-oscillatory factor. -/
def weightedModalInteraction {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N)
    (t : Real) : Complex :=
  interactionTensor m n modes * modalOscillatoryFactor m sign modes t

/-- Deterministic fixed-realization bound for a nonresonant weighted interaction. -/
theorem norm_weightedModalInteraction_le {N n : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N)
    (sign : Fin n → InteractionSign) (modes : Fin n → Lattice.Site N)
    (t : Real) (h : IsNonresonant m sign modes) :
    ‖weightedModalInteraction m sign modes t‖ ≤
      |interactionTensor m n modes| *
        min |t| (2 / |phaseMismatch m sign modes|) := by
  rw [weightedModalInteraction, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_left
    (norm_modalOscillatoryFactor_le_min m sign modes t h)
    (abs_nonneg (interactionTensor m n modes))

end

end ArchonPhysics.ModalPhaseMismatch
