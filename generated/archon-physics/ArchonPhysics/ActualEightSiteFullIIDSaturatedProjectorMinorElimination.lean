import ArchonPhysics.ActualEightSiteFullIIDIrregularMassPolynomialReduction
import ArchonPhysics.ActualProjectorAdjugateSaturatedSpectralSystem

/-!
# Saturated elimination target for the actual full-eight projector minor

The unsaturated adjugate/characteristic system has a diagonal spectral
solution for every mass vector, so eliminating its three spectral variables
cannot produce a useful nonzero mass-only certificate.  This file records
that obstruction and gives the exact constructive replacement: a checked
Bezout identity in the Vandermonde-saturated five-equation system.

Such an identity, together with a nonzero mass polynomial, produces the
`FullEightSelectedProjectorMinorPolynomialCertificate` used by the iid
small-ball chain.  No existence of that identity or nonzero polynomial is
assumed or asserted here.  Thus the remaining computer-algebra obligation is
exposed as one finite polynomial identity plus one nonzero check.
-/

open scoped BigOperators Matrix

namespace ArchonPhysics.ActualEightSiteFullIIDSaturatedProjectorMinorElimination

open ArchonPhysics
open ArchonPhysics.ActualEightSiteExactAllDistinctLinearSmallBall
open ArchonPhysics.ActualEightSiteExactDecayIVTBridge
open ArchonPhysics.ActualEightSiteFullIIDPositiveWeightedNearResonancePatch
open ArchonPhysics.ActualEightSiteFullIIDGoodLevelLimitAudit
open ArchonPhysics.ActualEightSiteFullIIDIrregularMassPolynomialReduction
open ArchonPhysics.ActualProjectorAdjugatePolynomial
open ArchonPhysics.ActualProjectorAdjugateSaturatedSpectralSystem
open ArchonPhysics.ActualProjectorAdjugateSpectralSystem
open ArchonPhysics.ActualThreeMassLiftedSpectralChart
open ArchonPhysics.ActualThreeMassProjectorWeightJacobian
open ArchonPhysics.GenericSpectrumResultant
open ArchonPhysics.OrderedSingleModeProjector
open ArchonPhysics.RandomMassResultantBridge
open ArchonPhysics.ThreeParameterSpectralAveragingDensity
open ArchonPhysics.UniformRandomMassHarmonicSpectrumComparison
open Set

noncomputable section

/-- The inclusion of the eight inverse-mass variables into the saturated
mass/spectral/Rabinowitsch variable space. -/
def fullEightSaturatedMassInclusion (i : Fin 8) :
    SaturatedAdjugateSpectralVariable 8 :=
  some (Sum.inl i)

/-- The corresponding inclusion into the unsaturated mass/spectral space. -/
def fullEightUnsaturatedMassInclusion (i : Fin 8) :
    AdjugateSpectralVariable 8 :=
  Sum.inl i

/-- The actual five-polynomial Vandermonde-saturated system for sites
`(2,5,7)`. -/
def fullEightSaturatedProjectorSystem :
    Fin 5 -> MvPolynomial (SaturatedAdjugateSpectralVariable 8) Real :=
  actualThreeMassSaturatedAdjugateSpectralSystem
    (actualEightSiteSelectedSites 0)
    (actualEightSiteSelectedSites 1)
    (actualEightSiteSelectedSites 2)

/-- The actual unsaturated four-polynomial system. -/
def fullEightUnsaturatedProjectorSystem :
    Fin 4 -> MvPolynomial (AdjugateSpectralVariable 8) Real :=
  actualThreeMassAdjugateSpectralSystem
    (actualEightSiteSelectedSites 0)
    (actualEightSiteSelectedSites 1)
    (actualEightSiteSelectedSites 2)

/-- A fully checkable output format for resultant/Groebner elimination.

The identity says that the renamed mass polynomial belongs to the ideal
generated by the saturated adjugate numerator, the three characteristic
equations, and the Vandermonde Rabinowitsch equation.  The two nontrivial
computational tasks are deliberately visible: supplying the five multipliers
and proving that the resulting mass polynomial is nonzero. -/
structure FullEightSaturatedProjectorEliminationCertificate where
  polynomial : MvPolynomial (Fin 8) Real
  polynomial_ne_zero : polynomial ≠ 0
  multiplier : Fin 5 ->
    MvPolynomial (SaturatedAdjugateSpectralVariable 8) Real
  bezoutIdentity :
    MvPolynomial.rename fullEightSaturatedMassInclusion polynomial =
      ∑ q : Fin 5, multiplier q * fullEightSaturatedProjectorSystem q

/-- A single exact specialization is enough to discharge the nonzero part of
the saturated elimination certificate.  In particular, an explicit rational
inverse-mass vector may be cast to `Real` and checked by normalization. -/
def FullEightSaturatedProjectorEliminationCertificate.ofSpecialization
    (polynomial : MvPolynomial (Fin 8) Real)
    (multiplier : Fin 5 ->
      MvPolynomial (SaturatedAdjugateSpectralVariable 8) Real)
    (bezoutIdentity :
      MvPolynomial.rename fullEightSaturatedMassInclusion polynomial =
        ∑ q : Fin 5, multiplier q * fullEightSaturatedProjectorSystem q)
    (inverseMassWitness : Fin 8 -> Real)
    (hWitness : MvPolynomial.eval inverseMassWitness polynomial ≠ 0) :
    FullEightSaturatedProjectorEliminationCertificate where
  polynomial := polynomial
  polynomial_ne_zero := by
    intro hzero
    simp [hzero] at hWitness
  multiplier := multiplier
  bezoutIdentity := bezoutIdentity

/-- The algebraic vanishing implication before any spectral branch is
selected: every common zero of the saturated system projects to a zero of
the mass polynomial. -/
theorem saturatedEliminationPolynomial_eval_eq_zero_of_systemSolution
    (certificate : FullEightSaturatedProjectorEliminationCertificate)
    (point : SaturatedAdjugateSpectralVariable 8 -> Real)
    (hsystem : ∀ q : Fin 5,
      MvPolynomial.eval point (fullEightSaturatedProjectorSystem q) = 0) :
    MvPolynomial.eval (point ∘ fullEightSaturatedMassInclusion)
      certificate.polynomial = 0 := by
  calc
    MvPolynomial.eval (point ∘ fullEightSaturatedMassInclusion)
        certificate.polynomial =
      MvPolynomial.eval point
        (MvPolynomial.rename fullEightSaturatedMassInclusion
          certificate.polynomial) := by
        rw [MvPolynomial.eval_rename]
    _ = MvPolynomial.eval point
        (∑ q : Fin 5,
          certificate.multiplier q * fullEightSaturatedProjectorSystem q) := by
      rw [certificate.bezoutIdentity]
    _ = 0 := by
      simp [hsystem]

/-- A nonzero specialization of the eliminant excludes every saturated
spectral branch over that inverse-mass vector, not merely the selected
ordered branch. -/
theorem no_saturatedSystemSolution_of_eliminant_eval_ne_zero
    (certificate : FullEightSaturatedProjectorEliminationCertificate)
    (point : SaturatedAdjugateSpectralVariable 8 -> Real)
    (hne : MvPolynomial.eval (point ∘ fullEightSaturatedMassInclusion)
      certificate.polynomial ≠ 0) :
    ¬ ∀ q : Fin 5,
      MvPolynomial.eval point (fullEightSaturatedProjectorSystem q) = 0 := by
  intro hsystem
  exact hne
    (saturatedEliminationPolynomial_eval_eq_zero_of_systemSolution
      certificate point hsystem)

/-- On the physical support, the actual saturated spectral point restricts
to the raw coordinatewise inverse masses. -/
theorem actualSaturatedSpectralPoint_comp_massInclusion
    {x : EightMassVector} (hx : x ∈ fullEightMassSupportInterior) :
    (actualThreeMassSaturatedAdjugateSpectralPoint
      (fullEightMassConfig x)
      (actualEightSiteSelectedSites 0)
      (actualEightSiteSelectedSites 1)
      (actualEightSiteSelectedSites 2)
      actualEightSiteDecayModes
      (actualEightSiteSelectedMassTriple x)) ∘
        fullEightSaturatedMassInclusion = coordinatewiseInv x := by
  funext i
  change inverseMassCoordinates
      (threeMassSiteConfig (fullEightMassConfig x)
        (actualEightSiteSelectedSites 0)
        (actualEightSiteSelectedSites 1)
        (actualEightSiteSelectedSites 2)
        (actualEightSiteSelectedMassTriple x)) i = (x i)⁻¹
  rw [threeMassSiteConfig_actualEightSiteSelectedMassTriple hx]
  exact congrFun
    (inverseMassCoordinates_fullEightMassConfig
      (fun i => ⟨(hx i).1.le, (hx i).2.le⟩)) i

/-- Simple spectrum transfers from the site-space harmonic matrix to the
actual three-mass edge-space dual matrix at the reconstructed mass triple. -/
theorem actualThreeMassDual_simple_of_fullEight_simple
    {x : EightMassVector} (hx : x ∈ fullEightMassSupportInterior)
    (hsimple : SimpleOrderedSpectrum (fullEightHarmonic x)) :
    SimpleOrderedSpectrum
      (actualThreeMassDualHermitian (fullEightMassConfig x)
        (actualEightSiteSelectedSites 0)
        (actualEightSiteSelectedSites 1)
        (actualEightSiteSelectedSites 2)
        (actualEightSiteSelectedMassTriple x)) := by
  intro i j hij
  apply hsimple
  simp only [actualThreeMassDualHermitian] at hij
  rw [threeMassSiteConfig_actualEightSiteSelectedMassTriple hx] at hij
  simpa only [fullEightHarmonic,
    orderedEigenvalue_harmonic_eq_dual] using hij

/-- A saturated Bezout certificate gives the exact mass-polynomial
vanishing implication required by the full-eight iid regularity reduction. -/
theorem saturatedElimination_vanishes_of_projectorMinor_eq_zero
    (certificate : FullEightSaturatedProjectorEliminationCertificate)
    (x : EightMassVector) (hx : x ∈ fullEightMassSupportInterior)
    (hsimple : SimpleOrderedSpectrum (fullEightHarmonic x))
    (hminor : actualEightSiteSelectedProjectorMinor x = 0) :
    MvPolynomial.eval (coordinatewiseInv x) certificate.polynomial = 0 := by
  let point : SaturatedAdjugateSpectralVariable 8 -> Real :=
    actualThreeMassSaturatedAdjugateSpectralPoint
      (fullEightMassConfig x)
      (actualEightSiteSelectedSites 0)
      (actualEightSiteSelectedSites 1)
      (actualEightSiteSelectedSites 2)
      actualEightSiteDecayModes
      (actualEightSiteSelectedMassTriple x)
  have hsimpleDual := actualThreeMassDual_simple_of_fullEight_simple hx hsimple
  have hminorThree :
      (actualThreeMassProjectorWeightMatrix (fullEightMassConfig x)
        (actualEightSiteSelectedSites 0)
        (actualEightSiteSelectedSites 1)
        (actualEightSiteSelectedSites 2)
        actualEightSiteDecayModes
        (actualEightSiteSelectedMassTriple x)).det = 0 := by
    rw [actualThreeMassProjectorWeightMatrix_selected_eq hx]
    exact hminor
  have hsystem : ∀ q : Fin 5,
      MvPolynomial.eval point (fullEightSaturatedProjectorSystem q) = 0 := by
    simpa only [point, fullEightSaturatedProjectorSystem] using
      (actualThreeMassProjectorMinor_eq_zero_iff_saturatedSpectralSystem
        (fullEightMassConfig x)
        (actualEightSiteSelectedSites 0)
        (actualEightSiteSelectedSites 1)
        (actualEightSiteSelectedSites 2)
        actualEightSiteDecayModes
        (actualEightSiteSelectedMassTriple x)
        hsimpleDual actualEightSiteDecayModes_injective).mp hminorThree
  calc
    MvPolynomial.eval (coordinatewiseInv x) certificate.polynomial =
        MvPolynomial.eval point
          (MvPolynomial.rename fullEightSaturatedMassInclusion
            certificate.polynomial) := by
      rw [MvPolynomial.eval_rename,
        actualSaturatedSpectralPoint_comp_massInclusion hx]
    _ = MvPolynomial.eval point
        (∑ q : Fin 5,
          certificate.multiplier q * fullEightSaturatedProjectorSystem q) := by
      rw [certificate.bezoutIdentity]
    _ = 0 := by
      simp [hsystem]

/-- The checked saturated elimination output constructs the precise
polynomial certificate consumed by the existing iid null-set theorem. -/
def FullEightSaturatedProjectorEliminationCertificate.toPolynomialCertificate
    (certificate : FullEightSaturatedProjectorEliminationCertificate) :
    FullEightSelectedProjectorMinorPolynomialCertificate where
  polynomial := certificate.polynomial
  polynomial_ne_zero := certificate.polynomial_ne_zero
  vanishes_of_projectorMinor_eq_zero :=
    saturatedElimination_vanishes_of_projectorMinor_eq_zero certificate

/-- End-to-end consequence: the checked saturated identity removes the exact
irregular mass in the actual eightfold iid model. -/
theorem fullEightSelectedJacobianIrregularMass_eq_zero_of_saturatedElimination
    (certificate : FullEightSaturatedProjectorEliminationCertificate) :
    fullEightSelectedJacobianIrregularMass = 0 :=
  fullEightSelectedJacobianIrregularMass_eq_zero_of_polynomialCertificate
    certificate.toPolynomialCertificate

/-- An unsaturated ideal-combination candidate.  Unlike the saturated
certificate, this structure intentionally carries no nonzero field: the
following theorem proves that it evaluates to zero at every physical
full-eight mass point. -/
structure FullEightUnsaturatedProjectorIdealCombination where
  polynomial : MvPolynomial (Fin 8) Real
  multiplier : Fin 4 -> MvPolynomial (AdjugateSpectralVariable 8) Real
  idealIdentity :
    MvPolynomial.rename fullEightUnsaturatedMassInclusion polynomial =
      ∑ q : Fin 4, multiplier q * fullEightUnsaturatedProjectorSystem q

/-- The unsaturated system's diagonal spectral branch forces every mass-only
ideal consequence to vanish throughout the physical support.  This is the
formal reason a direct unsaturated iterated resultant cannot certify the
desired nonzero mass polynomial. -/
theorem unsaturatedIdealCombination_eval_eq_zero_on_physicalSupport
    (candidate : FullEightUnsaturatedProjectorIdealCombination)
    (x : EightMassVector) (hx : x ∈ fullEightMassSupportInterior) :
    MvPolynomial.eval (coordinatewiseInv x) candidate.polynomial = 0 := by
  let point : AdjugateSpectralVariable 8 -> Real :=
    actualThreeMassAdjugateSpectralPoint
      (fullEightMassConfig x)
      (actualEightSiteSelectedSites 0)
      (actualEightSiteSelectedSites 1)
      (actualEightSiteSelectedSites 2)
      (fun _ => (0 : Fin 8))
      (actualEightSiteSelectedMassTriple x)
  have hsystem : ∀ q : Fin 4,
      MvPolynomial.eval point (fullEightUnsaturatedProjectorSystem q) = 0 := by
    simpa only [point, fullEightUnsaturatedProjectorSystem] using
      actualThreeMassAdjugateSpectralSystem_has_diagonalSolution
        (fullEightMassConfig x)
        (actualEightSiteSelectedSites 0)
        (actualEightSiteSelectedSites 1)
        (actualEightSiteSelectedSites 2)
        (actualEightSiteSelectedMassTriple x) (0 : Fin 8)
  have hpoint : point ∘ fullEightUnsaturatedMassInclusion =
      coordinatewiseInv x := by
    funext i
    change inverseMassCoordinates
        (threeMassSiteConfig (fullEightMassConfig x)
          (actualEightSiteSelectedSites 0)
          (actualEightSiteSelectedSites 1)
          (actualEightSiteSelectedSites 2)
          (actualEightSiteSelectedMassTriple x)) i = (x i)⁻¹
    rw [threeMassSiteConfig_actualEightSiteSelectedMassTriple hx]
    exact congrFun
      (inverseMassCoordinates_fullEightMassConfig
        (fun i => ⟨(hx i).1.le, (hx i).2.le⟩)) i
  calc
    MvPolynomial.eval (coordinatewiseInv x) candidate.polynomial =
        MvPolynomial.eval point
          (MvPolynomial.rename fullEightUnsaturatedMassInclusion
            candidate.polynomial) := by
      rw [MvPolynomial.eval_rename, hpoint]
    _ = MvPolynomial.eval point
        (∑ q : Fin 4,
          candidate.multiplier q * fullEightUnsaturatedProjectorSystem q) := by
      rw [candidate.idealIdentity]
    _ = 0 := by
      simp [hsystem]

/-- Consequently, an unsaturated ideal combination cannot have a certified
nonzero evaluation at any physical mass point. -/
theorem no_unsaturatedIdealCombination_with_physical_nonzero_witness :
    ¬ ∃ candidate : FullEightUnsaturatedProjectorIdealCombination,
      ∃ x : EightMassVector, x ∈ fullEightMassSupportInterior ∧
        MvPolynomial.eval (coordinatewiseInv x) candidate.polynomial ≠ 0 := by
  rintro ⟨candidate, x, hx, hne⟩
  exact hne
    (unsaturatedIdealCombination_eval_eq_zero_on_physicalSupport
      candidate x hx)

end

end ArchonPhysics.ActualEightSiteFullIIDSaturatedProjectorMinorElimination
