import ArchonPhysics.LennardJonesModalRemainderKineticBound

/-!
# Interaction-picture kinetic-time bound for the higher LJ remainder

The finite-mode real force estimate is lifted through the exact
positive-frequency complex-source convention.  Hence the higher LJ force
beyond the local FPUT alpha-beta jet contributes `O(g)` to the selected
interaction-picture Duhamel integral on `0 <= t <= L/g^2`.

The coefficient remains finite-volume and frequency dependent.  No
uniform-in-volume estimate, tube persistence, random-phase propagation, or
kinetic limit is asserted.
-/

namespace ArchonPhysics.LennardJonesRotatedModalRemainderKineticBound

open Set
open ArchonPhysics
open ArchonPhysics.CoerciveHamiltonianPhyslib
open ArchonPhysics.ForcedComplexModeDuhamel
open ArchonPhysics.LennardJonesKineticTimeForceRemainder
open ArchonPhysics.LennardJonesModalRemainderKineticBound
open ArchonPhysics.PhaseRenormalization

noncomputable section

/-- Interaction-picture source generated by the normalized higher LJ modal
force. -/
def rotatedNormalizedHigherResidualSource {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (k : Lattice.Site N)
    (omega depth r₀ g : Real) (q : Real → HilbertConfiguration N) :
    Real → Complex :=
  fun t => phaseFactor (omega * t) *
    forcedModeSource omega
      (normalizedHigherResidualModalForce m depth r₀ g (q t) k)

/-- Exact norm of the complex amplitude source generated by a real force. -/
theorem norm_forcedModeSource
    {omega : Real} (_homega : 0 < omega) (force : Real) :
    ‖forcedModeSource omega force‖ =
      |force| / Real.sqrt (2 * omega) := by
  have hsqrt : 0 ≤ Real.sqrt (2 * omega) := Real.sqrt_nonneg _
  simp only [forcedModeSource, norm_div, norm_mul, Complex.norm_I,
    Complex.norm_real, Real.norm_eq_abs, one_mul, abs_of_nonneg hsqrt]

/-- Coupling-independent coefficient for the interaction-picture remainder. -/
def rotatedModalHigherRemainderCoefficient {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (k : Lattice.Site N)
    (omega r₀ rho amplitudeBound : Real) : Real :=
  modalHigherRemainderCoefficient m k r₀ rho amplitudeBound /
    Real.sqrt (2 * omega)

/-- The interaction-picture higher LJ remainder contributes only `O(g)` over
the kinetic window at fixed finite volume and positive mode frequency. -/
theorem intervalIntegrable_and_norm_integral_rotatedModalRemainder_le_kinetic
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (k : Lattice.Site N)
    {omega depth r₀ g rho L amplitudeBound : Real}
    (homega : 0 < omega)
    (hdepth : 0 < depth) (hr₀ : 0 < r₀) (hg : 0 < g)
    (hrho0 : 0 ≤ rho) (hrho1 : rho < 1)
    (hL : 0 ≤ L) (hAmplitude : 0 ≤ amplitudeBound)
    (q : Real → HilbertConfiguration N)
    (hIntegrable : IntervalIntegrable
      (rotatedNormalizedHigherResidualSource
        m k omega depth r₀ g q)
      MeasureTheory.volume 0 (kineticWindowTime g L))
    (htube : ∀ t ∈ Icc 0 (kineticWindowTime g L),
      ∀ i : Lattice.Site N,
        |g * Lattice.forwardDifference (asConfiguration (q t)) i| ≤ rho * r₀)
    (hamplitude : ∀ t ∈ Icc 0 (kineticWindowTime g L),
      ∀ i : Lattice.Site N,
        |Lattice.forwardDifference (asConfiguration (q t)) i| ≤ amplitudeBound) :
    IntervalIntegrable
        (rotatedNormalizedHigherResidualSource
          m k omega depth r₀ g q)
        MeasureTheory.volume 0 (kineticWindowTime g L) ∧
      ‖∫ t in 0..kineticWindowTime g L,
          rotatedNormalizedHigherResidualSource
            m k omega depth r₀ g q t‖ ≤
        rotatedModalHigherRemainderCoefficient
          m k omega r₀ rho amplitudeBound * L * g := by
  refine ⟨hIntegrable, ?_⟩
  have htime : 0 ≤ kineticWindowTime g L := by
    unfold kineticWindowTime
    exact div_nonneg hL (sq_nonneg g)
  have hsqrt : 0 < Real.sqrt (2 * omega) :=
    Real.sqrt_pos.2 (mul_pos (by norm_num) homega)
  calc
    ‖∫ t in 0..kineticWindowTime g L,
        rotatedNormalizedHigherResidualSource
          m k omega depth r₀ g q t‖ ≤
      (modalHigherRemainderCoefficient m k r₀ rho amplitudeBound * g ^ 3 /
          Real.sqrt (2 * omega)) *
        |kineticWindowTime g L - 0| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro t ht
      have htIcc : t ∈ Icc 0 (kineticWindowTime g L) := by
        simpa only [uIcc_of_le htime] using Set.uIoc_subset_uIcc ht
      have hforce :=
        abs_normalizedHigherResidualModalForce_le_g_cubed
          m k hdepth hr₀ hg hrho0 hrho1 hAmplitude (q t)
            (htube t htIcc) (hamplitude t htIcc)
      unfold rotatedNormalizedHigherResidualSource
      rw [norm_mul, norm_phaseFactor, one_mul,
        norm_forcedModeSource homega]
      exact (div_le_div_iff_of_pos_right hsqrt).2 hforce
    _ = rotatedModalHigherRemainderCoefficient
          m k omega r₀ rho amplitudeBound * L * g := by
      rw [sub_zero, abs_of_nonneg htime]
      unfold kineticWindowTime rotatedModalHigherRemainderCoefficient
      field_simp [ne_of_gt hg, ne_of_gt hsqrt]

end

end ArchonPhysics.LennardJonesRotatedModalRemainderKineticBound
