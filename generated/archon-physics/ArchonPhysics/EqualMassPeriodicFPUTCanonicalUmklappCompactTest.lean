import ArchonPhysics.EqualMassPeriodicFPUTCanonicalPositiveRootBrillouin

/-!
# Compactly supported tests for the canonical Umklapp chart

This module reduces the measure input of the canonical collision chart to a
continuous density whose support lies in the explicit mismatch image.  Its
Lebesgue integrability and the physical mark factorization are then derived.
An explicit continuous tent density provides a completely constructed test.

No kinetic equation or statistical closure is assumed.
-/

namespace ArchonPhysics.EqualMassPeriodicFPUTCanonicalUmklappCompactTest

open Set
open ArchonPhysics.EqualMassPeriodicFPUTCanonicalPositiveRootBrillouin
open ArchonPhysics.EqualMassPeriodicFPUTContinuumFourWaveGeometry
open ArchonPhysics.EqualMassPeriodicFPUTUmklappCollisionChartAdapter
open ArchonPhysics.EqualMassPeriodicFPUTUmklappCollisionDensity
open ArchonPhysics.EqualMassPeriodicFPUTUmklappFiniteAtlas
open ArchonPhysics.EqualMassPeriodicFPUTUmklappOnShellJacobian
open ArchonPhysics.EqualMassPeriodicFPUTUmklappTransversality
open ArchonPhysics.NormalizedResonancePeakKernel
open Filter MeasureTheory Topology

noncomputable section

/-- A continuous compactly supported tent on the open interval `(left,right)`.
It is deliberately unnormalized; collision normalization is supplied by the
resonance kernel. -/
def compactIntervalTentDensity (left right x : Real) : Real :=
  max 0 ((x - left) * (right - x))

theorem continuous_compactIntervalTentDensity (left right : Real) :
    Continuous (compactIntervalTentDensity left right) := by
  unfold compactIntervalTentDensity
  fun_prop

theorem support_compactIntervalTentDensity_subset_Ioc
    {left right : Real} (hleftRight : left < right) :
    Function.support (compactIntervalTentDensity left right) ⊆
      Ioc left right := by
  intro x hx
  have hproduct : 0 < (x - left) * (right - x) := by
    by_contra hnot
    have hnonpositive : (x - left) * (right - x) ≤ 0 :=
      le_of_not_gt hnot
    apply hx
    unfold compactIntervalTentDensity
    exact max_eq_left hnonpositive
  rcases (mul_pos_iff.mp hproduct) with hpositive | hnegative
  · exact ⟨by linarith [hpositive.1], by linarith [hpositive.2]⟩
  · exfalso
    linarith [hnegative.1, hnegative.2, hleftRight]

/-- Minimal test-density input.  Integrability is omitted because continuity
plus the displayed finite support condition implies Lebesgue integrability. -/
structure UmklappCompactTestDensityData
    (rootBranch : UmklappArcsineBranch) (k₀ k₁ : Real)
    (density : Real → Real) : Prop where
  density_continuous : Continuous density
  density_support : Function.support density ⊆
    Ioc
      (umklappReducedFourWaveMismatch k₀ k₁
        (umklappArcsineLocalLeft rootBranch k₀ k₁))
      (umklappReducedFourWaveMismatch k₀ k₁
        (umklappArcsineLocalRight rootBranch k₀ k₁))

/-- The physical mark induced by a mismatch-space density and the actual
FPUT transverse Jacobian. -/
def umklappDensityInducedMark
    (k₀ k₁ : Real) (density : Real → Real) (z : Real) : Real :=
  density (umklappReducedFourWaveMismatch k₀ k₁ z) *
    umklappK₂DerivativeFactor k₀ k₁ z

theorem UmklappCompactTestDensityData.hasCompactSupport
    {rootBranch : UmklappArcsineBranch} {k₀ k₁ : Real}
    {density : Real → Real}
    (data : UmklappCompactTestDensityData rootBranch k₀ k₁ density) :
    HasCompactSupport density := by
  apply HasCompactSupport.of_support_subset_isCompact isCompact_Icc
  exact data.density_support.trans Ioc_subset_Icc_self

/-- Continuous compact support supplies integrability against Lebesgue
measure; it is not an additional chart hypothesis. -/
theorem UmklappCompactTestDensityData.integrable_volume
    {rootBranch : UmklappArcsineBranch} {k₀ k₁ : Real}
    {density : Real → Real}
    (data : UmklappCompactTestDensityData rootBranch k₀ k₁ density) :
    Integrable density (volume : Measure Real) :=
  data.density_continuous.integrable_of_hasCompactSupport
    data.hasCompactSupport

/-- Adapter to the earlier measure-data API.  Both integrability and mark
factorization are generated by the compact test-density construction. -/
theorem UmklappCompactTestDensityData.toCollisionMeasureData
    {rootBranch : UmklappArcsineBranch} {k₀ k₁ : Real}
    {density : Real → Real}
    (data : UmklappCompactTestDensityData rootBranch k₀ k₁ density) :
    UmklappArcsineCollisionMeasureData rootBranch k₀ k₁
      (umklappDensityInducedMark k₀ k₁ density) density where
  density_continuous := data.density_continuous
  density_integrable := data.integrable_volume
  density_support := data.density_support
  mark_factorization := by
    intro z _hz
    rfl

/-- Canonical chart geometry with the root-range conditions discharged by
the principal-zone theorem. -/
theorem canonicalPositiveGeometry_principalZone
    {k₀ k₁ : Real}
    (hk₀0 : 0 < k₀) (hk₀2pi : k₀ < 2 * Real.pi)
    (hk₁0 : 0 < k₁) (hk₁2pi : k₁ < 2 * Real.pi)
    (hdisc : 0 < umklappTransverseDiscriminant k₀ k₁) :
    ExplicitPositiveUmklappArcsineGeometry
      (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁ :=
  explicitCanonicalPositiveUmklappArcsineGeometry
    hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc
      (canonicalPositiveArcsineRoot_pos
        hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc)
      (canonicalPositiveArcsineRoot_lt_two_pi
        hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc)

/-- The mismatch image of the canonical local interval strictly straddles
zero. -/
theorem canonicalPositiveMismatchImage_straddles_zero
    {k₀ k₁ : Real}
    (hk₀0 : 0 < k₀) (hk₀2pi : k₀ < 2 * Real.pi)
    (hk₁0 : 0 < k₁) (hk₁2pi : k₁ < 2 * Real.pi)
    (hdisc : 0 < umklappTransverseDiscriminant k₀ k₁) :
    umklappReducedFourWaveMismatch k₀ k₁
        (umklappArcsineLocalLeft
          (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁) < 0 ∧
      0 < umklappReducedFourWaveMismatch k₀ k₁
        (umklappArcsineLocalRight
          (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁) := by
  let geometry := canonicalPositiveGeometry_principalZone
    hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc
  constructor
  · rw [← geometry.root_resonant]
    exact geometry.mismatch_strictMono
      ⟨le_rfl, geometry.interval_lt.le⟩
      ⟨geometry.root_mem.1.le, geometry.root_mem.2.le⟩
      geometry.root_mem.1
  · rw [← geometry.root_resonant]
    exact geometry.mismatch_strictMono
      ⟨geometry.root_mem.1.le, geometry.root_mem.2.le⟩
      ⟨geometry.interval_lt.le, le_rfl⟩
      geometry.root_mem.2

/-- Collision limit for every continuous density supported in the explicit
mismatch image.  The endpoint is the Lebesgue density value at resonance;
integrability, factorization, geometry, and root range are all generated. -/
theorem tendsto_canonicalPositiveUmklappCompactTest
    {k₀ k₁ : Real} {density : Real → Real}
    (hk₀0 : 0 < k₀) (hk₀2pi : k₀ < 2 * Real.pi)
    (hk₁0 : 0 < k₁) (hk₁2pi : k₁ < 2 * Real.pi)
    (hdisc : 0 < umklappTransverseDiscriminant k₀ k₁)
    (data : UmklappCompactTestDensityData
      (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁ density) :
    Tendsto
      (fun T : Real ↦ ∫ z in
        umklappArcsineLocalLeft
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁..
          umklappArcsineLocalRight
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁,
        normalizedFiniteTimeResonanceKernel
            (umklappReducedFourWaveMismatch k₀ k₁ z) T *
          umklappDensityInducedMark k₀ k₁ density z)
      atTop (nhds (density 0)) := by
  have hlimit :=
    tendsto_canonicalPositiveUmklappCollisionChart_principalZone
      hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc data.toCollisionMeasureData
  let geometry := canonicalPositiveGeometry_principalZone
    hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc
  let chart := data.toCollisionMeasureData.toPositiveUmklappCollisionChart
    geometry
  have hrootIcc :
      umklappArcsineRoot
          (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁ ∈
        uIcc
          (umklappArcsineLocalLeft
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁)
          (umklappArcsineLocalRight
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁) := by
    rw [uIcc_of_le geometry.interval_lt.le]
    exact ⟨geometry.root_mem.1.le, geometry.root_mem.2.le⟩
  have hvalue := density_zero_eq_mark_div_exactJacobian
    chart hrootIcc hdisc geometry.root_resonant
  rw [← hvalue] at hlimit
  exact hlimit

/-- Explicit mismatch-space tent density for the canonical chart. -/
def canonicalPositiveUmklappTentDensity (k₀ k₁ x : Real) : Real :=
  compactIntervalTentDensity
    (umklappReducedFourWaveMismatch k₀ k₁
      (umklappArcsineLocalLeft
        (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁))
    (umklappReducedFourWaveMismatch k₀ k₁
      (umklappArcsineLocalRight
        (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁)) x

/-- Physical mark induced by the explicit tent density. -/
def canonicalPositiveUmklappTentMark (k₀ k₁ z : Real) : Real :=
  umklappDensityInducedMark k₀ k₁
    (canonicalPositiveUmklappTentDensity k₀ k₁) z

theorem canonicalPositiveUmklappTentDensity_data
    {k₀ k₁ : Real}
    (hk₀0 : 0 < k₀) (hk₀2pi : k₀ < 2 * Real.pi)
    (hk₁0 : 0 < k₁) (hk₁2pi : k₁ < 2 * Real.pi)
    (hdisc : 0 < umklappTransverseDiscriminant k₀ k₁) :
    UmklappCompactTestDensityData
      (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁
      (canonicalPositiveUmklappTentDensity k₀ k₁) := by
  have hstraddle := canonicalPositiveMismatchImage_straddles_zero
    hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc
  constructor
  · exact continuous_compactIntervalTentDensity _ _
  · exact support_compactIntervalTentDensity_subset_Ioc
      (hstraddle.1.trans hstraddle.2)

/-- A fully concrete compact-test endpoint: no density, integrability,
support, factorization, or root-range certificates are supplied by the user. -/
theorem tendsto_canonicalPositiveUmklappTentCollision
    {k₀ k₁ : Real}
    (hk₀0 : 0 < k₀) (hk₀2pi : k₀ < 2 * Real.pi)
    (hk₁0 : 0 < k₁) (hk₁2pi : k₁ < 2 * Real.pi)
    (hdisc : 0 < umklappTransverseDiscriminant k₀ k₁) :
    Tendsto
      (fun T : Real ↦ ∫ z in
        umklappArcsineLocalLeft
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁..
          umklappArcsineLocalRight
            (umklappPositiveArcsineBranch k₀ k₁) k₀ k₁,
        normalizedFiniteTimeResonanceKernel
            (umklappReducedFourWaveMismatch k₀ k₁ z) T *
          canonicalPositiveUmklappTentMark k₀ k₁ z)
      atTop (nhds (canonicalPositiveUmklappTentDensity k₀ k₁ 0)) := by
  exact tendsto_canonicalPositiveUmklappCompactTest
    hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc
      (canonicalPositiveUmklappTentDensity_data
        hk₀0 hk₀2pi hk₁0 hk₁2pi hdisc)

end

end ArchonPhysics.EqualMassPeriodicFPUTCanonicalUmklappCompactTest
