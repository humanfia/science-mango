import ArchonPhysics.NonresonantOscillatoryGain

/-!
# Nested finite-time oscillatory integrals

Second-Picard character expansions contain a triangular time integral: an
outer oscillatory phase multiplies an inner first-Picard oscillatory
integral.  This module packages that coefficient with the same positive
phase convention as `NonresonantOscillatoryGain.oscillatoryIntegral`:

`exp (i * DeltaOut * s) * integral_0^s exp (i * DeltaIn * u) du`.

All identities are exact on a finite oriented interval.  Resonant cases are
kept in division-free forms, and the nonzero-inner-mismatch formula is only
used under an explicit hypothesis.  No kinetic limit, random-phase closure,
collision operator, or Fermi-golden-rule conclusion is asserted.
-/

namespace ArchonPhysics.NestedOscillatoryIntegral

open MeasureTheory
open ArchonPhysics.NonresonantOscillatoryGain
open scoped Interval

noncomputable section

/-- The triangular coefficient generated by one inner and one outer
oscillatory mismatch. -/
def nestedOscillatoryIntegral
    (deltaOut deltaIn time : Real) : Complex :=
  ∫ s in (0 : Real)..time,
    Complex.exp ((Complex.I * deltaOut) * s) *
      oscillatoryIntegral deltaIn s

/-- Two real-frequency complex phases combine by addition of their
mismatches. -/
theorem exp_phase_mul_exp_phase
    (deltaOut deltaIn time : Real) :
    Complex.exp ((Complex.I * deltaOut) * time) *
        Complex.exp ((Complex.I * deltaIn) * time) =
      Complex.exp ((Complex.I * (deltaOut + deltaIn)) * time) := by
  rw [← Complex.exp_add]
  congr 1
  ring_nf

/-- The one-step oscillatory integral is continuous in its upper endpoint. -/
theorem continuous_oscillatoryIntegral_time (delta : Real) :
    Continuous (oscillatoryIntegral delta) := by
  unfold oscillatoryIntegral
  apply intervalIntegral.continuous_primitive
  intro a b
  exact (by fun_prop : Continuous (fun s : Real ↦
    Complex.exp ((Complex.I * delta) * s))).intervalIntegrable
      (μ := volume) a b

/-- The nested-integral time integrand is continuous. -/
theorem continuous_nestedOscillatoryIntegrand
    (deltaOut deltaIn : Real) :
    Continuous (fun s : Real ↦
      Complex.exp ((Complex.I * deltaOut) * s) *
        oscillatoryIntegral deltaIn s) := by
  exact (by fun_prop : Continuous (fun s : Real ↦
    Complex.exp ((Complex.I * deltaOut) * s))).mul
      (continuous_oscillatoryIntegral_time deltaIn)

/-- Consequently, the nested integrand is integrable on every finite
oriented interval. -/
theorem intervalIntegrable_nestedOscillatoryIntegrand
    (deltaOut deltaIn a b : Real) :
    IntervalIntegrable (fun s : Real ↦
      Complex.exp ((Complex.I * deltaOut) * s) *
        oscillatoryIntegral deltaIn s) volume a b :=
  (continuous_nestedOscillatoryIntegrand deltaOut deltaIn).intervalIntegrable
    (μ := volume) a b

/-- The nested coefficient is continuous in its upper time endpoint. -/
theorem continuous_nestedOscillatoryIntegral
    (deltaOut deltaIn : Real) :
    Continuous (nestedOscillatoryIntegral deltaOut deltaIn) := by
  unfold nestedOscillatoryIntegral
  exact (intervalIntegral.differentiable_integral_of_continuous
    (continuous_nestedOscillatoryIntegrand deltaOut deltaIn)).continuous

/-- Fundamental-theorem-of-calculus derivative of the nested coefficient. -/
theorem hasDerivAt_nestedOscillatoryIntegral
    (deltaOut deltaIn time : Real) :
    HasDerivAt (nestedOscillatoryIntegral deltaOut deltaIn)
      (Complex.exp ((Complex.I * deltaOut) * time) *
        oscillatoryIntegral deltaIn time) time := by
  unfold nestedOscillatoryIntegral
  let integrand : Real → Complex := fun s ↦
    Complex.exp ((Complex.I * deltaOut) * s) *
      oscillatoryIntegral deltaIn s
  have hcontinuous : Continuous integrand :=
    continuous_nestedOscillatoryIntegrand deltaOut deltaIn
  exact intervalIntegral.integral_hasDerivAt_right
    (hcontinuous.intervalIntegrable (μ := volume) 0 time)
    hcontinuous.aestronglyMeasurable.stronglyMeasurableAtFilter
    hcontinuous.continuousAt

/-- Direct triangular iterated-integral normal form.  This does not exchange
the order of integration and therefore is valid for every oriented endpoint
without a sign case split. -/
theorem nestedOscillatoryIntegral_eq_iteratedIntegral
    (deltaOut deltaIn time : Real) :
    nestedOscillatoryIntegral deltaOut deltaIn time =
      ∫ s in (0 : Real)..time,
        ∫ u in (0 : Real)..s,
          Complex.exp ((Complex.I * deltaOut) * s) *
            Complex.exp ((Complex.I * deltaIn) * u) := by
  unfold nestedOscillatoryIntegral oscillatoryIntegral
  apply intervalIntegral.integral_congr
  intro s hs
  dsimp
  rw [intervalIntegral.integral_const_mul]

/-- Away from an inner resonance, the triangular coefficient is a divided
difference of the two one-step oscillatory integrals. -/
theorem nestedOscillatoryIntegral_eq_sub_div
    {deltaOut deltaIn time : Real} (hdeltaIn : deltaIn ≠ 0) :
    nestedOscillatoryIntegral deltaOut deltaIn time =
      (oscillatoryIntegral (deltaOut + deltaIn) time -
        oscillatoryIntegral deltaOut time) /
          (Complex.I * deltaIn) := by
  unfold nestedOscillatoryIntegral
  simp_rw [oscillatoryIntegral_eq_div hdeltaIn]
  calc
    (∫ s in (0 : Real)..time,
        Complex.exp ((Complex.I * deltaOut) * s) *
          ((Complex.exp (Complex.I * (deltaIn * s)) - 1) /
            (Complex.I * deltaIn))) =
      ∫ s in (0 : Real)..time,
        (Complex.exp ((Complex.I * (deltaOut + deltaIn)) * s) -
          Complex.exp ((Complex.I * deltaOut) * s)) /
            (Complex.I * deltaIn) := by
      apply intervalIntegral.integral_congr
      intro s hs
      dsimp
      rw [← exp_phase_mul_exp_phase deltaOut deltaIn s]
      ring_nf
    _ =
      ((∫ s in (0 : Real)..time,
          Complex.exp ((Complex.I * (deltaOut + deltaIn)) * s)) -
        ∫ s in (0 : Real)..time,
          Complex.exp ((Complex.I * deltaOut) * s)) /
            (Complex.I * deltaIn) := by
      rw [intervalIntegral.integral_div,
        intervalIntegral.integral_sub]
      · exact (by fun_prop : Continuous (fun s : Real ↦
          Complex.exp ((Complex.I * (deltaOut + deltaIn)) * s))).intervalIntegrable
          (μ := volume) 0 time
      · exact (by fun_prop : Continuous (fun s : Real ↦
          Complex.exp ((Complex.I * deltaOut) * s))).intervalIntegrable
          (μ := volume) 0 time
    _ = _ := by
      unfold oscillatoryIntegral
      push_cast
      rfl

/-- Safe exact form when the inner mismatch is resonant.  It contains no
division by a mismatch. -/
theorem nestedOscillatoryIntegral_inner_zero
    (deltaOut time : Real) :
    nestedOscillatoryIntegral deltaOut 0 time =
      ∫ s in (0 : Real)..time,
        Complex.exp ((Complex.I * deltaOut) * s) * (s : Complex) := by
  simp [nestedOscillatoryIntegral]

/-- Safe exact form when the outer mismatch is resonant. -/
theorem nestedOscillatoryIntegral_outer_zero
    (deltaIn time : Real) :
    nestedOscillatoryIntegral 0 deltaIn time =
      ∫ s in (0 : Real)..time, oscillatoryIntegral deltaIn s := by
  simp [nestedOscillatoryIntegral]

/-- At double resonance the triangular time volume is exactly `time^2 / 2`,
with the real value embedded in the complex coefficient field. -/
@[simp] theorem nestedOscillatoryIntegral_zero_zero (time : Real) :
    nestedOscillatoryIntegral 0 0 time = ((time ^ 2 / 2 : Real) : Complex) := by
  rw [nestedOscillatoryIntegral_inner_zero]
  norm_num
  have hderiv (s : Real) :
      HasDerivAt (fun x : Real ↦ ((x ^ 2 / 2 : Real) : Complex))
        (s : Complex) s := by
    convert ((((hasDerivAt_id s).pow 2).div_const (2 : Real)).ofReal_comp)
      using 1 <;> norm_num
  have hintegrable : IntervalIntegrable (fun s : Real ↦ (s : Complex))
      volume 0 time :=
    (by fun_prop : Continuous (fun s : Real ↦ (s : Complex))).intervalIntegrable
      (μ := volume) 0 time
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun s hs ↦ hderiv s) hintegrable]
  norm_num

/-- For zero outer mismatch and nonzero inner mismatch, the exact divided
difference specializes without evaluating any zero denominator. -/
theorem nestedOscillatoryIntegral_outer_zero_eq_sub_div
    {deltaIn time : Real} (hdeltaIn : deltaIn ≠ 0) :
    nestedOscillatoryIntegral 0 deltaIn time =
      (oscillatoryIntegral deltaIn time - (time : Complex)) /
        (Complex.I * deltaIn) := by
  simpa using (nestedOscillatoryIntegral_eq_sub_div
    (deltaOut := 0) (deltaIn := deltaIn) (time := time) hdeltaIn)

/-- If the combined mismatch resonates while the inner mismatch remains
nonzero, the resonant one-step factor is kept exactly as elapsed time. -/
theorem nestedOscillatoryIntegral_total_zero_eq_sub_div
    {deltaOut deltaIn time : Real} (hdeltaIn : deltaIn ≠ 0)
    (htotal : deltaOut + deltaIn = 0) :
    nestedOscillatoryIntegral deltaOut deltaIn time =
      ((time : Complex) - oscillatoryIntegral deltaOut time) /
        (Complex.I * deltaIn) := by
  rw [nestedOscillatoryIntegral_eq_sub_div hdeltaIn, htotal,
    oscillatoryIntegral_zero]

/-- The nested coefficient starts at zero for every pair of mismatches. -/
@[simp] theorem nestedOscillatoryIntegral_time_zero
    (deltaOut deltaIn : Real) :
    nestedOscillatoryIntegral deltaOut deltaIn 0 = 0 := by
  simp [nestedOscillatoryIntegral]

end

end ArchonPhysics.NestedOscillatoryIntegral
