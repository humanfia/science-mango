/-- Genuine compact regular data for every frozen complementary environment.
Finite inverse-function atlases and their cardinalities are derived, not
stored as assumptions. -/
structure ActualTwoMassChildRepeatedFrozenCompactAtlasData
    (n : Nat) (site₁ site₂ : Lattice.Site (n + 2)) where
  weightCeiling : ChildRepeatedFrozenEnvironment n site₁ site₂ →
    ChildRepeatedModePair (n + 2) → ENNReal
  K : ChildRepeatedFrozenEnvironment n site₁ site₂ →
    ChildRepeatedModePair (n + 2) → Set (Real × Real)
  detLower : ChildRepeatedFrozenEnvironment n site₁ site₂ →
    ChildRepeatedModePair (n + 2) → Real
  hweight : ∀ rest modes,
    ∀ᵐ point ∂iidMassPairLaw,
      actualTwoMassChildRepeatedPositivePairWeight
          (childRepeatedFrozenMass n site₁ site₂ rest)
          site₁ site₂ modes point ≤
        weightCeiling rest modes
  hK : ∀ rest modes, IsCompact (K rest modes)
  hKregular : ∀ rest modes, K rest modes ⊆ actualTwoMassRegularSource
    (childRepeatedFrozenMass n site₁ site₂ rest)
    site₁ site₂ modes.1 modes.2
  hdetLower : ∀ rest modes, 0 < detLower rest modes
  hdet : ∀ rest modes point, point ∈ K rest modes →
    detLower rest modes ≤
      |(actualTwoMassChildFrequencyJacobian
        (childRepeatedFrozenMass n site₁ site₂ rest)
        site₁ site₂ modes.1 modes.2 point).det|

/-- The simultaneous finite atlas supplied by compact regularity in one
frozen environment. -/
def actualTwoMassChildRepeatedFrozenCompactAtlasCard
    {n : Nat} {site₁ site₂ : Lattice.Site (n + 2)}
    (hsite : site₁ ≠ site₂)
    (atlas : ActualTwoMassChildRepeatedFrozenCompactAtlasData n site₁ site₂)
    (rest : ChildRepeatedFrozenEnvironment n site₁ site₂) :
    ChildRepeatedModePair (n + 2) → Nat :=
  Classical.choose
    (exists_atlasCard_actualTwoMassChildRepeatedConditionalPerSite_resonanceStrip_apply_le
      (childRepeatedFrozenMass n site₁ site₂ rest)
      (fun site ↦ finitePairEnvironmentPositiveMassConfig_mass_mem_support
        site₁ site₂ rest site)
      hsite
      (actualTwoMassChildRepeatedPositivePairWeight
        (childRepeatedFrozenMass n site₁ site₂ rest) site₁ site₂)
      (atlas.weightCeiling rest) (atlas.hweight rest)
      (atlas.K rest) (atlas.hK rest) (atlas.hKregular rest)
      (atlas.detLower rest) (atlas.hdetLower rest) (atlas.hdet rest))

/-- The chosen finite atlas satisfies the exact conditional per-site strip
bound for every width. -/
theorem actualTwoMassChildRepeatedFrozenCompactAtlasCard_resonanceStrip_apply_le
    {n : Nat} {site₁ site₂ : Lattice.Site (n + 2)}
    (hsite : site₁ ≠ site₂)
    (atlas : ActualTwoMassChildRepeatedFrozenCompactAtlasData n site₁ site₂)
    (rest : ChildRepeatedFrozenEnvironment n site₁ site₂)
    {delta : Real} (hdelta : 0 ≤ delta) :
    actualTwoMassChildRepeatedConditionalPerSiteMeasure
        (childRepeatedFrozenMass n site₁ site₂ rest)
        site₁ site₂
        (actualTwoMassChildRepeatedPositivePairWeight
          (childRepeatedFrozenMass n site₁ site₂ rest) site₁ site₂)
        (childRepeatedReducedResonanceStrip delta) ≤
      actualTwoMassChildRepeatedCompactAtlasRegularPerSiteBudget
          (actualTwoMassChildRepeatedFrozenCompactAtlasCard hsite atlas rest)
          (atlas.weightCeiling rest) (atlas.detLower rest) *
          ENNReal.ofReal (2 * Real.sqrt 5 * delta) +
        actualTwoMassChildRepeatedBadPerSiteBudget
          (actualTwoMassChildRepeatedPositivePairWeight
            (childRepeatedFrozenMass n site₁ site₂ rest) site₁ site₂)
          (atlas.K rest) := by
  exact
    (Classical.choose_spec
      (exists_atlasCard_actualTwoMassChildRepeatedConditionalPerSite_resonanceStrip_apply_le
        (childRepeatedFrozenMass n site₁ site₂ rest)
        (fun site ↦ finitePairEnvironmentPositiveMassConfig_mass_mem_support
          site₁ site₂ rest site)
        hsite
        (actualTwoMassChildRepeatedPositivePairWeight
          (childRepeatedFrozenMass n site₁ site₂ rest) site₁ site₂)
        (atlas.weightCeiling rest) (atlas.hweight rest)
        (atlas.K rest) (atlas.hK rest) (atlas.hKregular rest)
        (atlas.detLower rest) (atlas.hdetLower rest) (atlas.hdet rest))) hdelta

/-- A volume-indexed compact atlas family with precisely the two remaining
quantitative estimates: a uniform finite regular budget and a vanishing bad
budget. -/
structure ActualTwoMassChildRepeatedAnnealedCompactAtlasSequence where
  site₁ : (n : Nat) → Lattice.Site ((n + 1) + 2)
  site₂ : (n : Nat) → Lattice.Site ((n + 1) + 2)
  site_ne : ∀ n, site₁ n ≠ site₂ n
  atlas : (n : Nat) → ActualTwoMassChildRepeatedFrozenCompactAtlasData
    (n + 1) (site₁ n) (site₂ n)
  regularCeiling : ENNReal
  regularCeiling_ne_top : regularCeiling ≠ ∞
  badError : Nat → ENNReal
  badError_ne_top : ∀ n, badError n ≠ ∞
  badError_tendsto_zero : Tendsto badError atTop (nhds 0)
  budget_le_ae : ∀ n,
    ∀ᵐ rest ∂(iidFiniteMassVectorLaw
        (finiteVolumeMassPairComplement (site₁ n) (site₂ n))),
      actualTwoMassChildRepeatedCompactAtlasRegularPerSiteBudget
          (actualTwoMassChildRepeatedFrozenCompactAtlasCard
            (site_ne n) (atlas n) rest)
          ((atlas n).weightCeiling rest) ((atlas n).detLower rest) ≤
            regularCeiling ∧
        actualTwoMassChildRepeatedBadPerSiteBudget
          (actualTwoMassChildRepeatedPositivePairWeight
            (childRepeatedFrozenMass (n + 1) (site₁ n) (site₂ n) rest)
            (site₁ n) (site₂ n))
          ((atlas n).K rest) ≤ badError n

/-- Exact pair/complement Fubini integrates the automatically generated
finite-atlas estimate into the canonical annealed child law. -/
theorem canonicalChildRepeatedReducedAnnealed_resonanceStrip_le_of_compactAtlas
    (data : ActualTwoMassChildRepeatedAnnealedCompactAtlasSequence)
    (n : Nat) {delta : Real} (hdelta : 0 ≤ delta) :
    (canonicalChildRepeatedReducedAnnealedPerSiteFiniteMeasure (n + 1) :
        Measure (Real × Real))
        (childRepeatedReducedResonanceStrip delta) ≤
      data.regularCeiling *
          ENNReal.ofReal (2 * Real.sqrt 5 * delta) +
        data.badError n := by
  apply
    canonicalChildRepeatedReducedAnnealedPerSiteFiniteMeasure_apply_le_of_conditional_ae
      (n + 1) (data.site₁ n) (data.site₂ n) (data.site_ne n)
      (childRepeatedReducedResonanceStrip_isClosed delta).measurableSet
      (data.regularCeiling *
        ENNReal.ofReal (2 * Real.sqrt 5 * delta) + data.badError n)
  filter_upwards [data.budget_le_ae n] with rest hbudget
  let atlas := data.atlas n
  calc
    actualTwoMassChildRepeatedConditionalPerSiteMeasure
        (childRepeatedFrozenMass (n + 1) (data.site₁ n) (data.site₂ n) rest)
        (data.site₁ n) (data.site₂ n)
        (actualTwoMassChildRepeatedPositivePairWeight
          (childRepeatedFrozenMass
            (n + 1) (data.site₁ n) (data.site₂ n) rest)
          (data.site₁ n) (data.site₂ n))
        (childRepeatedReducedResonanceStrip delta) ≤
      actualTwoMassChildRepeatedCompactAtlasRegularPerSiteBudget
          (actualTwoMassChildRepeatedFrozenCompactAtlasCard
            (data.site_ne n) atlas rest)
          (atlas.weightCeiling rest) (atlas.detLower rest) *
          ENNReal.ofReal (2 * Real.sqrt 5 * delta) +
        actualTwoMassChildRepeatedBadPerSiteBudget
          (actualTwoMassChildRepeatedPositivePairWeight
            (childRepeatedFrozenMass
              (n + 1) (data.site₁ n) (data.site₂ n) rest)
            (data.site₁ n) (data.site₂ n))
          (atlas.K rest) :=
      actualTwoMassChildRepeatedFrozenCompactAtlasCard_resonanceStrip_apply_le
        (data.site_ne n) atlas rest hdelta
    _ ≤ data.regularCeiling *
          ENNReal.ofReal (2 * Real.sqrt 5 * delta) + data.badError n :=
      add_le_add
        (mul_le_mul_left (hbudget.1)
          (ENNReal.ofReal (2 * Real.sqrt 5 * delta)))
        (hbudget.2)

/-- The compact-atlas sequence discharges the canonical real-valued
`ChildRepeated` annealed small-ball certificate. -/
def canonicalChildRepeatedDecaySectorAnnealedSmallBallBound_of_compactAtlas
    (data : ActualTwoMassChildRepeatedAnnealedCompactAtlasSequence) :
    CanonicalDecaySectorAnnealedMarkedIndexSmallBallBound
      (fun {_N} _inst ↦ ChildRepeated) where
  constant := 2 * Real.sqrt 5 * data.regularCeiling.toReal
  constant_nonneg := by positivity
  error := fun n ↦ (data.badError n).toReal
  error_nonneg := fun _n ↦ ENNReal.toReal_nonneg
  error_tendsto_zero := by
    change Tendsto (ENNReal.toReal ∘ data.badError) atTop (nhds 0)
    simpa only [ENNReal.toReal_zero] using
      (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
        data.badError_tendsto_zero
  bound := by
    intro n delta hdelta _hdelta1
    rw [canonicalDecaySectorAnnealed_childRepeated_eq_map_reduced]
    simp only [FiniteMeasure.toMeasure_map]
    rw [map_childRepeatedDecayMismatch_apply_absoluteMismatchSublevel]
    have hENN :=
      canonicalChildRepeatedReducedAnnealed_resonanceStrip_le_of_compactAtlas
        data n hdelta.le
    have hregularFinite :
        data.regularCeiling *
            ENNReal.ofReal (2 * Real.sqrt 5 * delta) ≠ ∞ :=
      ENNReal.mul_ne_top data.regularCeiling_ne_top ENNReal.ofReal_ne_top
    have hupperFinite :
        data.regularCeiling *
              ENNReal.ofReal (2 * Real.sqrt 5 * delta) +
            data.badError n ≠ ∞ :=
      ENNReal.add_ne_top.mpr
        ⟨hregularFinite, data.badError_ne_top n⟩
    have hfactor : 0 ≤ 2 * Real.sqrt 5 * delta :=
      mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg 5)) hdelta.le
    have hreal := ENNReal.toReal_mono hupperFinite hENN
    rw [ENNReal.toReal_add hregularFinite (data.badError_ne_top n),
      ENNReal.toReal_mul, ENNReal.toReal_ofReal hfactor] at hreal
    calc
      _ ≤ data.regularCeiling.toReal *
          (2 * Real.sqrt 5 * delta) + (data.badError n).toReal := hreal
      _ = (2 * Real.sqrt 5 * data.regularCeiling.toReal) * delta +
          (data.badError n).toReal := by ring

/-- With the compact child atlas grounded, full exact-resonance nullity is
reduced to the all-distinct annealed small-ball input alone. -/
theorem canonicalCollisionPerSiteMeasureLimit_decay_singleton_zero_eq_zero_of_allDistinct_of_childCompactAtlas
    (data : ActualTwoMassChildRepeatedAnnealedCompactAtlasSequence)
    (allDistinct : CanonicalDecaySectorAnnealedMarkedIndexSmallBallBound
      (fun {_N} _inst ↦ AllDistinctModes)) :
    (canonicalCollisionPerSiteMeasureLimit canonicalIIDMassPhaseEnsemble
        decayInteractionSign : Measure Real) ({0} : Set Real) = 0 :=
  canonicalCollisionPerSiteMeasureLimit_decay_singleton_zero_eq_zero
    allDistinct
    (canonicalChildRepeatedDecaySectorAnnealedSmallBallBound_of_compactAtlas
      data)

end

