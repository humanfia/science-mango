import ArchonPhysics.HarmonicModes

/-!
# Deterministic reduction of the harmonic spectrum

This module proves the deterministic zero-mode statement for the finite
periodic random-mass chain.  For every nonempty chain and every pointwise
positive mass profile, the mass-weighted harmonic operator has kernel exactly
the line generated by the mass-square-root translation mode.  Consequently,
its algebraic nonzero sector, realized as the range of the operator, has
dimension `N - 1`.

No measurable choice of eigenvectors, ordering of random eigenvalues, or
measurability statement in the mass parameter is asserted here.
-/

namespace ArchonPhysics.ReducedHarmonicSpectrum

open ArchonPhysics
open HarmonicModes

noncomputable section

/-- A periodic configuration with vanishing forward difference is constant. -/
theorem forwardDifference_eq_zero_iff_constant {N : Nat} [NeZero N]
    (q : Lattice.Configuration N) :
    Lattice.forwardDifference q = 0 ↔ ∃ c : Real, q = fun _ ↦ c := by
  constructor
  · intro hq
    have hstep (i : Lattice.Site N) : q (i + 1) = q i := by
      have hi := congrFun hq i
      change q (i + 1) - q i = 0 at hi
      exact sub_eq_zero.mp hi
    have hnat : ∀ k : Nat, q (k : Lattice.Site N) = q 0 := by
      intro k
      induction k with
      | zero => simp
      | succ k hk =>
          rw [Nat.cast_succ, hstep, hk]
    refine ⟨q 0, funext fun i ↦ ?_⟩
    rw [← ZMod.natCast_zmod_val i]
    exact hnat i.val
  · rintro ⟨c, rfl⟩
    ext i
    simp [Lattice.forwardDifference]

/-- The mass-weighted difference operator, viewed as a linear map. -/
def weightedDifferenceLinearMap {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    Lattice.Configuration N →ₗ[Real] Lattice.Configuration N :=
  (massWeightedDifferenceMatrix m).mulVecLin

/-- The mass-weighted harmonic operator, viewed as a linear map. -/
def harmonicLinearMap {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    Lattice.Configuration N →ₗ[Real] Lattice.Configuration N :=
  (massWeightedHarmonicMatrix m).mulVecLin

/--
The harmonic Gram operator has the same kernel as the weighted difference.

This is the model-specific specialization of Mathlib's
`Matrix.ker_mulVecLin_transpose_mul_self`; no Gram-kernel argument is repeated
locally.
-/
theorem harmonicLinearMap_ker_eq_weightedDifference_ker {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    LinearMap.ker (harmonicLinearMap m) =
      LinearMap.ker (weightedDifferenceLinearMap m) := by
  change LinearMap.ker
      ((Matrix.transpose (massWeightedDifferenceMatrix m) *
        massWeightedDifferenceMatrix m).mulVecLin) =
    LinearMap.ker (massWeightedDifferenceMatrix m).mulVecLin
  exact Matrix.ker_mulVecLin_transpose_mul_self _

/--
The kernel of the weighted difference is exactly the translation line.

For the forward inclusion, inverse-square-root weighting turns a kernel vector
into a configuration with zero periodic difference, hence into a constant.
For the reverse inclusion, the existing harmonic zero-mode theorem is
transported through Mathlib's Gram-kernel equality above.
-/
theorem weightedDifferenceLinearMap_ker_eq_span {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    LinearMap.ker (weightedDifferenceLinearMap m) =
      Real ∙ translationMode m := by
  ext v
  constructor
  · intro hv
    rw [LinearMap.mem_ker] at hv
    change Matrix.mulVec (massWeightedDifferenceMatrix m) v = 0 at hv
    let q : Lattice.Configuration N :=
      Matrix.mulVec
        (Matrix.diagonal (fun i ↦ (Real.sqrt (m.mass i))⁻¹)) v
    have hdiff : Matrix.mulVec differenceMatrix q = 0 := by
      unfold massWeightedDifferenceMatrix at hv
      rw [← Matrix.mulVec_mulVec] at hv
      simpa [q] using hv
    have hforward : Lattice.forwardDifference q = 0 := by
      rw [← differenceMatrix_mulVec]
      exact hdiff
    obtain ⟨c, hq⟩ := (forwardDifference_eq_zero_iff_constant q).mp hforward
    rw [Submodule.mem_span_singleton]
    refine ⟨c, funext fun i ↦ ?_⟩
    change c * Real.sqrt (m.mass i) = v i
    have hsqrt_ne : Real.sqrt (m.mass i) ≠ 0 :=
      Real.sqrt_ne_zero'.2 (m.mass_pos i)
    have hinv : (Real.sqrt (m.mass i))⁻¹ * v i = c := by
      have hi := congrFun hq i
      simpa [q, Matrix.mulVec_diagonal] using hi
    calc
      c * Real.sqrt (m.mass i) = Real.sqrt (m.mass i) * c := by ring
      _ = Real.sqrt (m.mass i) * ((Real.sqrt (m.mass i))⁻¹ * v i) := by
        rw [hinv]
      _ = v i := by
        rw [← mul_assoc, mul_inv_cancel₀ hsqrt_ne, one_mul]
  · intro hv
    rw [Submodule.mem_span_singleton] at hv
    obtain ⟨c, rfl⟩ := hv
    have htranslation :
        translationMode m ∈ LinearMap.ker (weightedDifferenceLinearMap m) := by
      rw [← harmonicLinearMap_ker_eq_weightedDifference_ker]
      rw [LinearMap.mem_ker]
      change Matrix.mulVec (massWeightedHarmonicMatrix m) (translationMode m) = 0
      exact translationMode_is_zero m
    exact (LinearMap.ker (weightedDifferenceLinearMap m)).smul_mem c htranslation


/-- The harmonic kernel is precisely the one-dimensional translation span. -/
theorem harmonicLinearMap_ker_eq_span {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    LinearMap.ker (harmonicLinearMap m) = Real ∙ translationMode m := by
  rw [harmonicLinearMap_ker_eq_weightedDifference_ker,
    weightedDifferenceLinearMap_ker_eq_span]

/-- The deterministic harmonic kernel has dimension one. -/
theorem harmonicKernel_finrank {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    Module.finrank Real (LinearMap.ker (harmonicLinearMap m)) = 1 := by
  rw [harmonicLinearMap_ker_eq_span]
  exact finrank_span_singleton (translationMode_ne_zero m)

/-- The algebraic nonzero sector is the range of the harmonic operator. -/
def nonzeroSector {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N) :
    Submodule Real (Lattice.Configuration N) :=
  LinearMap.range (harmonicLinearMap m)

/-- The nonzero sector of a nonempty `N`-site chain has dimension `N - 1`. -/
theorem nonzeroSector_finrank {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) :
    Module.finrank Real (nonzeroSector m) = N - 1 := by
  have h := LinearMap.finrank_range_add_finrank_ker (harmonicLinearMap m)
  rw [harmonicKernel_finrank, Module.finrank_pi, ZMod.card] at h
  change Module.finrank Real (LinearMap.range (harmonicLinearMap m)) = N - 1
  omega

end


end ArchonPhysics.ReducedHarmonicSpectrum
