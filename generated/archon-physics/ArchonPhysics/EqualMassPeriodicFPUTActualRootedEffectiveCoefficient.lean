import ArchonPhysics.EqualMassPeriodicFPUTActualEffectiveDiagramEnumeration

/-!
# The normalized rooted effective coefficient on the actual FPUT branches

This module keeps the oscillator normalizations carried by
`actualQuadraticVertex` and records the time ordering generated by the
actual first normal form.  The root mismatch is integrated first in the
instantaneous source, so its time primitive is
`nestedOscillatoryIntegral innerMismatch rootMismatch`, with the two
arguments in the opposite order from the older inner-first Picard family.

All sums are finite and range only over the explicitly reachable active
`EffectiveFourWaveDiagram`s.  No kinetic, random-phase, large-volume, or
statistical closure premise occurs here.
-/

namespace ArchonPhysics.EqualMassPeriodicFPUTActualRootedEffectiveCoefficient

open scoped BigOperators

open ArchonPhysics
open ArchonPhysics.ComplexFourierBranchAmplitude
open ArchonPhysics.EqualMassPeriodicFPUTActualEffectiveDiagramEnumeration
open ArchonPhysics.EqualMassPeriodicFPUTActualFirstNormalForm
open ArchonPhysics.EqualMassPeriodicFPUTEffectiveFourWaveVertex
open ArchonPhysics.NestedOscillatoryIntegral
open ArchonPhysics.NonresonantOscillatoryGain

noncomputable section

/-! ## Actual normalized coefficients before diagram reindexing -/

/-- Product of the two fully normalized actual branch vertices.  In
particular, all three oscillator square-root factors at each vertex remain
present. -/
def actualRootedTwoVertexNumerator
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  actualQuadraticVertex N alpha out
      (feedbackOuterLeft index) (feedbackOuterRight index) *
    actualQuadraticVertex N alpha (feedbackInsertedMode index)
      (feedbackInnerLeft index) (feedbackInnerRight index)

/-- Product of the three free actual branch amplitudes. -/
def actualFeedbackAmplitudeMonomial
    {N : Nat} (amplitude : ActualInteractionBranchMode N → Complex)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  amplitude (feedbackInnerLeft index) *
    amplitude (feedbackInnerRight index) *
    amplitude (feedbackSpectatorMode index)

/-- Instantaneous rooted coefficient occurring in the actual cubic source.
The outer/root primitive is multiplied by the instantaneous inner phase. -/
def actualRootedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  actualRootedTwoVertexNumerator N alpha out index *
    actualRootedFeedbackTimeKernel N tau out index

/-- Correct time primitive of the rooted coefficient.  Since the derivative
of `nestedOscillatoryIntegral deltaOut deltaIn` is the `deltaOut` phase times
the `deltaIn` primitive, the actual ordering is `(inner, root)`. -/
def actualSwappedNestedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  actualRootedTwoVertexNumerator N alpha out index *
    nestedOscillatoryIntegral
      (actualQuadraticMismatch N (feedbackInsertedMode index)
        (feedbackInnerLeft index) (feedbackInnerRight index))
      (actualQuadraticMismatch N out
        (feedbackOuterLeft index) (feedbackOuterRight index)) tau

/-- Homological effective coefficient produced by the actual swapped order.
The divisor is the root mismatch, not the old inner-first divisor. -/
def actualSwappedEffectiveFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  actualRootedTwoVertexNumerator N alpha out index /
    (Complex.I * actualQuadraticMismatch N out
      (feedbackOuterLeft index) (feedbackOuterRight index))

/-- The endpoint coefficient in the swapped normal-form extraction is the
same homological coefficient; it multiplies the inner-only phase. -/
def actualSwappedBoundaryFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) : Complex :=
  actualSwappedEffectiveFourWaveCoefficient N alpha out index

theorem actualRootedTwoVertexNumerator_scale
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) :
    actualRootedTwoVertexNumerator N alpha out index =
      (alpha : Complex) ^ 2 *
        actualRootedTwoVertexNumerator N 1 out index := by
  unfold actualRootedTwoVertexNumerator
  have houter := actualQuadraticVertex_scale N alpha out
    (feedbackOuterLeft index) (feedbackOuterRight index)
  have hinner := actualQuadraticVertex_scale N alpha
    (feedbackInsertedMode index)
    (feedbackInnerLeft index) (feedbackInnerRight index)
  rw [houter, hinner]
  ring

theorem actualRootedFourWaveCoefficient_scale
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) :
    actualRootedFourWaveCoefficient N alpha tau out index =
      (alpha : Complex) ^ 2 *
        actualRootedFourWaveCoefficient N 1 tau out index := by
  unfold actualRootedFourWaveCoefficient
  rw [actualRootedTwoVertexNumerator_scale]
  ring

theorem actualSwappedEffectiveFourWaveCoefficient_scale
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) :
    actualSwappedEffectiveFourWaveCoefficient N alpha out index =
      (alpha : Complex) ^ 2 *
        actualSwappedEffectiveFourWaveCoefficient N 1 out index := by
  unfold actualSwappedEffectiveFourWaveCoefficient
  rw [actualRootedTwoVertexNumerator_scale]
  ring

/-! ## Pointwise factorization and correct time primitive -/

/-- Every literal actual feedback term factors into its normalized rooted
coefficient and the three-free-branch monomial. -/
theorem actualCubicFeedbackTerm_eq_rootedCoefficient_mul_monomial
    (N : Nat) [NeZero N]
    (amplitude : ActualInteractionBranchMode N → Complex)
    (tau : Real) (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) :
    actualCubicFeedbackTerm N amplitude tau out index =
      actualRootedFourWaveCoefficient N 1 tau out index *
        actualFeedbackAmplitudeMonomial amplitude index := by
  rcases index with ⟨slot, outerLeft, outerRight,
    innerLeft, innerRight⟩
  fin_cases slot <;>
    simp [actualCubicFeedbackTerm, actualInnerVelocitySummand,
      actualRootedFourWaveCoefficient, actualRootedTwoVertexNumerator,
      actualRootedFeedbackTimeKernel, actualFeedbackAmplitudeMonomial,
      feedbackInsertionSlot, feedbackOuterLeft, feedbackOuterRight,
      feedbackInnerLeft, feedbackInnerRight, feedbackInsertedMode,
      feedbackSpectatorMode] <;>
    ring

/-- The swapped nested coefficient differentiates to the rooted
instantaneous coefficient, with no frozen-amplitude or dynamical premise. -/
theorem hasDerivAt_actualSwappedNestedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) (tau : Real) :
    HasDerivAt
      (actualSwappedNestedFourWaveCoefficient N alpha · out index)
      (actualRootedFourWaveCoefficient N alpha tau out index) tau := by
  have h := hasDerivAt_nestedOscillatoryIntegral
    (actualQuadraticMismatch N (feedbackInsertedMode index)
      (feedbackInnerLeft index) (feedbackInnerRight index))
    (actualQuadraticMismatch N out
      (feedbackOuterLeft index) (feedbackOuterRight index)) tau
  have hscaled := h.const_mul
    (actualRootedTwoVertexNumerator N alpha out index)
  apply hscaled.congr_deriv
  unfold actualRootedFourWaveCoefficient actualRootedFeedbackTimeKernel
  ring

/-- Exact effective-minus-boundary extraction for the correct swapped
ordering.  Nonresonance of the actual root mismatch is already a proved
finite-volume theorem. -/
theorem actualSwappedNestedFourWaveCoefficient_eq_effective_sub_boundary
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N) :
    actualSwappedNestedFourWaveCoefficient N alpha tau out index =
      actualSwappedEffectiveFourWaveCoefficient N alpha out index *
          oscillatoryIntegral
            (actualQuadraticMismatch N (feedbackInsertedMode index)
                (feedbackInnerLeft index) (feedbackInnerRight index) +
              actualQuadraticMismatch N out
                (feedbackOuterLeft index) (feedbackOuterRight index)) tau -
        actualSwappedBoundaryFourWaveCoefficient N alpha out index *
          oscillatoryIntegral
            (actualQuadraticMismatch N (feedbackInsertedMode index)
              (feedbackInnerLeft index) (feedbackInnerRight index)) tau := by
  unfold actualSwappedNestedFourWaveCoefficient
  rw [nestedOscillatoryIntegral_eq_sub_div
    (actualQuadraticMismatch_ne_zero N out
      (feedbackOuterLeft index) (feedbackOuterRight index))]
  unfold actualSwappedBoundaryFourWaveCoefficient
    actualSwappedEffectiveFourWaveCoefficient
  ring

/-- Active diagram form of the same extraction.  Both displayed phases use
the existing diagram mismatches, with the unavoidable global output-branch
sign made explicit. -/
theorem actualSwappedNestedFourWaveCoefficient_eq_diagramEffective_sub_boundary
    {N : Nat} [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActualCubicFeedbackIndex N)
    (hactive : IsActiveActualCubicFeedback out index) :
    actualSwappedNestedFourWaveCoefficient N alpha tau out index =
      actualSwappedEffectiveFourWaveCoefficient N alpha out index *
          oscillatoryIntegral
            (phaseSignReal (actualBranchSign out) *
              totalFourWaveMismatch
                (feedbackToEffectiveDiagram out index)) tau -
        actualSwappedBoundaryFourWaveCoefficient N alpha out index *
          oscillatoryIntegral
            (phaseSignReal (actualBranchSign out) *
              innerHomologicalDivisor
                (feedbackToEffectiveDiagram out index)) tau := by
  rw [actualSwappedNestedFourWaveCoefficient_eq_effective_sub_boundary]
  rw [add_comm,
    actualOuter_add_innerMismatch_eq_outputSign_mul_totalFourWaveMismatch
      out index hactive,
    ← outputSign_mul_innerHomologicalDivisor_eq_actual
      out index hactive.2]

/-! ## Reachable active-diagram coefficient interface -/

/-- Recover the literal active feedback index represented by one reachable
active effective diagram. -/
def reachableActualFeedbackIndex
    {N : Nat} [NeZero N] (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) :
    ActiveActualCubicFeedback N out :=
  (activeFeedbackEffectiveDiagramEquiv out).symm diagram

/-- Actual rooted coefficient transported to the existing active diagram
enumeration. -/
def reachableActualRootedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) : Complex :=
  actualRootedFourWaveCoefficient N alpha tau out
    (reachableActualFeedbackIndex out diagram).1

def reachableActualFeedbackAmplitudeMonomial
    (N : Nat) [NeZero N]
    (amplitude : ActualInteractionBranchMode N → Complex)
    (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) : Complex :=
  actualFeedbackAmplitudeMonomial amplitude
    (reachableActualFeedbackIndex out diagram).1

def reachableActualSwappedNestedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real) (tau : Real)
    (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) : Complex :=
  actualSwappedNestedFourWaveCoefficient N alpha tau out
    (reachableActualFeedbackIndex out diagram).1

def reachableActualSwappedEffectiveFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) : Complex :=
  actualSwappedEffectiveFourWaveCoefficient N alpha out
    (reachableActualFeedbackIndex out diagram).1

@[simp] theorem reachableActualFeedbackIndex_equiv
    {N : Nat} [NeZero N] (out : ActualInteractionBranchMode N)
    (index : ActiveActualCubicFeedback N out) :
    reachableActualFeedbackIndex out
        (activeFeedbackEffectiveDiagramEquiv out index) = index := by
  simp [reachableActualFeedbackIndex]

theorem actualActiveEffectiveDiagramTerm_eq_coefficient_mul_monomial
    (N : Nat) [NeZero N]
    (amplitude : ActualInteractionBranchMode N → Complex)
    (tau : Real) (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) :
    actualActiveEffectiveDiagramTerm N amplitude tau out diagram =
      reachableActualRootedFourWaveCoefficient N 1 tau out diagram *
        reachableActualFeedbackAmplitudeMonomial N amplitude out diagram := by
  unfold actualActiveEffectiveDiagramTerm
    reachableActualRootedFourWaveCoefficient
    reachableActualFeedbackAmplitudeMonomial reachableActualFeedbackIndex
  exact actualCubicFeedbackTerm_eq_rootedCoefficient_mul_monomial
    N amplitude tau out _

theorem hasDerivAt_reachableActualSwappedNestedFourWaveCoefficient
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (diagram : ActiveFeedbackEffectiveDiagramImage N out) (tau : Real) :
    HasDerivAt
      (reachableActualSwappedNestedFourWaveCoefficient N alpha · out diagram)
      (reachableActualRootedFourWaveCoefficient N alpha tau out diagram) tau := by
  exact hasDerivAt_actualSwappedNestedFourWaveCoefficient
    N alpha out (reachableActualFeedbackIndex out diagram).1 tau

/-- Exact whole-source formula over the reachable active subset of the
pre-existing effective-diagram enumeration. -/
theorem actualEffectiveCubicFourWaveSource_eq_reachableRootedCoefficientSum
    (N : Nat) [NeZero N]
    (amplitude : ActualInteractionBranchMode N → Complex)
    (tau : Real) (out : ActualInteractionBranchMode N) :
    actualEffectiveCubicFourWaveSource N amplitude tau out =
      ∑ diagram : ActiveFeedbackEffectiveDiagramImage N out,
        reachableActualRootedFourWaveCoefficient N 1 tau out diagram *
          reachableActualFeedbackAmplitudeMonomial N amplitude out diagram := by
  rw [actualEffectiveCubicFourWaveSource_eq_activeEffectiveDiagramSum]
  apply Finset.sum_congr rfl
  intro diagram _hdiagram
  exact actualActiveEffectiveDiagramTerm_eq_coefficient_mul_monomial
    N amplitude tau out diagram

/-- Coupling-explicit form matching the `alpha^2` factor in the actual
Physlib first-normal-form derivative. -/
theorem alpha_sq_mul_actualEffectiveCubicFourWaveSource_eq_reachableSum
    (N : Nat) [NeZero N] (alpha : Real)
    (amplitude : ActualInteractionBranchMode N → Complex)
    (tau : Real) (out : ActualInteractionBranchMode N) :
    (alpha : Complex) ^ 2 *
        actualEffectiveCubicFourWaveSource N amplitude tau out =
      ∑ diagram : ActiveFeedbackEffectiveDiagramImage N out,
        reachableActualRootedFourWaveCoefficient N alpha tau out diagram *
          reachableActualFeedbackAmplitudeMonomial N amplitude out diagram := by
  rw [actualEffectiveCubicFourWaveSource_eq_reachableRootedCoefficientSum]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro diagram _hdiagram
  unfold reachableActualRootedFourWaveCoefficient
  rw [actualRootedFourWaveCoefficient_scale N alpha tau out
    (reachableActualFeedbackIndex out diagram).1]
  ring

/-! ## Exact comparison interface with the older coefficient -/

/-- The minimal algebraic compatibility required to identify the actual
swapped coefficient with the older unnormalized inner-first coefficient.
It exposes both discrepancies: normalized numerators and different
homological divisors. -/
def ActualOldEffectiveCoefficientCompatibility
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActiveActualCubicFeedback N out) : Prop :=
  actualRootedTwoVertexNumerator N alpha out index.1 *
      (Complex.I * innerHomologicalDivisor
        (feedbackToEffectiveDiagram out index.1)) =
    twoVertexNumerator N alpha (feedbackToEffectiveDiagram out index.1) *
      (Complex.I * actualQuadraticMismatch N out
        (feedbackOuterLeft index.1) (feedbackOuterRight index.1))

/-- The compatibility condition is necessary and sufficient; it is not
postulated. -/
theorem actualSwappedEffectiveFourWaveCoefficient_eq_old_iff
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActiveActualCubicFeedback N out) :
    actualSwappedEffectiveFourWaveCoefficient N alpha out index.1 =
        effectiveFourWaveCoefficient N alpha
          (feedbackToEffectiveDiagram out index.1) ↔
      ActualOldEffectiveCoefficientCompatibility N alpha out index := by
  unfold actualSwappedEffectiveFourWaveCoefficient
    effectiveFourWaveCoefficient ActualOldEffectiveCoefficientCompatibility
  have hroot : (Complex.I * actualQuadraticMismatch N out
      (feedbackOuterLeft index.1) (feedbackOuterRight index.1)) ≠ 0 := by
    apply mul_ne_zero Complex.I_ne_zero
    exact_mod_cast actualQuadraticMismatch_ne_zero N out
      (feedbackOuterLeft index.1) (feedbackOuterRight index.1)
  have hinner : (Complex.I * innerHomologicalDivisor
      (feedbackToEffectiveDiagram out index.1)) ≠ 0 := by
    apply mul_ne_zero Complex.I_ne_zero
    exact_mod_cast innerHomologicalDivisor_ne_zero
      (activeFeedbackToEffectiveDiagram out index)
  exact div_eq_div_iff hroot hinner

/-- A more readable sufficient condition: equality of both microscopic
numerators and both divisors implies equality of the coefficients. -/
theorem actualSwappedEffectiveFourWaveCoefficient_eq_old_of_components
    (N : Nat) [NeZero N] (alpha : Real)
    (out : ActualInteractionBranchMode N)
    (index : ActiveActualCubicFeedback N out)
    (hnumerator : actualRootedTwoVertexNumerator N alpha out index.1 =
      twoVertexNumerator N alpha (feedbackToEffectiveDiagram out index.1))
    (hdivisor : actualQuadraticMismatch N out
        (feedbackOuterLeft index.1) (feedbackOuterRight index.1) =
      innerHomologicalDivisor (feedbackToEffectiveDiagram out index.1)) :
    actualSwappedEffectiveFourWaveCoefficient N alpha out index.1 =
      effectiveFourWaveCoefficient N alpha
        (feedbackToEffectiveDiagram out index.1) := by
  apply (actualSwappedEffectiveFourWaveCoefficient_eq_old_iff
    N alpha out index).2
  unfold ActualOldEffectiveCoefficientCompatibility
  rw [hnumerator, hdivisor]

end

end ArchonPhysics.EqualMassPeriodicFPUTActualRootedEffectiveCoefficient
