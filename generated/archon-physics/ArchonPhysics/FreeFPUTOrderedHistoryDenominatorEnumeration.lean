import ArchonPhysics.FreeFPUTRegularArbitraryOrderOscillatoryHistory

/-!
# Exact enumeration of every ordered-history small denominator

Repeated integration by parts in an ordered FPUT Duhamel history does not
only divide by the local phase mismatches.  It also divides by the cumulative
mismatches created when adjacent vertices are merged.  This file enumerates
those denominators by the same recursion as
`FullyNonresonantOrderedHistory`.

The main equivalence is exact: a history is fully nonresonant precisely when
every entry in `orderedHistoryDenominators` has absolute value at least the
chosen gap.  Consequently an irregular history has an explicit small-gap
witness.  The recursive list has exactly `2 ^ r - 1` entries at order `r`
(counting repetitions), so a future one-denominator small-ball theorem can be
lifted by a finite union bound without hiding any high-order or recollision
event.

This is deterministic bookkeeping.  It proves neither a small-ball estimate
for the frozen random-mass spectrum nor the kinetic-time summability of all
diagrams.
-/

namespace ArchonPhysics.FreeFPUTOrderedHistoryDenominatorEnumeration

open ArchonPhysics
open ArchonPhysics.FreeFPUTRegularArbitraryOrderOscillatoryHistory

noncomputable section

/-- All denominators generated by the complete ordered-history integration-
by-parts recursion.  Repetitions are retained because they are the natural
multiplicity for a later diagram/union estimate. -/
def orderedHistoryDenominators : List Real → List Real
  | [] => []
  | [delta] => [delta]
  | deltaOne :: deltaTwo :: tail =>
      deltaOne ::
        (orderedHistoryDenominators (deltaTwo :: tail) ++
          orderedHistoryDenominators ((deltaOne + deltaTwo) :: tail))
termination_by phases => phases.length

/-- The recursive nonresonance certificate is exactly the assertion that
every enumerated denominator obeys the requested gap. -/
theorem fullyNonresonantOrderedHistory_iff_forall_mem_denominators
    (gamma : Real) : ∀ phases : List Real,
    FullyNonresonantOrderedHistory gamma phases ↔
      ∀ delta ∈ orderedHistoryDenominators phases, gamma ≤ |delta|
  | [] => by
      constructor
      · intro _ delta hdelta
        simp [orderedHistoryDenominators] at hdelta
      · intro _
        exact FullyNonresonantOrderedHistory.nil
  | [delta] => by
      constructor
      · intro hregular
        cases hregular with
        | singleton _ hgap =>
            simpa [orderedHistoryDenominators] using hgap
      · intro hall
        exact FullyNonresonantOrderedHistory.singleton delta
          (hall delta (by simp [orderedHistoryDenominators]))
  | deltaOne :: deltaTwo :: tail => by
      have hdrop :=
        fullyNonresonantOrderedHistory_iff_forall_mem_denominators
          gamma (deltaTwo :: tail)
      have hmerge :=
        fullyNonresonantOrderedHistory_iff_forall_mem_denominators
          gamma ((deltaOne + deltaTwo) :: tail)
      constructor
      · intro hregular
        cases hregular with
        | cons _ _ _ hfirst hdropRegular hmergeRegular =>
            intro delta hdelta
            simp only [orderedHistoryDenominators, List.mem_cons,
              List.mem_append] at hdelta
            rcases hdelta with hdelta | hdelta | hdelta
            · simpa [hdelta] using hfirst
            · exact hdrop.mp hdropRegular delta hdelta
            · exact hmerge.mp hmergeRegular delta hdelta
      · intro hall
        have hfirst : gamma ≤ |deltaOne| :=
          hall deltaOne (by simp [orderedHistoryDenominators])
        have hdropRegular :
            FullyNonresonantOrderedHistory gamma (deltaTwo :: tail) := by
          apply hdrop.mpr
          intro delta hdelta
          exact hall delta (by
            simp only [orderedHistoryDenominators, List.mem_cons,
              List.mem_append]
            exact Or.inr (Or.inl hdelta))
        have hmergeRegular :
            FullyNonresonantOrderedHistory gamma
              ((deltaOne + deltaTwo) :: tail) := by
          apply hmerge.mpr
          intro delta hdelta
          exact hall delta (by
            simp only [orderedHistoryDenominators, List.mem_cons,
              List.mem_append]
            exact Or.inr (Or.inr hdelta))
        exact FullyNonresonantOrderedHistory.cons
          deltaOne deltaTwo tail hfirst hdropRegular hmergeRegular
termination_by phases => phases.length

/-- Failure of full nonresonance has a concrete cumulative-denominator
witness. -/
theorem not_fullyNonresonantOrderedHistory_iff_exists_small_denominator
    (gamma : Real) (phases : List Real) :
    ¬ FullyNonresonantOrderedHistory gamma phases ↔
      ∃ delta ∈ orderedHistoryDenominators phases, |delta| < gamma := by
  rw [fullyNonresonantOrderedHistory_iff_forall_mem_denominators]
  push Not
  rfl

/-- A subtraction-free form of the exact denominator count. -/
theorem length_orderedHistoryDenominators_add_one : ∀ phases : List Real,
    (orderedHistoryDenominators phases).length + 1 = 2 ^ phases.length
  | [] => by simp [orderedHistoryDenominators]
  | [delta] => by simp [orderedHistoryDenominators]
  | deltaOne :: deltaTwo :: tail => by
      have hdrop :=
        length_orderedHistoryDenominators_add_one (deltaTwo :: tail)
      have hmerge :=
        length_orderedHistoryDenominators_add_one
          ((deltaOne + deltaTwo) :: tail)
      simp only [orderedHistoryDenominators, List.length_cons,
        List.length_append]
      simp only [List.length_cons] at hdrop hmerge ⊢
      rw [pow_succ]
      omega
termination_by phases => phases.length

/-- At perturbative order `r`, the complete ordered IBP tree exposes exactly
`2 ^ r - 1` denominator occurrences. -/
theorem length_orderedHistoryDenominators (phases : List Real) :
    (orderedHistoryDenominators phases).length = 2 ^ phases.length - 1 := by
  have h := length_orderedHistoryDenominators_add_one phases
  omega

/-- Distinct small denominator values form a finite set. -/
def smallOrderedHistoryDenominators
    (gamma : Real) (phases : List Real) : Finset Real :=
  (orderedHistoryDenominators phases).toFinset.filter fun delta =>
    |delta| < gamma

/-- The finite small-denominator set is nonempty exactly for an irregular
history. -/
theorem smallOrderedHistoryDenominators_nonempty_iff
    (gamma : Real) (phases : List Real) :
    (smallOrderedHistoryDenominators gamma phases).Nonempty ↔
      ¬ FullyNonresonantOrderedHistory gamma phases := by
  classical
  rw [not_fullyNonresonantOrderedHistory_iff_exists_small_denominator]
  constructor
  · rintro ⟨delta, hdelta⟩
    have hfilter := Finset.mem_filter.mp hdelta
    exact ⟨delta, List.mem_toFinset.mp hfilter.1, hfilter.2⟩
  · rintro ⟨delta, hmem, hsmall⟩
    exact ⟨delta, Finset.mem_filter.mpr
      ⟨List.mem_toFinset.mpr hmem, hsmall⟩⟩

/-- The number of distinct bad values is bounded by the exact occurrence
budget `2 ^ r - 1`.  No independence is used here. -/
theorem card_smallOrderedHistoryDenominators_le
    (gamma : Real) (phases : List Real) :
    (smallOrderedHistoryDenominators gamma phases).card ≤
      2 ^ phases.length - 1 := by
  calc
    (smallOrderedHistoryDenominators gamma phases).card ≤
        (orderedHistoryDenominators phases).toFinset.card := by
      exact Finset.card_filter_le _ _
    _ ≤ (orderedHistoryDenominators phases).length :=
      List.toFinset_card_le (orderedHistoryDenominators phases)
    _ = 2 ^ phases.length - 1 :=
      length_orderedHistoryDenominators phases

end

end ArchonPhysics.FreeFPUTOrderedHistoryDenominatorEnumeration
