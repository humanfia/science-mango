import ArchonPhysics.PhyslibFPUTPositiveTimeCumulantHierarchy
import ArchonPhysics.ReducedGlobalTrajectoryPhyslibAdapter

/-!
# Exact positive-time cumulant hierarchy for the frozen coercive alpha-beta FPUT chain

The frozen v0.3 microscopic potential is not the pure cubic model.  It is

`U_g(x) = x^2 / 2 + kappa * g * x^3 / 3 + beta * g^2 * x^4 / 4`,

with `2 * kappa^2 / 9 < beta`.  Consequently its exact interaction-picture
modal source contains both the quadratic force generated by the cubic
potential and the cubic force generated by the stabilizing quartic potential.

This module lifts the arbitrary finite-order moment/cumulant calculus from
`PhyslibFPUTPositiveTimeCumulantHierarchy` to that full source.  It proves:

* the exact source split into its `kappa * g` quadratic and `beta * g^2`
  cubic-force pieces;
* the arbitrary-order signed moment and connected-cumulant hierarchy for
  actual Physlib trajectories satisfying the full alpha-beta Hamilton
  equations; and
* existence of such a two-sided global hierarchy for every finite ensemble
  of initial conditions, using the already verified coercive reduced global
  flow and its Physlib adapter.

No random-phase propagation, Markov closure, kinetic limit, cumulant decay,
or thermalization conclusion is made.  The point of this file is to remove
the scientifically incorrect `beta = 0` specialization from the exact
positive-time backbone used by the frozen target.
-/

namespace ArchonPhysics.PhyslibFPUTCoercivePositiveTimeCumulantHierarchy

open scoped BigOperators

open ArchonPhysics
open ArchonPhysics.CoerciveHamiltonianContinuation
open ArchonPhysics.CoerciveHamiltonianGlobalExistence
open ArchonPhysics.CoerciveHamiltonianPhyslib
open ArchonPhysics.FinitePhaseMonomials
open ArchonPhysics.InteractionPictureDuhamel
open ArchonPhysics.ModalPhaseMismatch
open ArchonPhysics.PhaseRenormalization
open ArchonPhysics.PhyslibFPUTBinaryInteractionTreeCouples
open ArchonPhysics.PhyslibFPUTFirstPicardDecomposition
open ArchonPhysics.PhyslibFPUTPositiveTimeCumulantHierarchy
open ArchonPhysics.PhyslibHamiltonDuhamel
open ArchonPhysics.ReducedGlobalTrajectoryPhyslibAdapter

noncomputable section

variable {I Omega : Type*}
  [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype Omega]

/-! ## Full alpha-beta source -/

/-- The exact interaction-picture source of the frozen coercive alpha-beta
FPUT Hamiltonian.  Its two nonlinear pieces have physical sizes `kappa * g`
and `beta * g^2` in the underlying force. -/
def physlibCoerciveRotatedSource
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (mode : Lattice.Site N) (q : Time → HilbertConfiguration N) :
    Real → Complex :=
  physlibModeRotatedSource m kappa beta g mode q

/-- The quartic potential contributes a cubic force to the rotated source. -/
def physlibQuarticForceRotatedSource
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (beta g : Real)
    (mode : Lattice.Site N) (q : Time → HilbertConfiguration N) :
    Real → Complex :=
  physlibCubicRotatedSource m beta g mode q

/-- Exact pointwise split of the full coercive source. -/
theorem physlibCoerciveRotatedSource_eq_quadratic_add_quarticForce
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (mode : Lattice.Site N) (q : Time → HilbertConfiguration N)
    (time : Real) :
    physlibCoerciveRotatedSource m kappa beta g mode q time =
      physlibQuadraticRotatedSource m kappa g mode q time +
        physlibQuarticForceRotatedSource m beta g mode q time := by
  exact physlibModeRotatedSource_eq_quadratic_add_cubic
    m kappa beta g mode q time

/-- Signed full source, with the conjugate branch treated by complex
conjugation rather than by a new stochastic copy. -/
def signedPhyslibCoerciveRotatedSource
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (sign : PhaseSign) (mode : Lattice.Site N)
    (q : Time → HilbertConfiguration N) : Real → Complex :=
  fun time ↦ phaseSignActComplex sign
    (physlibCoerciveRotatedSource m kappa beta g mode q time)

/-- Signed quartic-force part of the full source. -/
def signedPhyslibQuarticForceRotatedSource
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (beta g : Real)
    (sign : PhaseSign) (mode : Lattice.Site N)
    (q : Time → HilbertConfiguration N) : Real → Complex :=
  fun time ↦ phaseSignActComplex sign
    (physlibQuarticForceRotatedSource m beta g mode q time)

/-- The signed full source is exactly the signed quadratic source plus the
signed quartic-force source. -/
theorem signedPhyslibCoerciveRotatedSource_eq_quadratic_add_quarticForce
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (sign : PhaseSign) (mode : Lattice.Site N)
    (q : Time → HilbertConfiguration N) (time : Real) :
    signedPhyslibCoerciveRotatedSource m kappa beta g sign mode q time =
      signedPhyslibCubicLeadingQuadraticSource
          m kappa g sign mode q time +
        signedPhyslibQuarticForceRotatedSource
          m beta g sign mode q time := by
  unfold signedPhyslibCoerciveRotatedSource
    signedPhyslibCubicLeadingQuadraticSource
    signedPhyslibQuarticForceRotatedSource
  rw [physlibCoerciveRotatedSource_eq_quadratic_add_quarticForce]
  cases sign <;> simp [phaseSignActComplex,
    physlibCubicLeadingQuadraticSource,
    physlibQuadraticRotatedSource,
    physlibQuarticForceRotatedSource]

/-! ## Full-source derivative along an actual trajectory -/

/-- The actual interaction-picture amplitude differentiates to the full
coercive alpha-beta source. -/
theorem hasDerivAt_physlibInteractionModePath_coercive
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (mode : Lattice.Site N)
    (p q : Time → HilbertConfiguration N)
    (hp : Differentiable Real p) (hq : Differentiable Real q)
    (hHamilton : SatisfiesHamiltonEquations m kappa beta g p q)
    (homega : 0 < modeFrequency m mode) (time : Real) :
    HasDerivAt (physlibInteractionModePath m mode p q)
      (physlibCoerciveRotatedSource m kappa beta g mode q time) time := by
  let source : Real → Complex :=
    physlibModeRotatedSource m kappa beta g mode q
  have hcontinuous : Continuous source :=
    continuous_physlibModeRotatedSource m kappa beta g mode q hq
  have hintegral : HasDerivAt
      (fun endpoint ↦ ∫ s in (0 : Real)..endpoint, source s)
      (source time) time :=
    intervalIntegral.integral_hasDerivAt_right
      (hcontinuous.intervalIntegrable (μ := MeasureTheory.volume) 0 time)
      hcontinuous.aestronglyMeasurable.stronglyMeasurableAtFilter
      hcontinuous.continuousAt
  have hrhs := hintegral.const_add (physlibModeAmplitude m mode p q 0)
  apply hrhs.congr_of_eventuallyEq
  exact Filter.Eventually.of_forall fun endpoint ↦ by
    simpa only [physlibInteractionModePath,
      physlibCoerciveRotatedSource, source] using
      (interactionPicture_physlibMode_eq_initial_add_integral_of_differentiable
        m kappa beta g mode p q hp hq hHamilton homega endpoint)

/-- Both phase-sign branches obey the correspondingly signed full-source
equation. -/
theorem hasDerivAt_signedPhyslibInteractionModePath_coercive
    {N : Nat} [NeZero N]
    (m : Lattice.PositiveMassConfig N) (kappa beta g : Real)
    (sign : PhaseSign) (mode : Lattice.Site N)
    (p q : Time → HilbertConfiguration N)
    (hp : Differentiable Real p) (hq : Differentiable Real q)
    (hHamilton : SatisfiesHamiltonEquations m kappa beta g p q)
    (homega : 0 < modeFrequency m mode) (time : Real) :
    HasDerivAt (signedPhyslibInteractionModePath m sign mode p q)
      (signedPhyslibCoerciveRotatedSource
        m kappa beta g sign mode q time) time := by
  have hpositive := hasDerivAt_physlibInteractionModePath_coercive
    m kappa beta g mode p q hp hq hHamilton homega time
  cases sign with
  | phase =>
      change HasDerivAt (physlibInteractionModePath m mode p q)
        (physlibCoerciveRotatedSource m kappa beta g mode q time) time
      exact hpositive
  | conjugate =>
      change HasDerivAt
        (fun s ↦ star (physlibInteractionModePath m mode p q s))
        (star (physlibCoerciveRotatedSource
          m kappa beta g mode q time)) time
      exact hpositive.star

/-! ## Finite ensembles and their arbitrary-order connected cumulants -/

/-- Full signed source for a finite ensemble of actual alpha-beta
trajectories. -/
def actualFiniteCoerciveEnsembleSource
    {N : Nat} [NeZero N]
    (mass : Omega → Lattice.PositiveMassConfig N)
    (kappa beta g : Real)
    (entry : I → PhaseSign × Lattice.Site N)
    (q : Omega → Time → HilbertConfiguration N) :
    Omega → I → Real → Complex :=
  fun omega i ↦ signedPhyslibCoerciveRotatedSource
    (mass omega) kappa beta g (entry i).1 (entry i).2 (q omega)

/-- One-slot full-source insertion in an actual finite ensemble. -/
def actualFiniteCoerciveEnsembleBlockInsertion
    {N : Nat} [NeZero N]
    (weight : Omega → Real)
    (mass : Omega → Lattice.PositiveMassConfig N)
    (kappa beta g : Real)
    (entry : I → PhaseSign × Lattice.Site N)
    (p q : Omega → Time → HilbertConfiguration N)
    (block : Finset I) (time : Real) : Complex :=
  finiteWeightedBlockInsertion weight
    (actualFiniteCubicEnsemblePath mass entry p q)
    (actualFiniteCoerciveEnsembleSource mass kappa beta g entry q)
    block time

/-- Exact full alpha-beta hierarchy source for the finite-ensemble connected
cumulant. -/
def actualFiniteCoerciveEnsembleConnectedCumulantHierarchySource
    {N : Nat} [NeZero N]
    (weight : Omega → Real)
    (mass : Omega → Lattice.PositiveMassConfig N)
    (kappa beta g : Real)
    (entry : I → PhaseSign × Lattice.Site N)
    (p q : Omega → Time → HilbertConfiguration N)
    (time : Real) : Complex :=
  suppliedConnectedCumulantHierarchySource
    (finiteWeightedBlockMoment weight
      (actualFiniteCubicEnsemblePath mass entry p q))
    (actualFiniteCoerciveEnsembleBlockInsertion
      weight mass kappa beta g entry p q) time

/-- Main full-potential endpoint: for arbitrary finite joint order, the
connected cumulant of actual alpha-beta trajectories differentiates to the
partition sum of one-slot insertions of the full coercive source. -/
theorem hasDerivAt_actualFiniteCoerciveEnsembleConnectedCumulant
    {N : Nat} [NeZero N]
    (weight : Omega → Real)
    (mass : Omega → Lattice.PositiveMassConfig N)
    (kappa beta g : Real)
    (entry : I → PhaseSign × Lattice.Site N)
    (p q : Omega → Time → HilbertConfiguration N)
    (hp : ∀ omega, Differentiable Real (p omega))
    (hq : ∀ omega, Differentiable Real (q omega))
    (hHamilton : ∀ omega,
      SatisfiesHamiltonEquations (mass omega) kappa beta g
        (p omega) (q omega))
    (homega : ∀ omega i,
      0 < modeFrequency (mass omega) (entry i).2)
    (time : Real) :
    HasDerivAt
      (fun s ↦ actualFiniteCubicEnsembleConnectedCumulant
        weight mass entry p q s)
      (actualFiniteCoerciveEnsembleConnectedCumulantHierarchySource
        weight mass kappa beta g entry p q time) time := by
  apply hasDerivAt_suppliedConnectedCumulantPath
  intro block
  apply hasDerivAt_finiteWeightedBlockMoment
  intro omega i _hi
  exact hasDerivAt_signedPhyslibInteractionModePath_coercive
    (mass omega) kappa beta g (entry i).1 (entry i).2
    (p omega) (q omega) (hp omega) (hq omega)
    (hHamilton omega) (homega omega i) time

/-! ## Coercive global-trajectory existence -/

/-- Every finite family of initial reduced states in the frozen coercive
alpha-beta model admits actual two-sided global Physlib paths whose arbitrary
fixed-order connected cumulants obey the full hierarchy at every real time.
This removes a supplied positive-time trajectory from the finite-ensemble
endpoint; it still makes no iid-continuum or kinetic-limit claim. -/
theorem exists_global_actualFiniteCoerciveEnsembleCumulantHierarchy
    {N : Nat} [NeZero N]
    (weight : Omega → Real)
    (mass : Omega → Lattice.PositiveMassConfig N)
    {kappa beta : Real} (hbeta : 2 * kappa ^ 2 / 9 < beta)
    (g : Real)
    (initial : ∀ omega, ReducedPhaseSpace (mass omega))
    (entry : I → PhaseSign × Lattice.Site N)
    (homega : ∀ omega i,
      0 < modeFrequency (mass omega) (entry i).2) :
    ∃ p q : Omega → Time → HilbertConfiguration N,
      (∀ omega, Differentiable Real (p omega)) ∧
      (∀ omega, Differentiable Real (q omega)) ∧
      (∀ omega, p omega 0 =
        ((initial omega).2 : HilbertConfiguration N)) ∧
      (∀ omega, q omega 0 =
        ((initial omega).1 : HilbertConfiguration N)) ∧
      (∀ omega, SatisfiesHamiltonEquations (mass omega) kappa beta g
        (p omega) (q omega)) ∧
      ∀ time : Real,
        HasDerivAt
          (fun s ↦ actualFiniteCubicEnsembleConnectedCumulant
            weight mass entry p q s)
          (actualFiniteCoerciveEnsembleConnectedCumulantHierarchySource
            weight mass kappa beta g entry p q time) time := by
  choose z hz0 hz using fun omega ↦
    exists_global_reducedTrajectory
      (mass omega) hbeta g (initial omega)
  let p : Omega → Time → HilbertConfiguration N :=
    fun omega ↦ physlibMomentumPathOfReducedTrajectory (z omega)
  let q : Omega → Time → HilbertConfiguration N :=
    fun omega ↦ physlibPositionPathOfReducedTrajectory (z omega)
  have hp : ∀ omega, Differentiable Real (p omega) := by
    intro omega
    exact differentiable_physlibMomentumPathOfReducedTrajectory
      (mass omega) kappa beta g (z omega) (hz omega)
  have hq : ∀ omega, Differentiable Real (q omega) := by
    intro omega
    exact differentiable_physlibPositionPathOfReducedTrajectory
      (mass omega) kappa beta g (z omega) (hz omega)
  have hp0 : ∀ omega,
      p omega 0 = ((initial omega).2 : HilbertConfiguration N) := by
    intro omega
    simp [p, physlibMomentumPathOfReducedTrajectory, hz0 omega]
  have hq0 : ∀ omega,
      q omega 0 = ((initial omega).1 : HilbertConfiguration N) := by
    intro omega
    simp [q, physlibPositionPathOfReducedTrajectory, hz0 omega]
  have hHamilton : ∀ omega,
      SatisfiesHamiltonEquations (mass omega) kappa beta g
        (p omega) (q omega) := by
    intro omega
    exact satisfiesHamiltonEquations_physlibPathsOfReducedTrajectory
      (mass omega) kappa beta g (z omega) (hz omega)
  refine ⟨p, q, hp, hq, hp0, hq0, hHamilton, ?_⟩
  intro time
  exact hasDerivAt_actualFiniteCoerciveEnsembleConnectedCumulant
    weight mass kappa beta g entry p q hp hq hHamilton homega time

end

end ArchonPhysics.PhyslibFPUTCoercivePositiveTimeCumulantHierarchy
