noncomputable section

local instance canonicalProbabilityMeasure :
    IsProbabilityMeasure canonicalIIDMassPhaseEnsemble.probability :=
  ⟨canonicalIIDMassPhaseEnsemble.probability_univ⟩

/-- The one Borel event used at every time in a fixed kinetic window. -/
def supervolumeSignedFreeGood
    (sizeCutoff : Real → Nat) (T : Real) (j : Nat) :
    Set RandomEnsemble.SampleSpace :=
  canonicalPhysicalSignedFreeGridGood
    (N := physicalSupervolumeSize sizeCutoff j)
    T (inverseLinearCoupling j)

/-- The exact normalization loss generated by the dimension-free Duhamel
and modal-energy errors. -/
def supervolumeNormalizationLoss
    (kappa beta T : Real) (j : Nat) : Real :=
  normalizationLoss
    (kineticConstant (canonicalDuhamelConstant kappa beta) 2 T) j

theorem canonicalKineticRawModalLoss_supervolume_eq
    (kappa beta T : Real) (j : Nat) :
    canonicalKineticRawModalLoss kappa beta 2 T
        (inverseLinearCoupling j) =
      modalRawError
        (kineticConstant (canonicalDuhamelConstant kappa beta) 2 T) j := by
  rfl

/-- The measurable good-event complements vanish along every requested
supervolume schedule. -/
theorem supervolumeSignedFreeGood_compl_measureReal_tendsto_zero
    (sizeCutoff : Real → Nat) (T : Real) (hT : 0 ≤ T) :
    Tendsto
      (fun j ↦ canonicalIIDMassPhaseEnsemble.probability.real
        (supervolumeSignedFreeGood sizeCutoff T j)ᶜ)
      atTop (nhds 0) := by
  exact _root_.ArchonPhysics.R32PhysicalSignedFreeBondConcentrationV3.physicalSupervolumeSignedFreeGridGood_compl_measureReal_tendsto_zero
      sizeCutoff T hT

theorem supervolumeNormalizationLoss_tendsto_zero
    (kappa beta T : Real) :
    Tendsto (supervolumeNormalizationLoss kappa beta T)
      atTop (nhds 0) := by
  exact normalizationLoss_tendsto_zero
    (kineticConstant (canonicalDuhamelConstant kappa beta) 2 T)

/-- The actual canonical Hamiltonian has uniform `1/8-o(1)` persistence on
the explicit supervolume path.  The universal time quantifier is inside the
high-probability event. -/
theorem canonical_supervolume_uniformWindowPersistence
    {kappa beta : Real} (hbeta : 2 * kappa ^ 2 / 9 < beta)
    {mu delta : Real} (hmu : 0 ≤ mu) (hmuOne : mu < 1)
    (hdelta : delta < (1 : Real) / 8)
    (sizeCutoff : Real → Nat) :
    UniformWindowPersistence kappa beta hbeta mu delta sizeCutoff
      (supervolumeJointLimit sizeCutoff) := by
  apply uniformWindowPersistence_of_good_events_and_vanishing_loss
    (supervolumeSignedFreeGood sizeCutoff)
    (supervolumeNormalizationLoss kappa beta)
  · intro T j
    exact measurableSet_canonicalPhysicalSignedFreeGridGood
      (N := physicalSupervolumeSize sizeCutoff j)
      T (inverseLinearCoupling j)
  · intro T hT
    exact supervolumeSignedFreeGood_compl_measureReal_tendsto_zero
      sizeCutoff T hT.le
  · intro T _hT
    exact supervolumeNormalizationLoss_tendsto_zero kappa beta T
  · intro T hT
    let B := kineticConstant (canonicalDuhamelConstant kappa beta) 2 T
    have hK : 0 ≤ canonicalDuhamelConstant kappa beta :=
      canonicalDuhamelConstant_nonneg kappa beta
    have hthreshold :
        0 < couplingThreshold
          (canonicalDuhamelConstant kappa beta) 2 T :=
      couplingThreshold_pos hK (by norm_num) hT.le
    have hgSmall : ∀ᶠ j in atTop,
        inverseLinearCoupling j ≤
          couplingThreshold
            (canonicalDuhamelConstant kappa beta) 2 T :=
      inverseLinearCoupling_tendsto_zero_real.eventually
        (Iic_mem_nhds hthreshold)
    have hrhoOne : ∀ᶠ j in atTop, modalRawError B j < 1 :=
      (modalRawError_tendsto_zero B).eventually
        (Iio_mem_nhds (by norm_num : (0 : Real) < 1))
    filter_upwards [hgSmall, hrhoOne] with j hjSmall hjrho
    have hN : 3 ≤ physicalSupervolumeSize sizeCutoff j := by
      unfold physicalSupervolumeSize
      omega
    have hphysicalAE := physicalRealization_ae
      (N := physicalSupervolumeSize sizeCutoff j)
      hN (a := (1 / 4 : Real)) (by norm_num) (by norm_num)
      kappa beta (inverseLinearCoupling j) hbeta
    filter_upwards [hphysicalAE] with omega hphysical
    intro hgood
    have hfreeSup : ∀ time ∈
        Icc (0 : Real) (T / inverseLinearCoupling j ^ 2), ∀ i,
        |bondVector
          (canonicalPhysicalPositionPath
            (N := physicalSupervolumeSize sizeCutoff j)
            kappa beta 0 hbeta (1 / 4) omega time) i| ≤
          inverseLinearCoupling j ^ 4 := by
      intro time htime i
      rw [_root_.ArchonPhysics.R32PhysicalSignedCanonicalFreeBondBridge.canonicalExactFreePhysicalPositionPathBond_eq_physicalSignedHaar
          hN kappa beta hbeta omega hgood.1 time i]
      exact canonicalPhysicalSignedFreeGridGood_implies_wholeWindow_bound
        hN T (inverseLinearCoupling j) hT.le
        (inverseLinearCoupling_pos j) hgood i time htime
    have hsqrtTwo : Real.sqrt 2 ≤ (2 : Real) := by
      nlinarith [Real.sq_sqrt (by norm_num : (0 : Real) ≤ 2),
        Real.sqrt_nonneg 2]
    have hloss : canonicalKineticRawModalLoss kappa beta 2 T
        (inverseLinearCoupling j) < 1 := by
      rw [canonicalKineticRawModalLoss_supervolume_eq]
      exact hjrho
    have hlower := canonical_uniformWindow_pathwise_lower
      hN kappa beta (inverseLinearCoupling j) 2 T mu hbeta omega
      hphysical (inverseLinearCoupling_pos j) hT hmu hmuOne hsqrtTwo
      hjSmall hfreeSup hloss
    intro tau htau htauT
    have h := hlower tau htau htauT
    change (1 : Real) / 8 - supervolumeNormalizationLoss kappa beta T j ≤
      scaledDistance kappa beta hbeta mu
        ((supervolumeJointLimit sizeCutoff).systemSize j)
        ((supervolumeJointLimit sizeCutoff).coupling j) omega tau
    rw [show (supervolumeJointLimit sizeCutoff).coupling j =
        inverseLinearCoupling j by rfl]
    change (1 : Real) / 8 - supervolumeNormalizationLoss kappa beta T j ≤
      canonicalFrozenLateWindowL1Distance
        (N := physicalSupervolumeSize sizeCutoff j)
        kappa beta (inverseLinearCoupling j) hbeta (1 / 4) mu
          (tau / inverseLinearCoupling j ^ 2) omega
    rw [supervolumeNormalizationLoss, normalizationLoss,
      ← canonicalKineticRawModalLoss_supervolume_eq]
    convert h using 1 <;> ring
  · exact hdelta

/-- Therefore the frozen root's full positive-mode first-hitting law cannot
hold at the current `g^(-2)` clock for any proof-produced size cutoff. -/
theorem not_exists_frozen_root_highProbabilityG2Bounds
    {kappa beta : Real} (hbeta : 2 * kappa ^ 2 / 9 < beta)
    {mu delta : Real} (hmu : 0 ≤ mu) (hmuOne : mu < 1)
    (hdelta : delta < (1 : Real) / 8) :
    ¬ ∃ (sizeCutoff : Real → Nat) (lower upper : Real),
      HighProbabilityG2Bounds
        canonicalIIDMassPhaseEnsemble.probability
        (measurableClosedEquilibrationTime
          kappa beta hbeta mu delta)
        sizeCutoff lower upper := by
  apply not_exists_cutoff_highProbabilityG2Bounds_of_uniformSupervolumePersistence
    hmu hmuOne hdelta
  intro sizeCutoff
  exact canonical_supervolume_uniformWindowPersistence
    hbeta hmu hmuOne hdelta sizeCutoff

