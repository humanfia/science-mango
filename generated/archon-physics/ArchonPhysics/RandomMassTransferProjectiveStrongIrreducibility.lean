import ArchonPhysics.RandomMassTransferGroupNoncompactness
import Mathlib.Dynamics.PeriodicPts.Lemmas
import Mathlib.LinearAlgebra.Projectivization.Action

/-!
# Projective strong irreducibility for two random-mass transfers

For a nonzero spectral parameter and two distinct masses, the subgroup
generated by the corresponding transfer matrices preserves no nonempty
finite family of real projective lines.  The proof uses the explicit
nontrivial relative shear from
`RandomMassTransferGroupNoncompactness`: a finite invariant family is also
invariant under the inverse of each generator, hence under the relative
shear; every periodic direction of that shear is horizontal; but a transfer
matrix sends a nonzero horizontal direction to a nonhorizontal one.

This is the algebraic projective strong-irreducibility input only.  No
Furstenberg theorem, Lyapunov-exponent conclusion, EFC, or localization
statement is invoked here.
-/

open scoped LinearAlgebra.Projectivization Matrix

namespace ArchonPhysics.RandomMassTransferProjectiveStrongIrreducibility

open ArchonPhysics
open ArchonPhysics.RandomMassAndersonTransferBridge
open ArchonPhysics.RandomMassTransferGroupNoncompactness
open ArchonPhysics.RandomMassTwoStepAnnealedTransferGrowth
open Function Set

noncomputable section

abbrev RealProjectiveLine := Projectivization Real (Fin 2 → Real)

/-- The Anderson transfer matrix has determinant one. -/
theorem andersonTransferMatrix_det (lambda mass : Real) :
    (andersonTransferMatrix lambda mass).det = 1 := by
  simp [andersonTransferMatrix, andersonDiagonalPotential,
    Matrix.det_fin_two_of]

/-- The one-site Anderson transfer as an element of `SL(2, ℝ)`. -/
def andersonTransferSL (lambda mass : Real) :
    Matrix.SpecialLinearGroup (Fin 2) Real :=
  ⟨andersonTransferMatrix lambda mass,
    andersonTransferMatrix_det lambda mass⟩

@[simp]
theorem andersonTransferSL_smul
    (lambda mass : Real) (state : Fin 2 → Real) :
    andersonTransferSL lambda mass • state =
      oneStepTransferState lambda mass state := by
  rfl

/-- The upper shear as an element of `SL(2, ℝ)`. -/
def upperUnipotentShearSL (shear : Real) :
    Matrix.SpecialLinearGroup (Fin 2) Real :=
  ⟨upperUnipotentShear shear, by
    simp [upperUnipotentShear, Matrix.det_fin_two_of]⟩

/-- The relative identity inside `SL(2, ℝ)`. -/
theorem andersonTransferSL_mul_inv_eq_upperUnipotentShearSL
    (lambda mass1 mass2 : Real) :
    andersonTransferSL lambda mass1 *
        (andersonTransferSL lambda mass2)⁻¹ =
      upperUnipotentShearSL (lambda * (mass2 - mass1)) := by
  apply Subtype.ext
  change andersonTransferMatrix lambda mass1 *
      Matrix.adjugate (andersonTransferMatrix lambda mass2) =
    upperUnipotentShear (lambda * (mass2 - mass1))
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnipotentShear, andersonTransferMatrix,
      andersonDiagonalPotential, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two];
    ring

/-- Projective equivalence of nonzero vectors is equality in Mathlib's
projectivization. -/
theorem projectivelyEquivalent_iff_mk_eq
    {left right : Fin 2 → Real} (hleft : left ≠ 0)
    (hright : right ≠ 0) :
    ProjectivelyEquivalent left right ↔
      Projectivization.mk Real left hleft =
        Projectivization.mk Real right hright := by
  constructor
  · rintro ⟨scale, hscale, rfl⟩
    rw [Projectivization.mk_eq_mk_iff' Real]
    exact ⟨scale⁻¹, by
      simp [hscale]⟩
  · intro h
    rw [Projectivization.mk_eq_mk_iff' Real] at h
    obtain ⟨scale, hscale⟩ := h
    have hscale_ne : scale ≠ 0 := by
      intro hz
      apply hleft
      simpa [hz] using hscale.symm
    refine ⟨scale⁻¹, inv_ne_zero hscale_ne, ?_⟩
    rw [← hscale]
    simp [hscale_ne]

/-- A projective-equivalence witness for one transfer step becomes an exact
equality of projective points. -/
theorem andersonTransferSL_smul_mk_eq_mk
    {lambda mass : Real} {left right : Fin 2 → Real}
    (hleft : left ≠ 0) (hright : right ≠ 0)
    (hprojective : ProjectivelyEquivalent
      (oneStepTransferState lambda mass left) right) :
    andersonTransferSL lambda mass •
        Projectivization.mk Real left hleft =
      Projectivization.mk Real right hright := by
  have hstep_ne : oneStepTransferState lambda mass left ≠ 0 := by
    rw [← andersonTransferSL_smul]
    exact (smul_ne_zero_iff_ne _).2 hleft
  rw [Projectivization.smul_mk]
  exact (projectivelyEquivalent_iff_mk_eq hstep_ne hright).1
    hprojective

/-- Smul by a group element is injective. -/
theorem group_smul_injective
    {G X : Type*} [Group G] [MulAction G X] (g : G) :
    Function.Injective (fun x : X => g • x) := by
  intro x y hxy
  have := congrArg (fun z => g⁻¹ • z) hxy
  simpa using this

/-- A finite forward-invariant set for a group action is also invariant under
the inverse action. -/
theorem finite_mapsTo_inverse
    {G X : Type*} [Group G] [MulAction G X]
    {s : Set X} (hs : s.Finite) (g : G)
    (hmaps : MapsTo (fun x => g • x) s s) :
    MapsTo (fun x => g⁻¹ • x) s s := by
  have hinj : InjOn (fun x : X => g • x) s :=
    (group_smul_injective g).injOn
  have hsurj : SurjOn (fun x : X => g • x) s s :=
    ((hs.injOn_iff_bijOn_of_mapsTo hmaps).1 hinj).surjOn
  intro x hx
  obtain ⟨y, hy, hyx⟩ := hsurj hx
  change g⁻¹ • x ∈ s
  rw [← hyx]
  change g⁻¹ • (g • y) ∈ s
  simpa using hy

/-- Exact coordinates of a powered shear acting on a vector. -/
theorem upperUnipotentShearSL_pow_smul_apply
    (shear : Real) (n : Nat) (state : Fin 2 → Real) :
    ((upperUnipotentShearSL shear) ^ n • state) 0 =
        state 0 + (n : Real) * shear * state 1 ∧
      ((upperUnipotentShearSL shear) ^ n • state) 1 = state 1 := by
  change
    Matrix.mulVec (upperUnipotentShear shear ^ n) state 0 = _ ∧
      Matrix.mulVec (upperUnipotentShear shear ^ n) state 1 = _
  rw [upperUnipotentShear_pow]
  constructor <;>
    simp [upperUnipotentShear, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two]

/-- Every positive-period projective point of a nontrivial upper shear is the
horizontal direction. -/
theorem periodic_upperUnipotentShearSL_is_horizontal
    {shear : Real} (hshear : shear ≠ 0) {n : Nat} (hn : 0 < n)
    {state : Fin 2 → Real} (hstate : state ≠ 0)
    (hperiod :
      (upperUnipotentShearSL shear) ^ n •
          Projectivization.mk Real state hstate =
        Projectivization.mk Real state hstate) :
    state 1 = 0 := by
  have hacted :
      (upperUnipotentShearSL shear) ^ n • state ≠ 0 :=
    (smul_ne_zero_iff_ne _).2 hstate
  rw [Projectivization.smul_mk,
    Projectivization.mk_eq_mk_iff' Real] at hperiod
  obtain ⟨scale, hscale⟩ := hperiod
  have hcoordinates := upperUnipotentShearSL_pow_smul_apply
    shear n state
  have hzero := congrFun hscale 0
  have hone := congrFun hscale 1
  simp only [Pi.smul_apply, smul_eq_mul] at hzero hone
  rw [hcoordinates.1] at hzero
  rw [hcoordinates.2] at hone
  by_contra hstate1
  have hscale_one : scale = 1 := by
    apply (mul_right_cancel₀ hstate1)
    simpa using hone
  rw [hscale_one, one_mul] at hzero
  have hnreal : (n : Real) ≠ 0 := by exact_mod_cast (ne_of_gt hn)
  exact mul_ne_zero (mul_ne_zero hnreal hshear) hstate1
    (by linarith [hzero])

/-- A point in a finite forward-invariant set of a group action is periodic
under the restricted action. -/
theorem finite_invariant_point_periodic
    {G X : Type*} [Group G] [MulAction G X]
    {s : Set X} (hs : s.Finite) (g : G)
    (hmaps : MapsTo (fun x => g • x) s s)
    {x : X} (hx : x ∈ s) :
    ∃ n : Nat, 0 < n ∧ g ^ n • x = x := by
  let restricted : s → s := fun y => ⟨g • y.1, hmaps y.2⟩
  have hrestricted : Function.Injective restricted := by
    intro y z hyz
    apply Subtype.ext
    exact group_smul_injective g (congrArg Subtype.val hyz)
  let _ : Finite s := Set.finite_coe_iff.mpr hs
  have hperiodic := hrestricted.mem_periodicPts ⟨x, hx⟩
  obtain ⟨n, hn, hnperiod⟩ := hperiodic
  refine ⟨n, hn, ?_⟩
  have hiterate :
      ∀ m : Nat, ((restricted^[m]) ⟨x, hx⟩).1 = g ^ m • x := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
        rw [Function.iterate_succ_apply']
        change g • ((restricted^[m]) ⟨x, hx⟩).1 = _
        rw [ih]
        simp [pow_succ', mul_smul]
  have := congrArg Subtype.val hnperiod
  rw [hiterate n] at this
  exact this

/-- Two distinct masses at a nonzero parameter preserve no nonempty finite
family of real projective lines. -/
theorem twoMass_isProjectivelyStronglyIrreducible
    {lambda mass1 mass2 : Real} (hlambda : lambda ≠ 0)
    (hmass : mass1 ≠ mass2) :
    IsProjectivelyStronglyIrreducible lambda mass1 mass2 := by
  intro hpreserves
  obtain ⟨k, hk, direction, hdirection, hmass1, hmass2⟩ :=
    hpreserves
  let point : Fin k → RealProjectiveLine := fun i =>
    Projectivization.mk Real (direction i) (hdirection i)
  let family : Set RealProjectiveLine := Set.range point
  have hfamily_finite : family.Finite := Set.finite_range point
  have hmaps1 : MapsTo
      (fun p => andersonTransferSL lambda mass1 • p)
      family family := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨j, hij⟩ := hmass1 i
    refine ⟨j, ?_⟩
    exact (andersonTransferSL_smul_mk_eq_mk
      (hdirection i) (hdirection j) hij).symm
  have hmaps2 : MapsTo
      (fun p => andersonTransferSL lambda mass2 • p)
      family family := by
    rintro _ ⟨i, rfl⟩
    obtain ⟨j, hij⟩ := hmass2 i
    refine ⟨j, ?_⟩
    exact (andersonTransferSL_smul_mk_eq_mk
      (hdirection i) (hdirection j) hij).symm
  have hmaps2_inv := finite_mapsTo_inverse hfamily_finite
    (andersonTransferSL lambda mass2) hmaps2
  have hrelative : MapsTo
      (fun p => (andersonTransferSL lambda mass1 *
        (andersonTransferSL lambda mass2)⁻¹) • p)
      family family := by
    intro p hp
    simpa [mul_smul] using hmaps1 (hmaps2_inv hp)
  have hshear : MapsTo
      (fun p => upperUnipotentShearSL
        (lambda * (mass2 - mass1)) • p)
      family family := by
    rw [← andersonTransferSL_mul_inv_eq_upperUnipotentShearSL]
    exact hrelative
  have hshear_ne : lambda * (mass2 - mass1) ≠ 0 :=
    mul_ne_zero hlambda (sub_ne_zero.mpr hmass.symm)
  have hhorizontal : ∀ i, direction i 1 = 0 := by
    intro i
    have hi : point i ∈ family := ⟨i, rfl⟩
    obtain ⟨n, hn, hperiod⟩ := finite_invariant_point_periodic
      hfamily_finite
      (upperUnipotentShearSL (lambda * (mass2 - mass1)))
      hshear hi
    exact periodic_upperUnipotentShearSL_is_horizontal
      hshear_ne hn (hdirection i) hperiod
  let i0 : Fin k := ⟨0, hk⟩
  obtain ⟨j, hij⟩ := hmass1 i0
  obtain ⟨scale, hscale_ne, hscale⟩ := hij
  have hstate0 : direction i0 0 ≠ 0 := by
    intro hzero
    apply hdirection i0
    funext i
    fin_cases i
    · exact hzero
    · exact hhorizontal i0
  have hcoord := congrFun hscale 1
  simp only [Pi.smul_apply, smul_eq_mul] at hcoord
  rw [oneStepTransferState_apply_one, hhorizontal j] at hcoord
  exact mul_ne_zero hscale_ne hstate0 hcoord.symm

/-- Frozen-support specialization of projective strong irreducibility. -/
theorem frozenSupport_twoMass_isProjectivelyStronglyIrreducible
    {lambda mass1 mass2 : Real} (hlambda : 0 < lambda)
    (hmass1 : mass1 ∈ RandomEnsemble.massSupport)
    (hmass2 : mass2 ∈ RandomEnsemble.massSupport)
    (hmass : mass1 ≠ mass2) :
    mass1 ∈ RandomEnsemble.massSupport ∧
      mass2 ∈ RandomEnsemble.massSupport ∧
      IsProjectivelyStronglyIrreducible lambda mass1 mass2 := by
  exact ⟨hmass1, hmass2,
    twoMass_isProjectivelyStronglyIrreducible (ne_of_gt hlambda) hmass⟩

end

end ArchonPhysics.RandomMassTransferProjectiveStrongIrreducibility
