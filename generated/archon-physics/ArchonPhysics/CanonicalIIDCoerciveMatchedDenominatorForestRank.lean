/-! ## Integer generation of cumulative denominators -/

/-- The additive subgroup generated by a finite list, presented without
quotients or a choice of coefficients.  It is the right structural notion
for cumulative denominators, which are made using addition and negation. -/
inductive AdditivelyGeneratedBy (generators : List Real) : Real → Prop
  | generator {value : Real} : value ∈ generators →
      AdditivelyGeneratedBy generators value
  | zero : AdditivelyGeneratedBy generators 0
  | add {left right : Real} :
      AdditivelyGeneratedBy generators left →
      AdditivelyGeneratedBy generators right →
      AdditivelyGeneratedBy generators (left + right)
  | neg {value : Real} :
      AdditivelyGeneratedBy generators value →
      AdditivelyGeneratedBy generators (-value)

theorem additivelyGeneratedBy_sub
    {generators : List Real} {left right : Real}
    (hleft : AdditivelyGeneratedBy generators left)
    (hright : AdditivelyGeneratedBy generators right) :
    AdditivelyGeneratedBy generators (left - right) := by
  rw [sub_eq_add_neg]
  exact hleft.add hright.neg

/-- Change generators whenever every old generator is generated by the new
family. -/
theorem AdditivelyGeneratedBy.mono
    {source target : List Real} {value : Real}
    (hgenerator : ∀ x ∈ source, AdditivelyGeneratedBy target x)
    (hvalue : AdditivelyGeneratedBy source value) :
    AdditivelyGeneratedBy target value := by
  induction hvalue with
  | generator hmem => exact hgenerator _ hmem
  | zero => exact .zero
  | add hleft hright ihleft ihrigh => exact ihleft.add ihrigh
  | neg hvalue ih => exact ih.neg

theorem additivelyGeneratedBy_of_mem
    {generators : List Real} {value : Real} (hvalue : value ∈ generators) :
    AdditivelyGeneratedBy generators value :=
  .generator hvalue

theorem list_sum_additivelyGeneratedBy
    {generators values : List Real}
    (hvalues : ∀ value ∈ values,
      AdditivelyGeneratedBy generators value) :
    AdditivelyGeneratedBy generators values.sum := by
  induction values with
  | nil => exact .zero
  | cons value values ih =>
      simpa only [List.sum_cons] using
        (hvalues value (by simp)).add
          (ih (fun x hx => hvalues x (by simp [hx])))

theorem own_list_sum_additivelyGeneratedBy (values : List Real) :
    AdditivelyGeneratedBy values values.sum :=
  list_sum_additivelyGeneratedBy fun value hvalue => .generator hvalue

/-- Every denominator exposed by the full ordered integration-by-parts tree
is generated by the original local phase list. -/
theorem orderedHistoryDenominators_additivelyGenerated :
    ∀ (phases : List Real) (delta : Real),
      delta ∈ orderedHistoryDenominators phases →
        AdditivelyGeneratedBy phases delta
  | [], delta, hdelta => by
      simp [orderedHistoryDenominators] at hdelta
  | [phase], delta, hdelta => by
      exact AdditivelyGeneratedBy.generator (by
        simpa [orderedHistoryDenominators] using hdelta)
  | phaseOne :: phaseTwo :: tail, delta, hdelta => by
      simp only [orderedHistoryDenominators, List.mem_cons,
        List.mem_append] at hdelta
      rcases hdelta with hfirst | hdrop | hmerge
      · exact AdditivelyGeneratedBy.generator (by simp [hfirst])
      · exact (orderedHistoryDenominators_additivelyGenerated
          (phaseTwo :: tail) delta hdrop).mono
            (fun x hx => .generator (by simp [hx]))
      · exact (orderedHistoryDenominators_additivelyGenerated
          ((phaseOne + phaseTwo) :: tail) delta hmerge).mono
            (fun x hx => by
              simp only [List.mem_cons] at hx
              rcases hx with rfl | hx
              · exact (AdditivelyGeneratedBy.generator (by simp :
                    phaseOne ∈ phaseOne :: phaseTwo :: tail)).add
                  (AdditivelyGeneratedBy.generator (by simp :
                    phaseTwo ∈ phaseOne :: phaseTwo :: tail))
              · exact AdditivelyGeneratedBy.generator (by simp [hx]))
termination_by phases => phases.length

/-! ## A canonical local-phase list for branching histories -/

/-- Move a head element across a list. -/
theorem perm_cons_append (value : Real) : ∀ left right : List Real,
    (value :: left ++ right).Perm (left ++ value :: right)
  | [], right => List.Perm.refl _
  | head :: tail, right => by
      exact (List.Perm.swap value head (tail ++ right)).symm.trans
        ((perm_cons_append value tail right).cons head)

/-- Every ordered shuffle preserves the two input multisets. -/
theorem perm_append_of_mem_orderedPhaseShuffles
    {left right shuffled : List Real}
    (hshuffled : shuffled ∈ orderedPhaseShuffles left right) :
    shuffled.Perm (left ++ right) := by
  induction left, right using orderedPhaseShuffles.induct generalizing shuffled with
  | case1 =>
      simp [orderedPhaseShuffles] at hshuffled
      subst shuffled
      exact List.Perm.refl _
  | case2 rightHead rightTail =>
      simp [orderedPhaseShuffles] at hshuffled
      subst shuffled
      exact List.Perm.refl _
  | case3 leftHead leftTail =>
      simp [orderedPhaseShuffles] at hshuffled
      subst shuffled
      simp
  | case4 leftHead leftTail rightHead rightTail ihleft ihrigh =>
      simp only [orderedPhaseShuffles, List.mem_append, List.mem_map] at hshuffled
      rcases hshuffled with hleft | hright
      · rcases hleft with ⟨tail, htail, rfl⟩
        exact (ihleft htail).cons leftHead
      · rcases hright with ⟨tail, htail, rfl⟩
        exact ((ihrigh htail).cons rightHead).trans
          (perm_cons_append rightHead (leftHead :: leftTail) rightTail)

/-- Canonical preorder list of the phase attached to every internal node. -/
def branchingPhaseList :
    (tree : BinaryInteractionTree) →
      BinaryInteractionTreePhaseAssignment tree → List Real
  | .leaf, _assignment => []
  | .node left right, assignment =>
      assignment.1 ::
        (branchingPhaseList left assignment.2.1 ++
          branchingPhaseList right assignment.2.2)

@[simp] theorem length_branchingPhaseList
    (tree : BinaryInteractionTree)
    (assignment : BinaryInteractionTreePhaseAssignment tree) :
    (branchingPhaseList tree assignment).length = tree.order := by
  induction tree with
  | leaf => rfl
  | node left right hleft hright =>
      simp [branchingPhaseList, BinaryInteractionTree.order,
        hleft, hright]

/-- Every branching linear extension is a permutation of the canonical
node-phase list. -/
theorem perm_branchingPhaseList_of_mem_linearExtensions
    (tree : BinaryInteractionTree)
    (assignment : BinaryInteractionTreePhaseAssignment tree)
    {phases : List Real}
    (hphases : phases ∈ branchingPhaseLinearExtensions tree assignment) :
    phases.Perm (branchingPhaseList tree assignment) := by
  induction tree generalizing phases with
  | leaf =>
      simp [branchingPhaseLinearExtensions, branchingPhaseList] at hphases
      subst phases
      exact List.Perm.refl _
  | node left right hleft hright =>
      simp only [branchingPhaseLinearExtensions, List.mem_map] at hphases
      rcases hphases with ⟨children, hchildren, rfl⟩
      unfold shufflePhaseFamilies at hchildren
      simp only [List.mem_flatMap] at hchildren
      rcases hchildren with
        ⟨leftPhases, hleftMem, rightPhases, hrightMem, hshuffle⟩
      have hpermShuffle :=
        perm_append_of_mem_orderedPhaseShuffles hshuffle
      have hpermChildren :
          (leftPhases ++ rightPhases).Perm
            (branchingPhaseList left assignment.2.1 ++
              branchingPhaseList right assignment.2.2) :=
        (hleft assignment.2.1 hleftMem).append
          (hright assignment.2.2 hrightMem)
      exact (hpermShuffle.trans hpermChildren).cons assignment.1

/-- All cumulative denominators of every branching linear extension are
generated by the canonical local-node phase list. -/
theorem branchingHistoryDenominators_additivelyGenerated
    (tree : BinaryInteractionTree)
    (assignment : BinaryInteractionTreePhaseAssignment tree)
    (delta : Real)
    (hdelta : delta ∈ branchingHistoryDenominators tree assignment) :
    AdditivelyGeneratedBy (branchingPhaseList tree assignment) delta := by
  simp only [branchingHistoryDenominators, List.mem_flatMap] at hdelta
  rcases hdelta with ⟨phases, hphases, hdelta⟩
  have hordered :=
    orderedHistoryDenominators_additivelyGenerated phases delta hdelta
  exact hordered.mono fun value hvalue =>
    .generator
      ((perm_branchingPhaseList_of_mem_linearExtensions
        tree assignment hphases).mem_iff.mp hvalue)

/-! ## Actual local mismatch assignment on a decorated tree -/

/-- Multiply every local phase in a dependent assignment by one scalar. -/
def scaleBranchingPhaseAssignment (scale : Real) :
    (tree : BinaryInteractionTree) →
      BinaryInteractionTreePhaseAssignment tree →
        BinaryInteractionTreePhaseAssignment tree
  | .leaf, _assignment => PUnit.unit
  | .node left right, assignment =>
      (scale * assignment.1,
        (scaleBranchingPhaseAssignment scale left assignment.2.1,
          scaleBranchingPhaseAssignment scale right assignment.2.2))

theorem sum_branchingPhaseList_scale
    (scale : Real) (tree : BinaryInteractionTree)
    (assignment : BinaryInteractionTreePhaseAssignment tree) :
    (branchingPhaseList tree
      (scaleBranchingPhaseAssignment scale tree assignment)).sum =
        scale * (branchingPhaseList tree assignment).sum := by
  induction tree with
  | leaf => simp [branchingPhaseList, scaleBranchingPhaseAssignment]
  | node left right hleft hright =>
      simp [branchingPhaseList, scaleBranchingPhaseAssignment,
        hleft, hright]
      ring

/-- Actual local vertex mismatches, with the cumulative edge sign applied
to every descendant phase. -/
def actualBinaryTreePhaseAssignment {Mode : Type*}
    (frequency : Mode → Real) :
    (tree : RandomEigenmodeBinaryTree Mode) →
      BinaryInteractionTreePhaseAssignment tree.shape
  | .leaf _mode => PUnit.unit
  | .node output leftSign rightSign left right =>
      (binaryVertexMismatch frequency output leftSign rightSign
          left.rootMode right.rootMode,
        (scaleBranchingPhaseAssignment (leftSign.exponent : Real)
            left.shape (actualBinaryTreePhaseAssignment frequency left),
          scaleBranchingPhaseAssignment (rightSign.exponent : Real)
            right.shape (actualBinaryTreePhaseAssignment frequency right)))

/-- Canonical actual local-mismatch list of a decorated binary history. -/
def actualBinaryTreePhaseList {Mode : Type*}
    (frequency : Mode → Real) (tree : RandomEigenmodeBinaryTree Mode) :
    List Real :=
  branchingPhaseList tree.shape
    (actualBinaryTreePhaseAssignment frequency tree)

@[simp] theorem length_actualBinaryTreePhaseList {Mode : Type*}
    (frequency : Mode → Real) (tree : RandomEigenmodeBinaryTree Mode) :
    (actualBinaryTreePhaseList frequency tree).length = tree.shape.order :=
  length_branchingPhaseList tree.shape
    (actualBinaryTreePhaseAssignment frequency tree)

/-- The signed local vertex mismatches telescope exactly to the existing
output-minus-leaf mismatch of the decorated tree. -/
theorem sum_actualBinaryTreePhaseList_eq_frequencyMismatch
    {Mode : Type*} (frequency : Mode → Real)
    (tree : RandomEigenmodeBinaryTree Mode) :
    (actualBinaryTreePhaseList frequency tree).sum =
      binaryTreeFrequencyMismatch frequency tree := by
  induction tree with
  | leaf mode =>
      change (List.sum [] : Real) = frequency mode - frequency mode
      simp
  | node output leftSign rightSign left right hleft hright =>
      rw [binaryTreeFrequencyMismatch_node]
      change
        (binaryVertexMismatch frequency output leftSign rightSign
              left.rootMode right.rootMode ::
            (branchingPhaseList left.shape
                (scaleBranchingPhaseAssignment
                  (leftSign.exponent : Real) left.shape
                  (actualBinaryTreePhaseAssignment frequency left)) ++
              branchingPhaseList right.shape
                (scaleBranchingPhaseAssignment
                  (rightSign.exponent : Real) right.shape
                  (actualBinaryTreePhaseAssignment frequency right)))).sum = _
      simp only [List.sum_cons, List.sum_append]
      rw [sum_branchingPhaseList_scale,
        sum_branchingPhaseList_scale]
      change
        binaryVertexMismatch frequency output leftSign rightSign
              left.rootMode right.rootMode +
            ((leftSign.exponent : Real) *
                (actualBinaryTreePhaseList frequency left).sum +
              (rightSign.exponent : Real) *
                (actualBinaryTreePhaseList frequency right).sum) = _
      rw [hleft, hright]
      simp only [phaseSignActReal]
      ring

/-- Actual cumulative denominator list of a decorated binary history. -/
def actualBinaryTreeDenominators {Mode : Type*}
    (frequency : Mode → Real) (tree : RandomEigenmodeBinaryTree Mode) :
    List Real :=
  branchingHistoryDenominators tree.shape
    (actualBinaryTreePhaseAssignment frequency tree)

theorem actualBinaryTreeDenominators_additivelyGenerated
    {Mode : Type*} (frequency : Mode → Real)
    (tree : RandomEigenmodeBinaryTree Mode) (delta : Real)
    (hdelta : delta ∈ actualBinaryTreeDenominators frequency tree) :
    AdditivelyGeneratedBy (actualBinaryTreePhaseList frequency tree) delta :=
  branchingHistoryDenominators_additivelyGenerated
    tree.shape (actualBinaryTreePhaseAssignment frequency tree) delta hdelta


/-! ## One matched-root relation and the corrected forest rank -/

/-- Eliminate the first generator of the right history using equality of the
two total phase sums. -/
def matchedPhaseBasis (left right : List Real) : List Real :=
  left ++ right.tail

theorem length_matchedPhaseBasis_of_right_ne_nil
    (left right : List Real) (hright : right ≠ []) :
    (matchedPhaseBasis left right).length =
      left.length + right.length - 1 := by
  cases right with
  | nil => exact False.elim (hright rfl)
  | cons head tail => simp [matchedPhaseBasis]

theorem left_generator_additivelyGeneratedBy_matchedPhaseBasis
    {left right : List Real} {value : Real} (hvalue : value ∈ left) :
    AdditivelyGeneratedBy (matchedPhaseBasis left right) value :=
  .generator (by simp [matchedPhaseBasis, hvalue])

/-- The omitted right-head phase is the left total minus the sum of the
remaining right phases. Hence every right generator lies in the reduced
basis. -/
theorem right_generator_additivelyGeneratedBy_matchedPhaseBasis
    {left right : List Real} (hright : right ≠ [])
    (hsum : left.sum = right.sum) {value : Real} (hvalue : value ∈ right) :
    AdditivelyGeneratedBy (matchedPhaseBasis left right) value := by
  cases right with
  | nil => exact False.elim (hright rfl)
  | cons head tail =>
      simp only [List.sum_cons] at hsum
      simp only [List.mem_cons] at hvalue
      rcases hvalue with rfl | htailValue
      · have hleftSum :
            AdditivelyGeneratedBy (matchedPhaseBasis left (value :: tail))
              left.sum :=
          list_sum_additivelyGeneratedBy fun x hx =>
            .generator (by simp [matchedPhaseBasis, hx])
        have htailSum :
            AdditivelyGeneratedBy (matchedPhaseBasis left (value :: tail))
              tail.sum :=
          list_sum_additivelyGeneratedBy fun x hx =>
            .generator (by simp [matchedPhaseBasis, hx])
        have hhead : value = left.sum - tail.sum := by linarith
        rw [hhead]
        exact additivelyGeneratedBy_sub hleftSum htailSum
      · exact .generator (by simp [matchedPhaseBasis, htailValue])

/-- Exact corrected ordered-history theorem: after one matched-total
relation, all denominator occurrences of the two histories use only
`left.length + right.length - 1` generators. -/
theorem matchedOrderedHistoryDenominators_additivelyGenerated
    (left right : List Real) (hright : right ≠ [])
    (hsum : left.sum = right.sum) (delta : Real)
    (hdelta : delta ∈
      orderedHistoryDenominators left ++
        orderedHistoryDenominators right) :
    AdditivelyGeneratedBy (matchedPhaseBasis left right) delta := by
  simp only [List.mem_append] at hdelta
  rcases hdelta with hleft | hrightDelta
  · exact (orderedHistoryDenominators_additivelyGenerated
      left delta hleft).mono fun value hvalue =>
        left_generator_additivelyGeneratedBy_matchedPhaseBasis hvalue
  · exact (orderedHistoryDenominators_additivelyGenerated
      right delta hrightDelta).mono fun value hvalue =>
        right_generator_additivelyGeneratedBy_matchedPhaseBasis
          hright hsum hvalue

/-- Reduced local-phase basis for a pair of branching histories. -/
def matchedBranchingPhaseBasis
    (leftTree rightTree : BinaryInteractionTree)
    (leftAssignment : BinaryInteractionTreePhaseAssignment leftTree)
    (rightAssignment : BinaryInteractionTreePhaseAssignment rightTree) :
    List Real :=
  matchedPhaseBasis
    (branchingPhaseList leftTree leftAssignment)
    (branchingPhaseList rightTree rightAssignment)

/-- The branching analogue includes every shuffled and cumulative
denominator, not just the two local phase lists. -/
theorem matchedBranchingHistoryDenominators_additivelyGenerated
    (leftTree rightTree : BinaryInteractionTree)
    (leftAssignment : BinaryInteractionTreePhaseAssignment leftTree)
    (rightAssignment : BinaryInteractionTreePhaseAssignment rightTree)
    (hright : 0 < rightTree.order)
    (hsum : (branchingPhaseList leftTree leftAssignment).sum =
      (branchingPhaseList rightTree rightAssignment).sum)
    (delta : Real)
    (hdelta : delta ∈
      branchingHistoryDenominators leftTree leftAssignment ++
        branchingHistoryDenominators rightTree rightAssignment) :
    AdditivelyGeneratedBy
      (matchedBranchingPhaseBasis leftTree rightTree
        leftAssignment rightAssignment) delta := by
  have hrightList : branchingPhaseList rightTree rightAssignment ≠ [] := by
    intro hnil
    have hlength := congrArg List.length hnil
    rw [length_branchingPhaseList] at hlength
    simp at hlength
    omega
  simp only [List.mem_append] at hdelta
  rcases hdelta with hleft | hrightDelta
  · exact (branchingHistoryDenominators_additivelyGenerated
      leftTree leftAssignment delta hleft).mono fun value hvalue =>
        left_generator_additivelyGeneratedBy_matchedPhaseBasis hvalue
  · exact (branchingHistoryDenominators_additivelyGenerated
      rightTree rightAssignment delta hrightDelta).mono fun value hvalue =>
        right_generator_additivelyGeneratedBy_matchedPhaseBasis
          hrightList hsum hvalue

theorem length_matchedBranchingPhaseBasis
    (leftTree rightTree : BinaryInteractionTree)
    (leftAssignment : BinaryInteractionTreePhaseAssignment leftTree)
    (rightAssignment : BinaryInteractionTreePhaseAssignment rightTree)
    (hright : 0 < rightTree.order) :
    (matchedBranchingPhaseBasis leftTree rightTree
      leftAssignment rightAssignment).length =
        leftTree.order + rightTree.order - 1 := by
  have hrightList : branchingPhaseList rightTree rightAssignment ≠ [] := by
    intro hnil
    have hlength := congrArg List.length hnil
    rw [length_branchingPhaseList] at hlength
    simp at hlength
    omega
  unfold matchedBranchingPhaseBasis
  rw [length_matchedPhaseBasis_of_right_ne_nil _ _ hrightList,
    length_branchingPhaseList, length_branchingPhaseList]


/-- Common root and equal Haar charge force equality of total tree
mismatches. This is the single relation used above. -/
theorem binaryTreeFrequencyMismatch_eq_of_rootMode_eq_of_charge_eq
    {Mode : Type*} [Fintype Mode] [DecidableEq Mode]
    (frequency : Mode → Real)
    {left right : RandomEigenmodeBinaryTree Mode}
    (hroot : left.rootMode = right.rootMode)
    (hcharge : binaryTreePhaseCharge left = binaryTreePhaseCharge right) :
    binaryTreeFrequencyMismatch frequency left =
      binaryTreeFrequencyMismatch frequency right := by
  unfold binaryTreeFrequencyMismatch
  rw [binaryTreeCarriedFrequency_eq_chargeFrequency,
    binaryTreeCarriedFrequency_eq_chargeFrequency, hroot, hcharge]

/-- Reduced basis of an actual decorated history couple. -/
def actualMatchedCouplePhaseBasis {Mode : Type*}
    (frequency : Mode → Real) (couple : BinaryInteractionTreeCouple Mode) :
    List Real :=
  matchedPhaseBasis
    (actualBinaryTreePhaseList frequency couple.1)
    (actualBinaryTreePhaseList frequency couple.2)

/-- All actual branching denominators in the ordered couple. -/
def actualMatchedCoupleDenominators {Mode : Type*}
    (frequency : Mode → Real) (couple : BinaryInteractionTreeCouple Mode) :
    List Real :=
  actualBinaryTreeDenominators frequency couple.1 ++
    actualBinaryTreeDenominators frequency couple.2

/-- Corrected structural/forest rank: the number of explicit generators in
the reduced actual phase basis. -/
def actualMatchedCoupleForestRank {Mode : Type*}
    (frequency : Mode → Real) (couple : BinaryInteractionTreeCouple Mode) :
    Nat :=
  (actualMatchedCouplePhaseBasis frequency couple).length

/-- Actual Haar-matched, common-root histories obey the corrected generator
theorem with no analytic rank hypothesis. -/
theorem actualMatchedCoupleDenominators_additivelyGenerated
    {Mode : Type*} [Fintype Mode] [DecidableEq Mode]
    (frequency : Mode → Real) (couple : BinaryInteractionTreeCouple Mode)
    (hright : 0 < couple.2.shape.order)
    (hroot : couple.1.rootMode = couple.2.rootMode)
    (hbalanced : leafPhaseBalanced couple)
    (delta : Real) (hdelta : delta ∈
      actualMatchedCoupleDenominators frequency couple) :
    AdditivelyGeneratedBy
      (actualMatchedCouplePhaseBasis frequency couple) delta := by
  have hcharge : binaryTreePhaseCharge couple.1 =
      binaryTreePhaseCharge couple.2 :=
    (leafPhaseBalanced_iff_charge_eq couple).mp hbalanced
  have hsum : (actualBinaryTreePhaseList frequency couple.1).sum =
      (actualBinaryTreePhaseList frequency couple.2).sum := by
    rw [sum_actualBinaryTreePhaseList_eq_frequencyMismatch,
      sum_actualBinaryTreePhaseList_eq_frequencyMismatch]
    exact binaryTreeFrequencyMismatch_eq_of_rootMode_eq_of_charge_eq
      frequency hroot hcharge
  exact matchedBranchingHistoryDenominators_additivelyGenerated
    couple.1.shape couple.2.shape
    (actualBinaryTreePhaseAssignment frequency couple.1)
    (actualBinaryTreePhaseAssignment frequency couple.2)
    hright hsum delta hdelta

/-- The corrected actual rank is `total vertices - 1`; exponential
denominator occurrence multiplicity does not enter. -/
theorem actualMatchedCoupleForestRank_eq_power_sub_one
    {Mode : Type*} (frequency : Mode → Real)
    (couple : BinaryInteractionTreeCouple Mode)
    (hright : 0 < couple.2.shape.order) :
    actualMatchedCoupleForestRank frequency couple =
      coupleInteractionPower couple - 1 := by
  unfold actualMatchedCoupleForestRank actualMatchedCouplePhaseBasis
  rw [length_matchedPhaseBasis_of_right_ne_nil]
  · rw [length_actualBinaryTreePhaseList,
      length_actualBinaryTreePhaseList]
    rfl
  · intro hnil
    have hlength := congrArg List.length hnil
    rw [length_actualBinaryTreePhaseList] at hlength
    simp at hlength
    omega

/-- For an equal-order nontrivial couple, the corrected rank is `2r-1`. -/
theorem actualMatchedCoupleForestRank_eq_two_mul_order_sub_one
    {Mode : Type*} (frequency : Mode → Real)
    (couple : BinaryInteractionTreeCouple Mode) (order : Nat)
    (hleft : couple.1.shape.order = order)
    (hright : couple.2.shape.order = order) (horder : 0 < order) :
    actualMatchedCoupleForestRank frequency couple = 2 * order - 1 := by
  rw [actualMatchedCoupleForestRank_eq_power_sub_one frequency couple
    (by omega)]
  unfold coupleInteractionPower
  omega

/-- Arithmetic diagnosis: the universal corrected equal-order rank is no
larger than the interaction-pair count exactly at orders zero and one. -/
theorem two_mul_order_sub_one_le_order_iff (order : Nat) :
    2 * order - 1 ≤ order ↔ order ≤ 1 := by
  omega


/-! ## Gardens of matched actual couples -/

/-- Flatten all actual denominator occurrences in a finite garden of ordered
matched couples. -/
def actualMatchedCoupleGardenDenominators {Mode : Type*}
    (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode)) : List Real :=
  garden.flatMap (actualMatchedCoupleDenominators frequency)

/-- Concatenate the reduced bases, one independent matched-total relation per
couple. -/
def actualMatchedCoupleGardenPhaseBasis {Mode : Type*}
    (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode)) : List Real :=
  garden.flatMap (actualMatchedCouplePhaseBasis frequency)

/-- Corrected forest rank of the finite matched-couple garden. -/
def actualMatchedCoupleGardenForestRank {Mode : Type*}
    (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode)) : Nat :=
  (actualMatchedCoupleGardenPhaseBasis frequency garden).length

/-- Every denominator in a garden is generated by the concatenated reduced
basis. Shared and nested cumulative denominators are already included by the
branching enumeration theorem. -/
theorem actualMatchedCoupleGardenDenominators_additivelyGenerated
    {Mode : Type*} [Fintype Mode] [DecidableEq Mode]
    (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode))
    (hright : ∀ couple ∈ garden, 0 < couple.2.shape.order)
    (hroot : ∀ couple ∈ garden, couple.1.rootMode = couple.2.rootMode)
    (hbalanced : ∀ couple ∈ garden, leafPhaseBalanced couple)
    (delta : Real)
    (hdelta : delta ∈ actualMatchedCoupleGardenDenominators frequency garden) :
    AdditivelyGeneratedBy
      (actualMatchedCoupleGardenPhaseBasis frequency garden) delta := by
  induction garden with
  | nil =>
      simp [actualMatchedCoupleGardenDenominators] at hdelta
  | cons couple garden ih =>
      simp only [actualMatchedCoupleGardenDenominators, List.flatMap_cons,
        List.mem_append] at hdelta
      rcases hdelta with hhead | htail
      · have hgenerated := actualMatchedCoupleDenominators_additivelyGenerated
          frequency couple (hright couple (by simp))
          (hroot couple (by simp)) (hbalanced couple (by simp)) delta hhead
        exact hgenerated.mono fun value hvalue =>
          .generator (by
            simp [actualMatchedCoupleGardenPhaseBasis, hvalue])
      · have hgenerated := ih
          (fun entry hentry => hright entry (by simp [hentry]))
          (fun entry hentry => hroot entry (by simp [hentry]))
          (fun entry hentry => hbalanced entry (by simp [hentry]))
          htail
        exact hgenerated.mono fun value hvalue =>
          .generator (by
            change value ∈
              actualMatchedCouplePhaseBasis frequency couple ++
                actualMatchedCoupleGardenPhaseBasis frequency garden
            exact List.mem_append.mpr (Or.inr hvalue))

/-- Total interaction power of a finite matched-couple garden. -/
def actualMatchedCoupleGardenInteractionPower {Mode : Type*}
    (garden : List (BinaryInteractionTreeCouple Mode)) : Nat :=
  (garden.map coupleInteractionPower).sum

/-- Exact corrected forest formula: every nontrivial matched couple removes
one generator from the sum of its local vertex counts. -/
theorem actualMatchedCoupleGardenForestRank_eq_sum_power_sub_one
    {Mode : Type*} (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode))
    (hright : ∀ couple ∈ garden, 0 < couple.2.shape.order) :
    actualMatchedCoupleGardenForestRank frequency garden =
      (garden.map fun couple => coupleInteractionPower couple - 1).sum := by
  induction garden with
  | nil => rfl
  | cons couple garden ih =>
      have hhead : 0 < couple.2.shape.order := hright couple (by simp)
      have htail : ∀ entry ∈ garden, 0 < entry.2.shape.order :=
        fun entry hentry => hright entry (by simp [hentry])
      simp only [actualMatchedCoupleGardenForestRank,
        actualMatchedCoupleGardenPhaseBasis, List.flatMap_cons,
        List.length_append, List.map_cons, List.sum_cons]
      change actualMatchedCoupleForestRank frequency couple +
          actualMatchedCoupleGardenForestRank frequency garden = _
      rw [actualMatchedCoupleForestRank_eq_power_sub_one
        frequency couple hhead, ih htail]

/-- Forest/matroid form: rank plus the number of independent matched-root
relations equals the total number of local vertices. -/
theorem actualMatchedCoupleGardenForestRank_add_card_eq_power
    {Mode : Type*} (frequency : Mode → Real)
    (garden : List (BinaryInteractionTreeCouple Mode))
    (hright : ∀ couple ∈ garden, 0 < couple.2.shape.order) :
    actualMatchedCoupleGardenForestRank frequency garden + garden.length =
      actualMatchedCoupleGardenInteractionPower garden := by
  rw [actualMatchedCoupleGardenForestRank_eq_sum_power_sub_one
    frequency garden hright]
  unfold actualMatchedCoupleGardenInteractionPower
  induction garden with
  | nil => rfl
  | cons couple garden ih =>
      have hpower : 0 < coupleInteractionPower couple := by
        unfold coupleInteractionPower
        have := hright couple (by simp)
        omega
      have htail : ∀ entry ∈ garden, 0 < entry.2.shape.order :=
        fun entry hentry => hright entry (by simp [hentry])
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      have ih := ih htail
      omega


/-! ## Exact physical A0, A1, and A2 rank certificates -/

/-- One local phase in a physical quadratic A1 history. -/
def physicalA1PhaseHistory
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (term : QuadraticPhaseTerm N) : List Real :=
  [quadraticPhaseMismatch frequency observed term]

/-- Equal-charge A1 histories share their only denominator, so the complete
A1/A1 denominator family has the explicit one-generator certificate. -/
theorem physicalA1MatchedDenominators_one_generator
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (left right : QuadraticPhaseTerm N)
    (hcharge : quadraticPhaseCharge left = quadraticPhaseCharge right)
    (delta : Real)
    (hdelta : delta ∈
      orderedHistoryDenominators
          (physicalA1PhaseHistory frequency observed left) ++
        orderedHistoryDenominators
          (physicalA1PhaseHistory frequency observed right)) :
    AdditivelyGeneratedBy
      [quadraticPhaseMismatch frequency observed left] delta := by
  have hmismatch := quadraticPhaseMismatch_eq_of_charge_eq
    frequency observed hcharge
  have hgenerated := matchedOrderedHistoryDenominators_additivelyGenerated
    (physicalA1PhaseHistory frequency observed left)
    (physicalA1PhaseHistory frequency observed right)
    (by simp [physicalA1PhaseHistory])
    (by simp [physicalA1PhaseHistory, hmismatch]) delta hdelta
  simpa [physicalA1PhaseHistory, matchedPhaseBasis] using hgenerated

/-- The exact A1/A1 corrected rank is one. -/
theorem physicalA1MatchedPhaseBasis_length
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (left right : QuadraticPhaseTerm N) :
    (matchedPhaseBasis
      (physicalA1PhaseHistory frequency observed left)
      (physicalA1PhaseHistory frequency observed right)).length = 1 := by
  simp [physicalA1PhaseHistory, matchedPhaseBasis]

/-- The two nested local phases in the physical iterated-quadratic A2
history. -/
def physicalIteratedA2PhaseHistory
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (term : IteratedQuadraticSecondPicardCharacterTerm N) : List Real :=
  [iteratedQuadraticOuterMismatch m observed term,
    iteratedQuadraticInnerMismatch m term]

/-- The single local phase in the direct-cubic A2 history. -/
def physicalDirectA2PhaseHistory
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (term : CubicPhaseTerm N) : List Real :=
  [cubicPhaseMismatch frequency observed term]

/-- Telescoping of the actual two-layer iterated mismatch. -/
theorem sum_physicalIteratedA2PhaseHistory
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (term : IteratedQuadraticSecondPicardCharacterTerm N) :
    (physicalIteratedA2PhaseHistory m observed term).sum =
      outputChargeMismatch (modeFrequency m observed)
        (iteratedQuadraticSecondPicardCharge term) (modeFrequency m) := by
  simp only [physicalIteratedA2PhaseHistory, List.sum_cons, List.sum_nil,
    add_zero]
  unfold iteratedQuadraticOuterMismatch iteratedQuadraticInnerMismatch
    firstPicardCoordinateBranchMismatch outputChargeMismatch
  rw [quadraticPhaseMismatch_eq_output_sub_chargeFrequency,
    chargeFrequency_iteratedQuadraticSecondPicardCharge]
  ring

@[simp] theorem sum_physicalDirectA2PhaseHistory
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (term : CubicPhaseTerm N) :
    (physicalDirectA2PhaseHistory frequency observed term).sum =
      outputChargeMismatch (frequency observed)
        (cubicPhaseCharge term) frequency := by
  simp [physicalDirectA2PhaseHistory, cubicPhaseMismatch]

/-- A0/iterated-A2 Haar matching forces the three enumerated denominators
outer, inner, and outer+inner into a one-generator subgroup. -/
theorem physicalA0IteratedA2Denominators_one_generator
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (term : IteratedQuadraticSecondPicardCharacterTerm N)
    (hcharge : freeInitialPhaseCharge observed 0 =
      iteratedQuadraticSecondPicardCharge term)
    (delta : Real)
    (hdelta : delta ∈ orderedHistoryDenominators
      (physicalIteratedA2PhaseHistory m observed term)) :
    AdditivelyGeneratedBy [iteratedQuadraticInnerMismatch m term] delta := by
  have houter :=
    iteratedQuadraticOuterMismatch_eq_neg_inner_of_charge_eq_freeInitial
      m observed term hcharge
  have hsum : ([] : List Real).sum =
      (physicalIteratedA2PhaseHistory m observed term).sum := by
    simp [physicalIteratedA2PhaseHistory, houter]
  have hgenerated := matchedOrderedHistoryDenominators_additivelyGenerated
    [] (physicalIteratedA2PhaseHistory m observed term)
    (by simp [physicalIteratedA2PhaseHistory]) hsum delta (by simp [hdelta])
  simpa [physicalIteratedA2PhaseHistory, matchedPhaseBasis] using hgenerated

/-- The exact A0/iterated-A2 corrected rank is one. -/
theorem physicalA0IteratedA2MatchedPhaseBasis_length
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (term : IteratedQuadraticSecondPicardCharacterTerm N) :
    (matchedPhaseBasis []
      (physicalIteratedA2PhaseHistory m observed term)).length = 1 := by
  simp [physicalIteratedA2PhaseHistory, matchedPhaseBasis]

/-- A0/direct-A2 charge matching places the only direct cubic denominator
exactly on shell, giving rank zero. -/
theorem physicalA0DirectA2Denominators_zero_generator
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (term : CubicPhaseTerm N)
    (hcharge : cubicPhaseCharge term = freeInitialPhaseCharge observed 0)
    (delta : Real)
    (hdelta : delta ∈ orderedHistoryDenominators
      (physicalDirectA2PhaseHistory frequency observed term)) :
    AdditivelyGeneratedBy [] delta := by
  have hmismatch := cubicPhaseMismatch_eq_zero_of_charge_eq_freeInitial
    frequency observed term hcharge
  have hsum : ([] : List Real).sum =
      (physicalDirectA2PhaseHistory frequency observed term).sum := by
    simp [physicalDirectA2PhaseHistory, hmismatch]
  have hgenerated := matchedOrderedHistoryDenominators_additivelyGenerated
    [] (physicalDirectA2PhaseHistory frequency observed term)
    (by simp [physicalDirectA2PhaseHistory]) hsum delta (by simp [hdelta])
  simpa [physicalDirectA2PhaseHistory, matchedPhaseBasis] using hgenerated

/-- The exact A0/direct-A2 corrected rank is zero. -/
theorem physicalA0DirectA2MatchedPhaseBasis_length
    {N : Nat} [NeZero N] (frequency : Lattice.Site N → Real)
    (observed : Lattice.Site N) (term : CubicPhaseTerm N) :
    (matchedPhaseBasis []
      (physicalDirectA2PhaseHistory frequency observed term)).length = 0 := by
  simp [physicalDirectA2PhaseHistory, matchedPhaseBasis]


/-- Actual phase history for either branch of the complete physical A2
family. -/
def physicalCompleteA2PhaseHistory
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N) :
    CompleteSecondPicardCharacterTerm N → List Real
  | Sum.inl term => physicalIteratedA2PhaseHistory m observed term
  | Sum.inr term =>
      physicalDirectA2PhaseHistory (modeFrequency m) observed term

/-- Both complete A2 branches telescope to output frequency minus their
existing complete Haar charge. -/
theorem sum_physicalCompleteA2PhaseHistory
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (term : CompleteSecondPicardCharacterTerm N) :
    (physicalCompleteA2PhaseHistory m observed term).sum =
      outputChargeMismatch (modeFrequency m observed)
        (completeSecondPicardCharge term) (modeFrequency m) := by
  rcases term with term | term
  · exact sum_physicalIteratedA2PhaseHistory m observed term
  · exact sum_physicalDirectA2PhaseHistory (modeFrequency m) observed term

/-- Equal complete A2 charge supplies the one total relation, and no hidden
rank premise, for every g4 A2/A2 subchannel. -/
theorem physicalCompleteA2MatchedDenominators_generated
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left right : CompleteSecondPicardCharacterTerm N)
    (hcharge : completeSecondPicardCharge left =
      completeSecondPicardCharge right)
    (delta : Real)
    (hdelta : delta ∈
      orderedHistoryDenominators
          (physicalCompleteA2PhaseHistory m observed left) ++
        orderedHistoryDenominators
          (physicalCompleteA2PhaseHistory m observed right)) :
    AdditivelyGeneratedBy
      (matchedPhaseBasis
        (physicalCompleteA2PhaseHistory m observed left)
        (physicalCompleteA2PhaseHistory m observed right)) delta := by
  have hright : physicalCompleteA2PhaseHistory m observed right ≠ [] := by
    rcases right with term | term <;>
      simp [physicalCompleteA2PhaseHistory, physicalIteratedA2PhaseHistory,
        physicalDirectA2PhaseHistory]
  have hsum : (physicalCompleteA2PhaseHistory m observed left).sum =
      (physicalCompleteA2PhaseHistory m observed right).sum := by
    rw [sum_physicalCompleteA2PhaseHistory,
      sum_physicalCompleteA2PhaseHistory, hcharge]
  exact matchedOrderedHistoryDenominators_additivelyGenerated
    _ _ hright hsum delta hdelta

/-- Structural rank of a complete A2/A2 subchannel. -/
def physicalCompleteA2MatchedForestRank
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left right : CompleteSecondPicardCharacterTerm N) : Nat :=
  (matchedPhaseBasis
    (physicalCompleteA2PhaseHistory m observed left)
    (physicalCompleteA2PhaseHistory m observed right)).length

@[simp] theorem physicalCompleteA2MatchedForestRank_inl_inl
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left right : IteratedQuadraticSecondPicardCharacterTerm N) :
    physicalCompleteA2MatchedForestRank m observed
      (Sum.inl left) (Sum.inl right) = 3 := by
  simp [physicalCompleteA2MatchedForestRank, matchedPhaseBasis,
    physicalCompleteA2PhaseHistory, physicalIteratedA2PhaseHistory]

@[simp] theorem physicalCompleteA2MatchedForestRank_inl_inr
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left : IteratedQuadraticSecondPicardCharacterTerm N)
    (right : CubicPhaseTerm N) :
    physicalCompleteA2MatchedForestRank m observed
      (Sum.inl left) (Sum.inr right) = 2 := by
  simp [physicalCompleteA2MatchedForestRank, matchedPhaseBasis,
    physicalCompleteA2PhaseHistory, physicalIteratedA2PhaseHistory,
    physicalDirectA2PhaseHistory]

@[simp] theorem physicalCompleteA2MatchedForestRank_inr_inl
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N) (left : CubicPhaseTerm N)
    (right : IteratedQuadraticSecondPicardCharacterTerm N) :
    physicalCompleteA2MatchedForestRank m observed
      (Sum.inr left) (Sum.inl right) = 2 := by
  simp [physicalCompleteA2MatchedForestRank, matchedPhaseBasis,
    physicalCompleteA2PhaseHistory, physicalIteratedA2PhaseHistory,
    physicalDirectA2PhaseHistory]

@[simp] theorem physicalCompleteA2MatchedForestRank_inr_inr
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N) (left right : CubicPhaseTerm N) :
    physicalCompleteA2MatchedForestRank m observed
      (Sum.inr left) (Sum.inr right) = 1 := by
  simp [physicalCompleteA2MatchedForestRank, matchedPhaseBasis,
    physicalCompleteA2PhaseHistory, physicalDirectA2PhaseHistory]


/-! ## Sharp order-two counterexample to pair-count rank -/

/-- Six abstract normal-mode labels suffice for the minimal balanced
order-two counterexample. -/
abbrev OrderTwoRankCounterMode := Fin 6

namespace OrderTwoRankCounterMode

def root : OrderTwoRankCounterMode := 0
def leftInternal : OrderTwoRankCounterMode := 1
def rightInternal : OrderTwoRankCounterMode := 2
def leafZero : OrderTwoRankCounterMode := 3
def leafOne : OrderTwoRankCounterMode := 4
def leafTwo : OrderTwoRankCounterMode := 5

end OrderTwoRankCounterMode

/-- First bracketing of the same three positive signed leaves. -/
def orderTwoRankCounterLeftTree :
    RandomEigenmodeBinaryTree OrderTwoRankCounterMode :=
  .node .root .phase .phase
    (.node .leftInternal .phase .phase
      (.leaf .leafZero) (.leaf .leafOne))
    (.leaf .leafTwo)

/-- Second bracketing, with a distinct internal carrier. -/
def orderTwoRankCounterRightTree :
    RandomEigenmodeBinaryTree OrderTwoRankCounterMode :=
  .node .root .phase .phase
    (.leaf .leafZero)
    (.node .rightInternal .phase .phase
      (.leaf .leafOne) (.leaf .leafTwo))

def orderTwoRankCounterCouple :
    BinaryInteractionTreeCouple OrderTwoRankCounterMode :=
  (orderTwoRankCounterLeftTree, orderTwoRankCounterRightTree)

@[simp] theorem orderTwoRankCounterLeftTree_order :
    orderTwoRankCounterLeftTree.shape.order = 2 := rfl

@[simp] theorem orderTwoRankCounterRightTree_order :
    orderTwoRankCounterRightTree.shape.order = 2 := rfl

@[simp] theorem orderTwoRankCounterCouple_sameRoot :
    orderTwoRankCounterCouple.1.rootMode =
      orderTwoRankCounterCouple.2.rootMode := rfl

/-- Both trees have exactly the same three positive signed leaves, hence the
couple passes the exact initial Haar selector. -/
theorem orderTwoRankCounterCouple_leafPhaseBalanced :
    leafPhaseBalanced orderTwoRankCounterCouple := by
  unfold leafPhaseBalanced orderTwoRankCounterCouple
  intro mode
  fin_cases mode <;>
    simp [orderTwoRankCounterLeftTree, orderTwoRankCounterRightTree,
      binaryTreePhaseCharge, phaseSignActCharge, SignedMode.charge,
      Pi.single_apply] <;> abel

/-- Three freely variable frequency coordinates; all other mode frequencies
are set to zero. -/
def orderTwoRankCounterFrequency
    (parameter : Fin 3 → Real) : OrderTwoRankCounterMode → Real :=
  ![0, parameter 0, parameter 2, parameter 1, 0, 0]

def orderTwoRankCounterLeftOuter (parameter : Fin 3 → Real) : Real :=
  binaryVertexMismatch (orderTwoRankCounterFrequency parameter)
    .root .phase .phase .leftInternal .leafTwo

def orderTwoRankCounterLeftInner (parameter : Fin 3 → Real) : Real :=
  binaryVertexMismatch (orderTwoRankCounterFrequency parameter)
    .leftInternal .phase .phase .leafZero .leafOne

def orderTwoRankCounterRightOuter (parameter : Fin 3 → Real) : Real :=
  binaryVertexMismatch (orderTwoRankCounterFrequency parameter)
    .root .phase .phase .leafZero .rightInternal

def orderTwoRankCounterRightInner (parameter : Fin 3 → Real) : Real :=
  binaryVertexMismatch (orderTwoRankCounterFrequency parameter)
    .rightInternal .phase .phase .leafOne .leafTwo

@[simp] theorem orderTwoRankCounterLeftOuter_eq
    (parameter : Fin 3 → Real) :
    orderTwoRankCounterLeftOuter parameter = -parameter 0 := by
  simp [orderTwoRankCounterLeftOuter, binaryVertexMismatch,
    orderTwoRankCounterFrequency, phaseSignActReal,
    OrderTwoRankCounterMode.root, OrderTwoRankCounterMode.leftInternal,
    OrderTwoRankCounterMode.rightInternal, OrderTwoRankCounterMode.leafZero,
    OrderTwoRankCounterMode.leafOne, OrderTwoRankCounterMode.leafTwo]

@[simp] theorem orderTwoRankCounterLeftInner_eq
    (parameter : Fin 3 → Real) :
    orderTwoRankCounterLeftInner parameter = parameter 0 - parameter 1 := by
  simp [orderTwoRankCounterLeftInner, binaryVertexMismatch,
    orderTwoRankCounterFrequency, phaseSignActReal,
    OrderTwoRankCounterMode.root, OrderTwoRankCounterMode.leftInternal,
    OrderTwoRankCounterMode.rightInternal, OrderTwoRankCounterMode.leafZero,
    OrderTwoRankCounterMode.leafOne, OrderTwoRankCounterMode.leafTwo]

@[simp] theorem orderTwoRankCounterRightOuter_eq
    (parameter : Fin 3 → Real) :
    orderTwoRankCounterRightOuter parameter = -parameter 1 - parameter 2 := by
  simp [orderTwoRankCounterRightOuter, binaryVertexMismatch,
    orderTwoRankCounterFrequency, phaseSignActReal,
    OrderTwoRankCounterMode.root, OrderTwoRankCounterMode.leftInternal,
    OrderTwoRankCounterMode.rightInternal, OrderTwoRankCounterMode.leafZero,
    OrderTwoRankCounterMode.leafOne, OrderTwoRankCounterMode.leafTwo]

@[simp] theorem orderTwoRankCounterRightInner_eq
    (parameter : Fin 3 → Real) :
    orderTwoRankCounterRightInner parameter = parameter 2 := by
  simp [orderTwoRankCounterRightInner, binaryVertexMismatch,
    orderTwoRankCounterFrequency, phaseSignActReal,
    OrderTwoRankCounterMode.root, OrderTwoRankCounterMode.leftInternal,
    OrderTwoRankCounterMode.rightInternal, OrderTwoRankCounterMode.leafZero,
    OrderTwoRankCounterMode.leafOne, OrderTwoRankCounterMode.leafTwo]

/-- The actual local-phase lists of the two decorated trees. -/
theorem orderTwoRankCounter_actualPhaseLists
    (parameter : Fin 3 → Real) :
    actualBinaryTreePhaseList (orderTwoRankCounterFrequency parameter)
        orderTwoRankCounterLeftTree =
        [orderTwoRankCounterLeftOuter parameter,
          orderTwoRankCounterLeftInner parameter] ∧
      actualBinaryTreePhaseList (orderTwoRankCounterFrequency parameter)
        orderTwoRankCounterRightTree =
        [orderTwoRankCounterRightOuter parameter,
          orderTwoRankCounterRightInner parameter] := by
  constructor <;>
    simp [actualBinaryTreePhaseList, actualBinaryTreePhaseAssignment,
      orderTwoRankCounterLeftTree, orderTwoRankCounterRightTree,
      branchingPhaseList, scaleBranchingPhaseAssignment,
      RandomEigenmodeBinaryTree.shape, RandomEigenmodeBinaryTree.rootMode,
      orderTwoRankCounterLeftOuter, orderTwoRankCounterLeftInner,
      orderTwoRankCounterRightOuter, orderTwoRankCounterRightInner]

/-- The fourth local phase is generated by the other three through the sole
matched-total relation. -/
theorem orderTwoRankCounterRightOuter_relation
    (parameter : Fin 3 → Real) :
    orderTwoRankCounterRightOuter parameter =
      orderTwoRankCounterLeftOuter parameter +
        orderTwoRankCounterLeftInner parameter -
          orderTwoRankCounterRightInner parameter := by
  simp
  ring

/-- Elementary linear independence of three real-valued phase forms. -/
def PhaseTripleLinearlyIndependent {Parameter : Type*}
    (first second third : Parameter → Real) : Prop :=
  ∀ a b c : Real,
    (∀ parameter,
      a * first parameter + b * second parameter + c * third parameter = 0) →
      a = 0 ∧ b = 0 ∧ c = 0

/-- The corrected three-generator basis is sharp: its three phase forms are
linearly independent as functions of the three free frequency coordinates. -/
theorem orderTwoRankCounter_phaseTriple_linearlyIndependent :
    PhaseTripleLinearlyIndependent
      orderTwoRankCounterLeftOuter
      orderTwoRankCounterLeftInner
      orderTwoRankCounterRightInner := by
  intro a b c hrelation
  have hzero := hrelation ![(1 : Real), 0, 0]
  have hone := hrelation ![(0 : Real), 1, 0]
  have htwo := hrelation ![(0 : Real), 0, 1]
  simp at hzero hone htwo
  constructor
  · linarith
  constructor <;> linarith

/-- The actual reduced phase basis of the counterexample contains exactly
the preceding three independent forms. -/
theorem orderTwoRankCounter_actualMatchedPhaseBasis
    (parameter : Fin 3 → Real) :
    actualMatchedCouplePhaseBasis (orderTwoRankCounterFrequency parameter)
      orderTwoRankCounterCouple =
      [orderTwoRankCounterLeftOuter parameter,
        orderTwoRankCounterLeftInner parameter,
        orderTwoRankCounterRightInner parameter] := by
  rcases orderTwoRankCounter_actualPhaseLists parameter with ⟨hleft, hright⟩
  simp [actualMatchedCouplePhaseBasis, matchedPhaseBasis,
    orderTwoRankCounterCouple, hleft, hright]

@[simp] theorem orderTwoRankCounter_forestRank
    (parameter : Fin 3 → Real) :
    actualMatchedCoupleForestRank (orderTwoRankCounterFrequency parameter)
      orderTwoRankCounterCouple = 3 := by
  rw [actualMatchedCoupleForestRank_eq_power_sub_one]
  · norm_num [coupleInteractionPower, orderTwoRankCounterCouple]
  · simpa [orderTwoRankCounterCouple] using
      orderTwoRankCounterRightTree_order

@[simp] theorem orderTwoRankCounter_matchedInteractionPairCount :
    matchedInteractionPairCount orderTwoRankCounterCouple = 2 := by
  norm_num [matchedInteractionPairCount, coupleInteractionPower,
    orderTwoRankCounterCouple]

/-- Minimal failure of the proposed all-order rank bound: a genuine balanced
order-two binary couple has sharp structural rank three but pair count two. -/
theorem orderTwoRankCounter_forestRank_not_le_pairCount
    (parameter : Fin 3 → Real) :
    ¬ actualMatchedCoupleForestRank
        (orderTwoRankCounterFrequency parameter) orderTwoRankCounterCouple ≤
      matchedInteractionPairCount orderTwoRankCounterCouple := by
  simp

/-- Nevertheless every actual cumulative/shuffled denominator in the
counterexample is generated by that sharp three-element basis. -/
theorem orderTwoRankCounter_denominators_generated
    (parameter : Fin 3 → Real) (delta : Real)
    (hdelta : delta ∈ actualMatchedCoupleDenominators
      (orderTwoRankCounterFrequency parameter) orderTwoRankCounterCouple) :
    AdditivelyGeneratedBy
      (actualMatchedCouplePhaseBasis
        (orderTwoRankCounterFrequency parameter) orderTwoRankCounterCouple)
      delta := by
  exact actualMatchedCoupleDenominators_additivelyGenerated
    (orderTwoRankCounterFrequency parameter) orderTwoRankCounterCouple
    (by simpa [orderTwoRankCounterCouple] using
      orderTwoRankCounterRightTree_order)
    orderTwoRankCounterCouple_sameRoot
    orderTwoRankCounterCouple_leafPhaseBalanced delta hdelta


/-! ## Closed cutoff consequences at physical second order -/

/-- A g4 term with the exact mixed-channel loss rank two has a feasible
quadratic kinetic cutoff. -/
theorem exists_quadraticCutoffExponent_g4_loss_two :
    ∃ alpha, CutoffExponentAdmissible 4 2
      quadraticKineticDeficit alpha := by
  simpa using
    (exists_quadraticCutoffExponent_for_exactMatchedPower
      (independentLoss := 2) (by norm_num))

/-- Direct/direct g4, with loss rank one, also has a strict margin. -/
theorem exists_quadraticCutoffExponent_g4_loss_one :
    ∃ alpha, CutoffExponentAdmissible 4 1
      quadraticKineticDeficit alpha := by
  rw [exists_cutoffExponentAdmissible_iff (by norm_num)]
  norm_num [quadraticKineticDeficit]

/-- The generic iterated/iterated g4 rank three is exactly on the infeasible
boundary of the absolute-value good/bad balance. -/
theorem no_quadraticCutoffExponent_g4_loss_three :
    ¬ ∃ alpha, CutoffExponentAdmissible 4 3
      quadraticKineticDeficit alpha := by
  exact no_cutoffExponentAdmissible_of_power_le
    (by norm_num) (by norm_num [quadraticKineticDeficit])

/-- The rank-one g2 term is likewise a boundary term. It is the retained
kinetic signal, not a vanishing regular-good error. -/
theorem no_quadraticCutoffExponent_g2_loss_one :
    ¬ ∃ alpha, CutoffExponentAdmissible 2 1
      quadraticKineticDeficit alpha := by
  exact no_cutoffExponentAdmissible_of_power_le
    (by norm_num) (by norm_num [quadraticKineticDeficit])

/-- Closed physical mixed A2 theorem: its computed rank, not a rank premise,
feeds the feasible g4 cutoff. -/
theorem physicalCompleteA2_inl_inr_exists_quadraticCutoffExponent
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left : IteratedQuadraticSecondPicardCharacterTerm N)
    (right : CubicPhaseTerm N) :
    ∃ alpha, CutoffExponentAdmissible 4
      (physicalCompleteA2MatchedForestRank m observed
        (Sum.inl left) (Sum.inr right) : Real)
      quadraticKineticDeficit alpha := by
  rw [physicalCompleteA2MatchedForestRank_inl_inr]
  exact exists_quadraticCutoffExponent_g4_loss_two

/-- The reverse mixed branch has the same closed feasible cutoff. -/
theorem physicalCompleteA2_inr_inl_exists_quadraticCutoffExponent
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N) (left : CubicPhaseTerm N)
    (right : IteratedQuadraticSecondPicardCharacterTerm N) :
    ∃ alpha, CutoffExponentAdmissible 4
      (physicalCompleteA2MatchedForestRank m observed
        (Sum.inr left) (Sum.inl right) : Real)
      quadraticKineticDeficit alpha := by
  rw [physicalCompleteA2MatchedForestRank_inr_inl]
  exact exists_quadraticCutoffExponent_g4_loss_two

/-- The direct/direct g4 subchannel is strictly admissible. -/
theorem physicalCompleteA2_inr_inr_exists_quadraticCutoffExponent
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N) (left right : CubicPhaseTerm N) :
    ∃ alpha, CutoffExponentAdmissible 4
      (physicalCompleteA2MatchedForestRank m observed
        (Sum.inr left) (Sum.inr right) : Real)
      quadraticKineticDeficit alpha := by
  rw [physicalCompleteA2MatchedForestRank_inr_inr]
  simpa only [Nat.cast_one] using
    exists_quadraticCutoffExponent_g4_loss_one

/-- The generic iterated/iterated g4 subchannel cannot be closed by this
absolute-value cutoff; further cancellation or renormalization is necessary. -/
theorem physicalCompleteA2_inl_inl_no_quadraticCutoffExponent
    {N : Nat} [NeZero N] (m : Lattice.PositiveMassConfig N)
    (observed : Lattice.Site N)
    (left right : IteratedQuadraticSecondPicardCharacterTerm N) :
    ¬ ∃ alpha, CutoffExponentAdmissible 4
      (physicalCompleteA2MatchedForestRank m observed
        (Sum.inl left) (Sum.inl right) : Real)
      quadraticKineticDeficit alpha := by
  rw [physicalCompleteA2MatchedForestRank_inl_inl]
  exact no_quadraticCutoffExponent_g4_loss_three

end

end ArchonPhysics.CanonicalIIDCoerciveMatchedDenominatorForestRank
