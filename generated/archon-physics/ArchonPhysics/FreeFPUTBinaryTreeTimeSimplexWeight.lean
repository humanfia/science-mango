import ArchonPhysics.FreeFPUTBinaryTreeCatalanMomentumCounting
import Mathlib.Analysis.SpecialFunctions.Integrals.Basic

/-!
# Exact time-simplex weights for free FPUT binary histories

A quadratic Picard history is not weighted merely by `T ^ r`: every internal
vertex carries a nested time integral.  For a fixed ordered binary shape this
file defines its tree factorial and proves that the exact scalar Duhamel
weight is

`T ^ tree.order / treeFactorial tree`.

The parent weight is proved to be the interval integral of the product of its
two child weights.  Combining this with the exact Catalan/sign/momentum count
also gives a transparent absolute-value majorant for all raw histories at one
order.  This is a short-time analytic input; no oscillatory cancellation,
small-denominator estimate, RPA propagation, or kinetic limit is asserted.
-/

namespace ArchonPhysics.FreeFPUTBinaryTreeTimeSimplexWeight

open ArchonPhysics
open ArchonPhysics.Lattice
open ArchonPhysics.PhyslibFPUTBinaryInteractionTreeCouples
open ArchonPhysics.FreeFPUTBinaryTreeCatalanMomentumCounting

noncomputable section

/-- Product of the subtree orders generated by the nested Duhamel simplex. -/
def binaryTreeFactorial : BinaryInteractionTree → Nat
  | .leaf => 1
  | .node left right =>
      (left.order + right.order + 1) *
        binaryTreeFactorial left * binaryTreeFactorial right

@[simp] theorem binaryTreeFactorial_leaf :
    binaryTreeFactorial .leaf = 1 := rfl

@[simp] theorem binaryTreeFactorial_node
    (left right : BinaryInteractionTree) :
    binaryTreeFactorial (.node left right) =
      (left.order + right.order + 1) *
        binaryTreeFactorial left * binaryTreeFactorial right := rfl

theorem binaryTreeFactorial_pos (tree : BinaryInteractionTree) :
    0 < binaryTreeFactorial tree := by
  induction tree with
  | leaf => simp
  | node left right hleft hright =>
      simp only [binaryTreeFactorial_node]
      positivity

theorem binaryTreeFactorial_ne_zero (tree : BinaryInteractionTree) :
    binaryTreeFactorial tree ≠ 0 :=
  Nat.ne_of_gt (binaryTreeFactorial_pos tree)

/-- Exact scalar time weight of one fixed binary history. -/
def binaryTreeTimeSimplexWeight
    (tree : BinaryInteractionTree) (T : Real) : Real :=
  T ^ tree.order / binaryTreeFactorial tree

@[simp] theorem binaryTreeTimeSimplexWeight_leaf (T : Real) :
    binaryTreeTimeSimplexWeight .leaf T = 1 := by
  simp [binaryTreeTimeSimplexWeight, BinaryInteractionTree.order]

theorem binaryTreeTimeSimplexWeight_nonneg
    (tree : BinaryInteractionTree) {T : Real} (hT : 0 ≤ T) :
    0 ≤ binaryTreeTimeSimplexWeight tree T := by
  unfold binaryTreeTimeSimplexWeight
  positivity

/-- The closed-form tree weight obeys exactly the recursive Duhamel integral
at every internal vertex. -/
theorem integral_mul_binaryTreeTimeSimplexWeight
    (left right : BinaryInteractionTree) (T : Real) :
    (∫ t in (0 : Real)..T,
      binaryTreeTimeSimplexWeight left t *
        binaryTreeTimeSimplexWeight right t) =
      binaryTreeTimeSimplexWeight (.node left right) T := by
  let leftFactorial : Real := binaryTreeFactorial left
  let rightFactorial : Real := binaryTreeFactorial right
  have hleftFactorial : leftFactorial ≠ 0 := by
    dsimp [leftFactorial]
    exact_mod_cast binaryTreeFactorial_ne_zero left
  have hrightFactorial : rightFactorial ≠ 0 := by
    dsimp [rightFactorial]
    exact_mod_cast binaryTreeFactorial_ne_zero right
  have horder : ((left.order + right.order + 1 : Nat) : Real) ≠ 0 := by
    positivity
  rw [show (fun t : Real ↦
      binaryTreeTimeSimplexWeight left t *
        binaryTreeTimeSimplexWeight right t) =
      fun t : Real ↦
        (1 / (leftFactorial * rightFactorial)) *
          t ^ (left.order + right.order) by
    funext t
    simp only [binaryTreeTimeSimplexWeight, div_eq_mul_inv,
      leftFactorial, rightFactorial]
    ring]
  rw [intervalIntegral.integral_const_mul, integral_pow]
  simp only [zero_pow (Nat.succ_ne_zero _), sub_zero]
  unfold binaryTreeTimeSimplexWeight
  simp only [BinaryInteractionTree.order, binaryTreeFactorial_node,
    Nat.cast_mul, Nat.cast_add, Nat.cast_one, leftFactorial,
    rightFactorial]
  field_simp

/-- Dropping the positive tree factorial gives the standard crude
absolute-value bound. -/
theorem binaryTreeTimeSimplexWeight_le_pow
    (tree : BinaryInteractionTree) {T : Real} (hT : 0 ≤ T) :
    binaryTreeTimeSimplexWeight tree T ≤ T ^ tree.order := by
  unfold binaryTreeTimeSimplexWeight
  apply div_le_self
  · positivity
  · exact_mod_cast (binaryTreeFactorial_pos tree)

/-! ## The summed raw fixed-root time majorant -/

/-- Sum of exact time-simplex weights over every raw shape, sign decoration,
and fixed-root momentum assignment at order `r`. -/
def fixedRootRawHistoryTimeWeight
    {N : Nat} [NeZero N] (r : Nat) (rootMomentum : Site N)
    (T : Real) : Real :=
  ∑ history : FixedRootRawHistoryIndex N r rootMomentum,
    binaryTreeTimeSimplexWeight history.1.1 T

theorem fixedRootRawHistoryTimeWeight_nonneg
    {N : Nat} [NeZero N] (r : Nat) (rootMomentum : Site N)
    {T : Real} (hT : 0 ≤ T) :
    0 ≤ fixedRootRawHistoryTimeWeight r rootMomentum T := by
  unfold fixedRootRawHistoryTimeWeight
  apply Finset.sum_nonneg
  intro history _historyMem
  exact binaryTreeTimeSimplexWeight_nonneg history.1.1 hT

/-- Exact counting plus the pointwise tree-simplex bound controls the entire
raw order-`r` time weight. -/
theorem fixedRootRawHistoryTimeWeight_le_exact_count
    {N : Nat} [NeZero N] (r : Nat) (rootMomentum : Site N)
    {T : Real} (hT : 0 ≤ T) :
    fixedRootRawHistoryTimeWeight r rootMomentum T ≤
      (catalan r * 4 ^ r * N ^ r : Nat) * T ^ r := by
  classical
  unfold fixedRootRawHistoryTimeWeight
  calc
    (∑ history : FixedRootRawHistoryIndex N r rootMomentum,
        binaryTreeTimeSimplexWeight history.1.1 T) ≤
        ∑ _history : FixedRootRawHistoryIndex N r rootMomentum,
          T ^ r := by
      apply Finset.sum_le_sum
      intro history _historyMem
      calc
        binaryTreeTimeSimplexWeight history.1.1 T ≤
            T ^ history.1.1.order :=
          binaryTreeTimeSimplexWeight_le_pow history.1.1 hT
        _ = T ^ r := by rw [history.1.2]
    _ = (Fintype.card (FixedRootRawHistoryIndex N r rootMomentum) : Nat) *
          T ^ r := by
      simp
    _ = (catalan r * 4 ^ r * N ^ r : Nat) * T ^ r := by
      rw [card_fixedRootRawHistoryIndex rootMomentum]

/-- Purely exponential version of the same absolute-value estimate. -/
theorem fixedRootRawHistoryTimeWeight_le_exponential
    {N : Nat} [NeZero N] (r : Nat) (rootMomentum : Site N)
    {T : Real} (hT : 0 ≤ T) :
    fixedRootRawHistoryTimeWeight r rootMomentum T ≤
      (16 ^ r * N ^ r : Nat) * T ^ r := by
  refine (fixedRootRawHistoryTimeWeight_le_exact_count
    r rootMomentum hT).trans ?_
  apply mul_le_mul_of_nonneg_right _ (pow_nonneg hT r)
  have hcount :
      catalan r * 4 ^ r * N ^ r ≤ 16 ^ r * N ^ r := by
    calc
      catalan r * 4 ^ r * N ^ r ≤ 4 ^ r * 4 ^ r * N ^ r :=
        Nat.mul_le_mul_right (N ^ r)
          (Nat.mul_le_mul_right (4 ^ r) (catalan_le_four_pow r))
      _ = 16 ^ r * N ^ r := by
        rw [← mul_pow]
        norm_num
  exact_mod_cast hcount

end

end ArchonPhysics.FreeFPUTBinaryTreeTimeSimplexWeight
