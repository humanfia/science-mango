import ArchonPhysics.ThreeWaveCollisionAlgebra

/-!
# Finite networks of three-wave collisions

This module lifts the exact algebra of one `1 ↔ 2 + 3` collision to a finite
network.  Every triad and mode is supplied explicitly.  The collision vector
field is the finite sum of the signed `(+,-,-)` contributions of all triads.

The results are finite-sum identities.  They neither construct this network
from the frozen random-mass lattice nor establish resonance, positive rates,
connectivity, a kinetic limit, relaxation, or thermalization for that model.
-/

namespace ArchonPhysics.FiniteThreeWaveCollisionNetwork

open ThreeWaveCollisionAlgebra

noncomputable section

/-- Incidence data for a family of reactions `mode₁ ↔ mode₂ + mode₃`.  Finiteness
is imposed by `Fintype` instances in the definitions and theorems below. -/
structure Network (Mode Triad : Type*) where
  mode₁ : Triad → Mode
  mode₂ : Triad → Mode
  mode₃ : Triad → Mode

variable {Mode Triad : Type*}
variable [Fintype Mode] [DecidableEq Mode] [Fintype Triad]

/-- The signed incidence coefficient of one triad at one mode.  This definition
also handles repeated mode labels by adding their signed multiplicities. -/
def stoichiometricCoefficient
    (network : Network Mode Triad) (a : Triad) (i : Mode) : Real :=
  (if i = network.mode₁ a then 1 else 0) -
    (if i = network.mode₂ a then 1 else 0) -
    (if i = network.mode₃ a then 1 else 0)

/-- The one-triad flux evaluated on a global action vector. -/
def networkTriadFlux
    (network : Network Mode Triad) (action : Mode → Real) (a : Triad) : Real :=
  collisionFlux (action (network.mode₁ a))
    (action (network.mode₂ a)) (action (network.mode₃ a))

/-- The collision vector field, summed over all triads at each mode. -/
def collisionVectorField
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real) (i : Mode) : Real :=
  ∑ a, rate a * networkTriadFlux network action a *
    stoichiometricCoefficient network a i

/-- Slope of a linear observable with supplied mode weights. -/
def weightedObservableSlope
    (network : Network Mode Triad) (weight : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real) : Real :=
  ∑ i, weight i * collisionVectorField network rate action i

/-- Total linear-energy slope generated by the collision vector field. -/
def totalEnergySlope
    (network : Network Mode Triad) (frequency : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real) : Real :=
  weightedObservableSlope network frequency rate action

/-- Pointwise logarithmic-entropy slope generated by the collision vector
field.  Positivity of the actions is imposed only in sign theorems. -/
def totalLogEntropyProduction
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real) : Real :=
  ∑ i, collisionVectorField network rate action i / action i

/-- Expanding the per-mode vector field and interchanging the two finite sums
recovers the sum of the single-triad linear-observable slopes. -/
theorem weightedObservableSlope_eq_sum
    (network : Network Mode Triad) (weight : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real) :
    weightedObservableSlope network weight rate action =
      ∑ a, linearObservableSlope
        (weight (network.mode₁ a))
        (weight (network.mode₂ a))
        (weight (network.mode₃ a))
        (rate a)
        (action (network.mode₁ a))
        (action (network.mode₂ a))
        (action (network.mode₃ a)) := by
  unfold weightedObservableSlope collisionVectorField
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  let fluxRate := rate a * networkTriadFlux network action a
  have hpoint (i : Mode) :
      weight i * (fluxRate * stoichiometricCoefficient network a i) =
        (if i = network.mode₁ a then weight i * fluxRate else 0) -
          (if i = network.mode₂ a then weight i * fluxRate else 0) -
          (if i = network.mode₃ a then weight i * fluxRate else 0) := by
    unfold stoichiometricCoefficient
    split_ifs <;> ring
  simp_rw [show rate a * networkTriadFlux network action a = fluxRate from rfl,
    hpoint]
  rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib]
  simp only [Finset.sum_ite_eq', Finset.mem_univ, if_true]
  unfold linearObservableSlope fluxRate
  simp only [networkTriadFlux]
  ring

/-- The network logarithmic-entropy slope is the sum of its single-triad
entropy productions. -/
theorem totalLogEntropyProduction_eq_sum
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real) :
    totalLogEntropyProduction network rate action =
      ∑ a, entropyProduction (rate a)
        (action (network.mode₁ a))
        (action (network.mode₂ a))
        (action (network.mode₃ a)) := by
  calc
    totalLogEntropyProduction network rate action =
        weightedObservableSlope network (fun i => (action i)⁻¹) rate action := by
      unfold totalLogEntropyProduction weightedObservableSlope
      apply Finset.sum_congr rfl
      intro i _
      rw [div_eq_mul_inv, mul_comm]
    _ = ∑ a, linearObservableSlope
        ((action (network.mode₁ a))⁻¹)
        ((action (network.mode₂ a))⁻¹)
        ((action (network.mode₃ a))⁻¹)
        (rate a)
        (action (network.mode₁ a))
        (action (network.mode₂ a))
        (action (network.mode₃ a)) :=
      weightedObservableSlope_eq_sum network (fun i => (action i)⁻¹) rate action
    _ = _ := by
      apply Finset.sum_congr rfl
      intro a _
      rfl

/-- If every triad satisfies its additive frequency resonance, the total
network energy slope vanishes.  No sign condition on the rates is needed. -/
theorem totalEnergySlope_eq_zero_of_resonance
    (network : Network Mode Triad) (frequency : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real)
    (hresonance : ∀ a, frequency (network.mode₁ a) =
      frequency (network.mode₂ a) + frequency (network.mode₃ a)) :
    totalEnergySlope network frequency rate action = 0 := by
  unfold totalEnergySlope
  rw [weightedObservableSlope_eq_sum]
  apply Finset.sum_eq_zero
  intro a _
  exact linearObservableSlope_eq_zero_of_balance
    (frequency (network.mode₁ a))
    (frequency (network.mode₂ a))
    (frequency (network.mode₃ a))
    (rate a)
    (action (network.mode₁ a))
    (action (network.mode₂ a))
    (action (network.mode₃ a))
    (hresonance a)

/-- Nonnegative rates and positive actions make total logarithmic-entropy
production nonnegative term by term. -/
theorem totalLogEntropyProduction_nonneg
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real)
    (hrate : ∀ a, 0 ≤ rate a) (haction : ∀ i, 0 < action i) :
    0 ≤ totalLogEntropyProduction network rate action := by
  rw [totalLogEntropyProduction_eq_sum]
  exact Finset.sum_nonneg fun a _ =>
    entropyProduction_nonneg (hrate a)
      (haction (network.mode₁ a))
      (haction (network.mode₂ a))
      (haction (network.mode₃ a))

/-- If the total entropy production is zero, every triad whose rate is
strictly positive satisfies inverse-action balance. -/
theorem inverseActionBalance_of_totalLogEntropyProduction_eq_zero
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real)
    (hrate : ∀ a, 0 ≤ rate a) (haction : ∀ i, 0 < action i)
    (hzero : totalLogEntropyProduction network rate action = 0)
    (a : Triad) (ha_active : 0 < rate a) :
    inverseActionMismatch
      (action (network.mode₁ a))
      (action (network.mode₂ a))
      (action (network.mode₃ a)) = 0 := by
  have hsum :
      (∑ b, entropyProduction (rate b)
        (action (network.mode₁ b))
        (action (network.mode₂ b))
        (action (network.mode₃ b))) = 0 := by
    rw [← totalLogEntropyProduction_eq_sum]
    exact hzero
  have hterm_nonneg : ∀ b ∈ (Finset.univ : Finset Triad),
      0 ≤ entropyProduction (rate b)
        (action (network.mode₁ b))
        (action (network.mode₂ b))
        (action (network.mode₃ b)) := by
    intro b _
    exact entropyProduction_nonneg (hrate b)
      (haction (network.mode₁ b))
      (haction (network.mode₂ b))
      (haction (network.mode₃ b))
  have ha_zero :=
    (Finset.sum_eq_zero_iff_of_nonneg hterm_nonneg).mp hsum a (Finset.mem_univ a)
  exact (entropyProduction_eq_zero_iff_inverseActionMismatch_eq_zero
    ha_active
    (haction (network.mode₁ a))
    (haction (network.mode₂ a))
    (haction (network.mode₃ a))).mp ha_zero

/-- With strictly positive rates, zero total entropy production balances every
triad in the network. -/
theorem all_inverseActionBalanced_of_totalLogEntropyProduction_eq_zero
    (network : Network Mode Triad) (rate : Triad → Real)
    (action : Mode → Real)
    (hrate : ∀ a, 0 < rate a) (haction : ∀ i, 0 < action i)
    (hzero : totalLogEntropyProduction network rate action = 0) :
    ∀ a, inverseActionMismatch
      (action (network.mode₁ a))
      (action (network.mode₂ a))
      (action (network.mode₃ a)) = 0 := by
  intro a
  exact inverseActionBalance_of_totalLogEntropyProduction_eq_zero
    network rate action (fun b => (hrate b).le) haction hzero a (hrate a)

/-- Explicit rigidity assumption for equilibrium identification: every scalar
mode weight balanced on all triads is proportional to `frequency`.  This is
the precise connectivity/rank input needed below; this module does not prove
it for the frozen lattice. -/
def FrequencyBalanceRigid
    (network : Network Mode Triad) (frequency : Mode → Real) : Prop :=
  ∀ weight : Mode → Real,
    (∀ a, weight (network.mode₁ a) =
      weight (network.mode₂ a) + weight (network.mode₃ a)) →
      ∃ scale : Real, ∀ i, weight i = scale * frequency i

/-- Under the explicit balance-rigidity assumption, zero entropy production
identifies inverse actions with a scalar multiple of the resonant frequency. -/
theorem inverseAction_proportional_of_totalLogEntropyProduction_eq_zero
    (network : Network Mode Triad) (frequency : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real)
    (hrigid : FrequencyBalanceRigid network frequency)
    (hrate : ∀ a, 0 < rate a) (haction : ∀ i, 0 < action i)
    (hzero : totalLogEntropyProduction network rate action = 0) :
    ∃ scale : Real, ∀ i, (action i)⁻¹ = scale * frequency i := by
  apply hrigid (fun i => (action i)⁻¹)
  intro a
  apply (inverseActionMismatch_eq_zero_iff
    (action (network.mode₁ a))
    (action (network.mode₂ a))
    (action (network.mode₃ a))).mp
  exact all_inverseActionBalanced_of_totalLogEntropyProduction_eq_zero
    network rate action hrate haction hzero a

/-- Conversely, an inverse-action profile proportional to a resonant frequency
has zero total entropy production. -/
theorem totalLogEntropyProduction_eq_zero_of_inverseAction_proportional
    (network : Network Mode Triad) (frequency : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real)
    (hresonance : ∀ a, frequency (network.mode₁ a) =
      frequency (network.mode₂ a) + frequency (network.mode₃ a))
    (hprofile : ∃ scale : Real, ∀ i, (action i)⁻¹ = scale * frequency i) :
    totalLogEntropyProduction network rate action = 0 := by
  obtain ⟨scale, hscale⟩ := hprofile
  rw [totalLogEntropyProduction_eq_sum]
  apply Finset.sum_eq_zero
  intro a _
  have hmismatch : inverseActionMismatch
      (action (network.mode₁ a))
      (action (network.mode₂ a))
      (action (network.mode₃ a)) = 0 := by
    unfold inverseActionMismatch
    rw [hscale, hscale, hscale, hresonance a]
    ring
  simp [entropyProduction, hmismatch]

/-- Equilibrium characterization for a resonant, balance-rigid finite network
with strictly positive rates and actions.  All structural hypotheses remain
explicit. -/
theorem totalLogEntropyProduction_eq_zero_iff_inverseAction_proportional
    (network : Network Mode Triad) (frequency : Mode → Real)
    (rate : Triad → Real) (action : Mode → Real)
    (hresonance : ∀ a, frequency (network.mode₁ a) =
      frequency (network.mode₂ a) + frequency (network.mode₃ a))
    (hrigid : FrequencyBalanceRigid network frequency)
    (hrate : ∀ a, 0 < rate a) (haction : ∀ i, 0 < action i) :
    totalLogEntropyProduction network rate action = 0 ↔
      ∃ scale : Real, ∀ i, (action i)⁻¹ = scale * frequency i := by
  constructor
  · exact inverseAction_proportional_of_totalLogEntropyProduction_eq_zero
      network frequency rate action hrigid hrate haction
  · exact totalLogEntropyProduction_eq_zero_of_inverseAction_proportional
      network frequency rate action hresonance

end


end ArchonPhysics.FiniteThreeWaveCollisionNetwork
