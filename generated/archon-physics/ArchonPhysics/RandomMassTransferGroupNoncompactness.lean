import ArchonPhysics.RandomMassTwoStepQuenchedLogObstruction

/-!
# Concrete transfer-group noncompactness

For two distinct masses, the relative element
`T(m₁, λ) T(m₂, λ)⁻¹` is an explicit nontrivial upper unipotent shear.
Its powers have a linearly growing off-diagonal entry, giving a concrete
unboundedness certificate for the group generated by the two transfer
matrices.  We also rule out a common real eigenline.

The absence of one common line excludes only a singleton invariant subset of
the real projective line.  The precise stronger Furstenberg input still to
prove is the absence of every nonempty finite invariant projective family,
defined at the end of this file.  No Furstenberg theorem, positive Lyapunov
exponent, EFC, or localization conclusion is asserted here.
-/

open scoped Matrix

namespace ArchonPhysics.RandomMassTransferGroupNoncompactness

open ArchonPhysics
open ArchonPhysics.RandomMassAndersonTransferBridge
open ArchonPhysics.RandomMassTwoStepAnnealedTransferGrowth
open ArchonPhysics.RandomMassWeakEnergyTransferGroundwork
open Set

noncomputable section

/-- Explicit inverse of the scalar one-site Anderson transfer matrix. -/
def andersonTransferMatrixInverse (lambda mass : Real) :
    Matrix (Fin 2) (Fin 2) Real :=
  !![ 0,                                      1;
     -1, 2 - andersonDiagonalPotential lambda mass]

theorem andersonTransferMatrix_mul_inverse (lambda mass : Real) :
    andersonTransferMatrix lambda mass *
      andersonTransferMatrixInverse lambda mass = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [andersonTransferMatrix, andersonTransferMatrixInverse,
      andersonDiagonalPotential, Matrix.mul_apply, Fin.sum_univ_two]

theorem andersonTransferMatrix_inverse_mul (lambda mass : Real) :
    andersonTransferMatrixInverse lambda mass *
      andersonTransferMatrix lambda mass = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [andersonTransferMatrix, andersonTransferMatrixInverse,
      andersonDiagonalPotential, Matrix.mul_apply, Fin.sum_univ_two]

/-- The transfer matrix as an actual unit of the `2×2` matrix ring. -/
def andersonTransferUnit (lambda mass : Real) :
    (Matrix (Fin 2) (Fin 2) Real)ˣ :=
  ⟨andersonTransferMatrix lambda mass,
    andersonTransferMatrixInverse lambda mass,
    andersonTransferMatrix_mul_inverse lambda mass,
    andersonTransferMatrix_inverse_mul lambda mass⟩

/-- Upper unipotent shear with parameter `shear`. -/
def upperUnipotentShear (shear : Real) : Matrix (Fin 2) (Fin 2) Real :=
  !![1, shear;
     0,     1]

/-- Exact relative-transfer identity. -/
theorem andersonTransferMatrix_mul_inverse_eq_upperUnipotentShear
    (lambda mass1 mass2 : Real) :
    andersonTransferMatrix lambda mass1 *
        andersonTransferMatrixInverse lambda mass2 =
      upperUnipotentShear (lambda * (mass2 - mass1)) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [andersonTransferMatrix, andersonTransferMatrixInverse,
      andersonDiagonalPotential, upperUnipotentShear,
      Matrix.mul_apply, Fin.sum_univ_two];
    ring

/-- The same identity expressed inside the actual unit group. -/
theorem coe_andersonTransferUnit_mul_inv_eq_upperUnipotentShear
    (lambda mass1 mass2 : Real) :
    ((↑(andersonTransferUnit lambda mass1 *
      (andersonTransferUnit lambda mass2)⁻¹) :
        Matrix (Fin 2) (Fin 2) Real)) =
      upperUnipotentShear (lambda * (mass2 - mass1)) := by
  change andersonTransferMatrix lambda mass1 *
      andersonTransferMatrixInverse lambda mass2 = _
  exact andersonTransferMatrix_mul_inverse_eq_upperUnipotentShear
    lambda mass1 mass2

/-- A positive spectral parameter and distinct masses give a nontrivial
relative shear. -/
theorem relative_shear_ne_zero
    {lambda mass1 mass2 : Real} (hlambda : 0 < lambda)
    (hmass : mass1 ≠ mass2) :
    lambda * (mass2 - mass1) ≠ 0 := by
  exact mul_ne_zero (ne_of_gt hlambda) (sub_ne_zero.mpr hmass.symm)

/-- Exact power formula for a unipotent shear. -/
theorem upperUnipotentShear_pow (shear : Real) (n : Nat) :
    upperUnipotentShear shear ^ n =
      upperUnipotentShear ((n : Real) * shear) := by
  induction n with
  | zero =>
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [upperUnipotentShear]
  | succ n ih =>
      rw [pow_succ, ih]
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [upperUnipotentShear, Matrix.mul_apply, Fin.sum_univ_two,
          Nat.cast_succ];
        ring

/-- Exact power formula for the relative transfer element. -/
theorem relativeTransfer_pow
    (lambda mass1 mass2 : Real) (n : Nat) :
    (andersonTransferMatrix lambda mass1 *
      andersonTransferMatrixInverse lambda mass2) ^ n =
        upperUnipotentShear
          ((n : Real) * (lambda * (mass2 - mass1))) := by
  rw [andersonTransferMatrix_mul_inverse_eq_upperUnipotentShear,
    upperUnipotentShear_pow]

/-- A nonzero real slope has unbounded natural multiples. -/
theorem exists_nat_abs_natCast_mul_gt
    {slope : Real} (hslope : slope ≠ 0) (bound : Real) :
    ∃ n : Nat, bound < |(n : Real) * slope| := by
  have hslope_abs : 0 < |slope| := abs_pos.mpr hslope
  obtain ⟨n, hn⟩ := exists_nat_gt (max 0 bound / |slope|)
  have hmul : max 0 bound < (n : Real) * |slope| :=
    (div_lt_iff₀ hslope_abs).mp hn
  refine ⟨n, ?_⟩
  calc
    bound ≤ max 0 bound := le_max_right _ _
    _ < (n : Real) * |slope| := hmul
    _ = |(n : Real) * slope| := by
      simp [abs_mul]

/-- The `(0,1)` entry of powers of the relative group element is unbounded. -/
theorem relativeTransfer_powers_unbounded_entry
    {lambda mass1 mass2 : Real} (hlambda : 0 < lambda)
    (hmass : mass1 ≠ mass2) (bound : Real) :
    ∃ n : Nat, bound <
      |((andersonTransferMatrix lambda mass1 *
        andersonTransferMatrixInverse lambda mass2) ^ n) 0 1| := by
  obtain ⟨n, hn⟩ := exists_nat_abs_natCast_mul_gt
    (relative_shear_ne_zero hlambda hmass) bound
  refine ⟨n, ?_⟩
  rw [relativeTransfer_pow]
  simpa [upperUnipotentShear] using hn

/-- Frozen-support version of the concrete noncompactness certificate. -/
theorem frozenSupport_twoMass_unbounded_relativeTransfer_entry
    {lambda mass1 mass2 : Real} (hlambda : 0 < lambda)
    (hmass1 : mass1 ∈ RandomEnsemble.massSupport)
    (hmass2 : mass2 ∈ RandomEnsemble.massSupport)
    (hmass : mass1 ≠ mass2) :
    mass1 ∈ RandomEnsemble.massSupport ∧
    mass2 ∈ RandomEnsemble.massSupport ∧
    ∀ bound : Real, ∃ n : Nat, bound <
      |((andersonTransferMatrix lambda mass1 *
        andersonTransferMatrixInverse lambda mass2) ^ n) 0 1| := by
  exact ⟨hmass1, hmass2,
    fun bound => relativeTransfer_powers_unbounded_entry
      hlambda hmass bound⟩

/-! ## Common invariant lines -/

/-- Two vectors represent the same real projective direction. -/
def ProjectivelyEquivalent (left right : Fin 2 → Real) : Prop :=
  ∃ scale : Real, scale ≠ 0 ∧ right = scale • left

/-- The two transfer matrices have a common invariant real line exactly when
they have a common nonzero real eigenvector, possibly with different
eigenvalues. -/
def HasCommonInvariantRealLine
    (lambda mass1 mass2 : Real) : Prop :=
  ∃ state : Fin 2 → Real, state ≠ 0 ∧
    ∃ eigenvalue1 eigenvalue2 : Real,
      oneStepTransferState lambda mass1 state = eigenvalue1 • state ∧
      oneStepTransferState lambda mass2 state = eigenvalue2 • state

/-- Distinct masses at a nonzero spectral parameter have no common real
eigenvector, hence no common invariant real line. -/
theorem not_hasCommonInvariantRealLine
    {lambda mass1 mass2 : Real} (hlambda : lambda ≠ 0)
    (hmass : mass1 ≠ mass2) :
    ¬HasCommonInvariantRealLine lambda mass1 mass2 := by
  rintro ⟨state, hstate, eigenvalue1, eigenvalue2, hfirst, hsecond⟩
  have hfirst0 := congrFun hfirst 0
  have hfirst1 := congrFun hfirst 1
  have hsecond0 := congrFun hsecond 0
  have hsecond1 := congrFun hsecond 1
  rw [oneStepTransferState_apply_zero] at hfirst0 hsecond0
  rw [oneStepTransferState_apply_one] at hfirst1 hsecond1
  simp only [Pi.smul_apply, smul_eq_mul] at hfirst0 hfirst1 hsecond0 hsecond1
  unfold centeredTransferCoefficient centeredMass at hfirst0 hsecond0
  by_cases hstate1 : state 1 = 0
  · have hstate0 : state 0 = 0 := by
      simpa [hstate1] using hfirst1
    apply hstate
    funext i
    fin_cases i
    · exact hstate0
    · exact hstate1
  · have heigenvalue : eigenvalue1 = eigenvalue2 := by
      apply (mul_right_cancel₀ hstate1)
      exact hfirst1.symm.trans hsecond1
    rw [heigenvalue] at hfirst0
    have hcoefficient : lambda * (mass1 - mass2) ≠ 0 :=
      mul_ne_zero hlambda (sub_ne_zero.mpr hmass)
    have hproduct : lambda * (mass1 - mass2) * state 0 = 0 := by
      nlinarith [hfirst0, hsecond0]
    have hstate0 : state 0 = 0 :=
      (mul_eq_zero.mp hproduct).resolve_left hcoefficient
    rw [hstate0] at hfirst0
    have : state 1 = 0 := by simpa using hfirst0
    exact hstate1 this

/-- A finite projective family invariant under both generators.  Negating
this proposition is the precise remaining strong-irreducibility step; the
common-line theorem above handles only the singleton case. -/
def PreservesNonemptyFiniteProjectiveFamily
    (lambda mass1 mass2 : Real) : Prop :=
  ∃ k : Nat, 0 < k ∧
    ∃ direction : Fin k → Fin 2 → Real,
      (∀ i, direction i ≠ 0) ∧
      (∀ i, ∃ j,
        ProjectivelyEquivalent
          (oneStepTransferState lambda mass1 (direction i))
          (direction j)) ∧
      (∀ i, ∃ j,
        ProjectivelyEquivalent
          (oneStepTransferState lambda mass2 (direction i))
          (direction j))

/-- The exact projective strong-irreducibility target left open here. -/
def IsProjectivelyStronglyIrreducible
    (lambda mass1 mass2 : Real) : Prop :=
  ¬PreservesNonemptyFiniteProjectiveFamily lambda mass1 mass2

end

end ArchonPhysics.RandomMassTransferGroupNoncompactness
