/-!
# Current generated by a rotating conducting spherical shell

The primary raster `982.png` shows a conducting spherical shell of radius
`10.0 cm` rotating at `2 Hz` about a vertical axis.  A uniform `1.00 T`
magnetic field points downward along that axis.  Stationary radial rods make
brush contact at the top of the sphere and at polar angle `60.0°`; their outer
ends are joined through a `10.0 Ω` resistor.

Physical magnitudes are represented by Physlib's unit-independent
`Dimensionful` quantities.  Real numbers occur only as coherent-SI readouts,
dimensionless angles, literal figure labels, and displayed answer values.

Assumption/target split:

* governing laws: `ω = 2πf`, the rotating-conductor motional-emf law between
  two polar contacts, and Ohm's law for the closed external circuit;
* previous-part results: none;
* figure/data readouts: conducting components and brush topology, vertical
  rotation axis, downward uniform field, radial contacts at `0°` and `60°`,
  `r = 10.0 cm`, `f = 2 Hz`, `B = 1.00 T`, and `R = 10.0 Ω`;
* current target conclusions: the current magnitude is exactly `3π/2000 A`,
  and hence the uniquely closest listed answer is B, `4.73 mA`.

The current and motional emf are independent fields of the setup.  Neither is
defined by the requested numerical answer, and no premise below states either
target conclusion.
-/

/-! ## Dimensions, physical magnitudes, and coherent-SI readouts -/

/-- Frequency and angular speed both have inverse-time dimension. -/
def inverseTimeDimension : Dimension := T𝓭⁻¹

/-- Magnetic flux density has SI dimension `M T⁻¹ C⁻¹` (tesla). -/
def magneticFluxDensityDimension : Dimension :=
  M𝓭 * T𝓭⁻¹ * C𝓭⁻¹

/-- Electric potential has SI dimension `M L² T⁻² C⁻¹` (volt). -/
def electricPotentialDimension : Dimension :=
  M𝓭 * L𝓭 * L𝓭 * T𝓭⁻¹ * T𝓭⁻¹ * C𝓭⁻¹

/-- Electric current has SI dimension `C T⁻¹` (ampere). -/
def electricCurrentDimension : Dimension :=
  C𝓭 * T𝓭⁻¹

/-- Electrical resistance has SI dimension `M L² T⁻¹ C⁻²` (ohm). -/
def electricalResistanceDimension : Dimension :=
  M𝓭 * L𝓭 * L𝓭 * T𝓭⁻¹ * C𝓭⁻¹ * C𝓭⁻¹

/-- A nonnegative, unit-independent physical length. -/
abbrev LengthMagnitude : Type :=
  Dimensionful (WithDim L𝓭 NNReal)

/-- A nonnegative, unit-independent rotation frequency. -/
abbrev FrequencyMagnitude : Type :=
  Dimensionful (WithDim inverseTimeDimension NNReal)

/-- A nonnegative, unit-independent angular speed. -/
abbrev AngularSpeedMagnitude : Type :=
  Dimensionful (WithDim inverseTimeDimension NNReal)

/-- A nonnegative, unit-independent magnetic-flux-density magnitude. -/
abbrev MagneticFluxDensityMagnitude : Type :=
  Dimensionful (WithDim magneticFluxDensityDimension NNReal)

/-- A nonnegative, unit-independent electrical resistance. -/
abbrev ResistanceMagnitude : Type :=
  Dimensionful (WithDim electricalResistanceDimension NNReal)

/-- A nonnegative, unit-independent electromotive-force magnitude. -/
abbrev ElectromotiveForceMagnitude : Type :=
  Dimensionful (WithDim electricPotentialDimension NNReal)

/-- A nonnegative, unit-independent electric-current magnitude. -/
abbrev ElectricCurrentMagnitude : Type :=
  Dimensionful (WithDim electricCurrentDimension NNReal)

/-- Coherent-SI scalar readout of a nonnegative dimensionful magnitude. -/
def coherentSIReadout {d : Dimension}
    (quantity : Dimensionful (WithDim d NNReal)) : ℝ :=
  ((quantity UnitChoices.SI).val : ℝ)

/-- Read a length magnitude in metres. -/
def lengthInMeters (length : LengthMagnitude) : ℝ :=
  coherentSIReadout length

/-- Read a rotation frequency in hertz. -/
def frequencyInHertz (frequency : FrequencyMagnitude) : ℝ :=
  coherentSIReadout frequency

/-- Read an angular speed in radians per second. -/
def angularSpeedInRadiansPerSecond (angularSpeed : AngularSpeedMagnitude) : ℝ :=
  coherentSIReadout angularSpeed

/-- Read a magnetic-flux-density magnitude in teslas. -/
def magneticFluxDensityInTeslas
    (fieldMagnitude : MagneticFluxDensityMagnitude) : ℝ :=
  coherentSIReadout fieldMagnitude

/-- Read an electrical resistance in ohms. -/
def resistanceInOhms (resistance : ResistanceMagnitude) : ℝ :=
  coherentSIReadout resistance

/-- Read an electromotive-force magnitude in volts. -/
def electromotiveForceInVolts (emf : ElectromotiveForceMagnitude) : ℝ :=
  coherentSIReadout emf

/-- Read an electric-current magnitude in amperes. -/
def currentInAmperes (current : ElectricCurrentMagnitude) : ℝ :=
  coherentSIReadout current

/-- Convert a degree readout into its dimensionless radian value. -/
def radiansFromDegrees (degrees : ℝ) : ℝ :=
  degrees * Real.pi / 180

/-! ## Physical roles, contact geometry, and primary-raster vocabulary -/

/-- The two brush-contact locations on the spherical shell. -/
inductive SphereContact where
  | top
  | oblique
  deriving DecidableEq, Fintype, Repr

/-- Orientations needed to state the axis geometry. -/
inductive AxisOrientation where
  | vertical
  | horizontal
  | other
  deriving DecidableEq, Repr

/-- Directions along the vertical rotation axis. -/
inductive AxialDirection where
  | upward
  | downward
  deriving DecidableEq, Repr

/-- Qualitative models for the applied magnetic field. -/
inductive MagneticFieldRegime where
  | constantUniform
  | nonuniform
  | timeDependent
  deriving DecidableEq, Repr

/-- Motion of a conductor relative to the laboratory frame. -/
inductive ConductorMotion where
  | rotatesWithSphere
  | stationaryInSupportFrame
  deriving DecidableEq, Repr

